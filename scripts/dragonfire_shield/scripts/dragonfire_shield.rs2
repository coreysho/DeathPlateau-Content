// THE DRAGONFIRE SHIELD (Corey, 2026-10-09) - Old School's 18 June 2007 item, in this build.
//
// Four pieces: what protects you from dragonfire, how the shield charges, what the charges are
// worth, and how one gets made.

// ---------------------------------------------------------------------------------------------
// DRAGONFIRE PROTECTION, asked of the item rather than of its name
// ---------------------------------------------------------------------------------------------
// Eleven tests across six files used to name antidragonbreathshield directly. Every one of them
// was a list of one, and the first thing that needed adding to it - this shield - would otherwise
// have been the best shield in the game and would still have burned its owner alive. They ask this
// now, and it reads param=antidragon off whatever is in the hand.

[proc,has_antidragon_shield]()(boolean)
def_obj $shield = inv_getobj(worn, ^wearpos_lhand);
if ($shield = null) {
    return(false);
}
return(oc_param($shield, antidragon));

// The second-player form, for bolt_effects.rs2's immunity test - a dot proc cannot call a plain
// one, which is why this is written out rather than shared.
[proc,.has_antidragon_shield]()(boolean)
def_obj $shield = .inv_getobj(worn, ^wearpos_lhand);
if ($shield = null) {
    return(false);
}
return(oc_param($shield, antidragon));

// ---------------------------------------------------------------------------------------------
// CHARGES
// ---------------------------------------------------------------------------------------------
// "The shield gains one charge for each adult dragon dragonfire attack or wyvern icy breath attack
// it absorbs while equipped, up to a maximum of 50." Called from the same places that just decided
// the breath was absorbed, so a charge is only ever paid for a breath the shield actually ate.

[proc,dfs_absorb]
def_obj $shield = inv_getobj(worn, ^wearpos_lhand);
if ($shield = dragonfire_shield_uncharged) {
    // the first breath turns the tradeable shield into the charged one, which is untradeable
    // because the charges are on the player and would otherwise travel with a trade
    inv_setslot(worn, ^wearpos_lhand, dragonfire_shield, 1);
    %dfs_charges = 0;
    mes("Your shield drinks in the dragonfire.");
} else if ($shield ! dragonfire_shield) {
    return;
}
if (%dfs_charges >= ^dfs_max_charges) {
    return;
}
%dfs_charges = add(%dfs_charges, 1);
~update_bonuses;

// "Each charge adds +1 to the melee and ranged defence bonuses, for a +50 maximum." equip.rs2 adds
// this to stab, slash, crush and ranged defence the way it already adds the blowpipe's dart to the
// ranged bonus - the one precedent in this build for a worn bonus that is not a static param.
[proc,dfs_charge_defence]()(int)
if (inv_getobj(worn, ^wearpos_lhand) ! dragonfire_shield) {
    return(0);
}
return(min(%dfs_charges, ^dfs_max_charges));

[proc,.dfs_charge_defence]()(int)
if (.inv_getobj(worn, ^wearpos_lhand) ! dragonfire_shield) {
    return(0);
}
return(min(.%dfs_charges, ^dfs_max_charges));

// ---------------------------------------------------------------------------------------------
// THE WORN OPTIONS
// ---------------------------------------------------------------------------------------------

[label,wearop2_dragonfire_shield]
if (%dfs_charges <= 0) {
    mes("Your dragonfire shield is already empty.");
    return;
}
mes("You release the dragonfire shield's charges harmlessly into the air.");
%dfs_charges = 0;
inv_setslot(worn, ^wearpos_lhand, dragonfire_shield_uncharged, 1);
~update_bonuses;

[opheld3,dragonfire_shield] ~dfs_check;
[label,wearop3_dragonfire_shield] ~dfs_check;

[proc,dfs_check]
if (%dfs_charges = 1) {
    mes("Your dragonfire shield has 1 charge.");
    return;
}
mes("Your dragonfire shield has <tostring(%dfs_charges)> charges.");

// ---------------------------------------------------------------------------------------------
// MAKING ONE
// ---------------------------------------------------------------------------------------------
// "A player with 90 Smithing can combine an anti-dragon shield with a draconic visage at an anvil
// to make a dragonfire shield. This grants 2,000 Smithing XP." Reached from [oplocu,anvil] in
// skill_smithing, the way the godsword shards are.

[label,dfs_smith_at_anvil]
def_obj $other = antidragonbreathshield;
if (last_useitem = antidragonbreathshield) {
    $other = draconic_visage;
}
if (inv_total(inv, $other) < 1) {
    ~mesbox("You need a draconic visage and an anti-dragon shield to make a dragonfire shield.");
    return;
}
if (inv_total(inv, hammer) < 1) {
    ~mesbox("You need a hammer to work the metal with.");
    return;
}
if (stat(smithing) < ^dfs_smith_level) {
    ~mesbox("You need a Smithing level of at least <tostring(^dfs_smith_level)> to attach the visage to the shield.|Oziach in Edgeville would do it for you, for a price.");
    return;
}
anim(human_smithing, 0);
sound_synth(anvil, 1, 0);
inv_del(inv, draconic_visage, 1);
inv_del(inv, antidragonbreathshield, 1);
inv_add(inv, dragonfire_shield_uncharged, 1);
stat_advance(smithing, ^dfs_smith_xp);
~objbox(dragonfire_shield_uncharged, "You attach the visage to the shield.", 250, 0, 0);

// ---------------------------------------------------------------------------------------------
// OZIACH, for players under the level
// ---------------------------------------------------------------------------------------------
// "Players without the required level can take the visage and an anti-dragon shield to Oziach in
// Edgeville, who will make the shield for 1,250,000 coins." He is already the Dragon Slayer
// reward npc, so the quest requirement is one he enforces anyway.

[label,oziach_dragonfire_shield]
~chatplayer("<p,quiz>Could you attach this visage to my shield?");
if (inv_total(inv, draconic_visage) < 1 | inv_total(inv, antidragonbreathshield) < 1) {
    ~chatnpc("<p,neutral>Bring me a draconic visage and an anti-dragon shield and I will see what I can do.");
    return;
}
~chatnpc("<p,neutral>I can do that. It is delicate work, mind - <tostring(^dfs_oziach_fee)> coins.");
if (~p_choice2("Yes, do it.", 1, "That's robbery.", 2) = 2) {
    ~chatplayer("<p,angry>That's robbery.");
    return;
}
if (inv_total(inv, coins) < ^dfs_oziach_fee) {
    ~chatnpc("<p,neutral>You do not have that kind of money.");
    return;
}
inv_del(inv, coins, ^dfs_oziach_fee);
inv_del(inv, draconic_visage, 1);
inv_del(inv, antidragonbreathshield, 1);
inv_add(inv, dragonfire_shield_uncharged, 1);
~objbox(dragonfire_shield_uncharged, "Oziach attaches the visage to your shield.", 250, 0, 0);

// ---------------------------------------------------------------------------------------------
// THE ACTIVATE SPECIAL
// ---------------------------------------------------------------------------------------------
// "Right-clicking Activate on the equipped shield uses one charge to fire a dragonfire blast",
// up to 25 damage, 10 tiles, about a two-minute cooldown, accuracy off the player's Defence level
// against the target's Magic defence.
//
// HOW IT FINDS WHAT TO SHOOT, which is the only place this departs from Old School. There it fires
// at whatever you are already fighting, and this build has no "current target" a WORN option can
// read: %aggressive_npc is set by an npc deciding to attack YOU, so it is null in exactly the case
// a player reaches for this button. So the shield looks for itself, with npc_huntall and
// .npc_findnext - the same pair the dragon 2h sword's multi-hit uses to find its extra targets -
// and takes the nearest attackable npc in range, preferring one that is already fighting you.

[label,wearop1_dragonfire_shield]
if (%dfs_charges <= 0) {
    mes("Your dragonfire shield has no charges left.");
    return;
}
if (map_clock < %dfs_cooldown) {
    mes("Your dragonfire shield needs to cool down before you can use it again.");
    return;
}
def_npc_uid $target = ~dfs_find_target;
if ($target = null) {
    mes("There is nothing in range for you to aim at.");
    return;
}
if (npc_finduid($target) = false) {
    return;
}
if (~npc_is_attackable = false) {
    return;
}
~dfs_fire;

[proc,dfs_find_target]()(npc_uid)
def_npc_uid $best = null;
def_int $best_dist = 99;
def_int $dist = 0;
npc_huntall(coord, ^dfs_special_range, ^vis_lineofsight);
while (.npc_findnext = true) {
    if (compare(nc_op(.npc_type, 2), "Attack") = 0) {
        $dist = max(abs(sub(coordx(.npc_coord), coordx(coord))), abs(sub(coordz(.npc_coord), coordz(coord))));
        // whatever is already on you wins, whichever is nearer
        if (.npc_uid = %aggressive_npc) {
            $dist = 0;
        }
        if ($dist < $best_dist) {
            $best_dist = $dist;
            $best = .npc_uid;
        }
    }
}
return($best);

[proc,dfs_fire]
%dfs_cooldown = add(map_clock, ^dfs_special_cooldown);
%dfs_charges = sub(%dfs_charges, 1);
if (%dfs_charges <= 0) {
    // spent: back to the shield you can trade, as Old School does it
    inv_setslot(worn, ^wearpos_lhand, dragonfire_shield_uncharged, 1);
}
~update_bonuses;
anim(human_shield_defence, 0);
sound_synth(dragonbreath, 1, 0);
def_int $duration = ~npc_projectile(coord, npc_uid, firebreath_travel, 43, 31, 51, 16, -5, 64, 10);

// "It does not work against chromatic dragons, metal dragons, wyverns, frost dragons" - here, the
// fiery and the draconic, which is the same pair bolt_effects.rs2 refuses its Dragon's Breath to.
if (npc_param(fiery) = ^true | npc_param(draconic) = ^true) {
    spotanim_npc(failedspell_impact, 92, $duration);
    ~npc_retaliate(0);
    return;
}

// "Accuracy: based on the player's Defence level, rolled against the target's Magic defence." The
// roll is built the way npc_defence_roll_specific builds the other side of it - effective stat
// with no prayer bonus, +9 for a style bonus of 1, and no equipment bonus, because the shield's
// blast has none.
def_int $attack_roll = ~combat_stat(add(~combat_effective_stat(stat(defence), 100), 9), 0);
def_int $defence_roll = ~npc_defence_roll_specific(^magic_style);
if (randominc($attack_roll) <= randominc($defence_roll)) {
    spotanim_npc(failedspell_impact, 92, $duration);
    ~npc_retaliate(0);
    return;
}

def_int $damage = randominc(min(^dfs_special_maxhit, npc_param(max_dealt)));
def_int $damage_capped = min($damage, npc_stat(hitpoints));
~npc_retaliate(calc($duration / 30 + 1));
npc_queue(2, $damage, calc($duration / 30 + 1));
npc_anim(npc_param(defend_anim), $duration);
npc_heropoints($damage_capped);
spotanim_npc(firebreath_attack, 92, $duration);
