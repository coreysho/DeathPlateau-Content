// Delay and 'climb' to a coord, similar to ladders. 
// Generally used for net obstacles
// THE ROOFTOP CLIMB. ~agility_climb_up plays human_reachforladder, which is a hand going up for a
// rung - right for the ladders and tree branches its twenty-odd callers use it for, and wrong for
// hauling yourself up a wall. Every rooftop course was using it, so a lap was a string of
// ladder-reaches and blinks: the courses themselves contain no anim() of their own at all.
//
// human_climbing (seq 737) is the wall motion, eight frames over 44 client cycles - a tick and a
// half - so the delay is 1 rather than the 0 that let the old one be cut off after a frame or two.
// It is a separate proc rather than a change to agility_climb_up because that one is also what
// Grand Tree, Eagles' Peak, Watchtower and the gnome course climb with, and a ladder is not a wall.
// A ROOFTOP LANDING, GLIDED ONCE. p_exactmove is not only a visual: Player.exactMove teleports you
// to the end tile and then tells the client to glide you there from the start, so a p_telejump
// after it is a SECOND teleport arriving after the glide was set up - the client gets the move,
// then a position update that contradicts it, and the player is dragged back before the animation
// plays. Seven courses did that on every obstacle.
//
// It cannot just be dropped, because exactMove teleports to the end x and z on THE FLOOR YOU ARE
// ALREADY ON - it cannot change storey, which is what the telejump was really doing on the
// obstacles that drop you a floor. So the floor is checked: same floor glides, another floor
// animates where it stands and then jumps.
[proc,agility_roof_move](int $xp, coord $end, seq $anim, int $direction)
if (coordy($end) ! coordy(coord)) {
    anim($anim, 0);
    p_delay(1);
    ~agility_xp($xp);
    p_telejump($end);
    return;
}
// AND IT STARTS AT CYCLE 0. Player.exactMove teleports you to the end BEFORE it sets the mask, so
// the server has you on the far roof from the moment it runs, while the mask tells the client to
// draw you at the START until start_cycle. That gap is a window where your real tile and your drawn
// tile disagree, and the camera follows you through it: forward to the landing, back to the
// obstacle, forward again. This waited 15 cycles - half a tick at 20ms a cycle. Al Kharid's cable
// waited 30 and was reported as exactly that; 15 is the same fault, half the size.
~agility_exactmove($anim, 0, 2, coord, $end, 0, 50, $direction, false);
~agility_xp($xp);
// AND ITS OPPOSITE. The last obstacle of a course drops you back into the street, and playing
// the climbing-UP animation at it reads as the player hauling themselves up thin air. Reported
// from play on Draynor's crate: "the final obstacle where you jump down, it shows a climbing up
// animation". The cache's human_climbing_down is the right motion, but it carries loops=8 - a
// loop point back to its last frame, because bas.rs2 uses it as a WALK seq. Played one-shot it
// loops on that frame for ever and the player reaches the street stuck in a climbing pose.
// agility_climbing_down is the same motion and timings with nothing to loop back to.
[proc,agility_roof_climb_down](int $xp, coord $coord)
anim(agility_climbing_down, 0);
p_delay(1);
~agility_xp($xp);
p_telejump($coord);

[proc,agility_roof_climb](int $xp, coord $coord)
anim(human_climbing, 0);
p_delay(1);
~agility_xp($xp);
p_telejump($coord);

[proc,agility_climb_up](int $xp, coord $coord)
anim(human_reachforladder, 0);
p_delay(0);
~agility_xp($xp);
p_telejump($coord);

// force walk to a specific location, this isn't the 
// same as an exactmove 
[proc,agility_force_move](int $xp, seq $walk_seq, coord $dest)
~set_forcemove_bas($walk_seq);
def_int $change_x = calc(coordx($dest) - coordx(coord));
def_int $change_z = calc(coordz($dest) - coordz(coord));
~agility_walk($change_x, $change_z, true);
~agility_xp($xp);

[proc,agility_walk](int $change_x, int $change_z, boolean $reset_bas)
if($change_x = 0 & $change_z = 0) {
    if($reset_bas = true) ~update_bas;
    return;
}
def_int $move_x = 0;
def_int $move_z = 0;
if ($change_x >= 1) {
    $move_x = 1;
} else if ($change_x <= -1) {
    $move_x = -1;
}
if ($change_z >= 1) {
    $move_z = 1;
} else if ($change_z <= -1) {
    $move_z = -1;
}
// Perform movement and re-calc
def_coord $movement_coord = movecoord(coord, $move_x, 0, $move_z);
p_teleport(movecoord(coord, $move_x, 0, $move_z));
$change_x = calc($change_x - $move_x);
$change_z = calc($change_z - $move_z);
p_stopaction;
p_delay(0);
// recursive call
~agility_walk($change_x, $change_z, $reset_bas);

// "clipped" teleport walk that OSRS seems to use, probably since p_walk isn't reliable
// and you wont want players visibly clipping much!
[proc,clipped_telewalk](int $change_x, int $change_z)
if($change_x = 0 & $change_z = 0) {
    return;
}
def_int $move_x = 0;
def_int $move_z = 0;
if ($change_x >= 1) {
    $move_x = 1;
} else if ($change_x <= -1) {
    $move_x = -1;
}
if ($change_z >= 1) {
    $move_z = 1;
} else if ($change_z <= -1) {
    $move_z = -1;
}
// if diagonal isn't blocked but adj's are blocked, this will prevent a diagonal movement
if (map_blocked(movecoord(coord, 0, 0, $move_z)) = true) { // z block
    $move_z = 0;
}
if (map_blocked(movecoord(coord, $move_x, 0, 0)) = true) { // x block
    $move_x = 0;
}
if (map_blocked(movecoord(coord, $move_x, 0, $move_z)) = true) { // diagonal blocked, convert to horiz/vert movement
    if (map_blocked(movecoord(coord, $move_x, 0, 0)) = false) { // try vert
        $move_z = 0;
    } else if (map_blocked(movecoord(coord, 0, 0, $move_z)) = false) { // try horiz
        $move_x = 0;
    } else {
        $move_x = 0;
        $move_z = 0;
    }
}
if($move_x = 0 & $move_z = 0) { // no possible movement
    return;
}
// Perform movement and re-calc
def_coord $movement_coord = movecoord(coord, $move_x, 0, $move_z);
p_teleport(movecoord(coord, $move_x, 0, $move_z));
$change_x = calc($change_x - $move_x);
$change_z = calc($change_z - $move_z);
p_stopaction;
p_delay(0);
// recursive call
~clipped_telewalk($change_x, $change_z);

// Proc for combining all general parts of an exactmove used in the agility skill (animation, delay, locmerge)
[proc,agility_exactmove](seq $anim, int $anim_delay, int $movement_delay, coord $start_coord, coord $end_coord, int $start_cycle, int $end_cycle, int $direction, boolean $merge_with_loc)
anim($anim, $anim_delay);
if($merge_with_loc = true) {
    p_locmerge($start_cycle, $end_cycle, $start_coord, $end_coord); 
}
p_exactmove($start_coord, $end_coord, $start_cycle, $end_cycle, $direction);
p_delay($movement_delay);

// Standard delayed fail used in agility
[proc,agility_delay_fail](coord $fall_face, coord $fail_coord, int $damage, string $message)
anim(human_walk_logbalance_stumble, 0);
sound_synth(stumble_loop, 10, 0);
facesquare($fall_face);
p_delay(1);
p_telejump($fail_coord);
damage(uid, 1, $damage);
if (gender() = 0) {
    sound_synth(human_hit2, 1, 20);
} else {
    sound_synth(female_hit2, 1, 20);
}
mes($message);
p_delay(0);
if (stat(hitpoints) = 0){
    //queue(player_death, 0);
    return;
}
~ring_of_life_check;

// Forces the player to walk to a certain coord. Basically p_teleport but doesnt telejump from a distance.
// doesnt respect clipping
[proc,forcemove](coord $dest_coord)
def_int $change_x = calc(coordx($dest_coord) - coordx(coord));
def_int $change_z = calc(coordz($dest_coord) - coordz(coord));
~agility_walk($change_x, $change_z, false);

// does a delayed walk to a certain coord using p_teleport (we can't use p_walk for this)
[proc,forcewalk](coord $dest_coord)(int)
def_int $change_x = calc(coordx($dest_coord) - coordx(coord));
def_int $change_z = calc(coordz($dest_coord) - coordz(coord));
~clipped_telewalk($change_x, $change_z);

// forces the player to delayed "walk" to a certain coord, used for agility obstacle setups
[proc,forcewalk2](coord $dest_coord)
p_delay(0);
~forcewalk($dest_coord);

// Instant fail, not used as often
[proc,agility_instant_fail](coord $fail_coord, int $damage, string $message)
p_telejump($fail_coord);
~damage_self($damage);
mes($message);

[proc,set_walkbas](seq $walk_seq)
~bas_set($walk_seq, $walk_seq, $walk_seq, $walk_seq, $walk_seq, $walk_seq, null);

[proc,set_readywalk_bas](seq $ready_seq, seq $walk_seq)
~bas_set($ready_seq, $walk_seq, $walk_seq, $walk_seq, $walk_seq, $walk_seq, null);

[proc,set_readywalkturn_bas](seq $ready_seq, seq $turn_seq, seq $walk_seq)
~bas_set($ready_seq, $turn_seq, $walk_seq, $walk_seq, $walk_seq, $walk_seq, null);

[proc,set_forcemove_bas](seq $walk_seq)
switch_seq($walk_seq) {
    case human_walk_logbalance : ~set_readywalk_bas(human_walk_logbalance_ready, human_walk_logbalance);
    case human_climbing : ~set_readywalk_bas(human_climbing_ready, human_climbing);
    case human_climbing_down : ~set_readywalk_bas(human_climbing_ready, human_climbing_down);
    case human_walk_sidestep : ~set_readywalkturn_bas(human_ready_sidestep, human_ready_sidestep, human_walk_sidestep);
    case human_walk_sidestepl : ~set_readywalkturn_bas(human_ready_sidestepl, human_ready_sidestepl, human_walk_sidestepl);
    case default : ~set_walkbas($walk_seq);
}

// Finds an identical loc on the $merge_pos coord to switch active_loc to
[proc,change_merged_loc](coord $merge_pos)
if (loc_find($merge_pos, loc_type) = true) {
    return;
}

// WHICH WAY THE PLAYER IS ACTUALLY GOING.
//
// p_exactmove takes a facing, and every one of the five courses courseplan.ts set up passed
// ^exact_north for all of it - so a player crossing west, or dropping south off a roof, slid along
// facing north the whole way. Reported as the animations being wrong on Falador, Seers',
// Pollnivneach, Rellekka and Ardougne alike, which is exactly the five.
//
// This is the travel vector instead, to the eight points the engine has constants for.
[proc,agility_facing](coord $from, coord $to)(int)
def_int $dx = calc(coordx($to) - coordx($from));
def_int $dz = calc(coordz($to) - coordz($from));
if ($dx = 0) {
    if ($dz < 0) {
        return(^exact_south);
    }
    return(^exact_north);
}
if ($dz = 0) {
    if ($dx < 0) {
        return(^exact_west);
    }
    return(^exact_east);
}
if ($dx > 0) {
    if ($dz > 0) {
        return(^exact_northeast);
    }
    return(^exact_southeast);
}
if ($dz > 0) {
    return(^exact_northwest);
}
return(^exact_southwest);
