// The Ardougne Rooftop Course - https://oldschool.runescape.wiki/w/Ardougne_Rooftop_Course
//
// Agility 90, seven obstacles, 889 experience a lap - the last of them and the fastest, which is
// most of the reason anyone trains Agility past 80.
//
// Old School lets you fail the first and second gaps until 95 Agility, and a failure "will drop
// the player below, requiring them to start the course over". The street tile each one drops you
// to is derived by tools/sim/coursefall.ts rather than guessed, which is what this course used to
// leave out. The course opens at 90, so the curve has five levels to run and starts at 94%.

[oploc1,osrsloc_15608]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You climb the wooden beams.");
~agility_roof_climb(^ardougne_xp_beams, ^ardougne_land_beams);
~ardougne_progress(1);

[oploc1,osrsloc_15609]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You jump across the gap.");
if (~ardougne_slipped = true) {
    ~ardougne_fall(^ardougne_fall_gap1, "You miss the jump and fall to the ground below.");
    return;
}
~ardougne_move(^ardougne_xp_gap1, ^ardougne_land_gap1, human_spot_jump);
~ardougne_progress(2);

[oploc1,osrsloc_26635]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You walk carefully along the plank.");
~ardougne_move(^ardougne_xp_plank, ^ardougne_land_plank, human_walk_logbalance);
~ardougne_progress(3);

[oploc1,osrsloc_15610]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You jump across the gap.");
if (~ardougne_slipped = true) {
    ~ardougne_fall(^ardougne_fall_gap2, "You miss the jump and fall to the ground below.");
    return;
}
~ardougne_move(^ardougne_xp_gap2, ^ardougne_land_gap2, human_spot_jump);
~ardougne_progress(4);

[oploc1,osrsloc_15611]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You jump across the gap.");
~ardougne_move(^ardougne_xp_gap3, ^ardougne_land_gap3, human_spot_jump);
~ardougne_progress(5);

[oploc1,osrsloc_28912]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You balance across the steep roof.");
~ardougne_move(^ardougne_xp_roof, ^ardougne_land_roof, human_walk_logbalance);
~ardougne_progress(6);

[oploc1,osrsloc_15612]
if (~ardougne_blocked = true) { return; }
p_arrivedelay;
mes("You jump down from the roof...");
~ardougne_move(^ardougne_xp_gap4, ^ardougne_land_gap4, human_spot_jump);
mes("...and land in the street below.");
~ardougne_progress(7);

[proc,ardougne_blocked]()(boolean)
if (stat(agility) < ^ardougne_level) {
    ~mesbox("You need an Agility level of <tostring(^ardougne_level)> to use this course.");
    return(true);
}
return(false);

// The facing is the way the player is GOING, not north. Every obstacle on this course used to
// pass ^exact_north, so a crossing heading west slid along facing north.
[proc,ardougne_move](int $xp, coord $end, seq $anim)
~agility_roof_move($xp, $end, $anim, ~agility_facing(coord, $end));

// WHETHER THIS ATTEMPT FAILS. The numbers live in ardougne_course.constant,
// where the curve they describe is written out.
[proc,ardougne_slipped]()(boolean)
if (stat_random(agility, ^ardougne_roll_low, ^ardougne_roll_high) = false) {
    return(true);
}
return(false);

// AND A FALL IS A LANDING. "Failing the obstacle will drop the player below, requiring them to
// start the course over" - so the lap progress goes, no experience is paid, and the player ends
// up on a street tile derived by tools/sim/coursefall.ts (^ardougne_fall_gap1, ^ardougne_fall_gap2)
// rather than guessed. ~agility_delay_fail stumbles, turns them towards the drop, waits a tick,
// telejumps, damages and prints, in that order.
[proc,ardougne_fall](coord $to, string $message)
%ardougne_course_progress = 0;
~agility_delay_fail($to, $to, calc(^ardougne_hit_low + random(^ardougne_hit_span)), $message);

[proc,ardougne_progress](int $completed)
if (calc(%ardougne_course_progress + 1) >= $completed) {
    %ardougne_course_progress = $completed;
}
if (%ardougne_course_progress < ^ardougne_obstacles) { return; }
%ardougne_course_progress = 0;
~skillpet_roll(skillpet_squirrel_item, agility, ^skillpet_squirrel_ardougne);
~ardougne_mark_roll;

[proc,ardougne_mark_roll]
if (random(^ardougne_mark_chance) ! 0) { return; }
if (inv_freespace(inv) < 1) {
    mes("You notice a mark of grace, but you have no room for it.");
    return;
}
inv_add(inv, mark_of_grace, 1);
mes("You pick up a mark of grace.");
