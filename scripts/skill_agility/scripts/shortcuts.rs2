[oploc1,falador_crumbling_wall]
if(stat(agility) < 5) {
    ~mesbox("You need an Agility level of 5 to climb the wall.");
    return;
}
if(coordx(coord) > coordx(loc_coord)) {
    def_coord $end_coord = movecoord(loc_coord, -1, 0, 0);
    ~agility_exactmove(human_walk_crumbledwall, 20, 0, coord, $end_coord, 45, 70, ^exact_west, true);
    p_teleport($end_coord);
} else {
    def_coord $end_coord = movecoord(loc_coord, 1, 0, 0);
    ~agility_exactmove(human_walk_crumbledwall, 20, 0, coord, $end_coord, 45, 70, ^exact_east, true);
    p_teleport($end_coord);
}
~agility_xp(50);
sound_synth(climb_wall, 1, 0);
mes("You climb over the wall.");

// Dwarven Mine narrow crevice. Real requirement is Agility 42 and - unusually for a shortcut - no
// experience at all, per the OSRS wiki; added 6 Sep 2005, so period-correct for 377. The loc
// (loc_9325, "Just another crack in the wall", op1=Squeeze-through) is placed twice in m47_153, the
// mine's own mapsquare, as shape-0 wall segments facing west (rotation 0) and east (rotation 2) -
// north-south walls crossed east<->west, matching the wiki's "get from the east part to the west
// part of the Dwarven Mine". Same cross-to-the-other-side shape as the crumbling wall above.
// human_pipesqueeze is the closest real squeeze animation in the cache (the pipe set is the only
// one); swap it if a dedicated crevice animation ever turns up.
// The crevice is a PAIR of loc_9325 tiles - m47_153 local (21,14) and (26,14) - so the
// exit is not one tile off whichever half was clicked. It is the far end of the whole
// passage: west lands at 20,14 and east at 27,14. Deriving it from loc_coord dropped you
// at 25,14, still inside the rocks.
[oploc1,loc_9325]
if (stat(agility) < 42) {
    ~mesbox("You need an Agility level of 42 to squeeze through the crevice.");
    return;
}
def_coord $west_exit = 0_47_153_20_14;
def_coord $east_exit = 0_47_153_27_14;
if (coordx(coord) > coordx($west_exit)) {
    ~agility_exactmove(human_pipesqueeze, 20, 0, coord, $west_exit, 45, 70, ^exact_west, true);
    p_teleport($west_exit);
} else {
    ~agility_exactmove(human_pipesqueeze, 20, 0, coord, $east_exit, 45, 70, ^exact_east, true);
    p_teleport($east_exit);
}
sound_synth(squeeze_through_rocks, 1, 0);
mes("You squeeze through the crevice.");

// ---------------------------------------------------------------- Fremennik Slayer Dungeon
//
// Two shortcuts inside the Rellekka slayer cave, both placed in the cache with their op already
// authored and neither wired to anything, so both right-click options were dead:
//
//   loc_9326 "Strange floor"  (Jump-over)      m43_156 - abs (2769, 10002) and (2774, 10003)
//   loc_9321 "Crevice"        (Squeeze-through) m42_156 - abs (2731, 10008) and (2734, 10008)
//
// The level requirements here are the ORIGINAL ones - Agility 62 for the floor and 81 for the
// crevice. OSRS cut them to 43 and 61 on 8 May 2024, which is far outside this revision.
//
// The crevice is a PAIR of tiles three apart on the same row, exactly like the Dwarven Mine one
// above, so the exits are the far ends of the whole passage rather than one tile off whichever
// half was clicked. The strange floor is a single tile each time, so it is crossed generically:
// step through the loc and out the far side.

[oploc1,loc_9326]
if (stat(agility) < 62) {
    ~mesbox("You need an Agility level of 62 to cross the strange floor.");
    return;
}
def_int $dx = 0;
def_int $dz = 0;
if (coordx(coord) < coordx(loc_coord)) {
    $dx = 1;
} else if (coordx(coord) > coordx(loc_coord)) {
    $dx = -1;
}
if (coordz(coord) < coordz(loc_coord)) {
    $dz = 1;
} else if (coordz(coord) > coordz(loc_coord)) {
    $dz = -1;
}
if ($dx = 0 & $dz = 0) {
    mes("You can't do that from here.");
    return;
}
def_int $dir = ^exact_north;
if ($dz < 0) {
    $dir = ^exact_south;
} else if ($dz = 0) {
    $dir = ^exact_east;
    if ($dx < 0) {
        $dir = ^exact_west;
    }
}
def_coord $exit = movecoord(loc_coord, $dx, 0, $dz);
mes("You jump over the strange floor.");
sound_synth(jump_no_land, 1, 20);
~agility_exactmove(human_steppingstonejump, 20, 2, coord, $exit, 48, 60, $dir, true);
p_teleport($exit);
~agility_xp(50);

[oploc1,loc_9321]
if (stat(agility) < 81) {
    ~mesbox("You need an Agility level of 81 to squeeze through the crevice.");
    return;
}
// You come out the OPPOSITE side from the one you went in on. Testing against the west exit
// rather than the loc itself is what the Dwarven Mine crevice above does, and it is the reason
// this reads the right way round: standing east of the passage sends you west, and vice versa.
def_coord $west_exit = 0_42_156_42_24;
def_coord $east_exit = 0_42_156_47_24;
if (coordx(coord) > coordx($west_exit)) {
    ~agility_exactmove(human_pipesqueeze, 20, 0, coord, $west_exit, 45, 70, ^exact_west, true);
    p_teleport($west_exit);
} else {
    ~agility_exactmove(human_pipesqueeze, 20, 0, coord, $east_exit, 45, 70, ^exact_east, true);
    p_teleport($east_exit);
}
sound_synth(squeeze_through_rocks, 1, 0);
mes("You squeeze through the crevice.");

// $anim because the same movement has two animations: a stile is stepped over
// (human_walk_style) and the fence south of Varrock is hurdled (human_jump_hurdle). The
// geometry is identical - a wall on a tile edge, crossed from whichever side you are on -
// and that is the part worth sharing.
[proc,climb_stile](seq $anim)
def_coord $start_coord = loc_coord;
def_int $mod = 1;
def_int $dir = ^exact_north;
def_coord $end_coord = movecoord($start_coord, 0, 0, 1);
if(coordz(coord) > coordz(loc_coord)) {
    $start_coord = movecoord(loc_coord, 0, 0, 1);
    $mod = -1;
    $dir = ^exact_south;
    $end_coord = movecoord(loc_coord, 0, 0, 0);
}
def_coord $walk_coord = movecoord($end_coord, 0, 0, $mod);
if(loc_angle = ^loc_north | loc_angle = ^loc_south) {
    $start_coord = loc_coord;
    $mod = 1;
    $dir = ^exact_east;
    $end_coord = movecoord($start_coord, 1, 0, 0);
    if(coordx(coord) > coordx(loc_coord)) {
        $start_coord = movecoord(loc_coord, 1, 0, 0);
        $mod = -1;
        $dir = ^exact_west;
        $end_coord = movecoord(loc_coord, 0, 0, 0);
    }
    $walk_coord = movecoord($end_coord, $mod, 0, 0);
} 
p_teleport($start_coord);
p_delay(0);
~agility_exactmove($anim, 30, 2, $start_coord, $end_coord, 30, 94, $dir, true);
p_teleport($walk_coord);

// OVER A WALL-SHAPED OBSTACLE, which is the other half of ~climb_stile below. A shape-0 loc's angle
// is the EDGE of its tile the wall lies on, so the two tiles it separates are the loc's own and the
// neighbour across that edge, and the crossing runs perpendicular to the edge. Which way round the
// player goes is read off which side of the boundary they are standing on, so one proc does both
// directions and a player standing diagonally still crosses rather than sliding along it.
[proc,hurdle_wall](seq $anim)
def_coord $low = movecoord(loc_coord, 0, 0, -1);
def_coord $high = loc_coord;
def_boolean $northsouth = true;
if (loc_angle = ^loc_north) {
    $low = loc_coord;
    $high = movecoord(loc_coord, 0, 0, 1);
} else if (loc_angle = ^loc_west) {
    $northsouth = false;
    $low = movecoord(loc_coord, -1, 0, 0);
    $high = loc_coord;
} else if (loc_angle = ^loc_east) {
    $northsouth = false;
    $low = loc_coord;
    $high = movecoord(loc_coord, 1, 0, 0);
}
def_coord $start = $low;
def_coord $end = $high;
def_int $dir = ^exact_north;
if ($northsouth = true) {
    if (coordz(coord) > coordz($low)) {
        $start = $high;
        $end = $low;
        $dir = ^exact_south;
    }
} else {
    $dir = ^exact_east;
    if (coordx(coord) > coordx($low)) {
        $start = $high;
        $end = $low;
        $dir = ^exact_west;
    }
}
p_teleport($start);
p_delay(0);
~agility_exactmove($anim, 30, 2, $start, $end, 30, 94, $dir, true);
p_teleport($end);

[proc,climb_fence]
def_coord $start_coord = loc_coord;
def_int $mod = 1;
def_int $dir = ^exact_north;
def_coord $end_coord = movecoord($start_coord, 0, 0, 1);
if(coordz(coord) > coordz(loc_coord)) {
    $start_coord = movecoord(loc_coord, 0, 0, 1);
    $mod = -1;
    $dir = ^exact_south;
    $end_coord = movecoord(loc_coord, 0, 0, 0);
}
def_coord $walk_coord = movecoord($end_coord, 0, 0, 0);
p_teleport($start_coord);
p_delay(0);
// THE WINDOW ENDS WHEN THE CRAWL DOES. This copied 30->94 from ~climb_stile and ~hurdle_wall
// beside it, where it is exactly right - human_walk_style is 64 cycles and human_jump_hurdle
// 63, so from 30 they finish at 94 and 93. human_crawling is 40, so it was over at 70 and the
// last 24 cycles carried the player on through the fence in an idle pose.
~agility_exactmove(human_crawling, 30, 2, $start_coord, $end_coord, 30, 70, $dir, true);
p_teleport($walk_coord);

// ---------------------------------------------------------------- under-wall tunnels
//
// All four of the tunnels above passed null as the animation, so the player slid through the hole
// standing bolt upright. The cache has had the whole three-part animation since the dump and
// nothing referenced it:
//
//   agilty_shortcut_enter_hole   (seq 2589)  12 frames, ending held - dropping into the hole
//   agilty_shortcut_tunnel_walk  (seq 2590)  one frame, loops=1 - the crawl pose, held while moving
//   agilty_shortcut_exit_hole    (seq 2591)  10 frames - climbing back out the far side
//
// The "agilty" misspelling is in content/pack/seq.pack, so it has to be written that way here.
// climb_under (synth 1786) is likewise the sound authored for exactly this obstacle.
[proc,agility_underwall_tunnel](coord $end_coord, int $direction)
anim(agilty_shortcut_enter_hole, 0);
sound_synth(climb_under, 1, 0);
p_delay(2);
~agility_exactmove(agilty_shortcut_tunnel_walk, 20, 0, coord, $end_coord, 45, 70, $direction, false);
p_teleport($end_coord);
anim(agilty_shortcut_exit_hole, 0);
p_delay(1);

// ---------------------------------------------------------------- Taverley Dungeon
//
// Two shortcuts that the cache placed, gave op text to, and then nobody ever wired up - there was
// no [oploc1] for either of them anywhere in the codebase, so both right-click options were dead:
//
//   loc_9293 "Obstacle pipe" (Squeeze-through), width=2, placed twice in m45_153 at local (7,7)
//            rotation 0 and (10,7) rotation 2 - a pair of pipe halves with a centrepiece between
//            them, spanning x=7..11 on row z=7. m45_153 places a babybluedragon at (12,7) and blue
//            dragons at (17,5), (19,10) and (24,10), which is how you can tell this is the blue
//            dragon shortcut and not some other pipe.
//   loc_9294 "Strange floor" (Jump-over), a single tile at m44_153 local (63,21), right on the
//            mapsquare boundary. (63,20) and (63,22) are both blocking wall_diagonal locs, so it
//            is crossed east<->west and nothing else: west is m44_153 (62,21), east is m45_153
//            (0,21), which is the same tile as x=64 on the square it sits on.
//
// Both are 2006-era requirements: Agility 70 for the pipe, 80 for the floor, and neither grants
// experience - the same as the Dwarven Mine crevice above.

[oploc1,loc_9293]
if (stat(agility) < 70) {
    ~mesbox("You need an Agility level of 70 to squeeze through the pipe.");
    return;
}
def_coord $west_exit = 0_45_153_6_7;
def_coord $east_exit = 0_45_153_12_7;
if (coordx(coord) > coordx($west_exit)) {
    ~agility_exactmove(human_pipesqueeze, 20, 0, coord, $west_exit, 45, 70, ^exact_west, true);
    p_teleport($west_exit);
} else {
    ~agility_exactmove(human_pipesqueeze, 20, 0, coord, $east_exit, 45, 70, ^exact_east, true);
    p_teleport($east_exit);
}
sound_synth(squeeze_in, 1, 0);
mes("You squeeze through the pipe.");

[oploc1,loc_9294]
if (stat(agility) < 80) {
    ~mesbox("You need an Agility level of 80 to cross the strange floor.");
    return;
}
def_coord $west_exit = 0_44_153_62_21;
def_coord $east_exit = 0_45_153_0_21;
mes("You jump over the strange floor.");
sound_synth(jump_no_land, 1, 20);
if (coordx(coord) > coordx($west_exit)) {
    ~agility_exactmove(human_steppingstonejump, 20, 2, coord, $west_exit, 48, 60, ^exact_west, true);
    p_teleport($west_exit);
} else {
    ~agility_exactmove(human_steppingstonejump, 20, 2, coord, $east_exit, 48, 60, ^exact_east, true);
    p_teleport($east_exit);
}

// ---------------------------------------------------------------- the River Lum stepping stones
// Reported as a live dead click: four "Stepping stone" locs in the river west of the Champions'
// Guild, every one of them carrying Jump-onto, and nothing answering any of them. It is a real
// Old School shortcut - 31 Agility, three experience, and failing it still puts you on the side
// you were heading for, with damage and one experience.
//
// ONE CLICK PER STONE, which is what the era does and what the option says. You stand on them
// between jumps - Old School's own patch notes have a player logging out mid-crossing and needing
// to be put back on solid ground - and you walk off the last one onto the bank, because a loc
// blocks a tile being entered and not a player leaving it. Jagex collapsed the four into one in
// 2026 to make it quicker, which is a change this build is twenty years early for.
//
// The fail rate is the one this file already uses for the Karamja stepping stone, which is the
// same obstacle: 140/250, so about two in three at the level that unlocks it and near-certain at
// 99. Old School publishes no chart for either of them. The damage is the Karamja figure too, a
// tenth of your hitpoints, for the same reason - it is the same fall into the same kind of water.
[oploc1,loc_9315]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
if (coord = loc_coord) {
    mes("You can't do that from here.");
    return;
}
if (stat(agility) < ^lum_stones_level) {
    ~mesbox("You need an Agility level of <tostring(^lum_stones_level)> to cross the stepping stones.");
    return;
}
p_arrivedelay;
// Which way you are going is read off which side of the stone you are standing on, so the same
// trigger does both crossings and there is no state to remember.
def_int $dir = ^exact_east;
def_coord $bank = ^lum_stones_east_bank;
def_coord $last = ^lum_stones_east_stone;
if (coordx(coord) > coordx(loc_coord)) {
    $dir = ^exact_west;
    $bank = ^lum_stones_west_bank;
    $last = ^lum_stones_west_stone;
}
mes("You jump onto the stepping stone.");
sound_synth(jump_no_land, 1, 20);
~agility_exactmove(human_steppingstonejump, 20, 2, coord, loc_coord, 48, 60, $dir, false);
if (stat_random(agility, 140, 250) = false) {
    sound_synth(pool_plop, 1, 0);
    spotanim_map(watersplash, coord, 0, 1);
    ~agility_instant_fail($bank, calc(stat(hitpoints) * 10 / 100),
                          "You lose your footing, and the river carries you to the far bank.");
    ~agility_xp(^lum_stones_failxp);
    return;
}
// The crossing pays once, on the jump onto the stone beside the bank you are heading for. Read
// off loc_coord and not off coord, because the move below has not happened yet.
if (loc_coord = $last) {
    ~agility_xp(^lum_stones_xp);
}
p_teleport(loc_coord);
