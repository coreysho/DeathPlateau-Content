[oploc1,loc_9299]
if(stat(agility) < 29) { 
    mes("You need an agility level of 29 to attempt to climb through this broken fence.");
    return;
}
~climb_fence;

// THE FENCE SOUTH OF VARROCK, which carried op1=Jump-over and nothing answered it - so the click
// said "Nothing interesting happens", which is how it was reported from the game. It is OSRS's own
// shortcut (loc 16518 there, at 3240,3334): Agility 13, no experience at all, and a jump rather
// than a squeeze.
//
// IT IS NOT A STILE, which is what the second report was - "jumps you to the east/west instead of
// north/south". ~climb_stile is written for the four 1x2 stile OBJECTS (shape 10), where the angle
// says which way the stile faces; this fence is a 1x1 WALL (shape 0, angle 3), where the angle says
// which EDGE of the tile the wall sits on. The two conventions are perpendicular to each other, so
// reading one with the other sent the player along the fence instead of over it: from 3240,3334 it
// put them at 3242,3335, two tiles east and still on the wrong side.
[oploc1,loc_9300]
if(stat(agility) < 13) {
    mes("You need an agility level of 13 to attempt to jump over this fence.");
    return;
}
~hurdle_wall(human_jump_hurdle);

