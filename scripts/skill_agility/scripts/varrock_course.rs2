// The Varrock Rooftop Course - https://oldschool.runescape.wiki/w/Varrock_Rooftop_Course
//
// Agility 30. SEVEN OF OLD SCHOOL'S NINE: the Wall and one of the four Gaps are not placed in the
// map this build grafts from, at any level, so they are not here and a lap pays 231.7 of the
// 269.7. The seven that are here carry the wiki's own numbers. See varrock_course.constant.
//
// The roofs are Old School's, grafted onto m50_53 at level 3 only - Varrock's streets, shops and
// upper floors are this build's and were not touched.

[oploc1,osrsloc_14412]
if (~varrock_blocked = true) {
    return;
}
if (coordz(coord) > ^varrock_wall_z) {
    mes("You can't reach the wall from here.");
    return;
}
p_arrivedelay;
mes("You climb the rough wall...");
~agility_climb_up(^varrock_xp_wall, ^varrock_land_wall);
mes("...and pull yourself onto the roof.");
~varrock_progress(1);

[oploc1,osrsloc_14413]
if (~varrock_blocked = true) {
    return;
}
p_arrivedelay;
mes("You carefully cross the clothes line.");
sound_synth(tightrope, 5, 0);
~varrock_cross(^varrock_xp_clothesline, ^varrock_clothesline_start, ^varrock_land_clothesline);
~varrock_progress(2);

[oploc1,osrsloc_14414]
if (~varrock_blocked = true) {
    return;
}
p_arrivedelay;
mes("You leap across the gap...");
~varrock_leap(^varrock_xp_gap1, ^varrock_land_gap1, ^exact_south);
mes("...and land on the roof below.");
~varrock_progress(3);

[oploc1,osrsloc_14834]
if (~varrock_blocked = true) {
    return;
}
p_arrivedelay;
mes("You leap across the gap...");
~varrock_leap(^varrock_xp_gap2, ^varrock_land_gap2, ^exact_east);
mes("...and land on the far side.");
~varrock_progress(4);

[oploc1,osrsloc_14835]
if (~varrock_blocked = true) {
    return;
}
p_arrivedelay;
mes("You leap across the gap...");
~varrock_leap(^varrock_xp_gap3, ^varrock_land_gap3, ^exact_east);
mes("...and land on the far side.");
~varrock_progress(5);

[oploc1,osrsloc_14836]
if (~varrock_blocked = true) {
    return;
}
p_arrivedelay;
mes("You hurdle along the ledge.");
~varrock_leap(^varrock_xp_ledge, ^varrock_land_ledge, ^exact_north);
~varrock_progress(6);

[oploc1,osrsloc_14841]
if (~varrock_blocked = true) {
    return;
}
p_arrivedelay;
mes("You jump off the edge...");
~varrock_leap(^varrock_xp_edge, ^varrock_land_edge, ^exact_north);
mes("...and land in the street below.");
~varrock_progress(7);

// ---------------------------------------------------------------- the level gate
[proc,varrock_blocked]()(boolean)
if (stat(agility) < ^varrock_level) {
    ~mesbox("You need an Agility level of <tostring(^varrock_level)> to use this course.");
    return(true);
}
return(false);

// ---------------------------------------------------------------- crossing and leaping
//
// A WALK STARTS ON THE OBSTACLE: ~agility_walk moves a tile a tick and spends its diagonal first,
// so a crossing that does not begin on the line leaves it on the first step. Draynor shipped both
// its tightropes that way.
[proc,varrock_cross](int $xp, coord $start, coord $end)
p_teleport($start);
p_delay(0);
~agility_force_move($xp, human_walk_logbalance, $end);

// AND A LEAP IS NOT A WALK - nor can an exactmove change floor, which Al Kharid's zip line proved:
// p_exactmove moves within the level the player is already on, so the telejump is what lands them
// and the exactmove is the motion on the way. Varrock's edge drops three floors to the street.
[proc,varrock_leap](int $xp, coord $end, int $direction)
~agility_exactmove(human_spot_jump, 0, 2, coord, $end, 15, 50, $direction, false);
p_telejump($end);
~agility_xp($xp);

// ---------------------------------------------------------------- the lap
[proc,varrock_progress](int $completed)
if (calc(%varrock_course_progress + 1) >= $completed) {
    %varrock_course_progress = $completed;
}
if (%varrock_course_progress < ^varrock_obstacles) {
    return;
}
%varrock_course_progress = 0;
~skillpet_roll(skillpet_squirrel_item, agility, ^skillpet_squirrel_varrock);
~varrock_mark_roll;

[proc,varrock_mark_roll]
if (random(^varrock_mark_chance) ! 0) {
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You notice a mark of grace, but you have no room for it.");
    return;
}
inv_add(inv, mark_of_grace, 1);
mes("You pick up a mark of grace.");
