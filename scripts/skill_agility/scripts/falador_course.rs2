[proc,falador_blocked]()(boolean)
if (stat(agility) < ^falador_level) {
    ~mesbox("You need an Agility level of <tostring(^falador_level)> to use this course.");
    return(true);
}
return(false);

// The exactmove is the motion you watch; the telejump is what actually lands you, because
// p_exactmove moves within the level the player is already on - Al Kharid's zip line proved that
// and Falador's edge drops three floors.
[proc,falador_move](int $xp, coord $end, seq $anim)
~agility_exactmove($anim, 0, 2, coord, $end, 15, 50, ^exact_north, false);
p_telejump($end);
~agility_xp($xp);

[proc,falador_progress](int $completed)
if (calc(%falador_course_progress + 1) >= $completed) {
    %falador_course_progress = $completed;
}
if (%falador_course_progress < ^falador_obstacles) { return; }
%falador_course_progress = 0;
~skillpet_roll(skillpet_squirrel_item, agility, ^skillpet_squirrel_falador);
~falador_mark_roll;

[proc,falador_mark_roll]
if (random(^falador_mark_chance) ! 0) { return; }
if (inv_freespace(inv) < 1) {
    mes("You notice a mark of grace, but you have no room for it.");
    return;
}
inv_add(inv, mark_of_grace, 1);
mes("You pick up a mark of grace.");
