// The Falador Rooftop Course - https://oldschool.runescape.wiki/w/Falador_Rooftop_Course
//
// Agility 50, fourteen obstacles, 586 experience a lap. The longest of these so far, and a full
// circuit of the city's north side: up the wall by the gem stall, east over the shops, north and
// then west along the whole terrace, and back down to the street by the park.
//
// EVERY OBSTACLE IS AN EXACTMOVE WITH A TELEJUMP BEHIND IT, the tightropes included. A tightrope
// here is not walkable the way Draynor's is: Falador's spans are blocked tiles, so ~agility_walk
// would be stepping through walls. The log-balance animation keeps it reading as a crossing.


[oploc1,osrsloc_14898]
if (~falador_blocked = true) { return; }
p_arrivedelay;
mes("You climb the rough wall...");
~agility_climb_up(^falador_xp_wall, ^falador_land_wall);
~falador_progress(1);

[oploc1,osrsloc_14899]
if (~falador_blocked = true) { return; }
p_arrivedelay;
mes("You carefully cross the tightrope.");
~falador_move(^falador_xp_rope1, ^falador_land_rope1, human_walk_logbalance);
~falador_progress(2);

