// The Canifis Rooftop Course - https://oldschool.runescape.wiki/w/Canifis_Rooftop_Course
//
// Agility 40, eight obstacles, 240 experience a lap. All eight are in the map, which makes this
// the first rooftop course here that is Old School's whole course and not a subset of it.
//
// EXPERIENCE IS IN TENTHS OF A POINT: stat_advance takes xp * 10.
^canifis_level = 40
^canifis_obstacles = 8
^canifis_xp_tree = 100     // 10
^canifis_xp_gap1 = 80      // 8
^canifis_xp_gap2 = 80      // 8
^canifis_xp_gap3 = 100     // 10 - the one Old School lets you fail
^canifis_xp_gap4 = 80      // 8
^canifis_xp_vault = 100    // 10
^canifis_xp_gap5 = 110     // 11
^canifis_xp_gap6 = 1750    // 175, the lap's own reward

// m54_54: base x 3456, base z 3456. Read off the grafted roofs, checked against the engine's
// collision, and then walked - a free tile is not the same as a tile you can get to or leave.
^canifis_land_tree = 3_54_54_49_36   // 3505,3492
^canifis_land_gap1 = 3_54_54_48_47   // 3504,3503
^canifis_land_gap2 = 3_54_54_37_48   // 3493,3504
^canifis_land_gap3 = 3_54_54_23_42   // 3479,3498
^canifis_land_gap4 = 3_54_54_22_31   // 3478,3487
^canifis_land_vault = 3_54_54_34_21  // 3490,3477
^canifis_land_gap5 = 3_54_54_53_20   // 3509,3476
^canifis_land_gap6 = 0_54_54_54_29   // 3510,3485 - the street, where the lap ends

^canifis_mark_chance = 4
// WHERE A FAILURE DROPS YOU, derived by tools/sim/coursefall.ts: the nearest street tile to
// the obstacle that the client draws a floor for, that the engine does not block, that a
// neighbour can step onto, and that is in the same walkable region as the course start - so
// a player who falls can walk back and start the lap over, which is what Old School makes
// them do. Re-derive rather than hand-edit.
^canifis_fall_gap3 = 0_54_54_29_43

// THE FAIL CURVE. stat_random's value is
//   floor(low * (99 - level) / 98) + floor(high * (level - 1) / 98) + 1
// against a 0-255 roll, so these two numbers ARE the curve: 225 at level 40 (87.9% pass) and
// 256 at level 64, which can no longer be beaten. Failable at 63, impossible at 64.
//
// THE ONE RATE OLD SCHOOL PUBLISHES: the third gap, "around 88% at level 40 Agility, up
// to a 100% success rate at level 64". 225 of 256 is 87.9%, and every other course on
// this list is fitted to the same shape against its own entry and stop levels.
^canifis_roll_low = 177
^canifis_roll_high = 299

// A fall costs 3-8 hitpoints.
^canifis_hit_low = 3
^canifis_hit_span = 6
