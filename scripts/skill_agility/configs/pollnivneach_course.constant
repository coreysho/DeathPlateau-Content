// The Pollnivneach Rooftop Course - https://oldschool.runescape.wiki/w/Pollnivneach_Rooftop_Course
//
// Agility 70, nine obstacles, 890 experience a lap. Old School pays 1016 with the Desert hard
// diary done; this build has no diaries, so the base 890 is the whole of it.
//
// It is the only one of these that starts on the GROUND and works upwards - a basket, a market
// stall, a banner - rather than a wall onto a roof.
//
// EXPERIENCE IS IN TENTHS OF A POINT: stat_advance takes xp * 10.
^pollnivneach_level = 70
^pollnivneach_obstacles = 9
^pollnivneach_xp_basket = 100
^pollnivneach_xp_stall = 450
^pollnivneach_xp_banner = 650
^pollnivneach_xp_gap = 350
^pollnivneach_xp_tree1 = 750
^pollnivneach_xp_wall = 50
^pollnivneach_xp_bars = 550
^pollnivneach_xp_tree2 = 600
^pollnivneach_xp_line = 5400

// m52_46: base x 3328, base z 2944. Picked by tools/sim/courseplan.ts - each obstacle puts you
// down beside the next one, on the side you are coming from.
^pollnivneach_land_basket = 1_52_46_22_26   // 3350,2970 - an island on purpose: you land and click the market stall beside you
^pollnivneach_land_stall = 1_52_46_27_34   // 3355,2978 - an island on purpose: the banner is beside you
^pollnivneach_land_banner = 1_52_46_34_33       // 3362,2977 (was 3362,2976)
^pollnivneach_land_gap = 1_52_46_38_32       // 3366,2976 (was 3366,2977)
^pollnivneach_land_tree1 = 1_52_46_38_38
^pollnivneach_land_wall = 2_52_46_31_41
^pollnivneach_land_bars = 2_52_46_30_52
^pollnivneach_land_tree2 = 2_52_46_34_56   // 3362,3000 - an island on purpose: the drying line is beside you
^pollnivneach_land_line = 0_52_46_36_56   // 3364,3000 - the street, and you walk from here

^pollnivneach_mark_chance = 4
// WHERE A FAILURE DROPS YOU, derived by tools/sim/coursefall.ts: the nearest street tile to
// the obstacle that the client draws a floor for, that the engine does not block, that a
// neighbour can step onto, and that is in the same walkable region as the course start - so
// a player who falls can walk back and start the lap over, which is what Old School makes
// them do. Re-derive rather than hand-edit.
^pollnivneach_fall_stall = 0_52_46_21_26

// THE FAIL CURVE. stat_random's value is
//   floor(low * (99 - level) / 98) + floor(high * (level - 1) / 98) + 1
// against a 0-255 roll, so these two numbers ARE the curve: 225 at level 70 (87.9% pass) and
// 256 at level 85, which can no longer be beaten. Failable at 84, impossible at 85.
//
// Stop level 85 is published: "At level 85 Agility, it becomes impossible to fail any
// part of the course." The banner's fail point was removed in May 2024, so the market
// stall is the only one left.
^pollnivneach_roll_low = 85
^pollnivneach_roll_high = 284

// A fall costs 3-8 hitpoints.
^pollnivneach_hit_low = 3
^pollnivneach_hit_span = 6
