// Grace's shop, EMPTY ON PURPOSE (2026-10-04). It held the six Graceful pieces at Old School's
// mark prices; the owner is implementing Graceful another way, so the stock is gone and the
// plumbing is not. Putting it back is six stock lines here and op3 in grace.npc.
//
// allstock=no matters even with no stock: with allstock=yes an empty shop will buy ANY item, so
// a player could turn a bronze dagger into Marks of Grace.
[grace_shop]
scope=shared
size=6
restock=yes
stackall=no
allstock=no
