// The Rellekka Rooftop Course - https://oldschool.runescape.wiki/w/Rellekka_Rooftop_Course
//
// Agility 80, seven obstacles, 780 experience a lap. Old School pays 920 with the Fremennik hard
// diary; this build has no diaries, so the base 780 is the whole of it.
//
// The course crosses a MAP SQUARE BOUNDARY - the first gap and the first tightrope are in m40_57
// and everything else in m41_57 - which is why the graft names two regions.
//
// EXPERIENCE IS IN TENTHS OF A POINT: stat_advance takes xp * 10.
^rellekka_level = 80
^rellekka_obstacles = 7
^rellekka_xp_wall = 200
^rellekka_xp_gap1 = 300
^rellekka_xp_rope1 = 400
^rellekka_xp_gap2 = 850
^rellekka_xp_gap3 = 250
^rellekka_xp_rope2 = 1050
^rellekka_xp_fish = 4750

// Picked by tools/sim/courseplan.ts - each obstacle puts you down beside the next one.
^rellekka_land_wall = 3_40_57_62_21
^rellekka_land_gap1 = 3_40_57_62_10
^rellekka_land_rope1 = 3_41_57_5_7       // 2629,3655 (was 2628,3656)
^rellekka_land_gap2 = 3_41_57_19_5       // 2643,3653 (was 2642,3654)
^rellekka_land_gap3 = 3_41_57_19_9       // 2643,3657 (was 2646,3663)
// NOT THE WEST SIDE. The pile of fish refuses an approach from 2653,3676 with "I can't reach
// that!" and takes one from anywhere else, so the tightrope lands you north of it instead of
// on the tile nearest where you came from.
^rellekka_land_rope2 = 3_41_57_31_28       // 2655,3676 (was 2654,3677)
^rellekka_land_fish = 0_41_57_31_28

^rellekka_mark_chance = 4
// WHERE A FAILURE DROPS YOU, derived by tools/sim/coursefall.ts: the nearest street tile to
// the obstacle that the client draws a floor for, that the engine does not block, that a
// neighbour can step onto, and that is in the same walkable region as the course start - so
// a player who falls can walk back and start the lap over, which is what Old School makes
// them do. Re-derive rather than hand-edit.
^rellekka_fall_rope1 = 0_40_57_63_10

// THE FAIL CURVE. stat_random's value is
//   floor(low * (99 - level) / 98) + floor(high * (level - 1) / 98) + 1
// against a 0-255 roll, so these two numbers ARE the curve: 241 at level 80 (94.1% pass) and
// 256 at level 85, which can no longer be beaten. Failable at 84, impossible at 85.
//
// Stop level 85 is published. The course opens at 80, so the curve has only five levels to
// run and cannot reach 88% at the entry level - it settles at 94%, which is what a
// five-level window gives.
^rellekka_roll_low = 14
^rellekka_roll_high = 296

// A fall costs 3-8 hitpoints.
^rellekka_hit_low = 3
^rellekka_hit_span = 6
