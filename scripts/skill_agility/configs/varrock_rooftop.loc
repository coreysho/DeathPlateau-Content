[osrsloc_15552]
// OSRS loc 15552 - THE ROOF ITSELF, and the surface the course is run on.
//
// blockwalk=no is not in the cache record and has to be here. GameMap gives collision to any loc
// whose type blocks, and this one is laid roof_flat across every tile of the Varrock roofs - so
// without it the whole course is a wall and the only reachable tiles are the handful the roof
// does not cover. Draynor and Al Kharid never showed this because their decks are TERRAIN with
// the roof locs beside them; Varrock's deck IS the loc.
blockwalk=no
model=osrsloc_15552
sharelight=yes
ambient=25
contrast=125

