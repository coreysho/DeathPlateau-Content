[osrsloc_14404]
name=Tropical tree
model=osrsloc_14404
// The swing fires from the east, west and north - tiles no player can walk to - so the only side
// that can ever be used is the south, from 3318,3165. That face was closed for a long time and the
// note here blamed the level-1 map; it was not the map. osrsloc_26587, a roof edge at 3318,3166,
// was placed as a shape-0 wall across it. Old School carries opcode 27 on that loc and this build's
// importer has no equivalent, so theirs is passable and ours was solid. blockwalk=no on the edge
// fixed it - see alkharid_rooftop.loc's osrsloc_26587, and alkharidcourse.ts, which walks the lap.
length=2
active=yes
resizex=164
resizez=256
op1=Swing-across

