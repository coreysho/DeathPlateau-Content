// The Al Kharid Rooftop Course - https://oldschool.runescape.wiki/w/Al_Kharid_Rooftop_Course
//
// Agility 20, eight obstacles, 216 experience a lap. Every number here is the wiki's.
^alkharid_level = 20
^alkharid_obstacles = 8
// EXPERIENCE IS IN TENTHS OF A POINT. stat_advance takes xp * 10 - Monk's Friend hands over
// 20000 for its 2000, the Grand Tree 79000 for 7900, a normal log 250 for 25 - so these are
// the wiki's numbers times ten. Written as whole points first, which paid a tenth of the rate.
^alkharid_xp_wall = 120
^alkharid_xp_rope1 = 360
^alkharid_xp_cable = 480
^alkharid_xp_zip = 480
^alkharid_xp_tree = 120
^alkharid_xp_beams = 60
^alkharid_xp_rope2 = 180
^alkharid_xp_gap = 360

// WHERE EACH ONE PUTS YOU DOWN. Unlike Draynor this course climbs: the zip line drops you to
// level 1, the tree swings you up to 2, the beams take you back to 3 and the gap drops you to the
// street. Every tile below was read off the grafted map and checked against the engine's own
// collision - tools/sim/alkharidcourse.ts walks the lap and fails if any of them is blocked, off
// the roof, or unreachable from the obstacle before it.
^alkharid_land_wall = 3_51_49_9_56      // 3273,3192 - the roof over Ellis the Tanner's
^alkharid_land_rope1 = 3_51_49_8_36     // 3272,3172
^alkharid_land_cable = 3_51_49_19_30    // 3283,3166 - the west edge of the long roof
^alkharid_land_zip = 1_51_49_50_27      // 3314,3163 - and down two floors
^alkharid_land_tree = 2_51_49_53_38     // 3317,3174 - the south-east corner of the level 2 roof
// Two wrong answers came before this one, and both looked right on a map. 3317,3169 is open air -
// the level 2 roof does not start until z3173 - so the swing left the player on top of the tree.
// 3318,3173 has a floor drawn on it and is still not somewhere you can stand: the whole z3173 row
// and the whole x3318 column are the roof's blocked rim, so that landing was a one-tile island
// with blocked on all four sides, and you could not move afterwards.
//
// The roof you can actually walk is x3315-3317 from z3174 to z3178, opening west at z3179 where
// the roof top beams stand at 3316,3179. This is its south-east corner, the nearest walkable tile
// to the tree at 3318,3166. Asked of the engine's own collision, not read off the overlays.
^alkharid_land_beams = 3_51_49_52_44    // 3316,3180
^alkharid_land_rope2 = 3_51_49_37_50    // 3301,3186
^alkharid_land_gap = 0_51_49_36_59      // 3300,3195 - the street, east of the scimitar shop

// AND WHERE THE WALKED ONES START. ~agility_walk spends its diagonal first, so a crossing whose
// start and finish are not on one row walks beside the rope instead of along it - which is how
// both of Draynor's tightropes shipped, and the reason this is written down rather than left to
// wherever the player happened to stop.
^alkharid_rope1_start = 3_51_49_8_44    // 3272,3180 - south along x 3272
^alkharid_rope2_start = 3_51_49_48_50   // 3312,3186 - west along z 3186

// The rough wall is climbed from the street north of Ellis's building; from inside you are past it.
^alkharid_wall_z = 3194

// Ours, as Draynor's is: the wiki publishes no mark rate for any rooftop course.
^alkharid_mark_chance = 4
