[opheld2,_] ~equip(last_slot);

[inv_button1,wornitems:worn]
if_close;
if (p_finduid(uid) = true) {
    p_clearpendingaction;
    ~unequip(last_slot);
}

[proc,equip](int $slot)
if (p_finduid(uid) = true) {
    def_obj $obj = inv_getobj(inv, $slot);
    if (oc_wearpos($obj) = null) {
        mes("[DEBUG]: No wearpos set on <oc_debugname($obj)>");
        return;
    }
    if (~duel_arena_equip_check($obj) = false) {
        return;
    }
    if (~duel_arena_flower_power_equip_check($obj) = false) {
        return;
    }
    if(inzone(0_51_147_0_0, 0_51_147_19_63, coord) = true) {
        if(npc_find(coord, desertminingmercenary2, 4, 2) = true | npc_find(coord, desertminingmercenary1, 4, 2) = true) {
            ~npc_retaliate(0);
            ~desertcamp_guard_search;
        }
    }
    if ((oc_wearpos($obj) = ^wearpos_rhand | oc_wearpos($obj) = ^wearpos_lhand) & ~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
        mes("You feel it would be cheating to hold anything other than a gnomeball on the");
        mes("gnomeball pitch");
        return;
    }
    if (~wearpos_conflicts($obj, castlewars_cloak_saradomin) = true & (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true)) {
            mes("You can't remove your team's colours.");
            return;
        }
    if (~falconry_equip_blocked($obj) = true) { // Hunter: nothing goes on over Matthias's glove
        return;
    }
    def_obj $previous_weapon = inv_getobj(worn, ^wearpos_rhand);
    if (~try_equip($slot) = false) {
        mes("You don't have enough free space to do that.");
        return;
    }
    ~equip_sound($obj);
    // todo: this needs a better home...
    if (%tutorial < ^tutorial_complete) {
        if (%tutorial = ^newbie_combat_instructor_worn_inventory & $obj = bronze_dagger){
            %tutorial = ^newbie_combat_instructor_dagger_equipped;
            ~set_tutorial_progress;
        }
        else if (%tutorial = ^newbie_combat_instructor_unequipping_items) {
            def_obj $shield = inv_getobj(worn, ^wearpos_lhand);

            if ($previous_weapon = bronze_sword & $shield = wooden_shield) {
                %tutorial = ^newbie_combat_instructor_open_combat_interface;
                ~set_tutorial_progress;
            }
        }
    }

    if($obj = elemental_shield) {
        inv_delslot(worn, ^wearpos_lhand);
        buildappearance(worn);
        spotanim_pl(elemental_shield_equip, 92, 0);
        sound_synth(shield_appear, 1, 0);
        p_delay(0);
        inv_setslot(worn, ^wearpos_lhand, elemental_shield, 1);
    } else if($obj = ibanstaff) {
        // https://youtu.be/n_ip_vEDbCA?si=0uESoOC98Fvl7HqS&t=2333
        mes("You equip the staff of Iban.");
    }

    ~update_all($previous_weapon);
}

// Equipping sounds. The cache carries 25 equip_* synths but nothing played them, so
// wearing anything was silent apart from the elemental shield's own spotanim sound.
// Picked off oc_category, which this repo already tags weapons and armour with, and
// falls back to the wearpos for the items that carry no category.
[proc,equip_sound](obj $obj)
if ($obj = elemental_shield) {
    // already plays shield_appear alongside its spotanim - don't double up
    return;
}
def_synth $sound = null;
if (~blowpipe_is_blowpipe($obj) = true) {
    // OSRS's toxic blowpipe goes on with the staff sound (toxic_blowpipe/scripts/blowpipe.rs2)
    sound_synth(equip_staff, 1, 0);
    return;
}
switch_category (oc_category($obj)) {
    case weapon_stab, weapon_slash, weapon_2h_sword : $sound = equip_sword;
    case weapon_blunt, weapon_crush : $sound = equip_blunt;
    case weapon_axe, weapon_pickaxe : $sound = equip_axe;
    case weapon_staff, weapon_powered_staff : $sound = equip_staff;
    case weapon_spear, weapon_spiked, weapon_javelin, weapon_claws, weapon_scythe : $sound = equip_spiked;
    case weapon_whip : $sound = equip_whip;
    case weapon_salamander : $sound = equip_salamander; // OSRS's own, for Hunter's salamanders
    case weapon_bow, weapon_crossbow, weapon_thrown, arrows : $sound = equip_ranged;
    case bolts : $sound = equip_bolt;
    case armour_shield : $sound = equip_shield;
    case armour_helmet : $sound = equip_helmet;
    case armour_body : $sound = equip_body;
    case armour_legs : $sound = equip_legs;
    case armour_feet : $sound = equip_feet;
    case armour_hands : $sound = equip_hands;
    case armour_cape, armour_godcape : $sound = equip_leather;
}
if ($sound = null) {
    // no category on this obj - fall back to the slot it goes in
    switch_int (oc_wearpos($obj)) {
        case ^wearpos_hat : $sound = equip_helmet;
        case ^wearpos_torso, ^wearpos_arms : $sound = equip_body;
        case ^wearpos_legs : $sound = equip_legs;
        case ^wearpos_feet : $sound = equip_feet;
        case ^wearpos_hands : $sound = equip_hands;
        case ^wearpos_lhand : $sound = equip_shield;
        case ^wearpos_rhand : $sound = equip_sword;
        case ^wearpos_quiver : $sound = equip_ranged;
        case ^wearpos_back : $sound = equip_leather;
    }
}
if ($sound ! null) {
    sound_synth($sound, 1, 0);
}

[proc,unequip](int $slot)
if (p_finduid(uid) = true) {
    def_obj $obj = inv_getobj(worn, $slot);
    if (~wguild_is_barrels($obj) = true) { // Warriors' Guild kegs are put down, not pocketed
        ~wguild_keg_drop(false);
        return;
    }
    if (~duel_arena_flower_power_unequip_check($slot) = false) {
        return;
    }
    if (~falconry_unequip_blocked($obj) = true) { // Hunter: only Matthias takes his glove off
        return;
    }
    if ($obj = ball_gnomeball_game & ~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
        mes("You feel it would be cheating to put the ball in your pack whilst on the pitch.");
        return;
    }
    if (($obj = castlewars_cloak_zamorak | $obj = castlewars_cloak_saradomin) & (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true)) {
        mes("You can't remove your team's colours."); // osrs
        return;
    }
    def_int $count = inv_getnum(worn, $slot);
    def_int $overflow = inv_itemspace2(inv, $obj, $count, inv_size(inv));
    if ($overflow >= $count) {
        mes("You don't have enough free space to do that.");
        return;
    }
    if($obj = elemental_shield) {
        sound_synth(shield_appear, 1, 0);
    }
    if (oc_param($obj, specwep) = ^true) {
        %sa_attack = ^false;
    }
    inv_moveitem(worn, inv, $obj, sub($count, $overflow));
    // Taking something off was silent while putting it on was not. Same table as ~equip_sound -
    // the cache has no separate remove_* synths, and OSRS reuses the equip sound both ways.
    // Deliberately here and NOT in ~on_unequip: that proc also runs from ~try_equip when a swap
    // pops the old item off, and the incoming item's own sound already plays for that.
    ~equip_sound($obj);
    ~update_all($obj);
    ~on_unequip($obj);
}

// Called whenever an obj is removed from the 'worn' inv, intented to be used as a central hook point for
// handling unequipping effects
[proc,on_unequip](obj $obj)
// null is a NORMAL input here, not an error: ~try_equip passes whatever was previously in the
// target slot, and that is null whenever the slot was empty. ~runecraft_unset_no_tally guards for
// it locally; the greegree oc_category check below did not, so any equip into an empty slot threw
//   script error: oc_category An input for a Obj type was not valid to use. Input was -1.
// and dropped the client (seen 2026-09-09 wearing a black mask with no hat on).
// Guarding here rather than at the call site so future hooks inherit the fix.
if ($obj = null) {
    return;
}
if ($obj = castlewars_saradomin_banner | $obj = castlewars_zamorak_banner) {
    ~castlewars_flag_drop(inv, $obj);
}
// Monkey Madness: taking a greegree off turns the player back into a human. Hooked here rather than
// on each of the eight greegree objs because this is the one proc every unequip path funnels
// through - see quests/quest_mm/scripts/mm_stage3.rs2.
if (oc_category($obj) = mm_greegree) {
    ~mm_greegree_removed;
}

// Easter 2006's ring, the same way: taking it off stops you being an egg.
// See misc/scripts/easter_ring.rs2.
if ($obj = easter06_ring_of_egg) {
    ~easter_ring_removed;
}
~runecraft_unset_no_tally($obj);

// used for duel arena, no weapon/no armour
[proc,try_unequip](int $slot)
if (p_finduid(uid) = true) {
    def_obj $obj = inv_getobj(worn, $slot);
    if ($obj = null) {
        return;
    }
    def_int $count = inv_getnum(worn, $slot);
    def_int $overflow = inv_itemspace2(inv, $obj, $count, inv_size(inv));
    if ($overflow >= $count) {
        return;
    }
    if (oc_param($obj, specwep) = ^true) {
        %sa_attack = ^false;
    }
    inv_moveitem(worn, inv, $obj, sub($count, $overflow));
    ~update_all($obj);
}

[proc,.try_unequip](int $slot)
if (.p_finduid(.uid) = true) {
    def_obj $obj = .inv_getobj(worn, $slot);
    if ($obj = null) {
        return;
    }
    def_int $count = .inv_getnum(worn, $slot);
    def_int $overflow = .inv_itemspace2(inv, $obj, $count, .inv_size(inv));
    if ($overflow >= $count) {
        return;
    }
    if (oc_param($obj, specwep) = ^true) {
        .%sa_attack = ^false;
    }
    .inv_moveitem(worn, inv, $obj, sub($count, $overflow));
    ~.update_all($obj);
}

