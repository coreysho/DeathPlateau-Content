[proc,player_die]
// ::godmode, developer and above. The hit landed and the splat showed; this is where it stops
// short of killing you. Every death in the build comes through here - npc combat, pvp, poison,
// the Arkan blade and ~damage_self - so one guard covers all of them. misc/scripts/godmode.rs2.
if (%godmode = true) {
    ~godmode_restore;
    return;
}
strongqueue(player_death_default, 0, 0);

[proc,player_death]
%death = ^true;
// every death script comes through here, the minigames' included - the Player Statistics count
%player_deaths = add(%player_deaths, 1);
p_delay(1);
p_stopaction;
if_close;
anim(human_death, 0);
p_delay(3);
%death = ^false;

[queue,player_death_default]
if (~in_castlewars_game(coord) = true) {
    @player_death_castlewars;
}
if (~in_castlewars_waitingroom(coord) = true) {
    @player_death_castlewars_waitingroom;
}
// The TzHaar Fight Cave is a SAFE minigame: you keep your items, you keep the Tokkul for the waves
// you survived, and the TzHaar put you outside. Same shape as the two Castle Wars guards above.
if (~in_fightcave(coord) = true) {
    @fightcave_death;
}
// Pest Control is a safe minigame in Old School and a safe one here: you keep everything, and the
// Void Knights pull you back to the outpost. The game is forfeit, which is the whole cost.
// minigames/game_pest/scripts/pest_solo.rs2.
if (~in_pest_solo(coord) = true) {
    @pest_solo_death;
}
// The Fremennik Trials: Koschei's arena under Thorvald's hut is a safe death too (wiki), and dying to
// his fourth form is how that fight is meant to end. quest_viking/scripts/viking_thorvald.rs2.
if (~viking_in_koschei_arena(coord) = true) {
    @viking_koschei_player_death;
}
// Zulrah's shrine: not a safe death, but not an ordinary one either - Priestess Zul-Gwenwynig
// keeps everything you were carrying and hands it back on the dock.
// area_zulrah/scripts/zulrah_death.rs2.
if (~in_zulrah_shrine(coord) = true) {
    @zulrah_player_death;
}

~player_death;
midi_jingle(death2);
// https://storage.googleapis.com/tannerdino/images/6543.jpg
// https://youtu.be/gWmwSYxzUfo
mes("Oh dear you are dead!");

~combat_clearqueue;
clearqueue(player_death_default);

if (.finduid(%duel2accept) = true) {
    if (~.in_duel_arena(.coord) = true & ~in_duel_arena(coord) = true) {
        @player_death_duel;
        return;
    }
}

~retribution_check;
// "Any unsafe death will delete all items left inside the deathbank" - and this is the unsafe
// death. area_zulrah/scripts/zulrah_death.rs2.
~zulrah_deathbank_lost;

def_obj $prev_wep = inv_getobj(worn, ^wearpos_rhand);
if (findhero = true) {
    // the killer's Player Statistics count. The same player the items drop for.
    .%player_pvp_kills = add(.%player_pvp_kills, 1);
    ~pvp_clear_pj_lock; // skill_combat/scripts/pvp/pvp_combat.rs2
    ~pvp_death_lose_items;
    session_log(^log_moderator, "Player died to <.displayname>");
} else {
    ~player_death_lose_items;
    // todo: what npc killed the player
    session_log(^log_moderator, "Player died");
}
p_teleport(map_findsquare(0_50_50_21_18, 0, 2, ^map_findsquare_lineofwalk));
buildappearance(worn);
~prayer_deactivate_all;
~follower_death;
anim(null, 0);
p_stopaction;

~stat_reset_all;
healenergy(10000);
~clear_pk_skull;
~clear_poison;
~update_all($prev_wep);
~initalltabs;
~player_end_poison;
// VENOM GOES TOO. Death cleared %poison and left %venom running, so a player killed while
// envenomed - at Zulrah, which is where venom comes from - respawned still envenomed and ticking
// up from where it left off. Reported from play.
//
// ~venom_clear rather than %venom = 0: the timer has to be cancelled as well, or it fires once
// more against a cleared varp (toxic_blowpipe/scripts/venom.rs2).
~venom_clear;

[proc,player_death_lose_items]
// A DEVELOPMENT WORLD DOES NOT TAKE YOUR ITEMS (Corey, 2026-10-07). Dying while testing something
// cost you the kit you were testing it with, and getting it back is a ::give at a time - which is
// not what a dev world is for. The live world is untouched: there, death costs what it always has.
//
// Said out loud rather than left to look like a bug, because a player who has just died and found
// nothing on the floor has no way to tell "kept" from "gone".
if (map_live = false) {
    mes("Your items came with you - this is a development world.");
    return;
}
// And staff keep theirs on the live world, as they always have.
if (staffmodlevel > 1) { return; }

def_boolean $skulled = false;
if (%pk_skull > 0) { $skulled = true; }
def_boolean $protecting_item = false;
if (%prayer8 = ^true) { $protecting_item = true; }
inv_clear(deathkeep);

if($skulled = false) {
    ~move_priciest_item_on_hero_to_death;
    ~move_priciest_item_on_hero_to_death;
    ~move_priciest_item_on_hero_to_death;
}
if($protecting_item = true) {
    ~move_priciest_item_on_hero_to_death;
}
~blowpipe_death_spill; // toxic_blowpipe/scripts/blowpipe.rs2
~rune_pouch_death_spill; // storage_items/scripts/rune_pouch.rs2 - the runes go with the pouch

// A GOD CAPE IS RECLAIMED WHEREVER YOU DIE, not only when a player kills you. Both loops told you
// "Saradomin reclaims the cape as it touches the ground" and then left the cape on the ground - and
// because it is untradeable it dropped owned by YOU and never reveals, so you walked back and picked
// up the thing you had just been told was gone. The inv_delslot the pvp loop has was missing here.
// Engine-TS tools/sim/deathuntradeable.ts holds it.
def_int $i = 0;
def_int $size = inv_size(inv);
while ($i < $size) {
    if (inv_getnum(inv, $i) > 0) {
        if (oc_category(inv_getobj(inv, $i)) = armour_godcape) {
            mes(oc_param(inv_getobj(inv, $i), lose_cape_message));
            inv_delslot(inv, $i);
        }
    }
    $i = calc($i + 1);
}

$i = 0;
$size = inv_size(worn);
while ($i < $size) {
    if (inv_getnum(worn, $i) > 0) {
        if (oc_category(inv_getobj(worn, $i)) = armour_godcape) {
            mes(oc_param(inv_getobj(worn, $i), lose_cape_message));
            inv_delslot(worn, $i);
        }
    }
    $i = calc($i + 1);
}

// The Undertaker's outfit goes before anything is dropped, and nobody is paid for it: a green
// dragon took the hat, and a dragon has no use for Death tokens.
def_int $ruined = calc(~undertaker_outfit_destroy(inv) + ~undertaker_outfit_destroy(worn));

inv_dropall(inv, coord, ^lootdrop_duration);
inv_dropall(worn, coord, ^lootdrop_duration);
inv_dropall(looting_bag_store, coord, ^lootdrop_duration); // looting bag contents are always lost - storage_items.rs2
obj_addall(coord, bones, 1, ^lootdrop_duration);
~moveallinv(deathkeep, inv);
inv_clear(deathkeep);

[proc,pvp_death_lose_items]
~pvp_death_message(.uid);
// Nothing changes hands on a development world either - see player_death_lose_items above. The
// killer still gets their message, and the skull, and the count; what they do not get is the kit.
if (map_live = false) {
    mes("Your items came with you - this is a development world.");
    return;
}
if (staffmodlevel > 1) { return; }

def_boolean $skulled = false;
if (%pk_skull > 0) { $skulled = true; }
def_boolean $protecting_item = false;
if (%prayer8 = ^true) { $protecting_item = true; }
inv_clear(deathkeep);

if($skulled = false) {
    ~move_priciest_item_on_hero_to_death;
    ~move_priciest_item_on_hero_to_death;
    ~move_priciest_item_on_hero_to_death;
}
if($protecting_item = true) {
    ~move_priciest_item_on_hero_to_death;
}
~blowpipe_death_spill_pvp; // toxic_blowpipe/scripts/blowpipe.rs2
~rune_pouch_death_spill_pvp; // storage_items/scripts/rune_pouch.rs2

// The outfit, destroyed, and the killer paid for exactly what was destroyed. AFTER the items-kept
// block above and BEFORE the drop loops below: after, so a piece can never be confused with one of
// the three an unskulled player keeps (param=destroy_death on every piece already bars it from that
// calculation, and from Protect Item); before, so it is gone by the time anything drops.
~undertaker_outfit_pay(.uid, calc(~undertaker_outfit_destroy(inv) + ~undertaker_outfit_destroy(worn)));

def_int $i = 0;
def_int $size = inv_size(inv);
while ($i < $size) {
    if (inv_getnum(inv, $i) > 0) {
        if (oc_category(inv_getobj(inv, $i)) = armour_godcape) {
            mes(oc_param(inv_getobj(inv, $i), lose_cape_message));
            inv_delslot(inv, $i);
        } else {
            both_dropslot(inv, coord, $i, ^lootdrop_duration);
        }
    }
    $i = calc($i + 1);
}

$i = 0;
$size = inv_size(worn);
while ($i < $size) {
    if (inv_getnum(worn, $i) > 0) {
        if (oc_category(inv_getobj(worn, $i)) = armour_godcape) {
            mes(oc_param(inv_getobj(worn, $i), lose_cape_message));
            inv_delslot(worn, $i);
        } else {
            both_dropslot(worn, coord, $i, ^lootdrop_duration);
        }
    }
    $i = calc($i + 1);
}
// looting bag contents always go to the killer, as in OSRS - storage_items/scripts/storage_items.rs2
$i = 0;
$size = inv_size(looting_bag_store);
while ($i < $size) {
    if (inv_getnum(looting_bag_store, $i) > 0) {
        both_dropslot(looting_bag_store, coord, $i, ^lootdrop_duration);
    }
    $i = calc($i + 1);
}
.obj_add(coord, bones, 1, ^lootdrop_duration);
~moveallinv(deathkeep, inv);
inv_clear(deathkeep);


[proc,move_priciest_item_on_hero_to_death]
def_obj $priciest_item;
def_obj $currentitem;
def_int $biggest_price = 0;
def_int $size_inv = inv_size(inv);
def_int $size_worn = inv_size(worn);
def_boolean $is_worn = false;
def_int $i = 0;
while ($i < $size_inv) {
    if (inv_getnum(inv, $i) > 0) {
        $currentitem = inv_getobj(inv, $i);
        if (oc_param($currentitem, destroy_death) ! ^true) {
            if (oc_cost($currentitem) > $biggest_price) {
                $biggest_price = oc_cost($currentitem);
                $priciest_item = $currentitem;
            }
        }
    }
    $i = calc($i + 1);
}
$i = 0;
while ($i < $size_worn) {
    if (inv_getnum(worn, $i) > 0) {
        $currentitem = inv_getobj(worn, $i);
        if (oc_param($currentitem, destroy_death) ! ^true) {
            if (oc_cost($currentitem) > $biggest_price) {
                $is_worn = true;
                $biggest_price = oc_cost($currentitem);
                $priciest_item = $currentitem;
            }
        }
    }
    $i = calc($i + 1);
}

if($priciest_item = null ) {
    return;
}
if($is_worn = true) {
    inv_moveitem(worn,deathkeep,$priciest_item,1);
} else {
    inv_moveitem(inv,deathkeep,$priciest_item,1);
}

[proc,player_end_poison]
%poison = 0;
~set_poison_timer;


// ---------------------------------------------------------------------------------------------
// THE UNDERTAKER'S OUTFIT IS LOST WHERE IT IS WORN (Corey, 12 October 2026)
// ---------------------------------------------------------------------------------------------
// Destroy every piece carrying param=pvp_token_bounty and report what it was worth; the caller pays
// a killer, if there was one. Only in the Wilderness: dying to a goblin in Lumbridge must not cost
// a player a thousand tokens of black suit.
//
// WHY THIS EXISTS. Before it, killing somebody wearing the outfit paid nothing at all. The engine
// decides that, in BOTH_DROPSLOT: a tradeable item drops assigned to the killer, an untradeable one
// drops assigned back to the VICTIM - so the hat landed at the dead player's feet flagged to them
// and they walked back for it. With no Wilderness Slayer master, the Undertaker's shelf is the whole
// of the wilderness identity, and a cosmetic that cannot be lost is a taunt with no stake behind it.
//
// DESTROYED RATHER THAN DROPPED, which is the part that stops it being an exploit rather than a
// feature. If the piece came back, the cycle would be free: be killed by a friend for the bounty,
// pick the piece up, again - and it does not even need a friend, an alt does it alone. Destroying it
// makes one cycle cost the shop price and pay a quarter of it, so the pair burns three tokens for
// every one they move. The invariant that keeps that true - bounty strictly below cost - is written
// on the param itself, and tools/sim/deathtoken.ts fails if any item breaks it.
//
// THE AMOUNT PAID IS WHAT WAS ACTUALLY DESTROYED, which is why this returns a total rather than the
// caller totting up what the player was wearing. Any gap between working out the payment and
// deleting the thing is a gap where a piece survives and the bounty is paid anyway - the free cycle
// again, by another road.
//
// TESTED ON ~wilderness_level RATHER THAN ON findhero. The duel arena is already safe - player_death
// branches to @player_death_duel long before either caller - but the next PvP zone somebody adds
// will not come with a warning, and "is this the Wilderness" is the question actually being asked.
[proc,undertaker_outfit_destroy](inv $inv)(int)
def_int $owed = 0;
if (~wilderness_level(coord) <= 0) {
    return($owed);
}
def_int $i = 0;
def_int $size = inv_size($inv);
def_obj $obj;
def_int $bounty;
while ($i < $size) {
    if (inv_getnum($inv, $i) > 0) {
        $obj = inv_getobj($inv, $i);
        $bounty = oc_param($obj, pvp_token_bounty);
        if ($bounty > 0) {
            mes("Your <lowercase(oc_name($obj))> is ruined beyond saving.");
            inv_delslot($inv, $i);
            $owed = calc($owed + $bounty);
        }
    }
    $i = calc($i + 1);
}
return($owed);

// .obj_add rather than .inv_add: obj_add owns the obj to whichever player the dot selects, so the
// tokens land in the victim's loot pile flagged to the killer, beside everything else they won. An
// inv_add would want protected access on the killer, which a death script does not hold - and it
// would also have to cope with a full inventory. The uid-and-finduid shape is ~pvp_death_message's,
// two procs up the same call.
[proc,undertaker_outfit_pay](player_uid $killer, int $owed)
if ($owed <= 0) {
    return;
}
if (.finduid($killer) = false) {
    return;
}
.mes("The Undertaker will take the deceased's effects off your hands.");
.obj_add(coord, death_token, $owed, ^lootdrop_duration);
