// Desert Treasure - the four Smoke Dungeon torches (Corey, 2026-09-07).
//
// Moved out of content/scripts/_unpack/377/all.loc so an op can be added; redeclaring a name that
// still exists there is a "Duplicate config found" build error.
//
// The cache ships these as the unlit half of a multiloc pair: 4d_standing_torchN is the shell that
// reads varbit fd_torch_countN and shows _unlit at 0 and _lit (which carries anim=fire) at 1. All of
// that already worked - the only thing missing was that the unlit torch declared no options at all,
// so there was no way to click it. op1=Light is the single addition; everything else below is the
// untouched cache data.

[4d_standing_torch1_unlit]
name=Standing Torch
desc=An old mystical torch.
model=4d_standing_torch
recol1s=15855
recol1d=8420
recol2s=12684
recol2d=6306
active=yes
ambient=30
contrast=15
op1=Light

[4d_standing_torch2_unlit]
name=Standing Torch
desc=An old mystical torch.
model=4d_standing_torch
recol1s=15855
recol1d=8420
recol2s=12684
recol2d=6306
active=yes
ambient=30
contrast=15
op1=Light

[4d_standing_torch3_unlit]
name=Standing Torch
desc=An old mystical torch.
model=4d_standing_torch
recol1s=15855
recol1d=8420
