// Ghosts Ahoy's quest journal. Rewritten 13 October 2026 with the quest itself - the old stages
// described a petition Velorina handed out and three favours that are not in this quest.
//
// One case per value of ahoy_questvar. @str@ is what has already happened, @dbl@ is what to do next
// and @dre@ picks out the names and places you need, which is the house style for these.
[if_button,questlist:ahoy]
def_string $text;

switch_int (%ahoy_questvar) {
    case ^ahoy_not_started :
        $text = "@dbl@@dre@Port Phasmatys@dbl@ is east of @dre@Canifis@dbl@, behind an|";
        $text = append($text, "@dbl@@dre@energy barrier|");
        $text = append($text, "@dbl@Nobody in it is alive. I will need an @dre@amulet of ghostspeak|");
        $text = append($text, "@dbl@to hear a word anyone says|");
        $text = append($text, "@dbl@Speak to @dre@Velorina@dbl@, in the house inside the east gate");

    case ^ahoy_velorina :
        $text = "@str@Two hundred years ago everyone in this town died, and|";
        $text = append($text, "@str@Necrovarus has not let one of them go on since.|");
        $text = append($text, "@str@Velorina has a husband somewhere in the crowd she has not|");
        $text = append($text, "@str@been able to say goodbye to.|");
        $text = append($text, "@dbl@Ask @dre@Necrovarus@dbl@ at the @dre@Ectofuntus@dbl@, north of the wall");

    case ^ahoy_refused :
        $text = "@str@He said no. He has been saying no for two centuries and it|";
        $text = append($text, "@str@has not stopped being the answer.|");
        $text = append($text, "@dbl@Go back to @dre@Velorina");

    case ^ahoy_crone_named :
        $text = "@str@There is a woman living east of the @str@slayer tower@str@ who|";
        $text = append($text, "@str@knew Necrovarus while he was still breathing.|");
        $text = append($text, "@dbl@She drinks @dre@nettle tea@dbl@, and she is particular:|");
        $text = append($text, "@dbl@a @dre@china cup@dbl@, with @dre@milk@dbl@ in it|");
        $text = append($text, "@dbl@Pick @dre@nettles@dbl@ with gloves on and boil them in a|");
        $text = append($text, "@dbl@@dre@bowl of water@dbl@ over a fire");

    case ^ahoy_crone_told :
        $text = "@str@Necrovarus did not do this with a spell. He did it with the|";
        $text = append($text, "@str@@str@Book of Haricanto@str@, and he buried the book on|");
        $text = append($text, "@str@@str@Dragontooth Island@str@ under a cross.|");
        $text = append($text, "@dbl@The map was torn in @dre@three@dbl@ and went down with a ship|");
        $text = append($text, "@dbl@on the rocks @dre@west of the town|");
        $text = append($text, "@dbl@Mend the @dre@old man's model ship@dbl@ for the captain's key");

    case ^ahoy_map :
        $text = "@str@The three scraps make one map, and the cross on it is out|";
        $text = append($text, "@str@past the harbour.|");
        $text = append($text, "@dbl@The @dre@ghost captain@dbl@ on the pier sails to @dre@Dragontooth|");
        $text = append($text, "@dbl@Take a @dre@spade");

    case ^ahoy_book :
        $text = "@str@The Book of Haricanto was two feet down on Dragontooth|";
        $text = append($text, "@str@Island, in an oilskin, where he said it was safe.|");
        $text = append($text, "@dbl@It is in a language nobody speaks. @dre@Ak-Haranu@dbl@ on the|");
        $text = append($text, "@dbl@dock owns the manual and wants a @dre@bow signed by Robin|");
        $text = append($text, "@dbl@Robin is in the @dre@inn@dbl@, and he signs bows for people he|");
        $text = append($text, "@dbl@owes money to");

    case ^ahoy_manual :
        $text = "@str@Ak-Haranu took the signed bow and gave me the translation|";
        $text = append($text, "@str@manual.|");
        $text = append($text, "@dbl@Use the @dre@manual@dbl@ on the @dre@Book of Haricanto");

    case ^ahoy_translated :
        $text = "@str@The book is not a spell. It is a list of what Necrovarus|";
        $text = append($text, "@str@took with him when he died, and his @str@robes@str@ are on it.|");
        $text = append($text, "@dbl@@dre@Gravingas@dbl@ is shouting in the square by the north gate|");
        $text = append($text, "@dbl@and has a @dre@petition@dbl@ nobody will sign|");
        $text = append($text, "@dbl@Ask the @dre@ghost innkeeper@dbl@ for work to get a @dre@bedsheet|");
        $text = append($text, "@dbl@Dye it with a @dre@bucket of ectoplasm@dbl@ and @dre@wear it");

    case ^ahoy_petition_full :
        $text = "@str@Ten ghosts signed the petition, which took a bedsheet over|";
        $text = append($text, "@str@my head and a straight face.|");
        $text = append($text, "@dbl@Show it to @dre@Necrovarus@dbl@ at the @dre@Ectofuntus");

    case ^ahoy_robes :
        $text = "@str@He dropped a @str@key of yellowed bone@str@ and did not notice.|";
        $text = append($text, "@dbl@It opens the @dre@door on the temple's upper floor|");
        $text = append($text, "@dbl@His @dre@coffin@dbl@ is through it, and it has never had a body|");
        $text = append($text, "@dbl@in it");

    case ^ahoy_ritual :
        $text = "@str@The old crone laughed for a long time when she saw the|";
        $text = append($text, "@str@robes. He is finished and does not know it yet.|");
        $text = append($text, "@dbl@Take them to @dre@Necrovarus@dbl@ and let him see you holding|");
        $text = append($text, "@dbl@them");

    case ^ahoy_released :
        $text = "@str@The barrier over the town is thinning, and a great many|";
        $text = append($text, "@str@people have started talking at once.|");
        $text = append($text, "@dbl@Go and tell @dre@Velorina");

    case default :
        $text = "@str@Necrovarus held a town of dead people for two hundred years|";
        $text = append($text, "@str@with a book he had buried on an island, and I dug it up.|");
        $text = append($text, "@str@Velorina has gone to find her husband.|");
        $text = append($text, "@dbl@@dre@QUEST COMPLETE");
}

~quest_journal("Ghosts Ahoy", $text);
