// Recipe for Disaster. Wiki: https://oldschool.runescape.wiki/w/Recipe_for_Disaster
// Released March 2006, so era-appropriate for a 377 build.
//
// PASS 1 (2026-09-09) BUILDS THE FRAME ONLY - the Cook, Aris, the way into the frozen dining room,
// the nine frozen victims, the Culinaromancer's chest and the quest journal. The ten sub-quests are
// each their own pass; see the SUB-QUESTS section at the bottom for what the cache already ships
// for each one and where it lives.
//
// ---------------------------------------------------------------------------------------------
// What the cache already ships - which is very nearly everything
// ---------------------------------------------------------------------------------------------
// * The whole dining room, twice, at m29_83 p0. Copy A (z4-19) is the frozen room: the nine victim
//   plinths, Aris, the time-bubble wall along x=4. Copy B (z28-43) is the same room with the nine
//   FREED heroes already placed as npcs - it is the after picture, and the quest ends by sending
//   the player there. Room interior is x5..x10; the walls are castlewall at x=3 and x=11-12.
// * The Lumbridge side: hundred_lumbridge_door at 0_50_50_7_17 (the kitchen door),
//   hundred_lumbridge_doubledoorl/r at (13,21)/(13,22), and hundred_portal_multi at 0_50_50_9_18 -
//   a multiloc on hundred_main_quest_var that becomes hundred_portal_active at state 4.
// * The Culinaromancer's chest: hundred_goodchest at 0_50_150_19_23 in the Lumbridge cellar, a
//   multiloc on hundred_main_quest_var (states 3, 4, 5) resolving to hundred_goodchest_base with
//   op1=Bank, op2=Buy-food, op3=Buy-items.
// * BOTH SHOPS, ten tiers each: hundred_foodchest1..10 and hundred_rewardchest1..10 in
//   _unpack/727/all.inv, all twenty already in pack/inv.pack. Tier N is unlocked by N completed
//   sub-quests, which is exactly what hundred_subquest_tally counts. rewardchestN stocks gauntlet
//   levels 1..N and the first N of the ten cooking weapons.
// * The ten gauntlet levels, the ten cooking weapons (spoon, whisk, spork, spatula, frying pan,
//   skewer, rolling pin, knife, hammer, cleaver), hundred_rewardlamp, and the ten
//   100_journal_head_* icons.
// * Every sub-quest's npcs, objs, locs and varbits. Nothing in this quest is blocked on missing
//   data - it is blocked only on the amount of scripting.
//
// ---------------------------------------------------------------------------------------------
// Stages - %hundred_main_quest_var (100intro bits 0-6)
// ---------------------------------------------------------------------------------------------
// The two multilocs above pin three of these values, so the numbering is not free: the chest must
// be 3, 4 or 5 and the portal must be 4. Everything else is arranged around that.
^hundred_not_started = 0
^hundred_told_by_cook = 1        // the Cook has explained; the castle is inside a time bubble
^hundred_seen_dining_room = 2    // been through the barrier and seen the nine victims
^hundred_met_aris = 3            // Aris has explained; the chest appears in the cellar
^hundred_in_progress = 4         // the portal stands in the dining hall; the ten sub-quests run
^hundred_complete = 5

// ---------------------------------------------------------------------------------------------
// Sub-quest bits - %hundred_subquest_tally (100intro bits 11-20, ten bits, one per sub-quest)
// ---------------------------------------------------------------------------------------------
// Ten bits for ten sub-quests, which is also exactly the number of chest tiers, gauntlet levels and
// cooking weapons the cache ships. One quest point each.
^hundred_bit_cook = 0            // Another Cook's Quest - the start
^hundred_bit_dwarf = 1           // Freeing the Mountain Dwarf
^hundred_bit_goblins = 2         // Freeing the Goblin generals
^hundred_bit_pirate = 3          // Freeing Pirate Pete
^hundred_bit_guide = 4           // Freeing the Lumbridge Guide
^hundred_bit_dave = 5            // Freeing Evil Dave
^hundred_bit_ogre = 6            // Freeing Skrach Uglogwee
^hundred_bit_varze = 7           // Freeing Sir Amik Varze
^hundred_bit_monkey = 8          // Freeing King Awowogei
^hundred_bit_culinaromancer = 9  // Defeating the Culinaromancer
^hundred_subquest_count = 10
// The first NINE bits are the nine frozen victims; bit 9 is the Culinaromancer, who is not a victim
// and cannot be freed before them. Anything asking "are all the victims out?" compares against this,
// not against the full count - which three places in quest_100.rs2 were doing, so the Cook, Aris and
// the journal would all have waited for the finale before admitting the finale was available.
^hundred_victims_count = 9

// ---------------------------------------------------------------------------------------------
// Coordinates
// ---------------------------------------------------------------------------------------------
// Into the frozen room: (5,5) is the tile immediately inside hundred_lumbridge_door at (5,4), and
// the only loc on it is nothing at all. (4,z) carries the 100_bubble3 time-barrier wall, so do not
// land anyone on x=4.
^hundred_dining_room = 0_29_83_5_5
// The finished room is the same layout 24 tiles north.
^hundred_dining_room_after = 0_29_83_5_29
// Back out: 0_50_50_8_18 is beside the portal at (9,18) in the Lumbridge dining hall and carries no
// loc. (9,19) is a throne and (9,17) is the kitchen wall row.
^hundred_lumbridge_return = 0_50_50_8_18

// Requirement: Cook's Assistant, which is what puts the Cook on speaking terms with you at all.

// ---------------------------------------------------------------------------------------------
// Sub-quest 2: Freeing the Mountain Dwarf - %hundred_dwarf_quest (varp hundred_dwarf, bits 0-10)
// ---------------------------------------------------------------------------------------------
// Rohak is at 0_44_154_49_20, in the dwarf camp at the east end of the tunnel under White Wolf
// Mountain - the same tunnel the Fishing Contest quest opens, whose east exit lands at
// 0_44_154_60_22, eleven tiles away. He is two npcs, not one: hundred_dwarf_dad_multi
// (multivar=hundred_dwarf_multi_dad, 0 -> "An old Dwarf", 1 -> Rohak) at (49,20) and
// hundred_dwarf_drunk_multi (state 2 -> drunk Rohak, with the dwarf_drunk* anims) at (49,21). At
// state 2 the first shell resolves to no child and vanishes, so the swap is clean.
^hundred_dwarf_not_started = 0
^hundred_dwarf_told = 1          // the plinth showed me what he was holding
^hundred_dwarf_met_rohak = 2     // found the old dwarf and learned his name
^hundred_dwarf_needs_ale = 3     // he wants an ale with a coin in the bottom
^hundred_dwarf_drunk_rohak = 4   // he has drunk it
^hundred_dwarf_has_hot = 5       // holding the red-hot cake
^hundred_dwarf_has_cool = 6      // cooled it in water
^hundred_dwarf_done = 7

// %hundred_dwarf_multi_dad drives both of Rohak's shells.
^hundred_rohak_stranger = 0
^hundred_rohak_named = 1
^hundred_rohak_drunk = 2

// ---------------------------------------------------------------------------------------------
// Sub-quest 5: Freeing the Lumbridge Guide - %100guide_prog (varp 100_pirate_quest, bits 12-15)
// ---------------------------------------------------------------------------------------------
// The dish is a cake, and the cache says so without ambiguity: 100guide_flourdone, 100guide_milkdone
// and 100guide_eggdone are the three ingredients of one, and the repo's cooking skill already builds
// cake_tin + pot_flour + bucket_milk + egg -> uncooked_cake -> range -> cake.
//
// The three ingredients come from the three people in Lumbridge who would have them: the Cook, and
// the two local farmers Gee (lumbridge_guide2_man) and Donie (lumbridge_guide2_woman). Both farmers
// are placed twice each around Lumbridge - 0_50_50_19_30 and (45,61) for Gee, (16,54) and (35,25)
// for Donie - with op1=Talk-to and, before this pass, no handler anywhere in the repo. Their whole
// dialogue is new.
//
// NOT USED, and why: 100guide_q1 (5 bits), 100guide_q2 (4), 100guide_tot (4) and 100guide_lastgame
// (3) describe some kind of repeated number game with a running total. What the rules were is not
// recoverable from the data - the ranges do not add up as a sum, there is no interface for it, and
// no npc in the cache carries a param that would drive one - so rather than invent a minigame and
// call it faithful, they are left at zero and recorded here.
^hundred_guide_not_started = 0
^hundred_guide_told = 1          // the plinth showed me what he was reaching for
^hundred_guide_done = 2

// ---------------------------------------------------------------------------------------------
// Sub-quest 9: Freeing King Awowogei - %hundred_ilm_quest (varp hundred_ilm_var_1, bits 0-6)
// ---------------------------------------------------------------------------------------------
// "ilm" is the cache's own prefix for this one - the three wise monkeys Mizaru, Kikazaru and
// Iwazaru (see, hear and speak no evil) stand side by side at 0_43_43_35_43, 36_43 and 37_43 on
// Ape Atoll. Every step is on or under Ape Atoll, so this sub-quest needs Monkey Madness.
//
// The dish is named by the objs and needs no guessing: snake corpse + sliced red banana + Tchiki nut
// paste -> "Raw stuffed snake" -> cook -> "Stuffed snake / Fit for a Monkey King".
//
//   loc_12610   the banana tree at 0_42_43_8_33. A multiloc on hundred_ilm_red_banana_tree:
//               0 and 1 -> "Banana tree" (op1=Pick), 2 -> "Red Banana Tree" with
//               anim=100_ilm_banana_tree_pull_down and NO ops, 3 -> "Red Banana Tree" (op1=Pick).
//               State 2 having the pull-down animation and no ops is what says what the mechanic is:
//               the red ones grow at the crown, out of reach, and you haul the crown down to get at
//               them. Nothing in the cache reddens an ordinary banana, and nothing needed to.
//   loc_12602   "Pit", op1=Enter, 0_45_42_41_33 - in the south-east jungle, among the mm_jungle_snakes
//   loc_12601   "Rope", op1=Climb, 0_47_85_15_48 - the way back out of the snake pit
//   loc_12617   "Exit", op1=Enter, 0_43_143_53_47 - off the Monkey Madness dungeon
//   loc_12616   "Exit", op1=Climb-up, 0_47_85_17_17 - the way back out of the nut cave
//   loc_12615   "Bush", op1=Pick, 0_47_85_12_17 - "A Bush with monkey nuts growing on it"
//   hundred_ilm_snake  npc "Big Snake" lvl 84, three of them at 0_47_85_13_48 / 15_46 / 17_49
//
// NOT USED: hundred_ilm_incorrectly_stuffed_snake ("Odd stuffed snake / Is this really what you
// wanted to do?"). Making one would hand the player an obj with no iops at all - not even Drop - and
// no way to undo it. The wrong-ingredient cases refuse instead.
^hundred_monkey_not_started = 0
^hundred_monkey_told = 1         // the plinth showed me what was on his platter
^hundred_monkey_recipe = 2       // the three monkeys have given me the recipe
^hundred_monkey_done = 3

// %hundred_ilm_red_banana_tree, straight off the multiloc above.
^hundred_banana_tree_normal = 0
^hundred_banana_tree_pulling = 2
^hundred_banana_tree_down = 3

// Landing tiles, all read out of the .jm2 LOC sections.
// (15,49) is inside the snake pit next to the rope at (15,48); the pit interior is x12-18, z45-51.
^hundred_snakepit_bottom = 0_47_85_15_49
// (40,33) is clear ground west of the 2x2 Pit at (41,33)-(42,34).
^hundred_snakepit_top = 0_45_42_40_33
// (16,17) is between the nut bush at (12,17) and the exit at (17,17).
^hundred_nutcave_in = 0_47_85_16_17
// (52,47) is the tile a player stands on to use the cave mouth at 0_43_143_53_47.
^hundred_nutcave_out = 0_43_143_52_47

// ---------------------------------------------------------------------------------------------
// Sub-quest 7: Freeing Skrach Uglogwee - %100_ogre_prog (varp 100_ogre, bits 3-10)
// ---------------------------------------------------------------------------------------------
// The cache put a SECOND Rantz on the Feldip shore for this one: 100_rantz_multi_npc at
// 0_41_46_27_18, multivar=100_ogre_rantz_visible, state 1 -> 100_rantz. Big Chompy's Rantz is a
// different npc entirely, at 0_41_46_6_37, and keeps its own handler. The shore Rantz appears when
// this sub-quest starts, which is what his multivar exists for.
//
// The whole boat is spelled out by one six-state multiloc. 100_jubbly_multi_push_tree at
// 0_41_46_29_19 (width 4) resolves to:
//     0  "Old tree - A large old tree."
//     1  "Old tree" + anim=100_jubbly_tree_fall            (transient)
//     2  "Old tree, pushed over by Rantz."
//     3  "Old tree that's been felled, with the roots cut off."
//     4  "Crude boat - A very crude boat, made from an old tree."
//     5  "Roots - The roots of a large old tree."
// None of the six declares an op, so every interaction with it is [oplocu] (which needs none) or
// comes from Rantz. The seq 100_jubbly_root_chopping is what state 2 -> 3 is animated with.
//
// Once the boat is launched, 100_ogre_jubbly_boat_visible reveals BOTH boat npcs at once -
// 100_jubbly_multi_boat_feldip at 0_41_46_31_20 and 100_jubbly_multi_boat_karamja at 0_43_48_1_9,
// each op1=Board. One varbit, a ferry in both directions.
//
// 100_jubbly_multi_arrow_tree at 0_43_48_10_9 is scenery: state 0 "A small palm tree", state 1 "A
// small palm tree with an ogre arrow in it", and NEITHER declares an op. It is set when the first
// shot is fired and never clicked.
//
// NOT USED: 100_jubbly_spitroast / _cooked / _ruined and 100_jubbly_rock_and_string_brown / _white
// are defined but placed nowhere and declare no ops, so using them would mean loc_add-ing scenery
// for its own sake. The meat cooks on any open fire instead, through a cooking_generic dbrow, and
// the bait is shown by the balloon-toad npc the cache already has.
^hundred_ogre_not_started = 0
^hundred_ogre_told = 1           // the plinth showed me what was on the spit
^hundred_ogre_met_rantz = 2      // Rantz will take me, but he has no boat
^hundred_ogre_tree_pushed = 3    // Rantz put the tree over
^hundred_ogre_roots_cut = 4      // roots off
^hundred_ogre_boat_made = 5      // hollowed out; Rantz drags it to the water
^hundred_ogre_hunting = 6        // the boat runs, and I have bait
^hundred_ogre_has_meat = 7
^hundred_ogre_done = 8

// %100_ogre_jubbly_push_tree, straight off the multiloc above.
^hundred_tree_standing = 0
^hundred_tree_falling = 1
^hundred_tree_over = 2
^hundred_tree_trimmed = 3
^hundred_tree_boat = 4
^hundred_tree_roots = 5

// Landing tiles. (30,18) on the Feldip shore carries no loc, but it is blocked all the same - the
// felled tree's footprint covers it - so the landing is (29,18), the open ground beside it.
// The Karamja island is empty apart from the palm at (10,9). (3,9) is NOT clear - it is sea, and
// landing there stood the player in the water with no way to walk - so the landing is (8,9), the
// sand just west of the palm, from where the boat back is in reach.
^hundred_jubbly_island = 0_43_48_8_9
^hundred_jubbly_shore = 0_41_46_29_18
// The island itself, for the bait check. It is a sandbar: the boat lands at (1,9), the only loc on
// it is the palm at (10,9), and everything from z4 to z16 is open.
^hundred_jubbly_island_sw = 0_43_48_0_2
^hundred_jubbly_island_ne = 0_43_48_16_18

// ---------------------------------------------------------------------------------------------
// Sub-quest 8: Freeing Sir Amik Varze - %100amikvisible + a stage of its own
// ---------------------------------------------------------------------------------------------
// The dish IS named, it just does not say "Varze" in it. hundred_fruit_blast is
//
//     name=Dirty blast
//     desc=A cool refreshing fruit mix. With ash in for some reason.
//
// A Fruit Blast, which the gnome cocktail system already makes (Blurberry's, and the premade), with
// ashes in it. Both halves are ordinary objs the repo already produces, so nothing here is invented:
// the only question the data left open is who tells you, and the answer is the man himself - the
// ordinary sir_amik_varze stands at 2_46_52_16_8 in Falador castle with a handler already, which
// this hooks into rather than redeclaring.
//
// The frozen victim in the dining room is the loc hundred_varze_base ("Sir Amik Varze - He's been
// frozen in time"). There is ALSO an npc hundred_varze_frozen (multivar=100amikvisible, 1 -> the
// frozen base, 2 -> hundred_varze, op1=Talk-to) which the world places nowhere - the same "npc and
// loc versions of the same victim" duplication the other eight plinths have. The loc is what is
// placed, so the loc is what this uses.
//
// THIS SUB-QUEST HAS NO STAGE VARBIT, and does not need one. Every other one has its own in the
// cache; this one has only 100amikvisible, a single bit. Rather than carve a stage out of 100intro's
// three spare bits (8-10) for the sake of symmetry, the whole thing reads off what the player is
// holding: the recipe is gated on the main quest reaching ^hundred_met_aris, and the journal reads
// the tally bit. Nothing is lost - there is no step here that can be half-done.

// ---------------------------------------------------------------------------------------------
// Sub-quest 3: Freeing the Goblin generals - %100goblin (varp 100council, bits 9-14)
// ---------------------------------------------------------------------------------------------
// CORRECTION to what this file and claude/recipe-for-disaster.md said for two days: the goblin dish
// IS named. The prefix is 100goblin_ with no underscore after the 100, which is why it did not turn
// up under 100_ or hundred_:
//
//     100goblin_compromise_mush   "Slop of compromise - Two out of two goblin generals prefer it!"
//     100goblin_soggy_bread       "Previously a nice crispy loaf of bread. Now just kind of icky."
//     100goblin_spicey_maggots    "They clearly taste so much better this way!"
//     100goblin_dyed_oranges      "Orange slices which have been dyed, but it looks more like they died."
//
// Three things neither general will give up, mashed into one bowl. Every input is an ordinary obj the
// repo already produces - bread, a bucket of water, fishing bait, spice (which hundred_foodchest1
// stocks), orange slices from the gnome cocktail set, and any of Aggie's dyes.
//
// The kitchen is under Goblin Village and the cache built it twice, the way it built the dining room
// twice. 100_goblin_ladder_down at 0_46_54_16_51 goes down; the intact kitchen is m46_154 p0 z50-62
// with 100_goblin_cauldren_still at (36,54) and the way back up at (37,60); the blasted copy is the
// same layout at z15-22 with 100_goblin_ladder_up_charred at (37,20). Every fitting in the room has a
// _blasted or _charred twin.
//
// The cauldron says what happens without being told: "The bottom of this cauldron is suprisingly
// blackened, even for a cauldron" -> 100_goblin_cauldren_shake "I don't think Cauldrons are supposed
// to bounce around like that" -> 100_goblin_cauldren_blast "Explosion - This could be considered to
// be a bad thing!". 100goblin_explosion then blows the roof off the hut above, in the village:
// 100_goblin_roof_multi at 1_46_54_15_48 and 100_goblin_large_table_multi at 0_46_54_15_48.
^hundred_goblin_not_started = 0
^hundred_goblin_told = 1         // the plinth showed me the bowl they were both reaching for
^hundred_goblin_asked = 2        // both generals have named their half of the argument
^hundred_goblin_cooked = 3       // the cauldron went up and the slop survived
^hundred_goblin_done = 4

// %100goblin_explosion, straight off the two multilocs.
^hundred_goblin_kitchen_intact = 0
^hundred_goblin_kitchen_blast = 1
^hundred_goblin_kitchen_after = 2

// Landing tiles, read out of the .jm2 LOC sections.
^hundred_goblin_kitchen = 0_46_154_37_59
^hundred_goblin_kitchen_charred = 0_46_154_37_19
^hundred_goblin_village = 0_46_54_16_50

// ---------------------------------------------------------------------------------------------
// Sub-quest 6: Freeing Evil Dave - %hundred_dave_main (varp hundred_dave, bits 0-2)
// ---------------------------------------------------------------------------------------------
// This is the sub-quest the cache is most complete about, and the one whose completeness is easiest
// to miss, because none of it sits under a single prefix. What ships:
//
//   hundred_dave_mum       Doris, at 0_48_54_7_36 - Edgeville, op1=Talk-to, no handler anywhere
//   100_dave_celler_trapdoor  at 0_48_54_5_37, a multiloc on hundred_dave_trapdoor:
//                          0 -> "Trapdoor" op1=Open, 1 -> "Open trapdoor" op1=Go-down op2=Close
//   100_dave_celler_stairs at 0_48_154_4_37 - the way back up. Its [oploc1] is in
//                          ladders+stairs/scripts/stairs.rs2 with nothing but a default case
//   hundred_evil_dave      the living Dave at 0_48_154_8_34, op1=Talk-to, no handler anywhere
//   hundred_dave_hellrat   eighteen of them around him at m48_154
//   hundred_dave_stew      "Spicy stew" - iop1=Eat AND iop2=Smell. The Smell option is the whole
//                          feedback loop of this sub-quest and nothing implemented it
//   hundred_dave_spice_<colour>_<4..1>  four shakers, four doses each, plus one shared
//                          hundred_dave_spice_empty
//   hundred_dave_red/_yellow/_brown/_orange          two bits each - the doses in the stew
//   hundred_dave_<colour>_target                     two bits each - the doses he wants
//   hundred_dave_hellrats_caught                     three bits - the run-up to a behemoth
//   hundred_dave_original_cat_colour                 five bits - what your cat was before
//   kittenpet_hell / growncat_hell / overgrowncat_hell and their three objs
//
// Between them those last two lines say exactly what the mechanic is, and on 2026-10-12 the owner
// said what it was: "it should be like osrs where you hunt the rats for the spices, with the option
// to hunt behemoths for a full spice drop". That is right, and the first pass had it backwards.
//
// WHAT THE ORIGINAL DOES (oldschool.runescape.wiki/w/Recipe_for_Disaster/Freeing_Evil_Dave and
// /w/Hellcat and /w/Hell-Rat_Behemoth):
//
//   * THE RAT IS THE SPICE. Every hell-rat the cat catches hands over a shaker - one of the four
//     colours, holding anywhere from one to four doses. That is the whole supply line for the
//     sub-quest, and it is why there are four dose-variants of each colour in the cache rather
//     than just the full ones.
//   * SEVEN CATCHES CORRUPT THE CAT. "After your cat catches seven rats, it will become corrupt."
//     A kitten instead has a chance on any catch. This is what hundred_dave_hellrats_caught is
//     for, and the clincher is its width: three bits, which holds 0..7 and not one more.
//   * IT STAYS CORRUPT. A hell-cat "can be turned back into a normal cat of the same colour it
//     was before the conversion at any time by feeding it a bucket of milk" - which is what the
//     five bits of hundred_dave_original_cat_colour are for. The colour is not remembered so it
//     can be handed back at the top of the stairs; it is remembered so the milk can undo it.
//   * THE BEHEMOTHS ARE OPTIONAL AND THEY COME AFTER. Four of them, one guarding each colour,
//     behind the curtains, and the quest reward is "the ability to have your cat fight Hell-Rat
//     Behemoths". Each always gives a full four-dose shaker of its own colour.
//
// WHAT THE FIRST PASS DID INSTEAD, and this is the bug the owner reported as "rats dont drop spice"
// and "hell cat varients cant be achived": catching a rat gave nothing at all, the counter ran to
// four rather than seven, the fourth catch forced a Hell-Rat Behemoth out whether you wanted one or
// not, and killing it was the only way to get any spice in the game. The hell form was applied by
// walking down the trapdoor and taken away by walking back up, so no hell-cat could ever be kept.
//
// THE ONE DELIBERATE DEVIATION LEFT, besides Dave tasting the stew (below): in the original your
// CAT fights the behemoth, in an instance, and you throw it fish to keep it alive. Here you fight
// it yourself and the cat only has to be with you to draw it out. The npc in configs/quest_100.npc
// is built as a player's fight - level 85, 40 hitpoints - rather than the 15-hitpoint thing a cat
// can beat, because an instanced pet battle is a much larger machine than this sub-quest needs.
//
// TWO THINGS THIS PASS FIXED THAT ARE NOT THIS QUEST'S FAULT:
//   * op5=Chase-vermin was missing from all eighteen pet cats, so [opnpc5,_petcat] in
//     quests/quest_fluffs/scripts/pet.rs2 had never been reachable by anybody.
//   * The three hell-cat npcs and objs had no category and no params, so the pet system could not
//     see them at all.
//
// DELIBERATE DEVIATION, and the only one: in the original you learn the recipe by trial and error
// with no hints. Here the living Dave tastes a stew and says, per colour, whether it wants more or
// less. The target is still rolled per player and still hidden - he is a taster, not an oracle - but
// three unknowns in the range 0..3 with no feedback at all is a brute-force search, and the cache
// gave the stew a Smell option precisely so the player can see where they are. This makes Smell mean
// something.
^hundred_dave_not_started = 0
^hundred_dave_told = 1           // the plinth showed me the bowl he was holding
^hundred_dave_met_doris = 2      // his mother pointed at the trapdoor
^hundred_dave_asked = 3          // the living Dave named the dish; his three doses are rolled
^hundred_dave_approved = 4       // he has tasted the right one and handed it back
^hundred_dave_done = 5

// Spice colours. Only used to pick which pair of dose varbits a line is talking about.
^hundred_spice_red = 0
^hundred_spice_orange = 1
^hundred_spice_yellow = 2
^hundred_spice_brown = 3

// Three doses spread over the four colours, so a colour can want anything from 0 to 3 - which is
// exactly the range its two bits hold.
^hundred_dave_doses = 3

// "After your cat catches seven rats, it will become corrupt." Seven is also the width of
// hundred_dave_hellrats_caught, which is three bits.
^hundred_dave_catches_to_hellcat = 7
// A kitten turns "on any hell-rat catch" by chance rather than on a count, and the wiki does not
// publish the odds. One in seven makes a kitten take as many catches on average as a cat takes
// for certain, which is the only figure here that is a choice rather than a quotation.
^hundred_dave_kitten_chance = 7

// The four curtains in the cellar, one behemoth behind each, read out of m48_154's LOC section.
// Three are 100_dave_crypt_curtainsl and the fourth is 100_dave_crypt_curtainsr, and those two locs
// are placed nowhere else in the game - so the four placements are exactly the four the original
// has, one per colour.
^hundred_dave_curtain_red = 0_48_154_1_30      // 3073,9886
^hundred_dave_curtain_orange = 0_48_154_1_32   // 3073,9888
^hundred_dave_curtain_yellow = 0_48_154_2_38   // 3074,9894
^hundred_dave_curtain_brown = 0_48_154_2_41    // 3074,9897

// Landing tiles, read out of the .jm2 LOC sections. The cellar is the house's map square plus 100
// regions of z, so the two trapdoor ends are one tile apart in local coordinates.
^hundred_dave_cellar = 0_48_154_5_37
^hundred_dave_house = 0_48_54_6_37
^hundred_dave_stairs = 0_48_154_4_37

// ---------------------------------------------------------------------------------------------
// Sub-quest 4: Freeing Pirate Pete - %100_pirate_quest_var (varp 100_pirate_quest, bits 0-11)
// ---------------------------------------------------------------------------------------------
// CORRECTION. This file and claude/recipe-for-disaster.md called this one "genuinely blocked" and
// listed four missing pieces. All four were wrong, and each for the same reason - the search was by
// prefix or by a word that returns hundreds of unrelated hits:
//
//   "nothing in the repo references m46_148"  -> the entrance is MURPHY, at 0_41_49_44_26 in Port
//       Khazard, who already has a full [opnpc1] in minigames/game_trawler/scripts/murphy.rs2. He is
//       the Fishing Trawler man and the diving man, exactly as in the original. Four Murphys ship:
//       murphy (Khazard) and murphy_normal / _halfsunk / _sunk, which are the trawler's three sink
//       states and nothing to do with this quest.
//   "there is no fishbowl obj"                -> fishbowl_empty, _water, _water_weed, three fish
//       variants and fishbowl_net all ship. And it does not matter, because
//       hundred_pirate_diving_helmet ("Fishbowl helmet - You'll look daft, but at least you won't
//       drown!") is a complete wearable obj with manwear / womanwear / manhead / womanhead and
//       wearpos hat+head+jaw. So is hundred_pirate_diving_backpack ("Diving apparatus - I'll need a
//       helmet to make this work"), wearpos back. The "hell" search that missed the hell-cat objs in
//       pass 8 missed these the same way.
//   "the crabs and mudskippers carry death_drop,null so nothing drops"  -> true, and irrelevant:
//       drop_tables/scripts/crab.rs2 and mudskipper.rs2 already exist and already drop the fresh
//       claw, the fresh shell and the hide. Only the crab MEAT was missing from the table.
//   "hundred_pirate is placed nowhere"        -> true, and normal. Every one of the nine victims has
//       an unplaced living npc and a placed frozen loc; see the note under Sir Amik Varze.
//
// ---------------------------------------------------------------------------------------------
// The seabed
// ---------------------------------------------------------------------------------------------
// m46_148 is four planes of it and every fitting has an op already:
//   p0  "seabed"  - the coral garden. 100_coral_* in six shapes, kelp, starfish, starfishbig.
//   p1  "seabed2" - the working floor. This is where the quest happens.
//   p2  "seabed3" - upper water, with anchor_middle2 ("Ze anchor chain") and the cave-mouth tops.
//   p3            - more seabed3 wall, and the second half of the anchor.
//
// On p1:
//   anchor_middle          1_46_148_19_5, op1=Climb - "It looks slippy but I think you can climb
//                          this." The way back up. The same loc is drawn again on p3 because the
//                          chain is two planes tall.
//   kelp_pickingpoint      51 of them, op1=Pick, blockwalk=no
//   hundred_pirate_rock    13 ground objs scattered over the floor
//   the mudskipper cave    seabed2_cavewall_mudskipper_caveentrancel/r at (5,44) and (6,44),
//                          op1=Enter; the matching caveexitl/r at (5,47) and (6,47), op1=Exit. A
//                          four-tile tunnel through the wall into the mudskipper end, x4-10 z50-58.
//   the crab pen           a walled enclosure x26-42 z42-51 with pen_wall_doorl/r at (30,42) and
//                          (31,42), op1=Open, and pen_wall_doorl_open / _doorr_open already
//                          shipped carrying the model and nothing else. Every giant crab in the
//                          world is inside it. Three pen_wall_broken sections mark old escapes.
//   the Mogre Guards       100_pirate_mogre_guard x4 and 100_pirate_mogre_nung, all outside the pen
//
// THE MOGRES CANNOT STOP ANYONE, and that is a reading, not an omission: they declare op1=Talk-to,
// no op2=Attack, no hitpoints, no attack, no strength, no defence, no damagetype and no anims. They
// are a conversation, so the pen door is not gated on them. %hundred_pirate_spoken_to_guards is a
// single bit and it records exactly what it says - that you have been told what the pen is for.
//
// The crab disguise is real and is built from what a crab drops: hundred_pirate_crab_shell_claw
// ("Fresh crab claw") and _crab_shell_head ("Fresh crab shell") are shaped against one of the rocks
// on the floor into _crab_shell_gauntlet and _crab_shell_helm, both wearable. crab_claw_broken
// ("Darn, it's useless now") and crab_shell_broken exist, which is the cache saying the shaping can
// fail. Wearing both is what gets Nung talking.
//
// ---------------------------------------------------------------------------------------------
// The dish
// ---------------------------------------------------------------------------------------------
// Four things ground or crumbed and pressed together, and every intermediate ships:
//     hundred_pirate_kelp             -> ground kelp           (pestle and mortar)
//     hundred_pirate_giant_crab_meat  -> ground crab meat      (pestle and mortar)
//     raw_cod                         -> ground cod            (pestle and mortar)
//     bread                           -> breadcrumbs           (pestle and mortar)
//     all four                        -> hundred_pirate_raw_fishcake -> cook -> _fishcake / _burned
// The four *_intro varbits are one bit each and are named after the four ingredients, so they are
// first-time hint messages and are used as such.
^hundred_pirate_not_started = 0
^hundred_pirate_told = 1         // the plinth showed me the fishcake
^hundred_pirate_met_murphy = 2   // Murphy has kitted me out
^hundred_pirate_dived = 3        // been down at least once
^hundred_pirate_done = 4

// NOT USED, and why. %hundred_pirate_rocks (4 bits) and %hundred_pirate_underwater_onfloor (1 bit)
// together describe a buoyancy mechanic - thirteen rocks lying on the seabed floor and a flag for
// whether you are on it - and nothing in the cache says how much weight sinks you, what floating
// looks like, or what happens while you float. There is no interface for it and no param on the
// diving gear that would drive one. The rocks are used for what the two broken-shell objs prove
// they are used for instead. %hundred_pirate_number_of_hides (4 bits) counts mudskipper hides,
// which mudskipper.rs2 already drops; nothing in the cache says what a number of them buys.

// Landing tiles, read out of the .jm2 LOC sections.
// (19,6) is the tile north of the anchor at (19,5); x15-25 z1-14 on p1 carries no loc at all.
^hundred_pirate_seabed = 1_46_148_19_6
// Murphy stands on a woodensupport1 at (44,26). (45,27) beside him has no loc of its own but is
// blocked all the same (the pier's edge), so climbing the chain stood the player in the sea with no
// way to walk; (45,25) is the open boards on the other side of him.
^hundred_pirate_khazard = 0_41_49_45_25
// The tunnel: in at (5,44)/(6,44) from the south, out into the mudskipper end at (6,50); back out
// at (5,47)/(6,47) to (6,41). Neither destination carries a loc.
^hundred_pirate_cave_in = 1_46_148_6_50
^hundred_pirate_cave_out = 1_46_148_6_41

// ---------------------------------------------------------------------------------------------
// Sub-quest 10: Defeating the Culinaromancer - %hundred_minionskilled_tally (100intro, bits 23-28)
// ---------------------------------------------------------------------------------------------
// The finale, and the only sub-quest with no dish. What ships:
//
//   m29_83 p2          a 22x22 arena, x33-54 z33-54, floored with exactly 484 100_tile and nothing
//                      else, plus four hundred_exit_portal at the midpoints of the four edges -
//                      (33,43), (43,54), (44,33), (54,44). Every tile of it is walkable.
//   culinaromancer_froze  npc 3387 at 0_29_83_7_5, standing IN the frozen dining room with
//                      walkanim and readyanim both 100_cul_froze and no ops at all. He has been in
//                      the room the whole quest, mid-spell, and cannot be clicked. Left as he is.
//   hundred_culinaromancer_book5 .. book1   five shells of the wizard, vislevel=hide, no ops,
//                      readyanim=book_chuck_ready, each with a different model9 - the stack of books
//                      in his hands, one fewer per minion summoned. book5 carries no model9 at all.
//   hundred_culinaromancer_final           op2=Attack, vislevel=75, and holding
//                      obj_hundred_cleaver_manwear - a CLEAVER, which is why he is built as a melee
//                      fighter rather than a caster.
//   hundred_culinaromancer_dead            walkanim and readyanim both 'inflate'
//   hundred_culinaromancer_end             the after-the-fight shell
//   hundred_minion1..4 and hundred_minion5 in six elemental forms
//
// ALL ELEVEN COMBAT NPCS SHIPPED WITH op2=Attack, A VISLEVEL AND NOTHING ELSE - no hitpoints, no
// attack, strength or defence, no damagetype, no anims. See the note above [hundred_minion1] in
// _unpack/377/all.npc. The anims were never the problem: agrith_nana_*, rock_*, dessourt_* and
// horror_dagannoth_* all ship complete attack / block / death sets.
//
// The gauntlet is sequential and the shells say so: five books, five minions. The wizard stands at
// the north end summoning them one at a time, loses a book each time one dies, and after the fifth
// picks up the cleaver himself.
//
// %hundred_minionskilled_tally is six bits and is used as a COUNT 0..6 - five minions and the
// wizard - rather than as a bitmask like %hundred_subquest_tally, because the gauntlet is strictly
// in order and "how far through this attempt am I" is the only question it has to answer. It resets
// to 0 on every entry, so leaving or dying costs the whole run, which is the original's behaviour.
//
// THE ARENA IS NOT INSTANCED, and neither is the Horror from the Deep cavern - two players fighting
// at once will see each other's bosses. That is the repo's existing behaviour for scripted quest
// bosses on a shared map, not a new compromise.
^hundred_gauntlet_length = 6

// Landing tiles. All of p2 is floor, so these only have to avoid the four portals.
^hundred_arena_enter = 2_29_83_44_36
^hundred_arena_wizard = 2_29_83_44_51
^hundred_arena_minion = 2_29_83_44_44
// Long enough that a spawn cannot expire mid-fight; short enough that a player who leaves does not
// strand six bosses on the map. Horror from the Deep uses 1000 for the same job.
^hundred_boss_lifetime = 1500
