// Recipe for Disaster - the frame. See configs/quest_100.constant for the stage and bit layout and
// for what the cache ships.
//
// The Cook's own trigger lives in areas/area_lumbridge/scripts/cook.rs2 and a trigger may only be
// declared once, so the quest branch is hooked in there and jumps to ~hundred_cook_chat.

// --- The Cook ---

[proc,hundred_cook_chat]
switch_int (%hundred_main_quest_var) {
    case ^hundred_not_started :
        ~hundred_cook_start;
    case ^hundred_told_by_cook :
        ~chatnpc("<p,shock>Go and look! Through the kitchen door - there's a thing standing in the middle of the hall like a hole in the air. I can't, I've tried. It won't have me.");
    case ^hundred_seen_dining_room :
        ~chatnpc("<p,sad>You saw them, didn't you. Nine of them, sat there like waxworks. Talk to the gypsy - she's the only one in there who's still moving.");
    case ^hundred_met_aris, ^hundred_in_progress :
        ~hundred_cook_progress;
    case ^hundred_complete :
        ~chatplayer("<p,happy>Hello again.");
        ~chatnpc("<p,happy>The castle's the castle again and I have nine guests who all want feeding at once. I've never been happier.");
        ~chatnpc("<p,neutral>The chest downstairs is yours to use. Least I can do.");
}

[proc,hundred_cook_start]
~chatnpc("<p,shock>Help! Please, help!");
~chatplayer("<p,quiz>What's happened?");
~chatnpc("<p,shock>The dining hall! I went in to lay the table and it's - I can't describe it. Go and look. Please just go and look.");
~chatplayer("<p,quiz>Is somebody hurt?");
~chatnpc("<p,sad>I don't know. That's the trouble. Nobody in there is anything - they're not hurt and they're not well, they're just stopped.");
~chatnpc("<p,neutral>The Duke's in there. Half the castle's in there. And there's a wall across the room like the inside of a soap bubble.");
def_int $choice = ~p_choice2("I'll take a look.", 1, "That sounds like somebody else's problem.", 2);
if ($choice = 2) {
    ~chatplayer("<p,neutral>That sounds like somebody else's problem.");
    ~chatnpc("<p,sad>...yes. Yes, I expect it does.");
    return;
}
~chatplayer("<p,happy>I'll take a look.");
~chatnpc("<p,happy>Bless you. Through the kitchen door, and then you'll see it. You can't miss it.");
%hundred_main_quest_var = ^hundred_told_by_cook;
~send_quest_progress(questlist:hundred_main, 1, ^hundred_complete);

[proc,hundred_cook_progress]
~chatplayer("<p,happy>Hello again.");
// Sub-quests that need something from the Cook get first refusal on the conversation. Each returns
// true if it did the talking.
if (~hundred_guide_cook_flour = true) {
    return;
}
def_int $done = ~hundred_subquests_done;
if ($done >= ^hundred_victims_count) {
    ~chatnpc("<p,happy>You've got them all out. All of them. Go and finish it.");
    return;
}
if ($done = 0) {
    ~chatnpc("<p,neutral>Nine of them, and every one wants something different before they'll lift a finger. Start with whichever you like the look of.");
    return;
}
~chatnpc("<p,happy>That's <tostring($done)> of them awake and talking. Keep going.");

// --- Aris ---
// The gypsy at 0_29_83_10_15, inside the frozen room. She is the only thing in there still moving,
// which is the point: she was outside the bubble when it closed.

[opnpc1,hundred_aris]
if (%hundred_main_quest_var >= ^hundred_met_aris) {
    @hundred_aris_progress;
}
~chatnpc("<p,quiz>Don't touch anything. Especially not them.");
~chatplayer("<p,quiz>What happened here?");
~chatnpc("<p,neutral>Time happened. Or rather it stopped happening, in this room, about an hour ago, and I was stood in the doorway so it went round me.");
~chatplayer("<p,quiz>Who did it?");
~chatnpc("<p,angry>The Culinaromancer. A very small, very angry man who was thrown out of this castle's kitchens a very long time ago and has been thinking about it ever since.");
~chatnpc("<p,neutral>He has frozen the nine people in this room and he will come back for the rest of Lumbridge when he is ready.");
~chatplayer("<p,quiz>Can they be woken up?");
~chatnpc("<p,neutral>One at a time, and not by me. Each of them was taken mid-mouthful, and each of them will only come back for the dish they were reaching for.");
~chatnpc("<p,neutral>Find out what each one was eating. Make it. Bring it here. Nine dishes, nine people, and then you and I will have a word about the tenth problem.");
~chatnpc("<p,neutral>Inspect them. They will not mind.");
%hundred_main_quest_var = ^hundred_met_aris;
~send_quest_progress(questlist:hundred_main, 3, ^hundred_complete);
~hundred_award_subquest(^hundred_bit_cook);
~mesbox("A chest has appeared in the castle cellar. Aris says it was always there; you are fairly sure it was not.");

[label,hundred_aris_progress]
// Once all nine are awake Aris is the way into the Culinaromancer's arena.
// ~hundred_finale_offer is in hundred_culinaromancer.rs2 and returns true if it did the talking.
if (~hundred_finale_offer = true) {
    return;
}
def_int $done = ~hundred_subquests_done;
~chatnpc("<p,neutral>Nine of them. <tostring($done)> awake. Inspect the ones who are not and they will tell you what they were reaching for.");

// --- Sub-quest bookkeeping ---
// One bit per sub-quest in %hundred_subquest_tally, one quest point each, and the chest tier is the
// count. Every sub-quest pass calls ~hundred_award_subquest with its own bit and nothing else.

[proc,hundred_subquests_done]()(int)
def_int $done = 0;
def_int $i = 0;
while ($i < ^hundred_subquest_count) {
    if (testbit(%hundred_subquest_tally, $i) = ^true) {
        $done = calc($done + 1);
    }
    $i = calc($i + 1);
}
return($done);

[proc,hundred_has_subquest](int $bit)(boolean)
if (testbit(%hundred_subquest_tally, $bit) = ^true) {
    return(true);
}
return(false);

[proc,hundred_award_subquest](int $bit)
if (~hundred_has_subquest($bit) = true) {
    return;
}
%hundred_subquest_tally = setbit(%hundred_subquest_tally, $bit);
if (%hundred_main_quest_var < ^hundred_in_progress) {
    %hundred_main_quest_var = ^hundred_in_progress;
}
~hundred_subquest_reward($bit);
~send_quest_progress(questlist:hundred_main, ~hundred_subquests_done, ^hundred_subquest_count);
~update_questpoints;

// ---------------------------------------------------------------- Sub-quest rewards
//
// WHAT A SUB-QUEST PAID BEFORE THIS: one quest point, and nothing else. There was not one
// stat_advance anywhere in Recipe for Disaster - ten sub-quests, no experience - and no reward
// scroll either, where every other quest in this build ends on ~send_quest_complete. Reported on
// the Mountain Dwarf; it was true of all nine.
//
// OLD SCHOOL PAYS PER SUB-QUEST rather than banking it all for the finale, and the finale's own
// 20,000 lamp is already handed over by hundred_culinaromancer.rs2. Figures are the wiki's
// per-sub-quest reward lists, cross-checked against its Quest experience rewards table:
//
//     Another Cook's Quest   quest point only, and the chest
//     Mountain Dwarf         1,000 Cooking, 1,000 Slayer
//     Goblin generals        1,000 each Cooking, Farming, Crafting
//     Pirate Pete            1,000 each Cooking, Crafting, Fishing, Smithing
//     Lumbridge Guide        2,500 Cooking, 2,500 Magic
//     Evil Dave              7,000 Cooking
//     Skrach Uglogwee        1,500 each Woodcutting, Cooking, Crafting, Ranged
//     Sir Amik Varze         4,000 Cooking, 4,000 Hitpoints
//     King Awowogei          10,000 Cooking, 10,000 Agility
//
// THE TWO SOURCES DISAGREE ON ONE ROW and the disagreement is a filing error, not a number. The
// Full guide lists Skrach's four 1,500s under Evil Dave; the sub-quest pages and the experience
// table agree with each other against it, and Dave's own page gives 7,000 Cooking and nothing
// else. Skrach keeps the four.
//
// The Culinaromancer is deliberately absent from the switch: that bit is set by
// hundred_culinaromancer.rs2, which opens its own ~send_quest_complete two lines later, and a
// second scroll on top of it would be the finale announcing itself twice.
[proc,hundred_subquest_reward](int $bit)
switch_int ($bit) {
    case ^hundred_bit_cook :
        ~hundred_subquest_scroll("You have completed\\nAnother Cook's Quest!",
            "1 Quest Point|The Culinaromancer's Chest");
    case ^hundred_bit_dwarf :
        stat_advance(cooking, 1000);
        stat_advance(slayer, 1000);
        ~hundred_subquest_scroll("You have freed\\nthe Mountain Dwarf!",
            "1 Quest Point|1,000 Cooking XP|1,000 Slayer XP|More of the Chest");
    case ^hundred_bit_goblins :
        stat_advance(cooking, 1000);
        stat_advance(farming, 1000);
        stat_advance(crafting, 1000);
        ~hundred_subquest_scroll("You have freed\\nthe Goblin generals!",
            "1 Quest Point|1,000 Cooking XP|1,000 Farming XP|1,000 Crafting XP|More of the Chest");
    case ^hundred_bit_pirate :
        stat_advance(cooking, 1000);
        stat_advance(crafting, 1000);
        stat_advance(fishing, 1000);
        stat_advance(smithing, 1000);
        ~hundred_subquest_scroll("You have freed\\nPirate Pete!",
            "1 Quest Point|1,000 Cooking XP|1,000 Crafting XP|1,000 Fishing XP|1,000 Smithing XP");
    case ^hundred_bit_guide :
        stat_advance(cooking, 2500);
        stat_advance(magic, 2500);
        ~hundred_subquest_scroll("You have freed\\nthe Lumbridge Guide!",
            "1 Quest Point|2,500 Cooking XP|2,500 Magic XP|More of the Chest");
    case ^hundred_bit_dave :
        stat_advance(cooking, 7000);
        ~hundred_subquest_scroll("You have freed\\nEvil Dave!",
            "1 Quest Point|7,000 Cooking XP|More of the Chest");
    case ^hundred_bit_ogre :
        stat_advance(woodcutting, 1500);
        stat_advance(cooking, 1500);
        stat_advance(crafting, 1500);
        stat_advance(ranged, 1500);
        ~hundred_subquest_scroll("You have freed\\nSkrach Uglogwee!",
            "1 Quest Point|1,500 Woodcutting XP|1,500 Cooking XP|1,500 Crafting XP|1,500 Ranged XP");
    case ^hundred_bit_varze :
        stat_advance(cooking, 4000);
        stat_advance(hitpoints, 4000);
        ~hundred_subquest_scroll("You have freed\\nSir Amik Varze!",
            "1 Quest Point|4,000 Cooking XP|4,000 Hitpoints XP|More of the Chest");
    case ^hundred_bit_monkey :
        stat_advance(cooking, 10000);
        stat_advance(agility, 10000);
        ~hundred_subquest_scroll("You have freed\\nKing Awowogei!",
            "1 Quest Point|10,000 Cooking XP|10,000 Agility XP|More of the Chest");
}

// The sub-quest scroll. ~send_quest_complete cannot be used for these: its last act is to paint
// the quest list entry GREEN and print "Quest complete!", and Recipe for Disaster is one entry
// with ten steps - the first sub-quest finished would mark the whole quest done. This is that
// proc's own inter_238 branch with the colouring left to ~send_quest_progress, which
// ~hundred_award_subquest runs on the line after this returns.
//
// The picture is the chest's gauntlets because that is the one reward every sub-quest really
// shares: each one widens what the Culinaromancer's Chest will sell you.
[proc,hundred_subquest_scroll](string $title, string $rewardtext)
def_int $random = random(128);
if ($random < 32) {
    midi_jingle("quest complete 3");
} else if ($random < 64) {
    midi_jingle("quest complete 2");
} else {
    midi_jingle("quest complete 1");
}
split_init($rewardtext, 200, 5, q8_full);
if_settext(inter_238:com_3, $title);
if_settext(inter_238:com_9, "<~pluralise(1, "Quest Point")>");
if_settext(inter_238:com_10, split_get(0, 0));
if_settext(inter_238:com_11, split_get(0, 1));
if_settext(inter_238:com_12, split_get(0, 2));
if_settext(inter_238:com_13, split_get(0, 3));
if_settext(inter_238:com_14, split_get(0, 4));
if_setobject(inter_238:com_4, hundred_gauntlets_level_1, 250);
if_openmain(inter_238);

// --- Quest journal ---

[if_button,questlist:hundred_main]
def_string $n = "Recipe for Disaster";
def_string $x;
if (%hundred_main_quest_var = ^hundred_not_started) {
    $x = append($x, "@dbl@I can start this quest by speaking to the @dre@Cook@dbl@ in the kitchen|");
    $x = append($x, "@dbl@of @dre@Lumbridge Castle@dbl@, once I have finished @dre@Cook's Assistant@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "@str@The Cook says something has happened in the Lumbridge Castle|");
$x = append($x, "@str@dining hall.|");
if (%hundred_main_quest_var = ^hundred_told_by_cook) {
    $x = append($x, "|@dbl@I should go through the @dre@kitchen door@dbl@ and look.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Nine people are frozen in time around the table, and a gypsy|");
$x = append($x, "@str@called Aris is standing among them.|");
if (%hundred_main_quest_var = ^hundred_seen_dining_room) {
    $x = append($x, "|@dbl@I should speak to @dre@Aris@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@The Culinaromancer froze them. Each one will only wake for the|");
$x = append($x, "@str@dish they were reaching for when time stopped.|");
$x = append($x, "|");
$x = append($x, ~hundred_journal_entry(^hundred_bit_dwarf, "The Mountain Dwarf"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_goblins, "The Goblin generals"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_pirate, "Pirate Pete"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_guide, "The Lumbridge Guide"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_dave, "Evil Dave"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_ogre, "Skrach Uglogwee"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_varze, "Sir Amik Varze"));
$x = append($x, ~hundred_journal_entry(^hundred_bit_monkey, "King Awowogei"));
if (%hundred_main_quest_var = ^hundred_complete) {
    $x = append($x, "|@dbl@@dre@QUEST COMPLETE!");
    ~quest_journal($n, $x);
    return;
}
if (~hundred_subquests_done >= ^hundred_victims_count) {
    $x = append($x, "|@dbl@All nine are awake. I should deal with the @dre@Culinaromancer@dbl@.");
    ~quest_journal($n, $x);
    return;
}
if (~hundred_has_subquest(^hundred_bit_dwarf) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_dwarf_journal);
}
if (~hundred_has_subquest(^hundred_bit_guide) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_guide_journal);
}
if (~hundred_has_subquest(^hundred_bit_monkey) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_monkey_journal);
}
if (~hundred_has_subquest(^hundred_bit_ogre) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_ogre_journal);
}
if (~hundred_has_subquest(^hundred_bit_varze) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_amik_journal);
}
if (~hundred_has_subquest(^hundred_bit_goblins) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_goblin_journal);
}
if (~hundred_has_subquest(^hundred_bit_dave) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_dave_journal);
}
if (~hundred_has_subquest(^hundred_bit_pirate) = false) {
    $x = append($x, "|");
    $x = append($x, ~hundred_pirate_journal);
}
~quest_journal($n, $x);

// One line per victim. @str@ once they are awake, @dbl@ while they are not.
[proc,hundred_journal_entry](int $bit, string $who)(string)
if (~hundred_has_subquest($bit) = true) {
    return(append(append("@str@", $who), " is awake.|"));
}
return(append(append("@dbl@", $who), " is still frozen.|"));
