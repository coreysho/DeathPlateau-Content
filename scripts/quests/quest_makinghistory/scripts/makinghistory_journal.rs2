[if_button,questlist:makinghistory]
def_string $text;

switch_int (%makinghistory_prog) {
    case ^mh_not_started :
        $text = "@dbl@@dre@Jorral@dbl@ keeps an @dre@outpost@dbl@ north of @dre@Ardougne@dbl@, on the|";
        $text = append($text, "@dbl@road up to the @dre@Gnome Stronghold|");
        $text = append($text, "@dbl@He is writing a history and it has holes in it");

    case ^mh_investigating :
        $text = "@str@The outpost was built at the start of the Fifth Age and for|";
        $text = append($text, "@str@sixty-five years three faiths kept one road open through it.|");
        $text = append($text, "@str@Then the Dreaded Years of Tragedy, then the Great Battle,|");
        $text = append($text, "@str@and three years after that the survivors founded the royal|");
        $text = append($text, "@str@line of Ardougne and the Equal Trade Market.|");
        $text = append($text, "@str@Jorral has the four dates and nothing in between them.|");
        $text = append($text, "@str@Three threads:||");

        if (%makinghistory_trader_prog >= ^mh_strand_done) {
            $text = append($text, "@gre@The trader - done|");
        } else if (%makinghistory_trader_prog = ^mh_strand_held) {
            $text = append($text, "@dbl@The @dre@trader@dbl@ - take the journal to Jorral|");
        } else if (~obj_gettotal(makinghistory_chest) > 0) {
            $text = append($text, "@dbl@The @dre@trader@dbl@ - use the @dre@key@dbl@ on the @dre@chest|");
        } else if (%makinghistory_trader_prog = ^mh_strand_asked) {
            $text = append($text, "@dbl@The @dre@trader@dbl@ - @dre@Feel@dbl@ Erin's key as you walk, and|");
            $text = append($text, "@dbl@@dre@dig@dbl@ where it is too hot to hold|");
        } else {
            $text = append($text, "@dbl@The @dre@trader@dbl@ - @dre@Erin@dbl@, the silver stall in the|");
            $text = append($text, "@dbl@@dre@Ardougne market|");
        }

        if (%makinghistory_warr_prog >= ^mh_strand_done) {
            $text = append($text, "@gre@The warrior - done|");
        } else if (%makinghistory_warr_prog = ^mh_strand_held) {
            $text = append($text, "@dbl@The @dre@warrior@dbl@ - tell Jorral what Dron told you|");
        } else if (%makinghistory_warr_prog = ^mh_strand_refused) {
            $text = append($text, "@dbl@The @dre@warrior@dbl@ - ask @dre@Dron@dbl@ again. He asks|");
            $text = append($text, "@dbl@@dre@fourteen questions@dbl@ and one wrong answer ends it|");
        } else if (%makinghistory_warr_prog = ^mh_strand_told) {
            $text = append($text, "@dbl@The @dre@warrior@dbl@ - @dre@Dron@dbl@, by the northern dock in|");
            $text = append($text, "@dbl@@dre@Rellekka@dbl@. He will say no first|");
        } else {
            $text = append($text, "@dbl@The @dre@warrior@dbl@ - @dre@Blanin@dbl@, in @dre@Rellekka|");
        }

        if (%makinghistory_ghost_prog >= ^mh_ghost_done) {
            $text = append($text, "@gre@The ghost - done");
        } else if (%makinghistory_ghost_prog = ^mh_ghost_held) {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - take the timeline to Jorral");
        } else if (%makinghistory_ghost_prog = ^mh_ghost_forgiven) {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - tell @dre@Droalak@dbl@ she will speak to him");
        } else if (%makinghistory_ghost_prog = ^mh_ghost_amulet) {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - talk to @dre@Melina@dbl@ again");
        } else if (%makinghistory_ghost_prog = ^mh_ghost_proof) {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - tell @dre@Melina@dbl@ about the garden, and|");
            $text = append($text, "@dbl@give her a @dre@sapphire amulet@dbl@ - a strung one");
        } else if (%makinghistory_ghost_prog = ^mh_ghost_melina) {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - ask @dre@Droalak@dbl@ for something only he|");
            $text = append($text, "@dbl@could know");
        } else if (%makinghistory_ghost_prog = ^mh_ghost_droalak) {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - @dre@Melina@dbl@, east of the general store");
        } else {
            $text = append($text, "@dbl@The @dre@ghost@dbl@ - @dre@Droalak@dbl@, in @dre@Port Phasmatys|");
            $text = append($text, "@dbl@Wear an @dre@amulet of ghostspeak");
        }

    case ^mh_reporting :
        $text = "@str@A famine, a battle three faiths could not keep a road open|";
        $text = append($text, "@str@through, and two friends who fought each other over this|");
        $text = append($text, "@str@outpost and then both went Guthixian.|");
        $text = append($text, "@str@And the outpost has been marked for demolition for six|");
        $text = append($text, "@str@years, because Jorral is a historian and Lathas is a king.||");
        $text = append($text, "@dbl@Take Jorral's @dre@letter@dbl@ to @dre@King Lathas@dbl@, upstairs in|");
        $text = append($text, "@dbl@the castle in @dre@Ardougne");

    case ^mh_lathas :
        $text = "@str@The king read it twice, which kings are not in the habit|";
        $text = append($text, "@str@of doing, and wrote back.||");
        $text = append($text, "@dbl@Take his @dre@letter@dbl@ back to @dre@Jorral");

    case ^mh_complete :
        $text = "@str@Four dated lines with a famine, a battle and two friends|";
        $text = append($text, "@str@between them, and a storeroom full of crates that is now a|");
        $text = append($text, "@str@museum, because the King of Ardougne agreed in writing that|");
        $text = append($text, "@str@the road could go round.|");
        $text = append($text, "@str@Droalak walked four minutes down a road it took him two|");
        $text = append($text, "@str@hundred years to start.||");
        if (%makinghistory_locstatus >= ^mh_grave_done) {
            $text = append($text, "@gre@All three mjolnirs are out of the ground|");
        } else {
            $text = append($text, "@dbl@The @dre@enchanted key@dbl@ is still warm. @dre@Feel@dbl@ it and|");
            $text = append($text, "@dbl@@dre@dig@dbl@ - there are three graves nobody marked|");
        }
        $text = append($text, "@red@QUEST COMPLETE!");

    case default :
        $text = "@dbl@@dre@Jorral@dbl@ keeps an @dre@outpost@dbl@ north of @dre@Ardougne";
}

~quest_journal("Making History", $text);
