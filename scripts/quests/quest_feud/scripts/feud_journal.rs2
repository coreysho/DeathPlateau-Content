// The Feud's quest journal. Rewritten 14 October 2026 with the quest - the old entries described a
// detective story about twenty missing crates and a mayor who hires you.
[if_button,questlist:feud]
def_string $text;

switch_int (%feud_var) {
    case ^feud_not_started :
        $text = "@dbl@@dre@Ali Morrisane@dbl@ in @dre@Al Kharid@dbl@ has lost goods on the road|";
        $text = append($text, "@dbl@south to @dre@Pollnivneach|");
        $text = append($text, "@dbl@I will need @dre@30 Thieving@dbl@, and it cannot be boosted");

    case ^feud_sent :
        $text = "@str@Pollnivneach is run by two gangs and nothing moves through it|";
        $text = append($text, "@str@without one of them knowing.|");
        $text = append($text, "@dbl@Buy a @dre@Kharidian headpiece@dbl@ and a @dre@fake beard@dbl@ from Ali|");
        $text = append($text, "@dbl@and put them together|");
        $text = append($text, "@dbl@Then buy @dre@three beers@dbl@ for the drunk in the bar");

    case ^feud_drunk :
        $text = "@str@Three beers bought me everything Drunken Ali knows.|";
        $text = append($text, "@dbl@Ask the @dre@bandits@dbl@ about the Menaphites|");
        $text = append($text, "@dbl@Ask the @dre@Menaphites@dbl@ about the bandits");

    case ^feud_asked_gangs :
        $text = "@str@Each gang blames the other for the road. Neither of them|";
        $text = append($text, "@str@mentioned the camels.|");
        $text = append($text, "@dbl@Buy @dre@both camels@dbl@ from the seller - @dre@500 coins@dbl@, and two|");
        $text = append($text, "@dbl@free spaces|");
        $text = append($text, "@dbl@Give a @dre@receipt@dbl@ to each gang");

    case ^feud_camels :
        $text = "@str@Both gangs think the other sent them a camel.|";
        $text = append($text, "@dbl@@dre@Ali the Operator@dbl@ in the big tent has noticed|");
        $text = append($text, "@dbl@Ask him for work");

    case ^feud_joined :
        $text = "@str@Ali the Operator will take me on if I can take something|";
        $text = append($text, "@str@off somebody.|");
        $text = append($text, "@dbl@@dre@Pickpocket a villager|");
        $text = append($text, "@dbl@Then go back to the tent");

    case ^feud_pickpocket :
        $text = "@str@He felt my hand and shouted the street down.|";
        $text = append($text, "@dbl@The @dre@street urchin@dbl@ by the well will be a nuisance for|");
        $text = append($text, "@dbl@@dre@10 coins|");
        $text = append($text, "@dbl@Pickpocket the villager he is pestering");

    case ^feud_blackjack :
        $text = "@str@The urchin kept him busy and he never felt a thing.|";
        $text = append($text, "@dbl@Buy a @dre@blackjack@dbl@ from the man by the bar|");
        $text = append($text, "@dbl@@dre@Wield@dbl@ it, @dre@lure@dbl@ a villager somewhere quiet, and|");
        $text = append($text, "@dbl@@dre@knock him out@dbl@ before going through his pockets");

    case ^feud_thief :
        $text = "@str@One villager asleep in an alley, and I am in the gang.|";
        $text = append($text, "@dbl@Ali the Operator has a job that is not a test");

    case ^feud_heist :
        $text = "@str@He wants the Mayor's wife's jewels, and he had the Mayor's|";
        $text = append($text, "@str@own keys in his robe.|");
        $text = append($text, "@dbl@Wear the @dre@disguise@dbl@ and @dre@gloves|");
        $text = append($text, "@dbl@@dre@Hide behind the cactus@dbl@ until the guard passes|");
        $text = append($text, "@dbl@Unlock the door, go upstairs, and @dre@search the picture");

    case ^feud_jewels :
        $text = "@str@One, one, two, three, five, eight. The jewels were behind|";
        $text = append($text, "@str@a portrait of the woman they belong to.|");
        $text = append($text, "@dbl@Take them to @dre@Ali the Operator|");
        $text = append($text, "@dbl@Then ask a @dre@thug@dbl@ what the gang does next");

    case ^feud_traitor :
        $text = "@str@They are going to poison the well. Four hundred people|";
        $text = append($text, "@str@drink out of that well.|");
        $text = append($text, "@dbl@The @dre@barman@dbl@ knows where the boss's beer is left|");
        $text = append($text, "@dbl@@dre@Ali the Hag@dbl@ wants a @dre@snake in a basket@dbl@ and a bucket of|");
        $text = append($text, "@dbl@@dre@ugthanki dung@dbl@ from a camel that drank something hot");

    case ^feud_poison :
        $text = "@str@The hag's poison will put a man down for a day and a night.|";
        $text = append($text, "@dbl@Put it in the @dre@beer on the table@dbl@ by the bar door");

    case ^feud_poisoned :
        $text = "@str@The boss's beer is waiting for him and so is the day after.|";
        $text = append($text, "@dbl@Tell the @dre@Menaphite leader@dbl@ outside the tent|");
        $text = append($text, "@dbl@Their @dre@tough guy@dbl@ will want a word");

    case ^feud_menaphite_down :
        $text = "@str@The Menaphites have no boss and no champion.|";
        $text = append($text, "@dbl@Tell a @dre@villager|");
        $text = append($text, "@dbl@Then tell the @dre@bandit leader@dbl@ by the northern carpet");

    case ^feud_bandit_down :
        $text = "@str@Both gangs lost everybody who gave orders, inside one|";
        $text = append($text, "@str@afternoon.|");
        $text = append($text, "@dbl@Tell @dre@Ali the Mayor@dbl@, by the well");

    case ^feud_told_mayor :
        $text = "@str@The Mayor has been in his own house all morning with the|";
        $text = append($text, "@str@door open.|");
        $text = append($text, "@dbl@Go back to @dre@Ali Morrisane");

    case default :
        $text = "@str@Pollnivneach had two gangs. I joined one of them, robbed the|";
        $text = append($text, "@str@Mayor for it, found out what it was really for, and put the|");
        $text = append($text, "@str@boss to sleep with a beer. Both champions are on the floor|");
        $text = append($text, "@str@and the Mayor has his village back.|");
        $text = append($text, "@dbl@@dre@QUEST COMPLETE");
}

~quest_journal("The Feud", $text);
