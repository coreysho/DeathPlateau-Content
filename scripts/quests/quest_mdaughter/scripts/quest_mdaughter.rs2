// Mountain Daughter - the world side. The talking is in the npc files beside this one.

// =========================================================================== getting into the camp

// The rockslide is a single blocking centrepiece across the path at the camp's southern edge, and
// the guard stands just inside it. Until Hamal has agreed to let an outsider ask after his
// daughter, nobody gets over it from the outside - which is the whole reason the boulder on the
// ledge above the path has a rope option.
[oploc1,mdaughter_rockslide]
p_arrivedelay;
if (coordz(coord) < coordz(loc_coord)) {
    if (%mdaughter_quest_var < ^mdaughter_started) {
        ~mesbox("You get a hand to the top of the slide and a spear comes over it. The camp is not letting you in this way.");
        return;
    }
    p_teleport(^mdaughter_rockslide_north);
    mes("You scramble over the rockslide.");
    return;
}
p_teleport(^mdaughter_rockslide_south);
mes("You scramble over the rockslide.");

// The boulder on the ledge. "Push" alone does nothing - it is two tons of mountain - but a rope
// round it reaches the camp's yard, which is how an outsider gets in before the chieftain has
// agreed to anything.
[oploc3,mdaughter_cliff_boulder]
p_arrivedelay;
if (inv_total(inv, rope) > 0) {
    ~mesbox("The boulder does not move, but it is not going anywhere either. A rope round it would reach the yard below.");
    return;
}
~mesbox("The boulder does not move. It would hold a rope, though, if you had one.");

[oplocu,mdaughter_cliff_boulder]
if (last_useitem ! rope) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_rope_the_boulder;

[oplocu,mdaughter_cliff_rock]
if (last_useitem ! rope) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_rope_the_boulder;

// The rope is not taken: you untie it at the bottom and coil it up again, which is why
// mdaughter_rope is "the rope you're holding" rather than an obj of its own in the pack.
[label,mdaughter_rope_the_boulder]
p_arrivedelay;
mes("You tie your rope around the boulder and drop the end over the rock.");
loc_change(mdaughter_cliff_boulder_withrope, 500);
p_delay(1);
anim(human_pickupfloor, 0);
~mesbox("You climb down into the camp, and coil your rope up again at the bottom.");
p_teleport(^mdaughter_boulder_bottom);

// mdaughter_cliff_boulder_withrope carries no ops at all - it is the state other people see while
// somebody is on the rope - so a second descent is another use of the rope on it.
[oplocu,mdaughter_cliff_boulder_withrope]
if (last_useitem ! rope) {
    ~displaymessage(^dm_default);
    return;
}
p_arrivedelay;
anim(human_pickupfloor, 0);
mes("You climb down the rope into the camp.");
p_teleport(^mdaughter_boulder_bottom);

// =========================================================================== the pole

// A dead tree gives the pole. mdaughter_impassable_tree and mdaughter_impassable_tree2 are the two
// that are meant to stay standing, so only the passable one can be felled.
// The two passable trees are also what stands between the camp and the Kendal's cave, so felling
// one has to work whether or not you want its pole - a player who already had one used to be told
// so and left standing on the wrong side of the second tree.
[oploc1,mdaughter_passable_tree]
p_arrivedelay;
// It is "Chop down", and the quest's item list asks for an axe for exactly this. The checker
// prints its own refusal.
if (~woodcutting_axe_checker(true) = null) {
    return;
}
if (~obj_gettotal(mdaughter_stick) > 0 | inv_total(inv, mdaughter_polevault) > 0) {
    mes("You fell the dead tree. You already have a pole, so you leave the wood where it lies.");
    loc_change(mdaughter_passable_tree_stump, 100);
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room for a pole.");
    return;
}
mes("You cut a long pole from the dead tree.");
inv_add(inv, mdaughter_stick, 1);
loc_change(mdaughter_passable_tree_stump, 100);

[oploc1,mdaughter_impassable_tree] @mdaughter_tree_too_thick;
[oploc1,mdaughter_impassable_tree2] @mdaughter_tree_too_thick;

[label,mdaughter_tree_too_thick]
mes("This one is far too thick to cut a pole from.");

// "Step-over": the stump is the way through the treeline, along x.
[oploc1,mdaughter_passable_tree_stump]
p_arrivedelay;
if (coordx(coord) < coordx(loc_coord)) {
    p_teleport(movecoord(loc_coord, 1, 0, 0));
} else {
    p_teleport(movecoord(loc_coord, -1, 0, 0));
}
mes("You step over the stump.");

// =========================================================================== mud

// The mud pond east of the camp, and the roots the water has pulled up around it. Both give the
// same handful of mud - mdaughter_swampbubbles1 is name="Mud" with op1=Dig-up and the six
// mdaughter_roots_1 beside it are op1=Dig-below, and the quest wants the mud for one thing only.
[oploc1,mdaughter_swampbubbles1] @mdaughter_dig_mud;
[oploc1,mdaughter_roots_1] @mdaughter_dig_mud;
[oploc1,mdaughter_roots_2] @mdaughter_dig_mud;

[label,mdaughter_dig_mud]
p_arrivedelay;
if (inv_freespace(inv) = 0) {
    mes("Your hands are full of mud and your pack is full of everything else.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(1);
mes("You scoop a handful of mud out from under the roots.");
inv_add(inv, mdaughter_mud, 1);

// =========================================================================== the crossings

// The tall tree on the lake shore had op3=Climb and nothing behind it, and it is the only way onto
// the ledge the vault starts from. Neither ledge has a dry tile next to what it crosses, so these
// are approach triggers: they fire from the ledge, across the water, in sight of the loc.
// The bark above the geysers is wet, and stays wet until somebody puts mud on it - which is what
// mdaughter_mud_var records.
[oplocu,mdaughter_lake_tree]
if (last_useitem ! mdaughter_mud) {
    ~displaymessage(^dm_default);
    return;
}
if (%mdaughter_mud_var = ^mdaughter_mud_on_tree) {
    mes("The tree has mud on it already.");
    return;
}
p_arrivedelay;
inv_del(inv, mdaughter_mud, 1);
%mdaughter_mud_var = ^mdaughter_mud_on_tree;
anim(human_pickupfloor, 0);
~mesbox("You work the mud into the bark where the steam has made it slick. It will hold a boot now.");

[aploc3,mdaughter_lake_tree]
if (distance(loc_coord, coord) > 5) {
    p_aprange(5);
    return;
}
if (coordz(coord) > coordz(^mdaughter_tree_shore)) {
    mes("You climb back along the branches to the shore.");
    p_delay(1);
    p_teleport(^mdaughter_tree_shore);
    return;
}
if (%mdaughter_mud_var ! ^mdaughter_mud_on_tree) {
    ~mesbox("The geysers have left the bark wet through. You get a grip on it, lose it, and slide back down. Something would have to be worked into the bark first.");
    return;
}
anim(human_pickupfloor, 0);
mes("You climb the tree and drop down onto a ledge on the far side of it.");
p_delay(1);
p_teleport(^mdaughter_tree_ledge);

// One clump of rocks to vault, then two flat stones to bridge. The vault is the only one that
// asks anything of the player - and only on the way out, so nobody is stranded on the island
// without the pole they brought.
[aploc1,mdaughter_polerocks]
if (distance(loc_coord, coord) > 3) {
    p_aprange(3);
    return;
}
// The tree cannot be seen from the ledge, so both ways off the ledge that do not vault go back
// round the tree to the shore - nobody can be left on it.
if (coordz(coord) > coordz(loc_coord)) {
    mes("You jump back down onto the ledge, and climb back round the tree to the shore.");
    p_teleport(^mdaughter_tree_shore);
    return;
}
if (inv_total(inv, mdaughter_stick) = 0 & inv_total(inv, mdaughter_polevault) = 0) {
    mes("The gap is too wide to jump. You would need a pole - Jokul keeps the goats, and the goat pen is made of them - so you climb back to the shore.");
    p_teleport(^mdaughter_tree_shore);
    return;
}
if (stat(agility) < 20) {
    mes("You need an Agility level of 20 to make this jump, so you climb back to the shore.");
    p_teleport(^mdaughter_tree_shore);
    return;
}
mes("You wedge the pole into the rocks and vault across.");
p_teleport(^mdaughter_rocks_north);

// The two flat stones are the last gap, and they take a plank: mdaughter_short_plank_stone1 and
// _stone2 are the same stones with "Someone put a plank on top of the stone! Clever..." written on
// them. The plank comes back off the stone as you step away from it, so one plank does both
// crossings and nothing is lost to the loc reverting.
// Jump-across is the only op the flat stones have, and mdaughter_short_plank_stone1 and _stone2 -
// the same stones with "Someone put a plank on top of the stone! Clever..." written on them - have
// no ops at all. So the plank goes down and comes back up inside the one click: you lay it, cross,
// and lift it after you, which is what the quest's one plank has to do both ways.
[oploc1,mdaughter_flatstone1] @mdaughter_stone_hop(mdaughter_short_plank_stone1);
[oploc1,mdaughter_flatstone2] @mdaughter_stone_hop(mdaughter_short_plank_stone2);

[oplocu,mdaughter_flatstone1]
if (last_useitem ! plank) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_stone_hop(mdaughter_short_plank_stone1);

[oplocu,mdaughter_flatstone2]
if (last_useitem ! plank) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_stone_hop(mdaughter_short_plank_stone2);

[label,mdaughter_stone_hop](loc $planked)
p_arrivedelay;
if (inv_total(inv, plank) = 0) {
    mes("The stones are too far apart to step between. A plank laid across them would do it.");
    return;
}
loc_change($planked, 20);
mes("You lay the plank across the stones and go over.");
p_delay(1);
if (coordx(coord) < coordx(^mdaughter_stones_east)) {
    p_teleport(^mdaughter_stones_east);
} else {
    p_teleport(^mdaughter_stones_west);
}
mes("You lift the plank after you.");

// =========================================================================== white pearls

// The thorny bushes on White Wolf Mountain. The thorns are the whole reason the quest asks for
// gloves: without them you come away bleeding and empty-handed.
[oploc3,mdaughter_white_pearl_bush]
p_arrivedelay;
if (inv_freespace(inv) = 0) {
    mes("You have no room for any more fruit.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(1);
if (inv_getobj(worn, ^wearpos_hands) = null) {
    mes("The thorns go straight through your bare hands and you come away with nothing.");
    ~damage_self(4);
    return;
}
mes("You pick a white pearl from the bush.");
inv_add(inv, mdaughter_white_pearl_fruit, 1);

// Eating one leaves the seed, which is the only one anybody has ever got out of a White Pearl -
// param=next_obj_stage on the fruit says as much.
[opheld3,mdaughter_white_pearl_fruit]
inv_del(inv, mdaughter_white_pearl_fruit, 1);
if (inv_freespace(inv) = 0) {
    ~mesbox("You eat the white pearl. It is as good as Jokul said it was - and you spit the seed out into the snow, because you have nowhere to put it.");
    return;
}
inv_add(inv, mdaughter_white_pearl_seed, 1);
if (%mdaughter_food_var = ^mdaughter_food_jokul) {
    %mdaughter_food_var = ^mdaughter_food_has_seed;
}
~mesbox("You eat the white pearl. It is as good as Jokul said it was, and there is a seed in the middle of it the size of your thumbnail.");

// =========================================================================== the Shining pool

// mdaughter_sulphar_gas is name="Shining pool" with op1=Listen-to and "You can also hear faint
// singing coming from it", and the map places 38 of them across the lake. Only the ones out by the
// island are close enough to make words out of, which is what sends the player over the water in
// the first place.
[oploc1,mdaughter_sulphar_gas]
p_arrivedelay;
if (distance(coord, ^mdaughter_burial_ground) > ^mdaughter_pool_range) {
    ~mesbox("The pool is singing. You cannot make out a word of it from here - whatever is doing it is further out, towards the island.");
    return;
}
@mdaughter_asleif_speaks;

// =========================================================================== the Ancient Rock

// Rellekka's stone, which the camp took and has kept for three generations. Brundt will not put
// Svidi's safe passage in writing until it comes back, and splitting it is the compromise: half
// each. The Ancient Rock carries no ops at all, so the pickaxe is used on it.
[oplocu,mdaughter_ancient_rock]
if (oc_category(last_useitem) ! weapon_pickaxe) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_split_rock;

[label,mdaughter_split_rock]
if (%mdaughter_relations_var < ^mdaughter_peace_brundt_wants_rock) {
    mes("The Ancient Rock of the mountain people. It is not yours to touch.");
    return;
}
if (~obj_gettotal(mdaughter_half_rock) > 0) {
    mes("You already have your half of the rock.");
    return;
}
if (%mdaughter_relations_var > ^mdaughter_peace_brundt_wants_rock) {
    mes("Brundt has his half. The camp can keep the rest of it.");
    return;
}
if (~pickaxe_checker = null) {
    mes("You would need a pickaxe to take a piece of this.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room to carry a piece of the rock.");
    return;
}
anim(human_mining_bronze_pickaxe, 0);
loc_change(mdaughter_ancient_rock_splitting, 4);
sound_synth(mine, 1, 0);
~mesbox("The Ancient Rock splits cleanly in two. Half of it is Rellekka's, and has been for three generations.");
inv_add(inv, mdaughter_half_rock, 1);

// =========================================================================== the Ancient Rock's tent

// "Go-through" on the flaps of the tent the Ancient Rock stands in had no trigger. The flaps are the
// north wall of their tile, so through is along z: the flap's own tile is the inside.
[oploc1,mdaughter_rocktent_door] @mdaughter_rocktent;
[oploc1,mdaughter_rocktent_doorl] @mdaughter_rocktent;

[label,mdaughter_rocktent]
p_arrivedelay;
if (coordz(coord) > coordz(loc_coord)) {
    p_teleport(loc_coord);
} else {
    p_teleport(movecoord(loc_coord, 0, 0, 1));
}
mes("You go through the tent flap.");

// =========================================================================== the Kendal's cave

[oploc1,mdaughter_caveentrance]
p_arrivedelay;
if (%mdaughter_quest_var < ^mdaughter_asked_of_death) {
    mes("There is something living in there. You have no reason to disturb it yet.");
    return;
}
// An earlier version moved the Kendal's multi off 0 when the fight began, and at any other value
// the client draws no npc at all - so anyone it happened to would find the cave empty.
%mdaughter_bear_multi_state = ^mdaughter_kendal_talking;
mes("You squeeze into the cave.");
p_teleport(^mdaughter_cave_inside);

[oploc1,mdaughter_caveexit]
p_arrivedelay;
mes("You climb back out into the daylight.");
p_teleport(^mdaughter_cave_outside);

[oploc1,mdaughter_caveexit_fake]
mes("This is not a way out - the passage closes up a few feet in.");

// =========================================================================== the burial

// The mound and the cairn are the two states of mdaughter_multimound, which is placed once at
// local(31,46) of m43_57 and keys off mdaughter_burial_state - so building either is a varbit
// write, not a loc_add.
// Burying her is the corpse's own iop3, not a use-on-loc, because at burial_state 0 the mound loc
// is not rendered and there is nothing at the burial ground to click.
// The wording of the out-of-range message is the one general_use/scripts/item_ops_generated.rs2
// already had for this op, kept rather than rewritten when the trigger moved here.
[opheld3,mdaughter_daughter_corpse]
if (distance(coord, ^mdaughter_burial_ground) > ^mdaughter_burial_range) {
    ~mesbox("This isn't the right place to lay her to rest.");
    return;
}
@mdaughter_lay_her_down;

[label,mdaughter_lay_her_down]
if (%mdaughter_burial_state ! ^mdaughter_burial_none) {
    mes("Asleif is already buried here.");
    return;
}
if (inv_total(inv, mdaughter_necklace) = 0) {
    ~mesbox("Not yet. Ragnar kept her necklace for ten years waiting for her to come back for it, and she should have it on.");
    return;
}
inv_del(inv, mdaughter_daughter_corpse, 1);
inv_del(inv, mdaughter_necklace, 1);
%mdaughter_burial_state = ^mdaughter_burial_mound;
%mdaughter_quest_var = ^mdaughter_buried;
~send_quest_progress(questlist:mdaughter, %mdaughter_quest_var, ^mdaughter_complete);
anim(human_pickuptable, 0);
~mesbox("You put her necklace back on her and lay her in the ground, and heap the earth over. It is a grave, but it is not a cairn - the mountain people mark their dead with stone.");

// Five rocks off the churned ground in the goat pen finish it. They go on in one go: the mound
// only ever gets built once, and a half-built cairn is not a thing the quest tracks.
[oplocu,mdaughter_multimound]
if (last_useitem ! mdaughter_rock) {
    ~displaymessage(^dm_default);
    return;
}
@mdaughter_cap_the_cairn;

[label,mdaughter_cap_the_cairn]
if (%mdaughter_burial_state = ^mdaughter_burial_none) {
    mes("There is nobody buried here yet.");
    return;
}
if (%mdaughter_burial_state = ^mdaughter_burial_cairn) {
    mes("The cairn is finished.");
    return;
}
if (inv_total(inv, mdaughter_rock) < ^mdaughter_cairn_rocks) {
    ~mesbox("One rock is not a cairn. It would take five of them, and the goats have churned up more than that.");
    return;
}
inv_del(inv, mdaughter_rock, ^mdaughter_cairn_rocks);
%mdaughter_burial_state = ^mdaughter_burial_cairn;
anim(human_pickuptable, 0);
~mesbox("You stack the rocks over her, one on another, until the mound is a cairn. It will stand as long as the mountain does.");
queue(mdaughter_quest_complete, 0, 0);

// =========================================================================== scenery

// mdaughter_poolwater is the 2x2 pool itself (op3=Listen-to) and is placed nowhere in the 377 map -
// the 38 bubbles are what the player actually clicks. It is handled anyway, for the same reason the
// fake cave exit is: the op exists.
[oploc3,mdaughter_poolwater]
p_arrivedelay;
if (distance(coord, ^mdaughter_burial_ground) > ^mdaughter_pool_range) {
    ~mesbox("The pool is singing. You cannot make out a word of it from here.");
    return;
}
@mdaughter_asleif_speaks;

// =========================================================================== completion

[queue,mdaughter_quest_complete]
%mdaughter_quest_var = ^mdaughter_complete;
// The scroll's own lines: 2,000 Prayer and 1,000 Attack, in that order (OSRS wiki, Mountain
// Daughter reward scroll). They were the other way round here, and so was the xp.
stat_advance(prayer, 20000);
stat_advance(attack, 10000);
session_log(^log_adventure, "Quest complete: Mountain Daughter");
~send_quest_complete(questlist:mdaughter, mdaughter_bear_helmet, 250, ^mdaughter_questpoints, "You have completed the\\nMountain Daughter Quest!", "2 Quest Points|2,000 Prayer XP|1,000 Attack XP|The Bearhead");
