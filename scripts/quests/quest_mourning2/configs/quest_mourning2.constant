// Mourning's End Part II - the light temple.
//
// mourning2.loc was already in this repo, 290 entries of it, with no script anywhere. Between it,
// the varbit table and the map, the temple is completely described:
//
//   60 mourning_light_temple_beam_* locs, each one a straight run of tiles
//   35 mourning_temple_pillar_<floor>_<room> locs at the junctions
//   43 mourning_light_temple_<floor>_<room>_up varbits, one per pillar, and each pillar loc is a
//      multiloc on its own: 0 dark, 1-7 the seven colours
//   50 mourning_light_temple_<floor>_<a>_<b> varbits, one per beam segment, on five transmitted
//      varps, so the client draws whatever the server lights
//   14 mourning_door_* varbits on the outer walls
//
// The graph in scripts/mourning2_graph.rs2 is GENERATED off maps/m29_72.jm2 rather than written:
// every edge is the real run of beam tiles between two real pillars, so the simulation cannot
// drift away from what the world looks like. 86 edges came out of it and they are symmetric, which
// is the check that the extraction was right.
//
// ---------------------------------------------------------------------------- the shaft
// mourning_temple_pillar_3_a is placed at (13,20) and (13,42) on plane 2 AND at (25,31) on plane 2,
// and mourning_temple_pillar_1_b is at (25,31) on plane 0 - the same tile, two floors down. That
// is the vertical shaft, and mourning_temple_final_pillar_of_light sits at (13,31) on plane 0
// between mourning_light_temple_beam_1_b_west and _1_d_west, which run to
// mourning_temple_light_wall_with_hole at (0,30).
//
// So the whole temple resolves to one sentence: get the light to the top-floor shaft pillar, let
// it fall, and send it west out of the hole in the wall.
//
// ---------------------------------------------------------------------------- the mirrors
// mourning_mirror is a "Hand mirror - A small hand mirror", and the six light-parts chests
// (mourning_temple_light_parts_2..6, op1=Open then op1=Search) are where the temple's fittings are.
// A mirror sits on a pillar at 45 degrees and is silvered on one side, so its four rotations are
// four different pairs of turns and three of the four do nothing to a given beam:
//
//   0   travelling east  -> north     travelling south -> west
//   1   travelling west  -> north     travelling south -> east
//   2   travelling west  -> south     travelling north -> east
//   3   travelling east  -> south     travelling north -> west
//
// A pillar with no mirror lets the beam straight through. That is the whole rule.
//
// AND IT GOES UP AND DOWN. A mirror tilted on its side takes a beam travelling along a corridor and
// sends it through the ceiling, or through the floor, and the cache is explicit about it: there are
// 43 mourning_light_temple_<floor>_<room>_up varbits, three bits each, one per pillar, and the ten
// mourning_pillar_light_cross_* tiles are 28-state enums whose children include a VERTICAL beam in
// each of the seven colours. Three floors of sixteen rooms is one puzzle, not three.
^mt_dir_north = 1
^mt_dir_east = 2
^mt_dir_south = 3
^mt_dir_west = 4
^mt_dir_up = 5
^mt_dir_down = 6

^mt_pillar_shaft_top = 29      // floor 3 pillar a, the shaft head at (25,31)
^mt_pillar_shaft_bottom = 6    // floor 1 pillar b, the same tile two floors down
^mt_pillar_entry = 35          // floor 3 pillar 16, where the light comes in
^mt_entry_dir = 3              // travelling south

^mt_trace_steps = 24

// ---------------------------------------------------------------------------- the colours
// THE LIGHT HAS A COLOUR AND EVERY VARBIT IN THE TEMPLE IS THREE BITS WIDE. 35 corridor segments,
// 27 room-to-room segments, 43 vertical beams and 10 crossings, all three bits, and every beam loc
// and every pillar is a multiloc on one of them with the same seven children:
//
//   1 red   2 yellow   3 green   4 cyan   5 blue   6 magenta   7 white
//
// That is the cache's own numbering, and it is a colour wheel with white in the middle. The first
// version of this file had one colour - ^mt_colour_white - and the generated graph wrote the
// literal 1 into every segment it lit, so the temple drew red corridors and white pillars and no
// crystal could change either.
^mt_colour_dark = 0
^mt_colour_red = 1
^mt_colour_yellow = 2
^mt_colour_green = 3
^mt_colour_cyan = 4
^mt_colour_blue = 5
^mt_colour_magenta = 6
^mt_colour_white = 7

// A CRYSTAL IS A FILTER, NOT A LAMP. It passes the components it is made of and stops the rest, so
// white through yellow is yellow; cyan and then yellow is green, which is what the walkthrough
// reports at the second chest; yellow and then magenta is red, which is what it reports at the
// fourth. Red through cyan is nothing at all and the beam stops there.
//
// The arithmetic is done on a three-bit mask and converted back to the numbering above to be
// drawn. Note what the masks say about the doors: magenta is red and blue together, and no filter
// can add a component back, so magenta light cannot be made from the crystals this temple holds -
// which is why the three magenta doors (floor 1 room 16 west, floor 2 room 4 west and south) are
// shut for good, and why the walkthrough's route never goes through one.
^mt_mask_red = 1
^mt_mask_green = 2
^mt_mask_blue = 4
^mt_mask_all = 7

// ---------------------------------------------------------------------------- the sockets
// One socket per pillar, FIVE bits each:
//
//    0       empty
//    1-4     a hand mirror lying flat, in one of its four rotations
//    5-9     a crystal: red, yellow, green, cyan, blue
//    10-17   a hand mirror tilted: ^mt_socket_tilt + (direction - 1) * 2, + 1 for down
//    18-19   spare, for the two fractured crystals
//
// A FLAT MIRROR TAKES THE BEAM ROUND A CORNER; A TILTED ONE TAKES IT THROUGH THE CEILING. Tilted
// states are a pair (direction, up or down) and mean "the beam travelling that way goes up (or
// down)" - which is how the walkthrough says it: "point Mirror #5 so the western light points down".
// Each state carries two transitions, because a mirror is reversible: tilt(north, up) sends a beam
// travelling north upwards, and a beam coming down southwards.
//
// Thirty-five pillars at five bits is 175 bits, which is six lots of six (36 slots, one spare) -
// six rather than seven so that no socket ever straddles a varp's sign bit. The first two blocks
// are the cache's own mourning_temple_mirrors_a and _b, which are perm-scoped varps that exist for
// nothing else; the other four are in configs/quest_mourning2.varp.
^mt_socket_empty = 0
^mt_socket_mirror = 1          // ^mt_socket_mirror + rotation, rotations 0-3
^mt_socket_crystal = 5         // ^mt_socket_crystal + colour - 1, colours 1-5 (red to blue)
^mt_socket_tilt = 10           // ^mt_socket_tilt + (dir - 1) * 2, and + 1 for down
^mt_sockets_per_varp = 6
^mt_socket_bits = 5
^mt_pillars = 35

// What a chest pays out. The walkthrough has five chests giving two mirrors each (the last gives
// three) plus the crystals, and the cache has exactly five: mourning_temple_light_parts_2..6.
// WHICH cache chest is which chest in the walkthrough is not settled yet - that needs the puzzle
// solved from the inside, which is the next stage of this rebuild - so the crystals are spread one
// per chest here, with the yellow one in the chest nearest the way in.
^mt_chest_mirrors = 2

// What the temple was left with, waiting in the collector by the lever: four mirrors and the
// orange crystal, which is the yellow one - the tray has a bit for red, blue and orange and the
// walkthrough collects exactly this before it opens a chest.
^mt_tray_start_mirrors = 4

// WHICH COLOUR OPENS WHICH CHEST, measured off the collision map (tools/sim/templerooms.ts): every
// chest is in a sealed room and the door on its edge says what it costs.
//
//   floor 1 room 16   mourning_temple_light_parts_6   yellow
//   floor 1 room 1    mourning_temple_light_parts_5   yellow
//   floor 1 room 13   mourning_temple_light_parts_4   cyan
//   floor 2 room 16   mourning_temple_light_parts_2   blue
//   floor 2 room 4    mourning_temple_light_parts_3   magenta
//
// So the chests are a chain - yellow lets you reach the cyan crystal, cyan the blue, blue the red -
// and the magenta one is behind a colour no crystal in the building can make on its own. Two beams
// meeting at one of the ten mourning_pillar_light_cross_* pillars is the only thing left that could
// make it, and that is the next stage of this rebuild.

// ---------------------------------------------------------------------------- places
^mt_tunnel_outside = 0_36_153_7_1       // in front of the tunnel mouth (7,0 is the tunnel loc)
// IN THE CORRIDORS, NOT IN A ROOM. The old arrival tile was 0_29_72_5_5, inside floor 1 room 13 -
// which is sealed by two cyan doors, so with the doors locked to a colour the player arrived in a
// box they could not leave and the cyan crystal was on the far side of it. The corridor network on
// the bottom floor is one region of 2,791 tiles and it runs east into the cave the quest walks in
// through (mapsquare 30,72, where the five searchable corpses are), so this tile is both reachable
// and the right side of every door.
// (60,31) is three tiles inside the east doorway, which is the one place the corridor network
// touches the square's east edge - the cave crosses the boundary at z=29 to 33 - so it is also
// where a player walking in from the corpses arrives.
^mt_temple_entry = 0_29_72_60_31
^mt_final_pillar = 0_29_72_13_31
^mt_wall_hole = 0_29_72_0_30
^mt_collector = 1_29_72_58_31
^mt_lever = 1_29_72_57_31

// Stages. mourning_quest_main is eight bits, so there is room to spare, and the new ones went into
// the gaps rather than renumbering - anybody halfway through keeps their place.
^mt_not_started = 0
^mt_arianwyn = 10       // Arianwyn has explained what is under the temple
^mt_inside = 20         // through the tunnel
^mt_journal = 24        // Edern's journal, off a corpse in the cave
^mt_sample = 26         // a sliver of the black crystal, taken with a chisel
^mt_mirrors = 30        // the chests opened
^mt_enchanted = 34      // Arianwyn has made the sliver into a crystal of his own
^mt_lit = 40            // light out of the hole in the wall
^mt_thorgel = 42        // Thorgel's list
^mt_items = 44          // all twenty-one of them, and a death talisman for them
^mt_charged = 46        // the crystal charged at the Death Altar
^mt_repowered = 48      // and put back into the black crystal on the top floor
^mt_complete = 50

// ---------------------------------------------------------------------------- Thorgel's list
// Twenty-one items, which is the 2006 list: one one-bit varbit each on mourning_part2_basevar2,
// bits 0 to 20, and the order of the switches in scripts/mourning2_altar.rs2 is the bit order.
// mourning_dwarf_startedtask is two bits wide, which is three states and one spare.
^mt_dwarf_items = 21
^mt_dwarf_none = 0
^mt_dwarf_list = 1
^mt_dwarf_paid = 2

^mt_off = 0
^mt_on = 1
