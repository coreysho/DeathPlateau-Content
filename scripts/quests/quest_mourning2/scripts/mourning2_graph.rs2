    case 7 : %mourning_light_temple_1_10_up = $colour;
    case 8 : %mourning_light_temple_1_11_up = $colour;
    case 9 : %mourning_light_temple_1_12_up = $colour;
    case 10 : %mourning_light_temple_1_13_up = $colour;
    case 11 : %mourning_light_temple_1_14_up = $colour;
    case 12 : %mourning_light_temple_1_16_up = $colour;
