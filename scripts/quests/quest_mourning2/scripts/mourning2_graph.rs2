    case 19 : %mourning_light_temple_2_10_up = $colour;
    case 20 : %mourning_light_temple_2_11_up = $colour;
    case 21 : %mourning_light_temple_2_15_up = $colour;
    case 22 : %mourning_light_temple_2_16_up = $colour;
    case 23 : %mourning_light_temple_3_1_up = $colour;
    case 24 : %mourning_light_temple_3_2_up = $colour;
    case 25 : %mourning_light_temple_3_3_up = $colour;
