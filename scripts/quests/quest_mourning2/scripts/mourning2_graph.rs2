}

[proc,m2_pillars_dark]()()
%mourning_light_temple_1_1_up = 0;
%mourning_light_temple_1_10_up = 0;
%mourning_light_temple_1_11_up = 0;
%mourning_light_temple_1_12_up = 0;
%mourning_light_temple_1_13_up = 0;
%mourning_light_temple_1_14_up = 0;
%mourning_light_temple_1_15_up = 0;
%mourning_light_temple_1_16_up = 0;
%mourning_light_temple_1_2_up = 0;
%mourning_light_temple_1_3_up = 0;
%mourning_light_temple_1_5_up = 0;
%mourning_light_temple_1_6_up = 0;
%mourning_light_temple_1_7_up = 0;
%mourning_light_temple_2_1_up = 0;
%mourning_light_temple_2_10_up = 0;
%mourning_light_temple_2_11_up = 0;
%mourning_light_temple_2_12_up = 0;
%mourning_light_temple_2_13_up = 0;
%mourning_light_temple_2_14_up = 0;
%mourning_light_temple_2_15_up = 0;
%mourning_light_temple_2_16_up = 0;
%mourning_light_temple_2_2_up = 0;
%mourning_light_temple_2_3_up = 0;
%mourning_light_temple_2_5_up = 0;
%mourning_light_temple_2_6_up = 0;
%mourning_light_temple_2_7_up = 0;
%mourning_light_temple_2_8_up = 0;
%mourning_light_temple_2_9_up = 0;
%mourning_light_temple_3_1_up = 0;
%mourning_light_temple_3_10_up = 0;
%mourning_light_temple_3_11_up = 0;
%mourning_light_temple_3_12_up = 0;
%mourning_light_temple_3_13_up = 0;
%mourning_light_temple_3_14_up = 0;
%mourning_light_temple_3_15_up = 0;
%mourning_light_temple_3_16_up = 0;
%mourning_light_temple_3_2_up = 0;
%mourning_light_temple_3_3_up = 0;
%mourning_light_temple_3_5_up = 0;
%mourning_light_temple_3_6_up = 0;
%mourning_light_temple_3_7_up = 0;
%mourning_light_temple_3_8_up = 0;
%mourning_light_temple_3_9_up = 0;

// Each crossing tile gets its own proc, because a varbit cannot be passed to one. $axis
// is 0 for a north-south beam, 7 for east-west, 14 for a vertical one; a beam arriving
// at a tile that already holds a beam on ANOTHER axis makes it a crossed beam, and the
// colour it is drawn in is the two colours added - which is the only way anything in
// this temple can be magenta.

[proc,m2_cross_1_15](int $axis, int $colour)(int)
def_int $now = %mourning_pillar_light_cross_1_15;
if ($now = ^mt_colour_dark) {
    %mourning_pillar_light_cross_1_15 = add($axis, $colour);
    return($colour);
}
if ($now > $axis & $now <= add($axis, ^mt_colour_white)) {
    // the same axis again: the two together are what shows
    def_int $both = ~mt_colour_add(sub($now, $axis), $colour);
    %mourning_pillar_light_cross_1_15 = add($axis, $both);
    return($both);
}
// TWO BEAMS CROSSING, and they add - which is the only way to magenta.
def_int $sum = ~mt_colour_add(~mt_cross_colour($now), $colour);
%mourning_pillar_light_cross_1_15 = add(^mt_cross_both, $sum);
return($sum);

