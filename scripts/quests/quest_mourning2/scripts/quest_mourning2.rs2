// Mourning's End Part II - a temple built round a beam of light, and one hole in one wall that the
// light has to come out of.
//
// THE LIGHT HAS A COLOUR. Every light varbit in this building is three bits wide and every beam loc
// and pillar is a multiloc on one of them with the same seven children - red, yellow, green, cyan,
// blue, magenta, white - and the fourteen doorways are two-state multilocs that show, when shut,
// the colour that opens them. So the temple is a colour puzzle, and the crystals are filters: a
// crystal passes the components it is made of and stops the rest. See configs/quest_mourning2.constant
// for the whole model, and scripts/mourning2_doors.rs2 (generated) for which door reads which beam.

// =========================================================================== the sockets
// Five bits per pillar: 0 empty, 1-4 a mirror lying flat in one of its rotations, 5-9 a crystal,
// 10-17 a mirror tilted to send a beam up or down. Six pillars to a varp, the first two blocks
// being the cache's own mourning_temple_mirrors_a and _b.
[proc,mt_socket_read](int $pillar)(int)
def_int $i = sub($pillar, 1);
def_int $lo = multiply(modulo($i, ^mt_sockets_per_varp), ^mt_socket_bits);
def_int $hi = add($lo, sub(^mt_socket_bits, 1));
switch_int (divide($i, ^mt_sockets_per_varp)) {
    case 0 : return(getbit_range(%mourning_temple_mirrors_a, $lo, $hi));
    case 1 : return(getbit_range(%mourning_temple_mirrors_b, $lo, $hi));
    case 2 : return(getbit_range(%mourning_temple_sockets_c, $lo, $hi));
    case 3 : return(getbit_range(%mourning_temple_sockets_d, $lo, $hi));
    case 4 : return(getbit_range(%mourning_temple_sockets_e, $lo, $hi));
    case 5 : return(getbit_range(%mourning_temple_sockets_f, $lo, $hi));
}
return(^mt_socket_empty);

[proc,mt_socket_write](int $pillar, int $value)()
def_int $i = sub($pillar, 1);
def_int $lo = multiply(modulo($i, ^mt_sockets_per_varp), ^mt_socket_bits);
def_int $hi = add($lo, sub(^mt_socket_bits, 1));
switch_int (divide($i, ^mt_sockets_per_varp)) {
    case 0 : %mourning_temple_mirrors_a = setbit_range_toint(%mourning_temple_mirrors_a, $value, $lo, $hi);
    case 1 : %mourning_temple_mirrors_b = setbit_range_toint(%mourning_temple_mirrors_b, $value, $lo, $hi);
    case 2 : %mourning_temple_sockets_c = setbit_range_toint(%mourning_temple_sockets_c, $value, $lo, $hi);
    case 3 : %mourning_temple_sockets_d = setbit_range_toint(%mourning_temple_sockets_d, $value, $lo, $hi);
    case 4 : %mourning_temple_sockets_e = setbit_range_toint(%mourning_temple_sockets_e, $value, $lo, $hi);
    case 5 : %mourning_temple_sockets_f = setbit_range_toint(%mourning_temple_sockets_f, $value, $lo, $hi);
}

// The socket's value if there is a MIRROR in it, flat or tilted, and 0 if there is not. (It used to
// return the rotation plus one, which could not describe a tilted mirror at all.)
[proc,mt_mirror_at](int $pillar)(int)
def_int $v = ~mt_socket_read($pillar);
if ($v >= ^mt_socket_mirror & $v < ^mt_socket_crystal) {
    return($v);
}
if ($v >= ^mt_socket_tilt) {
    return($v);
}
return(0);

// The rotation of a FLAT mirror, 0 to 3, or -1 for anything else.
[proc,mt_mirror_flat](int $pillar)(int)
def_int $v = ~mt_socket_read($pillar);
if ($v >= ^mt_socket_mirror & $v < ^mt_socket_crystal) {
    return(sub($v, ^mt_socket_mirror));
}
return(-1);

// The colour of the crystal in this socket, or dark for "no crystal".
[proc,mt_crystal_at](int $pillar)(int)
def_int $v = ~mt_socket_read($pillar);
if ($v >= ^mt_socket_crystal & $v < ^mt_socket_tilt) {
    return(add(sub($v, ^mt_socket_crystal), 1));
}
return(^mt_colour_dark);

[proc,mt_opposite](int $dir)(int)
switch_int ($dir) {
    case ^mt_dir_north : return(^mt_dir_south);
    case ^mt_dir_south : return(^mt_dir_north);
    case ^mt_dir_east : return(^mt_dir_west);
    case ^mt_dir_west : return(^mt_dir_east);
    case ^mt_dir_up : return(^mt_dir_down);
    case ^mt_dir_down : return(^mt_dir_up);
}
return(0);

// WHAT A MIRROR DOES TO A BEAM, and it is silvered on one face, so each setting turns exactly one
// corner - two transitions, one each way along it, and every other direction hits the back and
// stops. A flat mirror turns a corridor into the corridor beside it. A tilted one turns a corridor
// into the shaft above or below it, which is the whole of the third dimension.
[proc,mt_mirror_turn](int $socket, int $dir)(int)
if ($socket >= ^mt_socket_tilt) {
    def_int $i = sub($socket, ^mt_socket_tilt);
    def_int $lift = add(divide($i, 2), 1);
    def_int $vert = ^mt_dir_up;
    if (modulo($i, 2) = 1) {
        $vert = ^mt_dir_down;
    }
    if ($dir = $lift) {
        return($vert);
    }
    if ($dir = ~mt_opposite($vert)) {
        return(~mt_opposite($lift));
    }
    return(0);
}
switch_int (sub($socket, ^mt_socket_mirror)) {
    case 0 :
        if ($dir = ^mt_dir_east) { return(^mt_dir_north); }
        if ($dir = ^mt_dir_south) { return(^mt_dir_west); }
    case 1 :
        if ($dir = ^mt_dir_west) { return(^mt_dir_north); }
        if ($dir = ^mt_dir_south) { return(^mt_dir_east); }
    case 2 :
        if ($dir = ^mt_dir_west) { return(^mt_dir_south); }
        if ($dir = ^mt_dir_north) { return(^mt_dir_east); }
    case 3 :
        if ($dir = ^mt_dir_east) { return(^mt_dir_south); }
        if ($dir = ^mt_dir_north) { return(^mt_dir_west); }
}
return(0);

[proc,mt_dir_name](int $dir)(string)
switch_int ($dir) {
    case ^mt_dir_north : return("north");
    case ^mt_dir_east : return("east");
    case ^mt_dir_south : return("south");
    case ^mt_dir_west : return("west");
    case ^mt_dir_up : return("up");
    case ^mt_dir_down : return("down");
}
return("nowhere");

// How a socket reads out loud, for Search and for the collector.
[proc,mt_socket_name](int $pillar)(string)
def_int $v = ~mt_socket_read($pillar);
if ($v = ^mt_socket_empty) {
    return("an empty socket");
}
if ($v >= ^mt_socket_tilt) {
    def_int $i = sub($v, ^mt_socket_tilt);
    def_string $way = "up";
    if (modulo($i, 2) = 1) {
        $way = "down";
    }
    return(append(append("a mirror tilted to send the light travelling ",
        ~mt_dir_name(add(divide($i, 2), 1))), append(" ", $way)));
}
if ($v >= ^mt_socket_fractured) {
    def_int $fw = 0;
    def_int $fd = 0;
    $fw, $fd = ~mt_fractured_at($pillar);
    return(append("a fractured crystal, its clear edge to the ", ~mt_dir_name($fd)));
}
if ($v >= ^mt_socket_crystal) {
    return(append(append("a ", ~mt_colour_name(~mt_crystal_at($pillar))), " crystal"));
}
return("a mirror lying flat");

// =========================================================================== the colours
// The cache's numbering is a colour wheel; the arithmetic is done on a three-bit mask.
[proc,mt_colour_mask](int $colour)(int)
switch_int ($colour) {
    case ^mt_colour_red : return(^mt_mask_red);
    case ^mt_colour_yellow : return(add(^mt_mask_red, ^mt_mask_green));
    case ^mt_colour_green : return(^mt_mask_green);
    case ^mt_colour_cyan : return(add(^mt_mask_green, ^mt_mask_blue));
    case ^mt_colour_blue : return(^mt_mask_blue);
    case ^mt_colour_magenta : return(add(^mt_mask_red, ^mt_mask_blue));
    case ^mt_colour_white : return(^mt_mask_all);
}
return(0);

[proc,mt_mask_colour](int $mask)(int)
switch_int ($mask) {
    case 1 : return(^mt_colour_red);
    case 2 : return(^mt_colour_green);
    case 3 : return(^mt_colour_yellow);
    case 4 : return(^mt_colour_blue);
    case 5 : return(^mt_colour_magenta);
    case 6 : return(^mt_colour_cyan);
    case 7 : return(^mt_colour_white);
}
return(^mt_colour_dark);

// White through yellow is yellow. Cyan and then yellow is green. Red through cyan is nothing.
[proc,mt_filter](int $colour, int $crystal)(int)
return(~mt_mask_colour(and(~mt_colour_mask($colour), ~mt_colour_mask($crystal))));

[proc,mt_colour_name](int $colour)(string)
switch_int ($colour) {
    case ^mt_colour_red : return("red");
    case ^mt_colour_yellow : return("yellow");
    case ^mt_colour_green : return("green");
    case ^mt_colour_cyan : return("cyan");
    case ^mt_colour_blue : return("blue");
    case ^mt_colour_magenta : return("magenta");
    case ^mt_colour_white : return("white");
}
return("dark");

[proc,mt_crystal_colour](obj $crystal)(int)
if ($crystal = mourning_crystal_red) { return(^mt_colour_red); }
if ($crystal = mourning_crystal_yellow) { return(^mt_colour_yellow); }
if ($crystal = mourning_crystal_green) { return(^mt_colour_green); }
if ($crystal = mourning_crystal_cyan) { return(^mt_colour_cyan); }
if ($crystal = mourning_crystal_blue) { return(^mt_colour_blue); }
return(^mt_colour_dark);

[proc,mt_crystal_obj](int $colour)(namedobj)
switch_int ($colour) {
    case ^mt_colour_red : return(mourning_crystal_red);
    case ^mt_colour_yellow : return(mourning_crystal_yellow);
    case ^mt_colour_green : return(mourning_crystal_green);
    case ^mt_colour_cyan : return(mourning_crystal_cyan);
    case ^mt_colour_blue : return(mourning_crystal_blue);
}
return(null);

// =========================================================================== mixing and crossings
// Two beams that cross ADD, which is the one place in this temple where a colour gets brighter
// rather than dimmer: red and blue cross and the tile is magenta, and the beams carry magenta out
// of it. Everything else here is a filter and can only take components away.
[proc,mt_colour_add](int $a, int $b)(int)
return(~mt_mask_colour(or(~mt_colour_mask($a), ~mt_colour_mask($b))));

// The colour out of one of the ten 28-state crossing varbits, whichever block it is in.
[proc,mt_cross_colour](int $state)(int)
if ($state > ^mt_cross_both) {
    return(sub($state, ^mt_cross_both));
}
if ($state > ^mt_cross_vert) {
    return(sub($state, ^mt_cross_vert));
}
if ($state > ^mt_cross_ew) {
    return(sub($state, ^mt_cross_ew));
}
return($state);

// =========================================================================== fractured crystals
// Which fractured crystal is in this socket (1 or 2), and which way its clear edge points.
[proc,mt_fractured_at](int $pillar)(int, int)
def_int $v = ~mt_socket_read($pillar);
if ($v < ^mt_socket_fractured) {
    return(0, 0);
}
def_int $i = sub($v, ^mt_socket_fractured);
return(add(divide($i, ^mt_fractured_dirs), 1), add(modulo($i, ^mt_fractured_dirs), 1));

[proc,mt_fractured_obj](int $which)(namedobj)
if ($which = 1) {
    return(mourning_fractured_crystal_1);
}
if ($which = 2) {
    return(mourning_fractured_crystal_2);
}
return(null);

[proc,mt_fractured_which](obj $obj)(int)
if ($obj = mourning_fractured_crystal_1) {
    return(1);
}
if ($obj = mourning_fractured_crystal_2) {
    return(2);
}
return(0);

// =========================================================================== the trace
// Clear everything, then walk the beam from the entry until it stops, leaves the temple, or gets
// out of the hole in the west wall. Every segment, pillar and crossing it touches is lit in the
// colour it is carrying at that point, and those varbits are transmitted, so the client draws
// exactly the path - and the colour - the server walked.
//
// THE WALK IS IN THREE DIMENSIONS and there can be MORE THAN ONE BEAM. Up and down are directions
// 5 and 6 and the graph has edges for them; a fractured crystal splits a beam in two. ~mt_walk
// takes one beam to its end and hands back the one split it met on the way, so the trace is four
// walks in a chain - the beam that comes in, and up to three split off it - which is one more than
// two fractured crystals can produce.
//
// IT RUNS THE WHOLE CHAIN TWICE, and nothing is cleared in between, because a beam can only see the
// crossings the beams before it made. The writes are idempotent - a segment is assigned and a
// crossing is OR-ed - so the second pass is what lets the first beam carry a crossed colour it
// could not have known about on the way through.
[proc,mt_walk](int $p, int $d, int $c)(int, int, int, boolean)
def_int $steps = 0;
def_int $split_p = 0;
def_int $split_d = 0;
def_int $split_c = 0;
~m2_pillar_up($p, $c);
while ($steps < ^mt_trace_steps) {
    $steps = add($steps, 1);
    def_int $crystal = ~mt_crystal_at($p);
    if ($crystal > ^mt_colour_dark) {
        $c = ~mt_filter($c, $crystal);
        ~m2_pillar_up($p, $c);
        if ($c = ^mt_colour_dark) {
            // a crystal can take the last component out of a beam: red light into a cyan crystal
            return($split_p, $split_d, $split_c, false);
        }
    } else {
        def_int $which = 0;
        def_int $edge = 0;
        $which, $edge = ~mt_fractured_at($p);
        if ($which > 0) {
            // THE SPLIT. The beam carries straight on and a copy of it leaves along the clear
            // edge. Only the first split of a walk is handed back; a walk that meets two
            // fractured crystals loses the second, which two crystals cannot arrange.
            if ($split_p = 0 & $edge ! $d & $edge ! ~mt_opposite($d)) {
                $split_p = $p;
                $split_d = $edge;
                $split_c = $c;
            }
        } else {
            def_int $mirror = ~mt_mirror_at($p);
            if ($mirror > 0) {
                $d = ~mt_mirror_turn($mirror, $d);
                if ($d = 0) {
                    // the back of the mirror
                    return($split_p, $split_d, $split_c, false);
                }
            }
        }
    }
    def_int $next = 0;
    def_int $carry = 0;
    $next, $carry = ~m2_edge($p, $d, $c);
    $c = $carry;
    if ($next = 0) {
        // out of the temple; out of the west wall on the bottom floor is the one that counts
        if ($p = ^mt_pillar_shaft_bottom & $d = ^mt_dir_west) {
            return($split_p, $split_d, $split_c, true);
        }
        return($split_p, $split_d, $split_c, false);
    }
    $p = $next;
    ~m2_pillar_up($p, $c);
}
return($split_p, $split_d, $split_c, false);

[proc,mt_trace]()(boolean)
~m2_dark;
~m2_pillars_dark;
def_boolean $out = false;
def_int $pass = 0;
while ($pass < 2) {
    $pass = add($pass, 1);
    def_int $p1 = 0;
    def_int $d1 = 0;
    def_int $c1 = 0;
    def_boolean $hit = false;
    $p1, $d1, $c1, $hit = ~mt_walk(^mt_pillar_entry, ^mt_entry_dir, ^mt_colour_white);
    if ($hit = true) {
        $out = true;
    }
    if ($p1 > 0) {
        def_int $p2 = 0;
        def_int $d2 = 0;
        def_int $c2 = 0;
        $p2, $d2, $c2, $hit = ~mt_walk($p1, $d1, $c1);
        if ($hit = true) {
            $out = true;
        }
        if ($p2 > 0) {
            def_int $p3 = 0;
            def_int $d3 = 0;
            def_int $c3 = 0;
            $p3, $d3, $c3, $hit = ~mt_walk($p2, $d2, $c2);
            if ($hit = true) {
                $out = true;
            }
            if ($p3 > 0) {
                def_int $p4 = 0;
                def_int $d4 = 0;
                def_int $c4 = 0;
                $p4, $d4, $c4, $hit = ~mt_walk($p3, $d3, $c3);
                if ($hit = true) {
                    $out = true;
                }
            }
        }
    }
}
return($out);

// THE DOORS ARE PART OF THE LIGHT and have to be recomputed every time it moves, so nothing may
// call ~mt_trace on its own: a door left open after the beam that opened it has gone is a hole in
// the puzzle, and a door left shut under a beam of the right colour is a player stuck in a room.
//
// NOTICING THAT THE QUEST IS DONE belongs here too, for the same reason. A first version left that
// to a separate ~mt_retrace which the mirror and crystal handlers did not call, so the light went
// out through the hole in the wall and the quest did not react.
[proc,mt_relight]()(boolean)
def_boolean $out = ~mt_trace;
~m2_doors;
if ($out = false) {
    return(false);
}
if (%mourning_quest_main < ^mt_inside | %mourning_quest_main >= ^mt_lit) {
    return(true);
}
// THE LIGHT IS NOT THE END OF THE QUEST, and used to be. What it opens is the black door at the
// west end of the bottom floor, and behind that is the Death Altar, Thorgel and the crystal that
// has to go back into the one on the top floor - see scripts/mourning2_altar.rs2.
%mourning_quest_main = ^mt_lit;
~send_quest_progress(questlist:mourning2, %mourning_quest_main, ^mt_complete);
stat_advance(agility, 20000);
~mesbox("The beam goes down the shaft, across the bottom floor and out through the hole in the west wall, and something on the other side of that wall starts to make a noise it has not made in a very long time.");
return(true);

// =========================================================================== Arianwyn
[proc,mt_arianwyn]()(boolean)
if (%mourning_quest_main = ^mt_not_started) {
    if (%mourning_quest < ^mourning_complete) {
        return(false);
    }
    ~chatnpc("<p,neutral>You went into Prifddinas' death altar dressed as a mourner and came out with a list. I have read the list.");
    ~chatplayer("<p,quiz>And?");
    ~chatnpc("<p,sad>It is not a list of the dead. It is a list of what they are being used for, and the answer is a temple under the Isafdar that my people sealed six hundred years ago and have not spoken about since.");
    ~chatnpc("<p,neutral>It is built round a beam of light. There is a hole in the west wall of the bottom floor and the light is supposed to come out of it, and it has not for six centuries.");
    %mourning_quest_main = ^mt_arianwyn;
    %mourning_light_door_1_c_first_time = ^mt_on;
    ~send_quest_progress(questlist:mourning2, %mourning_quest_main, ^mt_complete);
    ~chatnpc("<p,neutral>The way in is the mourners' own dig - through their door, west along the cave, and in at the east wall. Take a chisel. There is a black crystal at the top of that temple and I want a piece of it.");
    ~chatnpc("<p,neutral>Open the chests in there while you are about it: mirrors, and crystals, and the crystals are the half of it nobody remembers. A door of light shows you the colour that opens it.");
    return(true);
}
if (%mourning_quest_main >= ^mt_complete) {
    ~chatnpc("<p,happy>Six hundred years, and it was three mirrors and somebody prepared to count corners.");
    return(true);
}
// THE SLIVER OF THE BLACK CRYSTAL. He is the only elf left who can make anything of it, and the
// cache's three objs are the three states: the sample, his crystal, and his crystal charged.
if (inv_total(inv, mourning_crystal_sample) > 0) {
    // a proc, not a label: mt_arianwyn is itself a proc and a proc cannot jump
    ~mt_enchant;
    return(true);
}
if (%mourning_quest_main = ^mt_repowered) {
    ~mt_finish;
    return(true);
}
if (%mourning_quest_main = ^mt_charged) {
    ~chatnpc("<p,neutral>Then put it back where it came from. The crystal on the top floor is the one that has to hold it.");
    return(true);
}
if (%mourning_quest_main >= ^mt_enchanted) {
    ~chatnpc("<p,neutral>The crystal in your hand is unfinished. It wants an altar, and the only one left down there is behind the light.");
    return(true);
}
if (%mourning_quest_main >= ^mt_lit) {
    ~chatnpc("<p,happy>The light is out of the wall. Now find me a piece of that black crystal - there is a chisel's worth of it loose at the top of the temple.");
    return(true);
}
// The tunnel into the temple (cavewalltunnel_to_temple) is a multiloc on this bit and is a blank
// cave wall without it. Nothing used to set it, so the temple could not be entered.
%mourning_light_door_1_c_first_time = ^mt_on;
~chatnpc("<p,neutral>The light has to come out of the west wall. Everything else in that building is a way of arranging that.");
return(true);

[proc,mt_enchant]()()
~chatplayer("<p,neutral>A piece of the black crystal.");
~chatnpc("<p,shock>You took a CHISEL to it.");
~chatplayer("<p,neutral>You asked me to.");
~chatnpc("<p,neutral>...I did. Give it here.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>And make room, because you are getting it back.");
    return;
}
if_close;
mes("Arianwyn turns the sliver over for a long time without saying anything.");
p_delay(4);
inv_del(inv, mourning_crystal_sample, 1);
inv_add(inv, mourning_crystal_new_sample, 1);
if (%mourning_quest_main < ^mt_enchanted) {
    %mourning_quest_main = ^mt_enchanted;
    ~send_quest_progress(questlist:mourning2, %mourning_quest_main, ^mt_complete);
}
~objbox(mourning_crystal_new_sample, "He sings over it for a while, in the way the elves of Lletya sing over crystal, and what he hands back is a new crystal with the old one inside it.", 250, 0, divide(^objbox_height, 2));
~chatnpc("<p,neutral>It is empty. It wants charging, and there is an altar of the dead under that temple that my people did not build and could not move.");
~chatnpc("<p,neutral>When it is full, put it back in the crystal it came out of.");

[proc,mt_finish]()()
~chatplayer("<p,neutral>The crystal at the top of the temple is lit.");
~chatnpc("<p,shock>...lit.");
if_close;
mes("Arianwyn asks you to describe the route three times and writes it down twice.");
p_delay(5);
~mesbox("\"Six hundred years,\" he says. \"We sealed it because nobody could make it work, and we told ourselves we had sealed it for a reason, and those are not the same thing.\"");
p_delay(3);
%mourning_quest_main = ^mt_complete;
// THE REWARD IS ONE SKILL AND IT IS SIXTY THOUSAND. This used to award 6,000 Agility, 6,000
// Thieving and 6,000 Mining - a tenth of the one reward the quest actually gives, spread over two
// skills it does not touch. 60,000 Agility XP, and the crystal trinket, which is the item on the
// reward scroll and was never handed over: ~send_quest_complete only draws the obj, it does not
// add it (the same trap as Enakhra's camulet).
stat_advance(agility, 600000);
if (inv_freespace(inv) > 0) {
    inv_add(inv, mourning_crystal_trinket, 1);
} else {
    obj_add(coord, mourning_crystal_trinket, 1, ^lootdrop_duration);
}
session_log(^log_adventure, "Quest complete: Mourning's End Part II");
~send_quest_complete(questlist:mourning2, mourning_crystal_trinket, 200, ^mt_questpoints, "You have completed\\nMourning's End Part II!", "2 Quest Points|60,000 Agility XP|A crystal trinket|The light temple");

// =========================================================================== the way in
[proc,mt_tunnel]()(boolean)
p_arrivedelay;
if (%mourning_quest_main < ^mt_arianwyn) {
    ~mesbox("A tunnel mouth behind the excavation, and no reason yet to be in it.");
    return(true);
}
mes("You crawl through.");
p_delay(3);
p_teleport(^mt_temple_entry);
~mt_relight;
if (%mourning_quest_main = ^mt_arianwyn) {
    %mourning_quest_main = ^mt_inside;
    ~mt_tray_seed;
    ~send_quest_progress(questlist:mourning2, %mourning_quest_main, ^mt_complete);
    ~mesbox("Three floors of it, and every floor is one room in sixteen parts with a pillar at every junction and a dead beam of light lying along every corridor. | Somebody built this to be solved.");
}
return(true);

// Straight up from the foot of either wall ladder is the ladder top itself, which blocks - so each
// has its own landing, checked against the collision map (tools/sim/audit2.ts).
[oploc1,mourning_temple_ladder_wall]
p_arrivedelay;
mes("You climb up.");
switch_coord (loc_coord) {
    case 1_29_72_42_2 : p_teleport(2_29_72_42_4);
    case 1_29_72_42_60 : p_teleport(2_29_72_42_58);
    case default : p_teleport(movecoord(coord, 0, 1, 0));
}

[oploc1,mourning_temple_ladder_wall_top]
p_arrivedelay;
mes("You climb down.");
switch_coord (loc_coord) {
    case 2_29_72_42_2 : p_teleport(1_29_72_42_3);
    case 2_29_72_42_59 : p_teleport(1_29_72_42_59);
    case default : p_teleport(movecoord(coord, 0, -1, 0));
}

// The rope between the bottom two floors.
[oploc1,mourning_temple_way_ropemulti]
p_arrivedelay;
anim(human_reachforladder, 0);
p_delay(0);
p_teleport(1_29_72_20_13);

[oploc1,mourning_temple_way_down]
p_arrivedelay;
anim(human_pickupfloor, 0);
p_delay(0);
p_teleport(0_29_72_20_13);

[oploc1,mourning_temple_wall_jump]
p_arrivedelay;
mes("You climb over the broken wall.");
if (coordx(coord) < coordx(loc_coord)) {
    p_teleport(movecoord(loc_coord, 1, 0, 0));
} else {
    p_teleport(movecoord(loc_coord, -1, 0, 0));
}

// =========================================================================== the doors of light
// Fourteen doorways, each a shell on its own mourning_door_* varbit, and each one a two-state
// multiloc: shut it is a door of light in the colour that opens it, open it is white. The varbit is
// set by ~m2_doors (generated, from the map) every time the beam moves, so by the time a player
// clicks one the answer is already decided - this trigger only reports it and steps through.
// A door of light is a blocking tile in a doorway: angles 0 and 2 span east-west, so it is passed
// north-south; 1 and 3 the other way. Step to the tile on the far side of it.
[label,mt_door_pass](int $open, int $colour)
p_arrivedelay;
if ($open = ^mt_off) {
    if ($colour = ^mt_colour_dark) {
        ~mesbox("A doorway with no light in it at all, and nothing to walk through but the dark. Something has to be lit on the other side of this wall.");
        return;
    }
    ~mesbox("A door of pure light, and it is <~mt_colour_name($colour)>. It will let you through when the light standing in this doorway is <~mt_colour_name($colour)> too, and not before.");
    return;
}
def_coord $door = loc_coord;
if (loc_angle = 0 | loc_angle = 2) {
    if (coordz(coord) < coordz($door)) {
        p_teleport(movecoord($door, 0, 0, 1));
    } else {
        p_teleport(movecoord($door, 0, 0, -1));
    }
    return;
}
if (coordx(coord) < coordx($door)) {
    p_teleport(movecoord($door, 1, 0, 0));
} else {
    p_teleport(movecoord($door, -1, 0, 0));
}

// The hole in the west wall is where the light has to go, and it had no trigger either. It is also
// the way back out to the tunnels.
[oploc1,mourning_temple_light_wall_with_hole]
p_arrivedelay;
if (%mourning_quest_main < ^mt_lit) {
    ~mesbox("A hole in the wall, and on the far side of it the dark of the tunnels. The light is supposed to go through here. You can squeeze through it yourself.");
} else {
    mes("You squeeze out through the hole the light is pouring through.");
}
p_delay(1);
p_teleport(^mt_tunnel_outside);

// =========================================================================== the chests
// Five chests, named Closed chest and Open chest in the cache, one to a room across the three
// floors. The walkthrough has each of them paying out two mirrors, and three of them a crystal as
// well; which cache chest is which chest in the walkthrough is not settled until the puzzle is
// solved from the inside, so the crystals are spread one per chest with the yellow one in the chest
// nearest the way in.
[oploc1,mourning_temple_light_parts_2_closed] @mt_chest_open(2);
[oploc1,mourning_temple_light_parts_3_closed] @mt_chest_open(3);
[oploc1,mourning_temple_light_parts_4_closed] @mt_chest_open(4);
[oploc1,mourning_temple_light_parts_5_closed] @mt_chest_open(5);
[oploc1,mourning_temple_light_parts_6_closed] @mt_chest_open(6);

// The chests are plain locs, not multilocs, so setting the varbit alone left the closed one in
// place - Open again, never Search - and the fittings could not be had. Swap the loc as every
// other chest does.
[label,mt_chest_open](int $n)
p_arrivedelay;
mes("You open the chest.");
switch_int ($n) {
    case 2 : loc_change(mourning_temple_light_parts_2_open, 300);
    case 3 : loc_change(mourning_temple_light_parts_3_open, 300);
    case 4 : loc_change(mourning_temple_light_parts_4_open, 300);
    case 5 : loc_change(mourning_temple_light_parts_5_open, 300);
    case 6 : loc_change(mourning_temple_light_parts_6_open, 300);
}

// WHAT mourning_temple_parts_1..6 ARE FOR. Six bits for six chests, one each, and they are the
// player's own - which is what a shared world loc cannot record. They are not the lid: the lid is
// the loc swap above, which every chest in the game does the same way. They are whether this
// player has had the fittings out of that chest.
[proc,mt_chest_taken](int $n)(boolean)
switch_int ($n) {
    case 2 : if (%mourning_temple_parts_2 = ^mt_on) { return(true); }
    case 3 : if (%mourning_temple_parts_3 = ^mt_on) { return(true); }
    case 4 : if (%mourning_temple_parts_4 = ^mt_on) { return(true); }
    case 5 : if (%mourning_temple_parts_5 = ^mt_on) { return(true); }
    case 6 : if (%mourning_temple_parts_6 = ^mt_on) { return(true); }
}
return(false);

[proc,mt_chest_take](int $n)()
switch_int ($n) {
    case 2 : %mourning_temple_parts_2 = ^mt_on;
    case 3 : %mourning_temple_parts_3 = ^mt_on;
    case 4 : %mourning_temple_parts_4 = ^mt_on;
    case 5 : %mourning_temple_parts_5 = ^mt_on;
    case 6 : %mourning_temple_parts_6 = ^mt_on;
}

[oploc1,mourning_temple_light_parts_2_open] @mt_chest_search(2);
[oploc1,mourning_temple_light_parts_3_open] @mt_chest_search(3);
[oploc1,mourning_temple_light_parts_4_open] @mt_chest_search(4);
[oploc1,mourning_temple_light_parts_5_open] @mt_chest_search(5);
[oploc1,mourning_temple_light_parts_6_open] @mt_chest_search(6);

[label,mt_chest_search](int $n)
p_arrivedelay;
if (~mt_chest_taken($n) = true) {
    ~mesbox("Spare glass, spare brackets and a great deal of dust. The useful things are out of this one already.");
    return;
}
def_int $colour = ^mt_colour_dark;
// The chain the doors make: the tray's yellow crystal opens the two yellow rooms, one of which
// holds the cyan crystal; cyan opens room 13 and its blue crystal; blue opens floor 2 room 16 and
// its red one. The magenta room is behind a colour no single crystal can make.
switch_int ($n) {
    case 5 : $colour = ^mt_colour_cyan;
    case 4 : $colour = ^mt_colour_blue;
    case 2 : $colour = ^mt_colour_red;
}
// AND THE TWO FRACTURED CRYSTALS, which are what make a second beam and therefore magenta: one
// with the red crystal, since red and blue crossing is the only way to it, and the other in the
// room behind the magenta door itself.
def_namedobj $fractured = null;
switch_int ($n) {
    case 2 : $fractured = mourning_fractured_crystal_1;
    case 3 : $fractured = mourning_fractured_crystal_2;
}
def_namedobj $crystal = ~mt_crystal_obj($colour);
def_int $want = ^mt_chest_mirrors;
if ($crystal ! null) {
    $want = add($want, 1);
}
if ($fractured ! null) {
    $want = add($want, 1);
}
if (inv_total(inv, mourning_colour_wheel) = 0) {
    $want = add($want, 1);
}
if (inv_freespace(inv) < $want) {
    ~mesbox("There is more in this chest than you have room for.");
    return;
}
~mt_chest_take($n);
inv_add(inv, mourning_mirror, ^mt_chest_mirrors);
if (inv_total(inv, mourning_colour_wheel) = 0) {
    inv_add(inv, mourning_colour_wheel, 1);
}
if (%mourning_quest_main = ^mt_inside) {
    %mourning_quest_main = ^mt_mirrors;
    ~send_quest_progress(questlist:mourning2, %mourning_quest_main, ^mt_complete);
}
if ($fractured ! null) {
    inv_add(inv, $fractured, 1);
}
if ($crystal ! null) {
    inv_add(inv, $crystal, 1);
    ~objbox($crystal, "<tostring(^mt_chest_mirrors)> hand mirrors, and under them a crystal the colour of <~mt_colour_name($colour)> glass. Light that goes through it comes out that colour and no other.", 250, 0, divide(^objbox_height, 2));
    return;
}
if ($fractured ! null) {
    ~objbox($fractured, "<tostring(^mt_chest_mirrors)> hand mirrors, and under them a crystal with a crack all the way through it and one edge polished clear. A beam that goes into it comes out twice.", 250, 0, divide(^objbox_height, 2));
    return;
}
~mesbox("<tostring(^mt_chest_mirrors)> hand mirrors, in brackets, wrapped in cloth that has not been touched in six hundred years.");

[proc,mt_mirrors_placed]()(int)
def_int $p = 1;
def_int $n = 0;
while ($p <= ^mt_pillars) {
    if (~mt_mirror_at($p) > 0) {
        $n = add($n, 1);
    }
    $p = add($p, 1);
}
return($n);

[oploc2,mourning_temple_light_parts_2_open] @mt_chest_shut(2);
[oploc2,mourning_temple_light_parts_3_open] @mt_chest_shut(3);
[oploc2,mourning_temple_light_parts_4_open] @mt_chest_shut(4);
[oploc2,mourning_temple_light_parts_5_open] @mt_chest_shut(5);
[oploc2,mourning_temple_light_parts_6_open] @mt_chest_shut(6);

[label,mt_chest_shut](int $n)
p_arrivedelay;
switch_int ($n) {
    case 2 : %mourning_temple_parts_2 = ^mt_off; loc_change(mourning_temple_light_parts_2_closed, 300);
    case 3 : %mourning_temple_parts_3 = ^mt_off; loc_change(mourning_temple_light_parts_3_closed, 300);
    case 4 : %mourning_temple_parts_4 = ^mt_off; loc_change(mourning_temple_light_parts_4_closed, 300);
    case 5 : %mourning_temple_parts_5 = ^mt_off; loc_change(mourning_temple_light_parts_5_closed, 300);
    case 6 : %mourning_temple_parts_6 = ^mt_off; loc_change(mourning_temple_light_parts_6_closed, 300);
}
mes("You shut the chest.");

// =========================================================================== the pillar sockets
// The triggers are generated into mourning2_pillars.rs2, one pair per pillar; the logic is here.
[label,mt_use_on_pillar](int $pillar)
def_obj $used = last_useitem;
if ($used = mourning_mirror) {
    p_arrivedelay;
    @mt_place_mirror($pillar);
}
if (~mt_crystal_colour($used) > ^mt_colour_dark) {
    p_arrivedelay;
    @mt_place_crystal($pillar, ~mt_crystal_colour($used));
}
if (~mt_fractured_which($used) > 0) {
    p_arrivedelay;
    @mt_place_fractured($pillar, ~mt_fractured_which($used));
}
~displaymessage(^dm_default);

[label,mt_search_pillar](int $pillar)
p_arrivedelay;
if (%mourning_quest_main < ^mt_inside) {
    ~mesbox("An octagonal pillar with a socket at head height, and no reason yet to put anything in it.");
    return;
}
def_int $crystal = ~mt_crystal_at($pillar);
if ($crystal > ^mt_colour_dark) {
    if (inv_freespace(inv) = 0) {
        ~mesbox("A crystal the colour of <~mt_colour_name($crystal)> glass is set in the socket, and your hands are full.");
        return;
    }
    inv_add(inv, ~mt_crystal_obj($crystal), 1);
    ~mt_socket_write($pillar, ^mt_socket_empty);
    mes("You take the <~mt_colour_name($crystal)> crystal back out of the socket.");
    ~mt_relight;
    return;
}
def_int $fwhich = 0;
def_int $fdir = 0;
$fwhich, $fdir = ~mt_fractured_at($pillar);
if ($fwhich > 0) {
    if (inv_freespace(inv) = 0) {
        ~mesbox("A fractured crystal is set in the socket with its clear edge to the <~mt_dir_name($fdir)>, and your hands are full.");
        return;
    }
    inv_add(inv, ~mt_fractured_obj($fwhich), 1);
    ~mt_socket_write($pillar, ^mt_socket_empty);
    mes("You take the fractured crystal back out of the socket.");
    ~mt_relight;
    return;
}
if (~mt_mirror_at($pillar) > 0) {
    @mt_mirror_menu($pillar);
}
if (inv_total(inv, mourning_mirror) > 0) {
    @mt_place_mirror($pillar);
}
~mesbox("An octagonal pillar with an empty socket at head height. A small hand mirror would fit it, and so would one of the crystals.");

// WHAT YOU CAN DO WITH A MIRROR THAT IS ALREADY IN A SOCKET. Four flat rotations was a click each;
// tilting adds eight more settings, and clicking through twelve of them is not an interface. The
// cache has no mirror interface at all - the pillars carry Search and nothing else - so this is the
// chat options the engine has, which is how 2006 asked a question with more than two answers.
[label,mt_mirror_menu](int $pillar)
def_int $socket = ~mt_mirror_at($pillar);
~mesbox("In the socket at head height: <~mt_socket_name($pillar)>.");
switch_int (~p_choice4("Turn it a quarter turn.", 1, "Tilt it to send a beam up.", 2, "Tilt it to send a beam down.", 3, "Take it out.", 4)) {
    case 1 :
        def_int $rot = ~mt_mirror_flat($pillar);
        if ($rot < 0) {
            // it is tilted: a quarter turn lays it flat again
            ~mt_socket_write($pillar, ^mt_socket_mirror);
            mes("You lay the mirror flat again.");
            ~mt_relight;
            return;
        }
        ~mt_socket_write($pillar, add(^mt_socket_mirror, modulo(add($rot, 1), 4)));
        mes("You turn the mirror a quarter turn.");
        ~mt_relight;
        return;
    case 2 : @mt_tilt_mirror($pillar, 0);
    case 3 : @mt_tilt_mirror($pillar, 1);
    case 4 :
        if (inv_freespace(inv) = 0) {
            ~mesbox("Your hands are too full to take it back.");
            return;
        }
        ~mt_socket_write($pillar, ^mt_socket_empty);
        inv_add(inv, mourning_mirror, 1);
        mes("You take the mirror back out.");
        ~mt_relight;
        return;
}

// Which beam goes through the floor or the ceiling: the walkthrough says it the same way round -
// "point Mirror #5 so the western light points down" - so the question is which travelling beam.
[label,mt_tilt_mirror](int $pillar, int $down)
def_int $dir = ~p_choice4("The beam travelling north.", ^mt_dir_north, "The beam travelling east.", ^mt_dir_east, "The beam travelling south.", ^mt_dir_south, "The beam travelling west.", ^mt_dir_west);
~mt_socket_write($pillar, add(add(^mt_socket_tilt, multiply(sub($dir, 1), 2)), $down));
def_string $way = "up";
if ($down = 1) {
    $way = "down";
}
mes("You tilt the mirror: a beam travelling <~mt_dir_name($dir)> will go <$way>.");
~mt_relight;

// A mirror goes in flat and each further click turns it a quarter; after the fourth it comes back
// out. The mirror itself leaves the inventory while it is in the socket, because there are only so
// many mirrors in the building and the whole puzzle is about having too few.
[label,mt_place_mirror](int $pillar)
if (%mourning_quest_main < ^mt_inside) {
    ~mesbox("An octagonal pillar with a socket at head height, and no reason yet to put anything in it.");
    return;
}
if (~mt_crystal_at($pillar) > ^mt_colour_dark) {
    ~mesbox("There is a crystal in this socket. One thing at a time.");
    return;
}
// USING A MIRROR ON AN OCCUPIED SOCKET IS STILL A QUARTER TURN, because that is the quick way to
// work a corner and it is how the puzzle was played: click, look, click. The full set of settings -
// the eight tilts - is on Search, which is the op the pillar actually carries.
def_int $already = ~mt_mirror_at($pillar);
if ($already > 0) {
    def_int $rot = ~mt_mirror_flat($pillar);
    if ($rot < 0) {
        ~mt_socket_write($pillar, ^mt_socket_mirror);
        mes("You lay the tilted mirror flat again.");
        ~mt_relight;
        return;
    }
    if ($rot >= 3) {
        if (inv_freespace(inv) = 0) {
            ~mesbox("Your hands are too full to take it back.");
            return;
        }
        ~mt_socket_write($pillar, ^mt_socket_empty);
        inv_add(inv, mourning_mirror, 1);
        mes("You take the mirror back out.");
        ~mt_relight;
        return;
    }
    ~mt_socket_write($pillar, add(^mt_socket_mirror, add($rot, 1)));
    mes("You turn the mirror a quarter turn.");
    ~mt_relight;
    return;
}
if (inv_total(inv, mourning_mirror) = 0) {
    ~mesbox("You have no mirror to put in it.");
    return;
}
inv_del(inv, mourning_mirror, 1);
~mt_socket_write($pillar, ^mt_socket_mirror);
mes("You set the mirror in the socket.");
~mt_relight;

// A crystal goes in and the beam that passes the pillar comes out its colour. Using the same
// crystal on the socket again takes it back; using a different one swaps them over.
[label,mt_place_crystal](int $pillar, int $colour)
if (%mourning_quest_main < ^mt_inside) {
    ~mesbox("An octagonal pillar with a socket at head height, and no reason yet to put anything in it.");
    return;
}
if (~mt_mirror_at($pillar) > 0) {
    ~mesbox("There is a mirror in this socket. Take it out first.");
    return;
}
def_int $already = ~mt_crystal_at($pillar);
if ($already = $colour) {
    ~mt_socket_write($pillar, ^mt_socket_empty);
    inv_add(inv, ~mt_crystal_obj($colour), 1);
    mes("You take the <~mt_colour_name($colour)> crystal back out of the socket.");
    ~mt_relight;
    return;
}
if ($already > ^mt_colour_dark) {
    inv_del(inv, ~mt_crystal_obj($colour), 1);
    inv_add(inv, ~mt_crystal_obj($already), 1);
    ~mt_socket_write($pillar, add(^mt_socket_crystal, sub($colour, 1)));
    mes("You swap the <~mt_colour_name($already)> crystal for the <~mt_colour_name($colour)> one.");
    ~mt_relight;
    return;
}
inv_del(inv, ~mt_crystal_obj($colour), 1);
~mt_socket_write($pillar, add(^mt_socket_crystal, sub($colour, 1)));
mes("You set the <~mt_colour_name($colour)> crystal in the socket.");
~mt_relight;

// A fractured crystal splits the beam: it carries on through and a copy leaves along the edge that
// is clear. Which edge is the player's to set, and the walkthrough calls those orientations
// vertical and horizontal - so the menu asks for a direction, with up and down behind one option.
[label,mt_place_fractured](int $pillar, int $which)
if (%mourning_quest_main < ^mt_inside) {
    ~mesbox("An octagonal pillar with a socket at head height, and no reason yet to put anything in it.");
    return;
}
if (~mt_mirror_at($pillar) > 0 | ~mt_crystal_at($pillar) > ^mt_colour_dark) {
    ~mesbox("There is something in this socket already. One thing at a time.");
    return;
}
def_int $have = 0;
def_int $old = 0;
$have, $old = ~mt_fractured_at($pillar);
if ($have = $which) {
    ~mt_socket_write($pillar, ^mt_socket_empty);
    inv_add(inv, ~mt_fractured_obj($which), 1);
    mes("You take the fractured crystal back out of the socket.");
    ~mt_relight;
    return;
}
if ($have > 0) {
    ~mesbox("The other fractured crystal is in this socket.");
    return;
}
def_int $dir = ~p_choice5("Along the edge pointing north.", ^mt_dir_north, "East.", ^mt_dir_east, "South.", ^mt_dir_south, "West.", ^mt_dir_west, "Up, or down.", 0);
if ($dir = 0) {
    $dir = ~p_choice2("Up.", ^mt_dir_up, "Down.", ^mt_dir_down);
}
inv_del(inv, ~mt_fractured_obj($which), 1);
~mt_socket_write($pillar, add(add(^mt_socket_fractured, multiply(sub($which, 1), ^mt_fractured_dirs)), sub($dir, 1)));
mes("You set the fractured crystal with its clear edge to the <~mt_dir_name($dir)>. A beam through it will come out twice.");
~mt_relight;

// =========================================================================== the collector
// THE CACHE NAMES BOTH HALVES OF THIS. mourning_temple_light_wall_lever is "Crystal collector - A
// Lever", op1=Pull, and mourning_temple_light_wall_collector is "Crystal collector - A collection
// point", op1=Collect; and the tray they share has six bits for a count of mirrors
// (mourning_temple_mirrors_reset_tray) and one bit each for a red, a blue and an orange crystal.
// So Pull takes every fitting out of every socket in the building and drops it in the tray, and
// Collect hands the tray over - which is the walkthrough's "pull the crystal dispenser to reset,
// then collect all items".
//
// IT IS ALSO WHERE THE TEMPLE'S OWN KIT COMES FROM. Every chest in the building is behind a door
// of light - two yellow, one cyan, one blue and one magenta - so a player with no mirrors and no
// crystal cannot open any of them, and the first mirrors cannot be chest mirrors. The tray starts
// with the fittings the temple was left with, which is what the walkthrough collects before it
// touches a chest.
[proc,mt_tray_seed]()()
%mourning_temple_mirrors_reset_tray = ^mt_tray_start_mirrors;
%mourning_temple_orange_crystal_reset_tray = ^mt_on;

// The tray has a bit for a red, a blue and an orange crystal and none for cyan or green, so those
// two go back to the player's hands instead, and stay in their socket if there is no room.
[proc,mt_tray_take_crystal](int $colour)(boolean)
if ($colour = ^mt_colour_red & %mourning_temple_red_crystal_reset_tray = ^mt_off) {
    %mourning_temple_red_crystal_reset_tray = ^mt_on;
    return(true);
}
if ($colour = ^mt_colour_blue & %mourning_temple_blue_crystal_reset_tray = ^mt_off) {
    %mourning_temple_blue_crystal_reset_tray = ^mt_on;
    return(true);
}
if ($colour = ^mt_colour_yellow & %mourning_temple_orange_crystal_reset_tray = ^mt_off) {
    %mourning_temple_orange_crystal_reset_tray = ^mt_on;
    return(true);
}
return(false);

[oploc1,mourning_temple_light_wall_lever]
p_arrivedelay;
anim(human_leverdown, 0);
p_delay(3);
def_int $p = 1;
def_int $in = 0;
def_int $stuck = 0;
while ($p <= ^mt_pillars) {
    def_int $crystal = ~mt_crystal_at($p);
    if (~mt_mirror_at($p) > 0) {
        %mourning_temple_mirrors_reset_tray = add(%mourning_temple_mirrors_reset_tray, 1);
        ~mt_socket_write($p, ^mt_socket_empty);
        $in = add($in, 1);
    }
    if ($crystal > ^mt_colour_dark) {
        if (~mt_tray_take_crystal($crystal) = true) {
            ~mt_socket_write($p, ^mt_socket_empty);
            $in = add($in, 1);
        } else {
            if (inv_freespace(inv) > 0) {
                inv_add(inv, ~mt_crystal_obj($crystal), 1);
                ~mt_socket_write($p, ^mt_socket_empty);
                $in = add($in, 1);
            } else {
                $stuck = add($stuck, 1);
            }
        }
    }
    $p = add($p, 1);
}
~mt_relight;
if ($stuck > 0) {
    ~mesbox("Every fitting in the building drops out of its socket at once. <tostring($stuck)> of them are left lying where they fell, because the collector has no shelf for them and your hands are full.");
    return;
}
~mesbox("Every fitting in the building drops out of its socket at once and the beam goes back to where it starts. | <tostring($in)> of them are waiting in the collector by the lever.");

[oploc1,mourning_temple_light_wall_collector]
p_arrivedelay;
def_int $out = 0;
while (%mourning_temple_mirrors_reset_tray > 0 & inv_freespace(inv) > 0) {
    %mourning_temple_mirrors_reset_tray = sub(%mourning_temple_mirrors_reset_tray, 1);
    inv_add(inv, mourning_mirror, 1);
    $out = add($out, 1);
}
if (inv_total(inv, mourning_colour_wheel) = 0 & $out > 0 & inv_freespace(inv) > 0) {
    inv_add(inv, mourning_colour_wheel, 1);
}
if (%mourning_temple_orange_crystal_reset_tray = ^mt_on & inv_freespace(inv) > 0) {
    %mourning_temple_orange_crystal_reset_tray = ^mt_off;
    inv_add(inv, mourning_crystal_yellow, 1);
    $out = add($out, 1);
}
if (%mourning_temple_red_crystal_reset_tray = ^mt_on & inv_freespace(inv) > 0) {
    %mourning_temple_red_crystal_reset_tray = ^mt_off;
    inv_add(inv, mourning_crystal_red, 1);
    $out = add($out, 1);
}
if (%mourning_temple_blue_crystal_reset_tray = ^mt_on & inv_freespace(inv) > 0) {
    %mourning_temple_blue_crystal_reset_tray = ^mt_off;
    inv_add(inv, mourning_crystal_blue, 1);
    $out = add($out, 1);
}
if ($out > 0) {
    ~mesbox("You take <tostring($out)> fittings out of the collector. | A mirror turns a beam ninety degrees and only from one side: a quarter turn changes which two corners it will take. An empty socket is not an obstacle. A crystal keeps the colours it is made of and stops the rest.");
    return;
}
def_int $n = ~mt_mirrors_placed;
if (~mt_relight = true) {
    ~mesbox("The collector is empty and full of light: <tostring($n)> mirrors are in their sockets and the beam is coming out of the west wall.");
    return;
}
~mesbox("The collector is empty and dark. <tostring($n)> mirrors are in their sockets. | Pull the lever beside it and every fitting in the building comes back here.");

// =========================================================================== the final pillar
// mourning_temple_final_pillar_of_light carries no ops, so the handler that used to be here could
// never fire. The collector says the same thing and can be clicked.

[opheld1,mourning_colour_wheel]
~mesbox("A colour wheel, and on the back of it, in a hand six hundred years old: | A MIRROR TAKES THE BEAM ROUND ONE CORNER AND IT IS SILVERED ON ONE FACE ONLY. | A QUARTER TURN CHANGES WHICH CORNER. | AN EMPTY SOCKET IS NOT AN OBSTACLE. | A CRYSTAL KEEPS WHAT IT IS MADE OF: YELLOW THEN CYAN LEAVES GREEN, AND RED THEN CYAN LEAVES NOTHING. | THE LIGHT ENTERS AT THE TOP OF THE EAST WALL AND MUST LEAVE BY THE HOLE IN THE WEST.");

[opheld1,mourning_mirror]
~mesbox("A small hand mirror. It fits the sockets on the pillars, and it fits them four ways.");
