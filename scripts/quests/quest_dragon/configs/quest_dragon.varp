[dragonquest]
// The quest helper plugin reads this to know which leg of the quest you are on. Without
// transmit the client's copy stays 0 for ever and the panel has nothing to show.
scope=perm
transmit=yes

[dragonquestvar]
type=int
scope=perm

[dragon_ned_hired]
type=int
scope=perm

[dragon_oracle]
type=int
scope=perm

[dragon_wall]
type=int
scope=perm

//https://www.neoseeker.com/forums/2410/t367735-help-with-dragon-slayer/
[dragon_shield]
type=int
scope=perm

[dragon_goblin]
type=int
scope=perm
