// Basalt rocks - the causeway out to the lighthouse (Corey, 2026-09-05).
//
// Ten locs named "Basalt rock" (horror_jumping_spot1..10), all placed on plane 1 around the north
// side of the lighthouse island, each already carrying op1=Jump-across and the examine "I can jump
// off this one." Nothing in the repo referenced any of them, so every one of those right-click
// options was dead.
//
// They are not a single line of stones. The map places two separate chains:
//   spots 1-4   x=2522, z=3595 / 3597 / 3600 / 3602
//   spots 5-10  (2518,3611) (2516,3611) then x=2514, z=3613 / 3615 / 3617 / 3619
// so the player hops rock to rock by clicking the next one, which is how the obstacle actually
// works - you jump ONTO the rock you clicked.
//
// There is no Agility level requirement in 2006; it is a chance-based obstacle that gets reliable
// somewhere around level 35, and the middle rocks of a chain cannot be failed at all. Failing drops
// you in the water for a few points of damage. That matches the wiki and the cache (none of the ten
// locs carries a level param).

// The rocks stand 2-3 tiles apart in open water, so no tile beside one is ever walkable and
// [oploc1] can never fire - the engine answers "I can't reach that" before the script runs.
// [aploc1] fires on approach instead; the 4-tile guard below still forces you onto a
// neighbouring rock rather than letting you cross the bay in one click. The whole causeway
// is on PLANE 1 - walking there from plane 0 will never reach it.
[aploc1,horror_jumping_spot1]  ~horror_basalt_jump(false);
[aploc1,horror_jumping_spot2]  ~horror_basalt_jump(false);
[aploc1,horror_jumping_spot3]  ~horror_basalt_jump(true);
[aploc1,horror_jumping_spot4]  ~horror_basalt_jump(false);
[aploc1,horror_jumping_spot5]  ~horror_basalt_jump(false);
[aploc1,horror_jumping_spot6]  ~horror_basalt_jump(false);
[aploc1,horror_jumping_spot7]  ~horror_basalt_jump(true);
[aploc1,horror_jumping_spot8]  ~horror_basalt_jump(true);
[aploc1,horror_jumping_spot9]  ~horror_basalt_jump(false);
[aploc1,horror_jumping_spot10] ~horror_basalt_jump(false);

[oploc1,horror_jumping_spot1]  ~horror_basalt_jump(false);
[oploc1,horror_jumping_spot2]  ~horror_basalt_jump(false);
[oploc1,horror_jumping_spot3]  ~horror_basalt_jump(true);
[oploc1,horror_jumping_spot4]  ~horror_basalt_jump(false);
[oploc1,horror_jumping_spot5]  ~horror_basalt_jump(false);
[oploc1,horror_jumping_spot6]  ~horror_basalt_jump(false);
[oploc1,horror_jumping_spot7]  ~horror_basalt_jump(true);
[oploc1,horror_jumping_spot8]  ~horror_basalt_jump(true);
[oploc1,horror_jumping_spot9]  ~horror_basalt_jump(false);
[oploc1,horror_jumping_spot10] ~horror_basalt_jump(false);

// $safe marks the centremost rocks of each chain, which cannot be failed.
// The lighthouse dagannoths are ranged monsters (damagetype ^ranged_style, spike projectile) that
// had no ranged AI, so they closed to melee. Same generic path the Waterbirth ones use.
[ai_queue1,horror_dagganoth_jr] ~npc_default_retaliate_ap;
[ai_queue1,horror_dagganoth_jr_darker] ~npc_default_retaliate_ap;
[ai_queue1,horror_dagganoth_jr_lighter] ~npc_default_retaliate_ap;
[ai_applayer2,horror_dagganoth_jr] ~npc_rangeattack;
[ai_applayer2,horror_dagganoth_jr_darker] ~npc_rangeattack;
[ai_applayer2,horror_dagganoth_jr_lighter] ~npc_rangeattack;
[ai_opplayer2,horror_dagganoth_jr] ~npc_rangeattack;
[ai_opplayer2,horror_dagganoth_jr_darker] ~npc_rangeattack;
[ai_opplayer2,horror_dagganoth_jr_lighter] ~npc_rangeattack;

[proc,horror_basalt_jump](boolean $safe)
if (coord = loc_coord) {
    mes("You can't do that from here.");
    return;
}
def_int $dx = sub(coordx(loc_coord), coordx(coord));
def_int $dz = sub(coordz(loc_coord), coordz(coord));

// Refuse a jump from too far away rather than letting the player teleport across the whole bay by
// clicking the last rock in the chain.
if (add(~abs_value($dx), ~abs_value($dz)) > 4) {
    mes("You need to be closer to jump to that rock.");
    return;
}

def_int $dir = ^exact_north;
if ($dz < 0) {
    $dir = ^exact_south;
} else if ($dz = 0) {
    $dir = ^exact_east;
    if ($dx < 0) {
        $dir = ^exact_west;
    }
}

// THE ROLL COMES BEFORE THE JUMP, which is the whole of this fix. It used to move the player onto
// the rock FIRST and then roll, so a failed jump said "you fall into the water", took the damage -
// and left you standing safely on the rock you were aiming at. A failure that still gets you
// across is not a failure; the causeway was free, with a toll.
//
// "It is possible to slip on the rocks, which results in the player falling into the water, being
// swept back to shore, and taking up to 10 damage." So a slip goes in the water where the player is
// STANDING, and then the sea puts them back on the mainland beach. The damage is up to 10, which is
// also what the quest guide warns about - "a max hit of 10" - where this rolled 3 to 8.
if ($safe = false & stat_random(agility, 60, 200) = false) {
    mes("You jump for the next rock.");
    sound_synth(jump_no_land, 1, 20);
    mes("You slip on the wet rock and fall into the water.");
    sound_synth(pool_plop, 1, 0);
    spotanim_map(watersplash, coord, 0, 1);
    p_delay(1);
    ~damage_self(calc(random(^horror_basalt_max_damage) + 1));
    mes("The sea sweeps you back to the shore.");
    p_telejump(^horror_basalt_shore);
    stat_advance(agility, 5);
    return;
}
mes("You jump from one rock to the next.");
sound_synth(jump_no_land, 1, 20);
~agility_exactmove(human_steppingstonejump, 20, 2, coord, loc_coord, 48, 60, $dir, false);
stat_advance(agility, 20);

[proc,abs_value](int $n)(int)
if ($n < 0) {
    return(multiply($n, -1));
}
return($n);
