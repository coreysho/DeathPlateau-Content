[oplocu,plaguemudpatch1]
switch_obj(last_useitem) {
    case spade : ~elena_dig_mud_patch;
    case bucket_water : @elena_bucket_mud_patch(last_useslot);
}

[oplocu,plaguemudpatch2]
switch_obj(last_useitem) {
    case spade : ~elena_dig_mud_patch;
    case bucket_water : @elena_bucket_mud_patch(last_useslot);
}

[proc,elena_dig_mud_patch]
anim(human_dig, 0);
// The tunnel is filled in only once Plague City is BEHIND you. Elena is the one who says so - "they
// discovered the tunnel and filled it in", area_ardougne_east/scripts/elena.rs2, the line that sets
// %biohazard to ^biohazard_started - so Biohazard having begun is the right thing to read. What was
// wrong is that it was read on its own, ahead of any check that Plague City was finished: a player
// who reached Biohazard with %elenaquest still short of ^elena_complete was told the ground was
// packed hard while the bucket script was telling him the soil was already soft enough, and the mud
// patch is the ONLY way down during the quest, so there was no way to finish it and no way back.
if (%elenaquest >= ^elena_complete & %biohazard >= ^biohazard_started) {
    ~objbox(spade, "The ground's been filled in and packed hard.", 250, 0, 0);
    return;
}
if (%elenaquest < ^quest_elena_mud_patch4) {
    ~objbox(spade, "You dig the soil...|The ground is rather hard.", 250, 0, 0);
    return;
}
~objbox(spade, "You dig deep into the soft soil...|Suddenly it crumbles away!", 250, 0, 0);
if (%elenaquest < ^quest_elena_opened_tunnel) ~quest_elena_set_progress(^quest_elena_opened_tunnel);
p_telejump(^quest_elena_sewer_mud_pile_coord);
// The message below has always claimed Edmond follows you down, and the cache has always had the
// mechanism for it - edmond_top and edmond_bottom are two placed shells reading the same varbit,
// plaguecity_can_see_edmond_up_top, one showing Edmond at 0 and the other at 1. Nothing had ever
// written to that varbit, so he stayed in his garden and the message was a lie.
%plaguecity_can_see_edmond_up_top = 1;
~mesbox("You fall through...|...you land in the sewer.|Edmond follows you down the hole.");

[label,elena_bucket_mud_patch](int $slot)
switch_int(%elenaquest) {
    case ^quest_elena_not_started, ^quest_elena_started, ^quest_elena_gasmask : ~mesbox("You see no reason to do that at the moment.");
    case ^quest_elena_started_mud_patch : @elena_soften_mud_patch($slot, ^quest_elena_mud_patch1);
    case ^quest_elena_mud_patch1 : @elena_soften_mud_patch($slot, ^quest_elena_mud_patch2);
    case ^quest_elena_mud_patch2 : @elena_soften_mud_patch($slot, ^quest_elena_mud_patch3);
    case ^quest_elena_mud_patch3 : @elena_soften_mud_patch($slot, ^quest_elena_mud_patch4);
    case default : ~mesbox("You don't need to pour any more water. The soil is soft enough already.");
}

[label,elena_soften_mud_patch](int $slot, int $progress)
~quest_elena_set_progress($progress);
inv_delslot(inv, $slot);
inv_add(inv, bucket_empty, 1);
if (%elenaquest = ^quest_elena_mud_patch4) {
    ~mesbox("You pour water onto the soil.|The soil is now soft enough to dig into.");
} else {
    ~mesbox("You pour the water onto the soil.|The soil softens slightly.");
}

// THE SPADE'S OWN DIG, as well as using the spade on the patch (owner, 2026-09-29). Every other
// quest dig in general_use/scripts/spade.rs2 is a coordinate test, because the thing being dug is
// scenery with no ops. The mud patch is not: it is a real loc with its own oplocu, and nothing
// writes its coordinate down. So this looks for the loc in the player's own zone rather than
// testing a coordinate, which also keeps working if the patch is ever moved on the map.
//
// One tile of slack, so digging works from the tile you walked onto as well as from the patch
// itself - the same reach the click on the loc has.
[proc,elena_mud_patch_dig]()(boolean)
loc_findallzone(coord);
while (loc_findnext = true) {
    if ((loc_type = plaguemudpatch1 | loc_type = plaguemudpatch2) & distance(coord, loc_coord) <= 1) {
        ~elena_dig_mud_patch;
        return(true);
    }
}
return(false);
