// Swan Song - a fishing colony that cannot hold, and the one man who could save it being carried
// back through the gate about four minutes after he arrives.

// =========================================================================== outside the colony
// swan_multioutside is Herman until stage 20 and the Wise Old Man from 30. Handler on the shell.
[opnpc1,swan_multioutside]
if (%swansong >= ^swan_wom & %swansong <= ^swan_ambush) {
    @swan_wom_talk;
}
@swan_herman_talk;

[opnpc1,swan_herman] @swan_herman_talk;

// DEVIN MENDELBERG, who had nothing to say to anybody. swan_boat_colonist carries op1=Talk-to
// through its multinpc (it is swan_colonist_1 at every stage) and no script answered it, so the
// click did nothing at all; eaglespeak's dead-op check caught him when he wandered into its box.
// He is the only swan_boat_colonist in the whole map set and he is standing in map square 37_54,
// which is the Gnome Stronghold - eight map squares from the colony he is a colonist of. That spawn
// came in with the bulk map import (34ef090e) rather than from anything here, and whether he should
// be there at all is one line in maps/m37_54.jm2; what is certainly wrong is a clickable npc with
// no handler, which is this.
//
// HANDLER ON THE SHELL, as with swan_multioutside above: Player.getOpTrigger looks the trigger up
// on the npc's own type and OpNpcHandler resolves multinpc only to decide whether the option
// exists, so an [opnpc1,swan_colonist_1] would never fire.
[opnpc1,swan_boat_colonist]
if (%swansong < ^swan_complete) {
    ~chatnpc("<p,neutral>Devin Mendelberg. I came out here for the fishing, and I have had a good deal more of the sea trolls than of the fish.");
    return;
}
~chatnpc("<p,happy>Devin Mendelberg. The fishing is good again, now that nothing is eating the fishermen.");

[label,swan_herman_talk]
switch_int (%swansong) {
    case ^swan_not_started : @swan_start;
    case ^swan_walls : @swan_walls_check;
    case ^swan_fish : @swan_fish_check;
    case ^swan_fed : @swan_letter_out;
    case ^swan_letter :
        ~chatnpc("<p,neutral>The boat went this morning. Whether anybody reads it is another matter.");
    case ^swan_planted : @swan_battle_scene;
    case ^swan_battle : @swan_battle_scene;
    case ^swan_queen : @swan_battle_scene;
    case ^swan_told : @swan_finish;
    case default :
        if (%swansong >= ^swan_complete) {
            ~chatnpc("<p,happy>Seventy-one people and a fishing ground, and one man asleep in my office who I cannot wake up.");
            return;
        }
        ~chatnpc("<p,neutral>Do what he told you. He was right about all of it up to the part where he walked out of the gate.");
}

[label,swan_start]
// THE REQUIREMENTS WERE NOT CHECKED. OSRS wants 100 quest points, One Small Favour and Garden of
// Tranquillity before Herman will take you on, and this took anybody who said the right thing.
// The six skill levels are not start requirements and are checked where they are spent - Fishing
// 62 at the spots, and the rest in the press and the pottery that this cache cannot build.
if (%qp < ^swan_req_questpoints) {
    ~chatnpc("<p,angry>You have done nothing anybody has heard of. Come back when somebody somewhere owes you a favour.");
    ~mesbox("You need <tostring(^swan_req_questpoints)> quest points to start Swan Song. You have <tostring(%qp)>.");
    return;
}
if (%onesmallfavour < ^osf_complete) {
    ~chatnpc("<p,angry>You have never done one small favour for anybody in your life, have you.");
    return;
}
if (%garden_quest < ^garden_complete) {
    ~chatnpc("<p,neutral>The old man in Draynor will not come for a stranger. Do something for his neighbours first.");
    return;
}
~chatnpc("<p,angry>If you are here to fish, turn round. If you are here to help, say so quickly.");
switch_int (~p_choice2("What's happening here?", 1, "I'm here to fish.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>I'm here to fish.");
        ~chatnpc("<p,angry>So is everything in the water and it is not fish it is after.");
        return;
    case 1 :
        ~chatplayer("<p,quiz>What's happening here?");
}
~chatnpc("<p,sad>Sea trolls. They came up out of the fishing grounds eleven days ago and they have not gone back down, and there are seventy-one people behind that palisade and the palisade has five holes in it.");
~chatplayer("<p,quiz>Why not leave?");
~chatnpc("<p,angry>One boat. Seventy-one people. You do the arithmetic and then tell me who gets on it.");
~chatnpc("<p,neutral>Franklin is our engineer. Start with the wall.");
%swansong = ^swan_walls;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);

[label,swan_walls_check]
if (~swan_walls_done < ^swan_walls_needed) {
    ~chatnpc("<p,neutral>The wall. Franklin has the press and no hands.");
    return;
}
~chatnpc("<p,neutral>Five sections. That is the first thing anybody has finished here in eleven days.");
~chatnpc("<p,sad>Now the other problem. Nobody has eaten since the trolls came, because the fishing grounds are where the trolls are.");
%swansong = ^swan_fish;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);

[label,swan_fish_check]
if (%swansong_fish < ^swan_fish_needed) {
    ~chatnpc("<p,neutral>Fish. <tostring(%swansong_fish)> of <tostring(^swan_fish_needed)>. The spots are on the north shore and so are the trolls.");
    return;
}
~chatnpc("<p,neutral>Seventy-one people fed. Thank you.");
%swansong = ^swan_fed;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
@swan_letter_out;

[label,swan_letter_out]
~chatnpc("<p,sad>And none of it matters, because the wall will not hold and the food will run out and I have known both of those things for a week.");
~chatplayer("<p,quiz>So who can help?");
~chatnpc("<p,neutral>There is a man in Draynor who is supposed to be the best magician alive and who has spent thirty years pretending to be a pensioner.");
~chatnpc("<p,neutral>I have written to him four times. I am going to write a fifth and you are going to put it on the boat, and then we will both find out whether that was worth doing.");
if_close;
mes("Herman gives the letter to Kathy Corkat and the boat goes out on the tide.");
p_delay(5);
%swansong = ^swan_letter;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
p_delay(3);
// THE LETTER IS NOT THE END OF THIS STEP ANY MORE. It used to set ^swan_wom in the same breath,
// because the man it is addressed to was placed nowhere on the map - he is npc 2253 and Draynor
// had no Wise Old Man at all. He is at 3088,3251 now, so the quest does what Herman says it does:
// the letter goes out, and you go and fetch him.
~mesbox("The letter goes out on the tide. | Herman has written the name of the man on it twice, which is not a thing a man does if he thinks the letter will be read.");

// =========================================================================== getting in
// The crawl-hole through the palisade. Herman stands outside it and does not let strangers past.
[oploc1,loc_14922]
p_arrivedelay;
if (coordz(coord) > coordz(loc_coord)) {
    mes("You crawl back out through the hole.");
    p_teleport(^swan_hole_outside);
    return;
}
if (%swansong = ^swan_not_started) {
    mes("Herman Caranos is standing right beside the hole, and he does not look like he means to let anybody through it.");
    return;
}
mes("You crawl through the hole in the palisade.");
p_teleport(^swan_hole_inside);

// The colony gate, a pair of gates on the north edge of their tiles.
[oploc1,loc_14929] @swan_colony_gate;
[oploc1,loc_14931] @swan_colony_gate;

[label,swan_colony_gate]
p_arrivedelay;
sound_synth(door_open, 1, 0);
if (coordz(coord) > coordz(loc_coord)) {
    p_teleport(movecoord(coord, 0, 0, sub(coordz(loc_coord), coordz(coord))));
} else {
    p_teleport(movecoord(coord, 0, 0, sub(add(coordz(loc_coord), 1), coordz(coord))));
}

// Kathy Corkat. The ground outside the colony, where Herman stands, is not joined on foot to the
// rest of the map in this cache - her boat is the only way there, so before the quest (when her
// multinpc shows only Talk-to) the conversation is what takes you.
[opnpc1,swan_boat_boatwoman]
if (%swansong = ^swan_not_started) {
    ~chatnpc("<p,neutral>I row supplies up to the fishing colony at Piscatoris. Herman Caranos has been asking everyone who comes past for help - do you want to go and see what he wants?");
} else {
    ~chatnpc("<p,neutral>Up to the colony? Hop in.");
}
if (~p_choice2("Yes please.", 1, "No thanks.", 2) = 1) {
    @swan_boat_travel(^swan_boat_north);
}

[opnpc3,swan_boat_boatwoman] @swan_boat_travel(^swan_boat_north);

[opnpc1,swan_boatwoman_2]
~chatnpc("<p,neutral>Back down to the Gnome Stronghold?");
if (~p_choice2("Yes please.", 1, "No thanks.", 2) = 1) {
    @swan_boat_travel(^swan_boat_south);
}

[opnpc3,swan_boatwoman_2] @swan_boat_travel(^swan_boat_south);

[label,swan_boat_travel](coord $to)
if_close;
mes("Kathy Corkat rows you along the coast.");
p_delay(3);
p_teleport($to);

// =========================================================================== the Wise Old Man
[label,swan_wom_talk]
switch_int (%swansong) {
    case ^swan_wom :
        ~chatnpc("<p,neutral>Four letters. I read all four and I did not come, and then the fifth one had somebody else's handwriting on the envelope.");
        ~chatplayer("<p,quiz>Can you stop them?");
        ~chatnpc("<p,happy>Almost certainly. I should like to look at them first. I have never seen a sea troll and I am eighty-one.");
        %swansong = ^swan_wom_looked;
        ~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
    case ^swan_wom_looked : @swan_ambush_scene;
    case ^swan_ambush :
        ~chatnpc("<p,neutral>...");
    case default :
        ~chatnpc("<p,neutral>Hm.");
}

[label,swan_ambush_scene]
~chatplayer("<p,quiz>Well?");
~chatnpc("<p,neutral>There are rather more of them than Mr Caranos thinks, and the ones he has seen are the small ones.");
~chatnpc("<p,happy>Stand behind me. This will take a moment and it will be worth watching.");
if_close;
mes("The Wise Old Man walks out through the gap in the palisade and raises one hand.");
p_delay(5);
%swansong = ^swan_ambush;
~mesbox("It is worth watching for about four seconds. | Then something comes out of the water behind him that is not one of the small ones.");
p_delay(4);
mes("They carry him back through the gate.");
p_delay(4);
%swansong = ^swan_coma;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
~mesbox("He is breathing and he is not waking up, and he is eighty-one, and the colony's entire plan was him. | Herman puts him on the floor of his own office and goes very quiet.");

// From 65 onwards he is lying in the office and he stays there.
// swan_wom_office resolves to wom_inactive, which carries no ops at all - he is lying on the floor
// and cannot be talked to, which is the point of him. Arnold says what is in the room instead.

// =========================================================================== Herman's book
[opheld1,swan_book]
~mesbox("Herman's book. | Most of it is fish prices. | The last six pages are not, and they are not in Herman's hand: they were written this week, on the floor, by somebody who was losing consciousness while he wrote them. | BONE SEEDS. Bury them, they come up, they fight. They want BONES and they want a LOT of bones and the ground here is nothing but bones because it is a fishing colony and it is eleven days into a siege.");

[opheld1,swan_army]
~mesbox("Bone seeds. An highly portable army of skeletal magi, which is a sentence somebody has written on a label without appearing to think about it at all.");

[opheld4,swan_army]
p_arrivedelay;
if (%swansong < ^swan_seeds) {
    ~mesbox("Not yet, and not here.");
    return;
}
if (%swansong > ^swan_seeds) {
    ~mesbox("They are in the ground and they are coming up.");
    return;
}
if (%swansong_bones < ^swan_bones_needed) {
    ~mesbox("The book is emphatic about the quantity. <tostring(%swansong_bones)> of <tostring(^swan_bones_needed)>.");
    return;
}
if_close;
mes("You open the packet and put the seeds in the ground along the inside of the palisade.");
p_delay(5);
inv_del(inv, swan_army, 1);
%swansong = ^swan_planted;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
~mesbox("Nothing happens for about a minute. | Then the ground along forty yards of palisade starts moving, all of it at once, and seventy-one people go indoors.");

// =========================================================================== Franklin and the wall
// As in 2006: Franklin wants five iron sheets for the five holes in the west palisade, and makes
// them on the metal press in his workshop. Logs in the firebox at its east end, a tinderbox to light
// them, then iron bars through the press one at a time, and each sheet goes on a broken wall with a
// hammer in the pack. He hands over a tinderbox and a hammer if you have none.
//
// The cache has all of it. swansong_franklin drives both halves of the press: the firebox
// (loc_14955) is empty at 0 and 1, has logs in it at 2 and is lit from 3, and the press (loc_14954)
// shows working from 3. Each broken wall (loc_14933-14937, on the west palisade) is a multiloc on
// its own swansong_wall_N, Broken wall at 0 and Patched wall at 1. None of them has an op, so all
// of this is use-item-on-loc.
[opnpc1,swan_franklin]
if (%swansong < ^swan_walls) {
    ~chatnpc("<p,neutral>Iron. I have a press and no iron, and five holes in the wall.");
    return;
}
if (~swan_walls_done >= ^swan_walls_needed) {
    ~chatnpc("<p,happy>Five sections. It is the first wall I have finished in my life.");
    return;
}
if (%swansong_franklin = ^swan_press_cold) {
    ~chatnpc("<p,neutral>Herman sent you? Good. The west wall has five holes in it, and timber will not stop a sea troll.");
    ~chatnpc("<p,neutral>Iron will. The press in the workshop makes sheets out of bars. Logs in the firebox at its east end, light them, and put iron bars through it.");
    ~chatnpc("<p,neutral>Five sheets, one to a hole. Bring your own bars - I have none left.");
    %swansong_franklin = ^swan_press_asked;
}
if (inv_total(inv, tinderbox) = 0 & %swansong_franklin < ^swan_press_hot) {
    ~swan_franklin_gives(tinderbox, "You'll want a tinderbox for the firebox. Here.");
}
if (inv_total(inv, hammer) = 0) {
    ~swan_franklin_gives(hammer, "And a hammer, for the wall. Hitting it with the sheets will not do.");
}
~chatnpc("<p,neutral><tostring(~swan_walls_done)> of <tostring(^swan_walls_needed)> patched. Iron bars through the press, and the sheets on the west wall.");

[proc,swan_franklin_gives](namedobj $obj, string $line)
~chatnpc("<p,neutral><$line>");
if (inv_freespace(inv) = 0) {
    ~mesbox("You have no room to take it.");
    return;
}
inv_add(inv, $obj, 1);
~objbox($obj, "Franklin gives you <~add_article(lowercase(oc_name($obj)))>.", 250, 0, ^objbox_height);

// the firebox: logs in, then the tinderbox
[oplocu,loc_14955]
def_obj $item = last_useitem;
p_arrivedelay;
if ($item = tinderbox) {
    @swan_firebox_light;
}
if (oc_category($item) ! category_22) {
    ~displaymessage(^dm_default);
    return;
}
if (%swansong_franklin = ^swan_press_cold) {
    mes("It is somebody's press. You should ask before you light it.");
    return;
}
if (%swansong_franklin >= ^swan_press_logs) {
    mes("There are logs in the firebox already.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(1);
inv_del(inv, $item, 1);
%swansong_franklin = ^swan_press_logs;
mes("You put the logs in the firebox.");

[label,swan_firebox_light]
if (%swansong_franklin >= ^swan_press_hot) {
    mes("The firebox is already lit.");
    return;
}
if (%swansong_franklin < ^swan_press_logs) {
    mes("There is nothing in the firebox to light.");
    return;
}
anim(human_createfire, 0);
p_delay(2);
%swansong_franklin = ^swan_press_hot;
mes("The logs catch, and the press starts to heat up.");

// the press: one iron bar in, one iron sheet out, and no more sheets than the wall still wants
[oplocu,loc_14954]
def_obj $item = last_useitem;
p_arrivedelay;
if ($item ! iron_bar) {
    ~displaymessage(^dm_default);
    return;
}
if (%swansong_franklin < ^swan_press_hot) {
    mes("The press is cold. The firebox at its east end needs lighting first.");
    return;
}
if (add(~swan_walls_done, inv_total(inv, iron_sheet)) >= ^swan_walls_needed) {
    mes("You have enough sheets for the wall.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(2);
inv_del(inv, iron_bar, 1);
inv_add(inv, iron_sheet, 1);
mes("You feed the iron bar through the press, and it comes out as a sheet.");

// the five broken walls, west palisade, north to south
[oplocu,loc_14933] @swan_patch_wall(1);
[oplocu,loc_14934] @swan_patch_wall(2);
[oplocu,loc_14935] @swan_patch_wall(3);
[oplocu,loc_14936] @swan_patch_wall(4);
[oplocu,loc_14937] @swan_patch_wall(5);

[label,swan_patch_wall](int $n)
def_obj $item = last_useitem;
p_arrivedelay;
if (~swan_wall_is_up($n) = true) {
    ~displaymessage(^dm_default);
    return;
}
if ($item = hammer) {
    anim(human_smithing, 0);
    p_delay(2);
    say("Aaargh!");
    mes("You feel a lot calmer. It didn't achieve anything, though - it wants an iron sheet over it.");
    return;
}
if ($item ! iron_sheet) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, hammer) = 0) {
    mes("You need a hammer to fix the sheet in place.");
    return;
}
anim(human_smithing, 0);
p_delay(3);
inv_del(inv, iron_sheet, 1);
stat_advance(crafting, 3000);
~swan_wall_patch($n);

[proc,swan_wall_is_up](int $n)(boolean)
switch_int ($n) {
    case 1 : if (%swansong_wall_1 = ^swan_on) { return(true); }
    case 2 : if (%swansong_wall_2 = ^swan_on) { return(true); }
    case 3 : if (%swansong_wall_3 = ^swan_on) { return(true); }
    case 4 : if (%swansong_wall_4 = ^swan_on) { return(true); }
    case 5 : if (%swansong_wall_5 = ^swan_on) { return(true); }
}
return(false);

[proc,swan_wall_patch](int $n)()
switch_int ($n) {
    case 1 : %swansong_wall_1 = ^swan_on;
    case 2 : %swansong_wall_2 = ^swan_on;
    case 3 : %swansong_wall_3 = ^swan_on;
    case 4 : %swansong_wall_4 = ^swan_on;
    case 5 : %swansong_wall_5 = ^swan_on;
}
def_int $done = ~swan_walls_done;
if ($done < ^swan_walls_needed) {
    ~mesbox("You nail the iron sheet over the hole. <tostring($done)> of <tostring(^swan_walls_needed)> sections.");
    return;
}
%swansong_franklin = ^swan_press_done;
~mesbox("You nail the iron sheet over the last hole. Five sections, and Herman should see this.");

[proc,swan_walls_done]()(int)
def_int $n = 0;
if (%swansong_wall_1 = ^swan_on) { $n = add($n, 1); }
if (%swansong_wall_2 = ^swan_on) { $n = add($n, 1); }
if (%swansong_wall_3 = ^swan_on) { $n = add($n, 1); }
if (%swansong_wall_4 = ^swan_on) { $n = add($n, 1); }
if (%swansong_wall_5 = ^swan_on) { $n = add($n, 1); }
return($n);

// =========================================================================== the fishing grounds
[opnpc1,swan_fishingspot] @swan_fish_attempt(harpoon, "harpoon");
[opnpc3,swan_fishingspot] @swan_fish_attempt(net, "net");

[label,swan_fish_attempt](obj $tool, string $what)
p_arrivedelay;
if (inv_total(inv, $tool) = 0) {
    ~mesbox("You would need a <$what>.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room.");
    return;
}
if (stat(fishing) < 62) {
    ~mesbox("You need a Fishing level of 62 for whatever is down there.");
    return;
}
anim(human_smallnet, 0);
p_delay(5);
inv_add(inv, swan_raw_monkfish, 1);
stat_advance(fishing, 1200);
if (%swansong = ^swan_fish & %swansong_fish < ^swan_fish_needed) {
    %swansong_fish = add(%swansong_fish, 1);
    mes("A monkfish. <tostring(%swansong_fish)> of <tostring(^swan_fish_needed)> for the colony.");
    return;
}
mes("You catch a monkfish.");

[opheld1,swan_monkfish]
~mesbox("Freshly caught and cooked - perfect for storing. Not so good for eating.");

// =========================================================================== bones
[opheldu,bones]
if (last_useitem ! swan_army) {
    ~displaymessage(^dm_default);
    return;
}
if (%swansong ! ^swan_seeds) {
    ~mesbox("Not yet.");
    return;
}
if (%swansong_bones >= ^swan_bones_needed) {
    ~mesbox("The packet will not take any more.");
    return;
}
inv_del(inv, bones, 1);
%swansong_bones = add(%swansong_bones, 1);
if (%swansong_bones >= ^swan_bones_needed) {
    ~mesbox("That is the quantity the book asked for, and the book was written by a man who was losing consciousness, so it is worth taking literally.");
    return;
}
mes("Bones into the packet. <tostring(%swansong_bones)> of <tostring(^swan_bones_needed)>.");

// =========================================================================== Arnold
[opnpc1,swan_arnold]
if (%swansong < ^swan_coma) {
    ~chatnpc("<p,neutral>Arnold Lydspor. I keep the stores and the strongbox, and at the moment I keep them shut.");
    return;
}
if (%swansong = ^swan_coma) {
    ~chatplayer("<p,quiz>Herman's book.");
    ~chatnpc("<p,neutral>On his desk. He has not been near the desk since they carried the old man in.");
    ~mesbox("The Wise Old Man is asleep on the floor of the office with a blanket over him and a chair beside him. | Whatever he was going to do about the sea trolls, he did not write any of it down.");
    if (inv_total(inv, swan_book) > 0) {
        return;
    }
    if (inv_freespace(inv) < 2) {
        ~chatnpc("<p,neutral>You have nowhere to put it.");
        return;
    }
    inv_add(inv, swan_book, 1);
    inv_add(inv, swan_army, 1);
    %swansong = ^swan_seeds;
    ~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
    ~chatnpc("<p,neutral>And this was in his hand when they put him down. It is a packet of seeds and it weighs nothing and the label on it is not funny.");
    return;
}
~chatnpc("<p,neutral>Stores and strongbox.");

[opnpc4,swan_arnold] @openbank;

// =========================================================================== the battle
// FIXED: this was [opnpc1,swan_skeleton_training], and that npc carries op2=Attack and nothing
// else - there is no Talk-to on a skeletal magus, so the trigger could never fire and the battle
// could not be started. Herman starts it; he is the one counting the palisade.

[label,swan_battle_scene]
if (%swansong = ^swan_queen) {
    @swan_queen_beaten;
}
if (%swansong = ^swan_battle) {
    ~chatnpc("<p,scared>She is still out there, and there is nobody else left standing. Finish it.");
    ~swan_queen_send;
    return;
}
if_close;
mes("The skeletal magi form up along the palisade without being told to, which is the most unsettling part of the whole thing.");
p_delay(5);
%swansong = ^swan_battle;
%swansong_trolls = 3;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
~mesbox("The sea trolls come up out of the fishing grounds for the twelfth day running and for the first time something is standing there waiting for them.");
p_delay(4);
~swan_battle_hit(14);
mes("The magi go through the small ones a rank at a time and none of them stop.");
p_delay(4);
~mesbox("The Wise Old Man puts the Sea Troll General down himself. Then the water hits him, all of it at once, and he does not get up.");
p_delay(3);
~swan_queen_send;

// THE SEA TROLL QUEEN IS A FIGHT, NOT A PARAGRAPH. She is level 170 with an Attack op and had no
// statblock at all - the seventh npc in this pass with a level, an op and nothing behind it - and
// this label used to narrate her death with two mesboxes and thirty-four points of ~damage_self.
// In OSRS the Wise Old Man is taken out by a 254 before she is even up and you kill her on your
// own: 200 hitpoints, Water Wave for 37, a crush for 16, and she does not move.
[proc,swan_queen_send]()()
if (npc_find(^swan_queen_spawn, swan_seatroll_queen, 16, ^false) = true) {
    return;
}
npc_add(^swan_queen_spawn, swan_seatroll_queen, ^swan_queen_despawn);
npc_setmode(opplayer2);
~mesbox("Something comes out of the water that the small ones were in front of. | It is the reason the Wise Old Man is asleep on a floor, and there is nobody else left to do this.");

[ai_queue3,swan_seatroll_queen]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
queue(swan_queen_down, 0, 0);

[queue,swan_queen_down]
if (%swansong ! ^swan_battle) {
    return;
}
%swansong = ^swan_queen;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
~mesbox("She goes back into the water and does not come up. | Seventy-one people come out of the buildings very slowly.");

[label,swan_queen_beaten]
~chatplayer("<p,neutral>She is dead.");
~chatnpc("<p,happy>I watched the whole of it from the gate. I have never been so pleased to be useless.");
%swansong = ^swan_told;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);


// 48 damage across the scene, and nothing requires the Hitpoints to take it: a player who died
// part-way through was left at ^swan_battle, which nobody's dialogue picks up again. The battle
// hurts, but it leaves you standing.
[proc,swan_battle_hit](int $amount)()
def_int $hp = stat(hitpoints);
if ($hp <= 1) {
    return;
}
~damage_self(min($amount, sub($hp, 1)));

[label,swan_finish]
~chatplayer("<p,neutral>It's over.");
~chatnpc("<p,sad>Seventy-one. I counted them twice and then I went and counted the one in my office, who is still asleep.");
if_close;
mes("Herman Caranos sits down on the ground outside his own colony for the first time in twelve days.");
p_delay(5);
%swansong = ^swan_complete;
// The Prayer experience and the twenty-five thousand coins were both missing. The Fishing stays
// at the 10,000 the quest paid when it was written - the 50,000 on the wiki is a November 2022
// rebalance of a modern economy, and this server is 2006.
stat_advance(fishing, 100000);
stat_advance(magic, 150000);
stat_advance(prayer, 100000);
if (inv_freespace(inv) > 0) {
    inv_add(inv, coins, 25000);
} else {
    obj_add(coord, coins, 25000, ^lootdrop_duration);
}
session_log(^log_adventure, "Quest complete: Swan Song");
~send_quest_complete(questlist:swansong, swan_monkfish, 200, ^swan_questpoints, "You have completed\\nSwan Song!", "2 Quest Points|15,000 Magic XP|10,000 Prayer XP|10,000 Fishing XP|25,000 coins");

// =========================================================================== Draynor
//
// Herman's letter goes to "a man in Draynor who is supposed to be the best magician alive and who
// has spent thirty years pretending to be a pensioner", and until the Wise Old Man was placed at
// 3088,3251 there was nobody there to read it. areas/area_draynor/scripts/wise_old_man.rs2 owns
// [opnpc1] on him and calls this. He wants the runes the wiki's version wants - ten mist, ten lava,
// five blood - and then he takes the morning boat himself.
[proc,swan_wom_wants]()(boolean)
if (%swansong = ^swan_letter) {
    return(true);
}
return(false);

[label,swan_wom_draynor_talk]
~chatplayer("<p,neutral>Herman Caranos of the Piscatoris fishing colony has written to you five times.");
~chatnpc("<p,neutral>Four times. The fifth one had somebody else's handwriting on the envelope, which is why I opened it.");
~chatplayer("<p,quiz>Will you come?");
~chatnpc("<p,happy>Almost certainly. I have never seen a sea troll and I am eighty-one.");
~chatnpc("<p,neutral>I shall want runes, though. Ten mist, ten lava and five blood. I am not walking into a siege on a hunch and a walking stick.");
if (inv_total(inv, mistrune) < 10 | inv_total(inv, lavarune) < 10 | inv_total(inv, bloodrune) < 5) {
    ~mesbox("He wants ten mist runes, ten lava runes and five blood runes. | You have <tostring(inv_total(inv, mistrune))> mist, <tostring(inv_total(inv, lavarune))> lava and <tostring(inv_total(inv, bloodrune))> blood.");
    return;
}
inv_del(inv, mistrune, 10);
inv_del(inv, lavarune, 10);
inv_del(inv, bloodrune, 5);
if_close;
mes("The Wise Old Man counts the runes into a pocket of his dressing gown and gets up without using the stick.");
p_delay(4);
%swansong = ^swan_wom;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
~mesbox("The boat comes back the next morning with one passenger on it, and he is extremely old and he is carrying nothing at all.");
