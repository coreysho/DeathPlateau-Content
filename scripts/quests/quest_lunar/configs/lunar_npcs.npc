[suqah]
// rev 474 npc 4527
name=Suqah
desc=Suqah.
model1=npc_suqah_1
model2=npc_suqah_2
model3=npc_suqah_3
model4=npc_suqah_4
size=2
readyanim=seq_474_4386
walkanim=seq_474_4383
resizeh=134
resizev=128
op2=Attack
vislevel=111
param=attack_anim,seq_474_4384
param=death_anim,seq_474_4389
// Combat, from the OSRS wiki: level 111, 105 hitpoints, max hit 10, 6-tick stab attack, and the
// defences the quest's own strategy pages quote (stab 50, slash 70, crush 70, magic 90, range 50) -
// the 25 June 2025 earth weakness and the ranged-defence cut are much later and are not here. The
// magic-casting northern variety is not imported: every Suqah on the island melees.
hitpoints=105
attack=95
strength=95
defence=95
param=attackrate,6
param=damagetype,^stab_style
param=stabdefence,50
param=slashdefence,70
param=crushdefence,70
param=magicdefence,90
param=rangedefence,50
param=death_drop,big_bones
wanderrange=5
maxrange=8
respawnrate=50
huntmode=aggressive_melee
huntrange=5

