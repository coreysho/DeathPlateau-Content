// The Great Brain Robbery (20 November 2006). Items imported from the rev 474 cache (474 obj
// 10884-10904) by tools/models/import474.py; models copied byte-for-byte, since 474 writes the
// same model format the 377 client reads. The examine strings and the weights are the OSRS
// cache's own records for the same ids - the 474 obj records carry no examine opcode.
//
// NOT IMPORTED, because the 377 cache already has them: the fishbowl helmet and the diving
// apparatus are obj 7534 and 7535 here too (hundred_pirate_diving_helmet and
// hundred_pirate_diving_backpack, Recipe for Disaster's Freeing Pirate Pete, which Murphy hands
// out at Port Khazard). The import appended a second pair before that was noticed; the configs
// were deleted again and the two obj.pack ids they took, 11513 and 11514, are left as a gap.
// This quest wears Murphy's pair, so there is one set of diving gear in the game.
//
// The barrelchest anchor itself is quests/quest_deal/configs/barrelchest_anchor.obj, imported from
// Old School when Rum Deal was built. It was hung on Rum Deal's completion then, because this
// quest did not exist; it is this quest's reward now, and that file says so.

// THE PRAYER BOOK, in two states. 474 obj 10886 carries no ops at all and 10890 carries Read and
// Recite-prayer, which leaves no way to read the first one, so the Read on the unread copy is
// added here by hand: the wiki's order is take it off the shelf, read it, and only then can it be
// recited. Both records are the cache's art.
[tgbr_prayer_book_unread]
name=Prayer book
desc=Used to cure poison through prayer.
model=obj_tgbr_prayer_book
recol1s=13504
recol1d=8354
iop1=Read
weight=100g
members=yes
tradeable=no

[tgbr_prayer_book]
name=Prayer book
desc=Used to cure poison through prayer.
model=obj_tgbr_prayer_book_read
2dzoom=854
2dxan=277
2dyan=1936
iop1=Read
iop2=Recite-prayer
weight=50g
members=yes
tradeable=no

// THE BLESSED LAMP. Old School's grants 5,000 experience in one skill the player already has
// level 30 in, which is not what the genie lamp does (that one scales with the skill's level), so
// general/scripts/xplamp/xplamp.rs2 was taught the difference rather than this being pointed at
// the existing lamp.
[tgbr_blessed_lamp]
name=Blessed lamp
desc=This will answer my prayers.
model=obj_tgbr_blessed_lamp
2dxof=2
2dyof=-2
2dzoom=840
2dxan=28
2dyan=228
iop1=Pray-over
iop5=Destroy
weight=100g
members=yes
tradeable=no

