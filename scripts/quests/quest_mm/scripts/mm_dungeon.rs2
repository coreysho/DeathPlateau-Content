[zoneexit,1_42_143_56_40] cleartimer(mm_dungeon_trap);

// ---------------------------------------------------------------------------------------------------
// What is underfoot
// ---------------------------------------------------------------------------------------------------
[timer,mm_dungeon_trap]
// THE FLOOR SPIKES ARE NOT HIDDEN and they are not a chance: they are drawn, they are animating, and
// standing on them hits you until you move. One tile each, so the player's own coord is exact.
if (loc_find(coord, mm_floorspikes) = true) {
    say("Ouch!");
    queue(damage_player, 0, ^mm_floorspike_damage);
    return;
}
// THE SPEAR TRAP IS WIDTH 2, which loc_find does not know about - it only ever matches a loc's
// origin tile. At an even angle the second tile is east of the origin and at an odd angle it is
// north of it, so the origin of a trap covering this tile is either here, one west, or one south.
// A failed loc_find leaves the active loc alone, so whichever of the three matches is the one
// loc_anim fires.
if (loc_find(coord, mm_speartrap) = true | loc_find(movecoord(coord, -1, 0, 0), mm_speartrap) = true | loc_find(movecoord(coord, 0, 0, -1), mm_speartrap) = true) {
    loc_anim(speartrap_release);
    say("Ouch!");
    queue(damage_player, 0, calc(((stat(hitpoints) * 10) / 100) + 1));
    // Old School: the small hidden spike traps poison, and the poison "fades quickly". ^mm_speartrap_poison
    // is the shortest severity the cache uses on any npc.
    queue(poison_player, 0, ^mm_speartrap_poison);
    return;
}
// AND THE SPRING TRAP, whose trigger sits on the middle tile of its own stalagmites - 2692,9109
// under 2692-2694,9109 and 2743,9146 under 2743,9145-9147 - so the trigger coord is exact and the
// stalagmites are one west of it at an even angle and one south at an odd one.
if (loc_find(coord, mm_double_springtrap_trigger) = true) {
    if (loc_find(movecoord(loc_coord, -1, 0, 0), mm_double_springtrap) = true | loc_find(movecoord(loc_coord, 0, 0, -1), mm_double_springtrap) = true) {
        loc_anim(double_springtrap_release);
    }
    say("Ouch!");
    queue(damage_player, 0, calc(((stat_base(hitpoints) * 8) / 100) + 1));
    world_delay(1);
    loc_anim(double_springtrap_reset);
}

// ---------------------------------------------------------------------------------------------------
// Searching the rock, and laying a plank over it
// ---------------------------------------------------------------------------------------------------
// Both are upass_double_springtrap_trigger's, because it is the same trap: there is no way to disarm
// it and the way past is a plank. mm_crossing_plank is in the cache for exactly this and was
// referenced by nothing.
[oploc1,mm_double_springtrap_trigger]
~mesbox("The rock shifts a little under your hand...|It is a trap, and there is nothing on it to disarm.|Something laid across it would do.");

[oplocu,mm_double_springtrap_trigger]
if (last_useitem ! woodplank) {
    ~mesbox("That is not going to bridge anything.");
    return;
}
mes("You lay the plank across the flat rock...");
anim(human_pickupfloor, 0);
sound_synth(put_down, 1, 0);
p_delay(1);
mes("...and walk over before it settles.");
loc_del(5);
if (coordz(coord) > coordz(loc_coord)) {
    loc_add(loc_coord, mm_crossing_plank, 0, grounddecor, 5);
    ~forcemove(movecoord(loc_coord, 0, 0, -1));
} else if (coordz(coord) < coordz(loc_coord)) {
    loc_add(loc_coord, mm_crossing_plank, 0, grounddecor, 5);
    ~forcemove(movecoord(loc_coord, 0, 0, 1));
} else if (coordx(coord) > coordx(loc_coord)) {
    loc_add(loc_coord, mm_crossing_plank, 1, grounddecor, 5);
    ~forcemove(movecoord(loc_coord, -1, 0, 0));
} else {
    loc_add(loc_coord, mm_crossing_plank, 1, grounddecor, 5);
    ~forcemove(movecoord(loc_coord, 1, 0, 0));
}
