// Monkey Madness, stage one - the Grand Tree, the hangar, Crash Island, and the crossing to Ape Atoll.
// See configs/quest_mm.constant for what the cache already ships and for the list of what is not
// built yet. The quest starts off King Narnode, whose handler lives in quest_grandtree and is jumped
// into from there.

// --- King Narnode ---
// Jumped to from [opnpc1,grandtree_narnode] once The Grand Tree is complete.

[label,mm_narnode]
if (%mm_main >= ^mm_started) {
    @mm_narnode_progress;
}
~chatplayer("<p,happy>Hello your highness!");
~chatnpc("<p,sad>Ah... Traveller. I am glad it is you and not another of my advisors.");
~chatplayer("<p,quiz>Is something wrong?");
~chatnpc("<p,sad>The 10th Squad. My finest soldiers. I sent them out months ago and not one of them has come home.");
~chatplayer("<p,quiz>Sent them where?");
~chatnpc("<p,worried>That is the difficulty. Officially I sent them nowhere at all, and officially I am not asking you to find them.");
~chatnpc("<p,neutral>Glough had his fingers in more than the shipyard, Traveller. Some of what he started did not stop when he did.");
~chatplayer("<p,quiz>So who do I talk to?");
~chatnpc("<p,neutral>Daero. He drinks in the Blurberry bar upstairs, and he knows every unofficial thing this stronghold has ever done. Tell him I sent you.");
%mm_main = ^mm_started;
~send_quest_progress(questlist:mm, 1, ^mm_complete);
// The seal and the orders are what Garkor will accept in place of a name. Both objs exist in the
// cache - "the official Gnome Royal Seal, signed by King Narnode Shareen" and "unreadable orders
// handwritten by King Narnode Shareen" - and nothing gave either of them out.
if (inv_freespace(inv) >= 2) {
    inv_add(inv, mm_gnome_royal_seal, 1);
    inv_add(inv, mm_narnode_orders, 1);
    ~objbox(mm_gnome_royal_seal, "The King presses his seal into your hand, with a folded order underneath it.", 250, 0, divide(^objbox_height, 2));
    ~chatnpc("<p,neutral>Whoever you find out there will want to see that before they believe a word.");
}
~chatnpc("<p,worried>And Traveller - do not tell my advisors.");

[label,mm_narnode_progress]
if (%mm_main = ^mm_demon_dead) {
    @mm_narnode_finish;
}
~chatplayer("<p,happy>Hello your highness!");
switch_int (%mm_main) {
    case ^mm_started, ^mm_daero_briefed :
        ~chatnpc("<p,neutral>Daero. Upstairs, in the bar. He will not look pleased to see you; that is simply his face.");
    case ^mm_in_hangar :
        ~chatnpc("<p,shock>You found the hangar? Then you have already seen more than I am supposed to know about.");
    case ^mm_crash_island, ^mm_ape_atoll :
        ~chatnpc("<p,worried>You have been out there. Tell me when you find them, Traveller. Only when you find them.");
        // The seal can be dropped, and without it Garkor will not talk. He can always cut another.
        if (~obj_gettotal(mm_gnome_royal_seal) < 1 & inv_freespace(inv) >= 1) {
            ~chatplayer("<p,sad>I've lost your seal.");
            ~chatnpc("<p,neutral>Then take another. I have a drawer of them and only one stronghold.");
            inv_add(inv, mm_gnome_royal_seal, 1);
        }
    case ^mm_has_sigil :
        ~chatnpc("<p,worried>Garkor has given you his own sigil. Be careful what you do with it.");
    case ^mm_complete :
        if (%mm_daero < ^mm_daero_paid) {
            ~chatnpc("<p,happy>Daero is waiting to make a soldier of you. Do not keep him.");
        } else {
            ~chatnpc("<p,happy>The gnomes and the monkeys, allies. Glough would be furious, and that is the best part.");
        }
    case default :
        ~chatnpc("<p,happy>Better than ever, thanks to you!");
}

// --- Daero ---
// Placed twice: m38_54 p1 (52,30) in the Blurberry bar, and m41_70 (24,34) in the hangar. Which one
// you are standing in front of is read off the npc's own coordinate, not off a quest stage, because
// the Grand Tree copy is still there after you have been taken down.

[opnpc1,mm_daero]
if (inzone(^mm_hangar_zone_min, ^mm_hangar_zone_max, npc_coord) = true) {
    @mm_daero_hangar;
}
if (%mm_main < ^mm_started) {
    ~chatplayer("<p,happy>Hello.");
    ~chatnpc("<p,neutral>I'm drinking. Whatever it is, ask someone with a desk.");
    return;
}
if (%mm_main = ^mm_complete) {
    @mm_daero_reward;
}
// HE TAKES YOU DOWN EVERY TIME YOU ASK. He used to say "you know the way down now" the moment he
// had taken you once, and there is no way down: ^mm_hangar_arrive is reached by this conversation
// and by Waydar flying in from Crash Island, and Crash Island is only reachable from the hangar. So
// one trip down and out through the bunker pad left Ape Atoll unreachable for the rest of the
// quest, which sends you back to it three more times.
if (%mm_main >= ^mm_daero_briefed) {
    @mm_daero_offer_trip;
}
// The three topics are the cache's own mm_daero_option_bit_one/two/three. Read as the three things
// you get to ask him about before he will take you anywhere; each is remembered so he does not
// repeat himself, and when all three are done the trip is offered.
~chatplayer("<p,neutral>King Narnode sent me. It's about the 10th Squad.");
~chatnpc("<p,angry>Did he. In a bar. Sit down and keep your voice at that level.");
@mm_daero_topics;

[label,mm_daero_topics]
def_int $one = %mm_daero_option_bit_one;
def_int $two = %mm_daero_option_bit_two;
def_int $three = %mm_daero_option_bit_three;
if ($one = 1 & $two = 1 & $three = 1) {
    %mm_main = ^mm_daero_briefed;
    ~send_quest_progress(questlist:mm, 2, ^mm_complete);
    @mm_daero_offer_trip;
}
def_int $choice = ~p_choice3(
    "Where did the 10th Squad actually go?", 1,
    "Why can't the King ask about it himself?", 2,
    "What do you need me to do?", 3);
if ($choice = 1) {
    ~chatplayer("<p,quiz>Where did the 10th Squad actually go?");
    ~chatnpc("<p,neutral>South. A long way south, past Karamja, to an island that isn't on any gnome chart because we drew the charts.");
    ~chatnpc("<p,sad>They were told it was a reconnaissance. It was not a reconnaissance.");
    %mm_daero_option_bit_one = 1;
} else if ($choice = 2) {
    ~chatplayer("<p,quiz>Why can't the King ask about it himself?");
    ~chatnpc("<p,angry>Because the order that sent them out has Glough's handwriting on it and the King's seal underneath, and only one of those two knew what he was signing.");
    ~chatnpc("<p,neutral>Narnode can send you. He cannot send an army without admitting there was something to send it about.");
    %mm_daero_option_bit_two = 1;
} else {
    ~chatplayer("<p,quiz>What do you need me to do?");
    ~chatnpc("<p,neutral>Go and look. That is all. Find them, or find out what happened to them.");
    ~chatnpc("<p,neutral>I can get you as far as the water. After that you are on your own, and you will want to be armed.");
    %mm_daero_option_bit_three = 1;
}
@mm_daero_topics;

[label,mm_daero_offer_trip]
if (%mm_main > ^mm_daero_briefed) {
    // He has done this before, and says so rather than pretending the hangar is still a secret.
    ~chatnpc("<p,neutral>Back again. Blindfold, same as last time - I am not having you learn the way.");
} else {
    ~chatnpc("<p,neutral>There is a hangar under this tree that the stronghold does not have. Do you want to see it?");
}
def_int $go = ~p_choice2("Yes. Take me down.", 1, "Not just yet.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>Not just yet.");
    ~chatnpc("<p,neutral>It will still be there. So will I.");
    return;
}
~chatplayer("<p,neutral>Yes. Take me down.");
~chatnpc("<p,neutral>Then you wear this, and you do not take it off until I say.");
// The stage moves before the pausing calls below, so a player who clicks away mid-cutscene is still
// counted as having made the trip rather than being left half-way through it.
if (%mm_main < ^mm_in_hangar) {
    %mm_main = ^mm_in_hangar;
    ~send_quest_progress(questlist:mm, 3, ^mm_complete);
}
~mesbox("Daero ties a strip of cloth over your eyes. You are led down a great many stairs, along something that echoes, and down a great many more.");
p_telejump(^mm_hangar_arrive);
~mesbox("The blindfold comes off. You are standing in a lit cavern the size of the Grand Tree's roots, and most of it is taken up by gliders.");

[label,mm_daero_hangar]
~chatplayer("<p,quiz>So what is all this?");
~chatnpc("<p,neutral>Officially, nothing. Waydar over there flies the only one of these that still has a pilot. Talk to him when you are ready to leave.");
~chatnpc("<p,worried>And do not touch the levers.");

// --- Waydar ---
// Placed at m41_70 (24,39) in the hangar and at m45_42 (17,39) on Crash Island, so he is the whole
// round trip on his own.

[opnpc1,mm_waydar]
if (%mm_main < ^mm_in_hangar) {
    ~chatnpc("<p,neutral>Nobody flies without Daero saying so.");
    return;
}
if (inzone(^mm_crash_island_min, ^mm_crash_island_max, npc_coord) = true) {
    @mm_waydar_return;
}
~chatplayer("<p,quiz>Daero says you can fly me out.");
~chatnpc("<p,neutral>He would. It's a two-seater and the second seat is where the cargo goes, so mind your knees.");
def_int $go = ~p_choice2("Let's go.", 1, "Give me a minute.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>Give me a minute.");
    ~chatnpc("<p,neutral>Take two. I'm not going anywhere.");
    return;
}
~chatplayer("<p,neutral>Let's go.");
if (%mm_main < ^mm_crash_island) {
    %mm_main = ^mm_crash_island;
    ~send_quest_progress(questlist:mm, 4, ^mm_complete);
}
@mm_travel(^mm_crash_island_arrive, "The glider drops out of the hangar mouth, and for a long time there is nothing under you but water. Then there is an island.");

[label,mm_waydar_return]
~chatplayer("<p,quiz>Can you take me back?");
~chatnpc("<p,neutral>To the hangar, yes. Anywhere a gnome would admit to, no.");
def_int $go = ~p_choice2("The hangar will do.", 1, "I'll stay here.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>I'll stay here.");
    ~chatnpc("<p,neutral>Suit yourself. Watch the snakes.");
    return;
}
~chatplayer("<p,neutral>The hangar will do.");
@mm_travel(^mm_hangar_arrive, "The island falls away behind you, and a long while later the hangar mouth swallows the glider whole.");

// One label for both the glider and the boat: the two were byte-identical, and a trigger or label
// that exists twice in different words is the kind of thing that drifts apart later.
[label,mm_travel](coord $dest, string $arrival)
// ~pre_travel_checks, NOT ~pre_tele_checks: the glider and the boat are vehicles, and the one thing
// ~pre_tele_checks adds on top is the check that refuses to move Awowogei's monkey - which would
// mean the quest sending you to Ardougne for a monkey it then will not let you bring back. See the
// comment on both procs in skill_magic/scripts/spells/teleport.rs2.
if (~pre_travel_checks(coord) = false) {
    return;
}
if_close;
p_delay(1);
p_telejump($dest);
~mesbox($arrival);

// --- Lumdo ---
// Placed at m45_42 (11,36) beside the Crash Island rowboat and at m43_42 (51,19) beside the Ape Atoll
// one. Same two-ended arrangement as Waydar.

[opnpc1,mm_lumdo]
if (%mm_main < ^mm_crash_island) {
    ~chatnpc("<p,neutral>I row for the squad, not for tourists.");
    return;
}
if (inzone(^mm_crash_island_min, ^mm_crash_island_max, npc_coord) = false) {
    @mm_lumdo_return;
}
if (%mm_main < ^mm_ape_atoll) {
    ~chatplayer("<p,quiz>What's across the water?");
    ~chatnpc("<p,worried>The place the squad went. I rowed them over myself and I have rowed nobody back.");
    ~chatnpc("<p,neutral>Garkor is still there. He signals sometimes. The rest, I don't know.");
    ~chatplayer("<p,quiz>Will you take me?");
    ~chatnpc("<p,angry>I'll take you. I won't wait long, and I won't come looking.");
}
def_int $go = ~p_choice2("Take me across.", 1, "Not yet.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>Not yet.");
    ~chatnpc("<p,neutral>Sensible.");
    return;
}
~chatplayer("<p,neutral>Take me across.");
if (%mm_main < ^mm_ape_atoll) {
    %mm_main = ^mm_ape_atoll;
    ~send_quest_progress(questlist:mm, 5, ^mm_complete);
}
@mm_travel(^mm_ape_atoll_arrive, "Lumdo rows you across in silence and puts you ashore on a beach under a wall of jungle. He does not get out of the boat.");

[label,mm_lumdo_return]
~chatplayer("<p,quiz>Back to the island, please.");
def_int $go = ~p_choice2("Yes, get me out of here.", 1, "Actually, I'll stay.", 2);
if ($go = 2) {
    ~chatplayer("<p,neutral>Actually, I'll stay.");
    ~chatnpc("<p,worried>Then keep to the beach.");
    return;
}
~chatplayer("<p,neutral>Yes, get me out of here.");
@mm_travel(^mm_crash_island_boat, "Lumdo has the boat off the sand before you are properly sitting down.");


// --- The way out of the hangar ---
// Without this the hangar is a trap: Waydar only flies between the hangar and Crash Island, Lumdo only
// rows between Crash Island and Ape Atoll, and nothing else on m40_70 leads anywhere. The cache's own
// answer is the bunker_teleport pad at (29,14) - op1=Operate, "some kind of Gnome teleportation
// device" - with a bunker_exitsign pointing at it from (32,14). It had no handler.

[oploc1,bunker_teleport]
if (%mm_main < ^mm_in_hangar) {
    mes("Nothing happens. Whatever this is, it is not listening to you.");
    return;
}
mes("You step onto the pad and press the only button on it.");
p_delay(2);
~mesbox("The cavern folds itself away and you are standing on the walkway outside the Blurberry bar, several hundred feet above where you were.");
p_telejump(^mm_grand_tree_return);


// ===================================================================================================
// STAGE TWO - Ape Atoll: Garkor, the tunnels, and the M'speak amulet
// ===================================================================================================

// --- Garkor ---
// The 10th Squad's commander, placed at m43_43 (53,10) beside the temple. He has been on this island
// for months and has no reason to believe a human who walks up out of the jungle, which is what
// King Narnode's seal is for.

[opnpc1,mm_garkor]
if (%mm_main < ^mm_ape_atoll) {
    return;
}
if (%mm_main > ^mm_met_garkor) {
    @mm_garkor_progress;
}
if (inv_total(inv, mm_gnome_royal_seal) < 1) {
    ~chatnpc("<p,angry>Stop there. A human, walking about on Ape Atoll as though it were a market.");
    ~chatplayer("<p,neutral>King Narnode sent me.");
    ~chatnpc("<p,angry>Everyone says that. Show me something that says it for you.");
    return;
}
~chatplayer("<p,neutral>King Narnode sent me. This is his seal.");
~chatnpc("<p,shock>...that is his seal. That is actually his seal.");
~chatnpc("<p,sad>Then he got my message. Six of us landed. Four of us are still standing, and two of those are in a cage.");
~chatplayer("<p,quiz>What happened?");
~chatnpc("<p,neutral>Glough's business. The monkeys here are being made ready for something, and we came to find out what, and we cannot ask them because we cannot talk to them.");
~chatplayer("<p,quiz>So teach me the language.");
~chatnpc("<p,laugh>You cannot learn it. Your mouth is the wrong shape. Zooknock can get around that - he is our mage, and he is in the tunnels under the island.");
// The mould and the dentures are handed over here rather than being scattered around the island.
// Flagged as an interpretation: the cache ships both objs and the three mm_zooknock_has_* varbits
// that consume them, but nothing in it says where either one is meant to come from. Having the squad
// that has been camped here for months already hold them keeps the chain non-circular - you cannot
// be sent to ask a monkey for the thing that lets you talk to monkeys.
if (inv_freespace(inv) < 2) {
    ~chatnpc("<p,neutral>I have two things to give you and you have nowhere to put them. Come back with your hands free.");
    return;
}
inv_add(inv, mm_monkey_amulet_mould, 1);
inv_add(inv, mm_monkey_dentures, 1);
%mm_main = ^mm_met_garkor;
~send_quest_progress(questlist:mm, 6, ^mm_complete);
~objbox(mm_monkey_amulet_mould, "Garkor hands you an amulet mould shaped like a monkey's head, and a set of dentures that are still chattering.", 250, 0, divide(^objbox_height, 2));
~chatnpc("<p,neutral>Zooknock needs those and a gold bar. Bring him all three. The tunnel mouth is on the west shore.");
~chatnpc("<p,worried>And human - the tunnels are worse than the island.");

[label,mm_garkor_progress]
~chatplayer("<p,happy>Garkor.");
if (%mm_main >= ^mm_alliance) {
    @mm_garkor_stage3;
}
switch_int (%mm_main) {
    case ^mm_zooknock_briefed :
        ~chatnpc("<p,neutral>Zooknock is waiting on you. A gold bar, the mould and the dentures.");
    case ^mm_has_amulet :
        ~chatnpc("<p,happy>You can hear them now, can't you. Go and listen to what they say when they think nobody understands.");
    case default :
        ~chatnpc("<p,neutral>Keep out of the open, human.");
}

// --- Zooknock ---
// The squad's mage, at m43_142 (52,57), the far corner of the tunnels from the entrance at (11,15).
// Bunkwicket and Waymottin are placed either side of him and have no scripts yet.

[opnpc1,mm_zooknock]
if (%mm_main < ^mm_met_garkor) {
    ~chatnpc("<p,angry>How did you even get down here?");
    return;
}
if (%mm_main >= ^mm_has_amulet) {
    ~chatnpc("<p,happy>It holds, then. Good. I have never made one for a human mouth before.");
    @mm_zooknock_greegree;
}
if (%mm_main = ^mm_met_garkor) {
    %mm_main = ^mm_zooknock_briefed;
    ~send_quest_progress(questlist:mm, 7, ^mm_complete);
    ~chatplayer("<p,neutral>Garkor sent me. He said you could make me able to talk to them.");
    ~chatnpc("<p,neutral>He would say that. It is not a small thing.");
    ~chatnpc("<p,neutral>A gold bar, the mould he gave you, and the dentures. The dentures do the talking; the gold only holds them still.");
}
@mm_zooknock_check;

[label,mm_zooknock_check]
// Already carrying the enchanted bar: he has done his half, and asking him for another gold bar
// would read as the quest having lost track of itself.
if (inv_total(inv, mm_enchanted_gold_bar) > 0) {
    ~chatnpc("<p,neutral>You have the bar. I cannot pour it and neither can you, down here. The crypt under the temple of Marimbo, and keep hold of the mould.");
    return;
}
if (inv_total(inv, gold_bar) < 1) {
    ~chatnpc("<p,neutral>No gold bar. Bring me one and we can begin.");
    return;
}
if (inv_total(inv, mm_monkey_amulet_mould) < 1) {
    ~chatnpc("<p,neutral>Where is the mould? I am not carving one by hand.");
    return;
}
if (inv_total(inv, mm_monkey_dentures) < 1) {
    ~chatnpc("<p,neutral>And the dentures. Without those it is a lump of gold on a string.");
    return;
}
~chatplayer("<p,happy>I have all three.");
~chatnpc("<p,neutral>Then stand back and do not speak while I am counting.");
// HE DOES NOT FINISH IT. The real quest has Zooknock hand back an enchanted bar and your mould, and
// the pouring happens at a wall of fire in the crypt under the Temple of Marimbo - which is why
// mm_enchanted_gold_bar exists in the cache and why two walls of flame are placed down there. This
// used to forge the whole amulet here and the bar had no source at all.
//
// Everything is spent and granted in one block before the first pausing call, so a player who
// dismisses the message cannot lose a gold bar without gaining the enchanted one. The mould is NOT
// consumed: it is handed back, and it has to be in the pack at the flames.
inv_del(inv, gold_bar, 1);
inv_del(inv, mm_monkey_dentures, 1);
inv_add(inv, mm_enchanted_gold_bar, 1);
%mm_zooknock_has_gold_bar = 1;
%mm_zooknock_has_dentures = 1;
~objbox(mm_enchanted_gold_bar, "Zooknock holds the dentures against the bar until the gold takes them, and the bar starts chattering to itself.", 250, 0, divide(^objbox_height, 2));
~chatnpc("<p,neutral>That is the spirit in the metal. It is not an amulet yet, and I cannot make it one - there is no fire down here hot enough to pour gold.");
~chatplayer("<p,quiz>Where is there?");
~chatnpc("<p,neutral>Under the temple of Marimbo there is a crypt, and in the crypt there is a wall of fire that has been burning since before the monkeys could count. Hold the bar into that, with the mould in your hand.");
~chatnpc("<p,worried>Keep the mould. Without it you will pour a spirit onto a stone floor.");

// ===================================================================================================
// The wall of flames, in the crypt under the Temple of Marimbo
// ===================================================================================================
// Real step 30. mm_iban_firewall_straight and _diagonal are placed in two clusters down there
// (around 2809-2813,9189 and again at 9208-9211) and both are active=yes, so they take an item;
// neither had a handler. The way in - mm_temple_trapdoor and mm_climbing_rope_bottom_temple - was
// already built in mm_ladders.rs2, which is what made this the cheapest missing step in the quest.
// The last banana off a tree leaves mm_bananatreeempty, which must answer for itself: the shared
// [oploc1,_banana_tree] handler changes the loc to its next_loc_stage, and an empty tree has none.
// Giving it the category instead of its own trigger turned the sixth click into a script error.
[oploc1,mm_bananatreeempty]
mes("There are no bananas left on the tree.");

[oplocu,mm_iban_firewall_straight] @mm_firewall_pour;
[oplocu,mm_iban_firewall_diagonal] @mm_firewall_pour;

[label,mm_firewall_pour]
if (last_useitem ! mm_enchanted_gold_bar) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, mm_monkey_amulet_mould) = 0) {
    ~mesbox("The bar goes soft almost at once and you have nothing to pour it into. Zooknock did say to keep the mould.");
    return;
}
p_arrivedelay;
if_close;
mes("You hold the bar into the wall of fire.");
sound_synth(lava_bowl_pour, 1, 0);
p_delay(4);
inv_del(inv, mm_enchanted_gold_bar, 1);
inv_add(inv, mm_amulet_of_monkey_speak_without_string, 1);
%mm_zooknock_has_amulet_mould = 1;
~objbox(mm_amulet_of_monkey_speak_without_string, "The gold runs into the mould and sets almost before you have taken it out of the flames. It is chattering quietly to itself. It has no string.", 250, 0, divide(^objbox_height, 2));

// Stringing is the ordinary amulet pattern. [opheldu,X] fires for both click orders - OpHeldUHandler
// tries the target item's trigger first and then the used item's, swapping the pointers - so inside
// this trigger last_useitem is always the other item.
[opheldu,mm_amulet_of_monkey_speak_without_string]
def_obj $used = last_useitem;
if ($used ! ball_of_wool) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, mm_amulet_of_monkey_speak_without_string, 1);
inv_del(inv, ball_of_wool, 1);
inv_add(inv, mm_amulet_of_monkey_speak, 1);
if (%mm_main < ^mm_has_amulet) {
    %mm_main = ^mm_has_amulet;
    ~send_quest_progress(questlist:mm, 8, ^mm_complete);
}
mes("You string the amulet.");
~mesbox("The chattering resolves itself into words. Somewhere above you, an island full of monkeys is having a conversation you can suddenly follow.");

// --- The monkeys you can now talk to ---
// The payoff for the amulet rather than a prerequisite for it. All three are placed on m42_43: the
// child at (55,43), its aunt at (50,42) and its uncle on p1 at (49,41).

[proc,mm_can_speak_monkey]()(boolean)
if (inv_total(worn, mm_amulet_of_monkey_speak) > 0) { return(true); }
return(false);

[opnpc1,mm_monkey_child]
if (~mm_can_speak_monkey = false) {
    @mm_monkey_gibberish;
}
// Captured BEFORE any dialogue. ~chatnpc pauses on p_pausebutton, and the aunt check in
// @mm_child_talisman does an npc_find, so the child's own coordinate and uid have to be taken while
// they are still unambiguously his and handed to the label explicitly.
def_coord $child_at = npc_coord;
def_npc_uid $child_uid = npc_uid;
~chatnpc("<p,quiz>You're the human. You're much taller close up.");
~chatplayer("<p,happy>You can understand me?");
~chatnpc("<p,happy>You're wearing the shouty necklace. Everyone can understand you. Uncle says you'll get eaten.");
@mm_child_talisman($child_at, $child_uid);

[opnpc1,mm_monkeys_aunt]
if (~mm_can_speak_monkey = false) {
    @mm_monkey_gibberish;
}
~chatnpc("<p,angry>Don't talk to the child. Talk to me.");
~chatplayer("<p,neutral>Sorry.");
~chatnpc("<p,sad>Everyone with a spear is at the temple and everyone without one is here. That is the whole of it.");

[opnpc1,mm_monkeys_uncle]
if (~mm_can_speak_monkey = false) {
    @mm_monkey_gibberish;
}
~chatnpc("<p,neutral>A human wearing a talking necklace. I have been alive a long time and that is new.");
~chatplayer("<p,quiz>What's happening on this island?");
~chatnpc("<p,worried>Awowogei is what's happening. Ask at the temple, if you want to be a story the children tell.");

[label,mm_monkey_gibberish]
~chatnpc("<p,quiz>Ook ook. Eek?");
~chatplayer("<p,confused>I have absolutely no idea what that means.");

// --- Quest journal ---

[if_button,questlist:mm]
def_string $n = "Monkey Madness";
def_string $x;
if (%mm_main < ^mm_started) {
    $x = append($x, "@dbl@I can start this quest by speaking to @dre@King Narnode Shareen@dbl@ in|");
    $x = append($x, "@dbl@the @dre@Grand Tree@dbl@, once I have finished @dre@The Grand Tree@dbl@ and|");
    $x = append($x, "@dbl@@dre@Tree Gnome Village@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "@str@King Narnode's 10th Squad went south months ago on an order with|");
$x = append($x, "@str@Glough's handwriting on it, and none of them came back.|");
if (%mm_main = ^mm_started) {
    $x = append($x, "|@dbl@I should find @dre@Daero@dbl@, who drinks in the @dre@Blurberry bar@dbl@ on the|");
    $x = append($x, "@dbl@first floor of the Grand Tree.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Daero knows where they went, and can get me as far as the water.|");
if (%mm_main = ^mm_daero_briefed) {
    $x = append($x, "|@dbl@@dre@Daero@dbl@ has offered to take me down to a hangar the stronghold|");
    $x = append($x, "@dbl@does not officially have.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@There is a hidden glider hangar under the Grand Tree.|");
if (%mm_main = ^mm_in_hangar) {
    $x = append($x, "|@dbl@@dre@Waydar@dbl@ will fly me out from the hangar when I am ready. I|");
    $x = append($x, "@dbl@should go armed.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Waydar flew me to a small island a long way south of Karamja.|");
if (%mm_main = ^mm_crash_island) {
    $x = append($x, "|@dbl@@dre@Lumdo@dbl@ rowed the squad across from here and has rowed nobody|");
    $x = append($x, "@dbl@back. He will take me if I ask.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Lumdo rowed me across to the island the squad went to.|");
if (%mm_main = ^mm_ape_atoll) {
    $x = append($x, "|@dbl@@dre@Garkor@dbl@ commands what is left of the 10th Squad and is|");
    $x = append($x, "@dbl@somewhere near the @dre@temple@dbl@. He will want to see the @dre@royal seal@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Garkor took the King's seal. Four of the six are alive and two of|");
$x = append($x, "@str@those are caged. Nobody can question the monkeys because nobody|");
$x = append($x, "@str@can speak to them.|");
if (%mm_main = ^mm_met_garkor) {
    $x = append($x, "|@dbl@@dre@Zooknock@dbl@ is in the tunnels under the island - the entrance is|");
    $x = append($x, "@dbl@on the @dre@west shore@dbl@. I have the mould and the dentures; I will|");
    $x = append($x, "@dbl@also need a @dre@gold bar@dbl@.");
    ~quest_journal($n, $x);
    return;
}
if (%mm_main = ^mm_zooknock_briefed) {
    $x = append($x, "|@dbl@@dre@Zooknock@dbl@ needs a @dre@gold bar@dbl@, the @dre@M'amulet mould@dbl@ and the|");
    $x = append($x, "@dbl@@dre@monkey dentures@dbl@ to make the amulet.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Zooknock cast the amulet and I strung it. I can understand every|");
$x = append($x, "@str@monkey on the island.|");
if (%mm_main = ^mm_has_amulet) {
    $x = append($x, "|@dbl@Understanding them is not the same as passing for one. @dre@Zooknock@dbl@|");
    $x = append($x, "@dbl@can fix that, with a real @dre@monkey talisman@dbl@ and a set of @dre@monkey|");
    $x = append($x, "@dbl@bones@dbl@. A child in the @dre@banana garden@dbl@ has a talisman, and will|");
    $x = append($x, "@dbl@not say so while his aunt is standing over him.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@A monkey child lent me his talisman for five bananas.|");
if (%mm_main = ^mm_has_talisman) {
    $x = append($x, "|@dbl@@dre@Zooknock@dbl@ needs the @dre@talisman@dbl@ and a set of @dre@monkey bones@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Zooknock worked the talisman and the bones into a greegree. While|");
$x = append($x, "@str@I hold it I am a monkey, and Marim does not look at me twice.|");
if (%mm_main = ^mm_has_greegree) {
    $x = append($x, "|@dbl@The @dre@elder guards@dbl@ at the palace sent me to @dre@Kruk@dbl@, on the hill|");
    $x = append($x, "@dbl@west of Marim. He decides who gets to see the king.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@King Awowogei will ally with the gnomes for a price: one of his|");
$x = append($x, "@str@own, caged in Ardougne Zoo.|");
if (%mm_main = ^mm_met_awowogei) {
    $x = append($x, "|@dbl@I need to reach the @dre@Ardougne Zoo@dbl@ as a monkey, talk the|");
    $x = append($x, "@dbl@caged one into my pack, and @dre@walk him back@dbl@ - he will not|");
    $x = append($x, "@dbl@survive a teleport.");
    ~quest_journal($n, $x);
    return;
}
if (%mm_main = ^mm_has_zoo_monkey) {
    $x = append($x, "|@dbl@The monkey is in my pack. @dre@Awowogei@dbl@ is waiting, and I cannot|");
    $x = append($x, "@dbl@@dre@teleport@dbl@ while I am carrying him.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Awowogei has his monkey back, and the gnomes have their alliance.|");
if (%mm_main = ^mm_alliance) {
    $x = append($x, "|@dbl@I should tell @dre@Garkor@dbl@ - and tell him what the monkeys know|");
    $x = append($x, "@dbl@about what Glough left under the @dre@Grand Tree@dbl@.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@Garkor gave me the 10th Squad's sigil. Glough left something|");
$x = append($x, "@str@under the Grand Tree, and the squad are going down to it.|");
if (%mm_main = ^mm_has_sigil) {
    $x = append($x, "|@dbl@@dre@Wearing the sigil@dbl@ will put me where they are. I should go|");
    $x = append($x, "@dbl@armed, fed and prayed up - whatever is down there is a demon.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@str@The Jungle Demon is dead.|");
if (%mm_main = ^mm_demon_dead) {
    $x = append($x, "|@dbl@@dre@King Narnode@dbl@ needs to hear what his gardener kept in the|");
    $x = append($x, "@dbl@cellar, and he needs to hear it from me.");
    ~quest_journal($n, $x);
    return;
}
if (%mm_daero < ^mm_daero_paid) {
    $x = append($x, "|@str@I told King Narnode everything.|");
    $x = append($x, "|@dbl@@dre@Daero@dbl@ still owes me the training the King promised.");
    ~quest_journal($n, $x);
    return;
}
$x = append($x, "|@red@QUEST COMPLETE!");
~quest_journal($n, $x);
