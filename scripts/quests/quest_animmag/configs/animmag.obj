// Turael's own axe with its edge replaced by holy silver. It fights exactly as the mithril axe it
// was, but it has no woodcutting_struct param, so it cuts nothing in skill_woodcutting - "Blessed
// axes are too soft to cut normal wood since the axe's edge must be replaced by holy silver."
[animmag_blessed_axe]
name=Blessed axe
desc=A mithril axe with an edge of holy silver.
model=obj_animmag_blessed_axe
manwear=obj_animmag_blessed_axe_manwear,0
womanwear=obj_animmag_blessed_axe_manwear,6
2dxof=-15
2dzoom=1060
2dxan=520
2dyan=1196
iop2=Wield
iop5=Destroy
wearpos=righthand
cost=20
members=yes
tradeable=no
weight=40oz
category=weapon_axe
param=stabattack,-2
param=slashattack,12
param=crushattack,10
param=slashdefence,1
param=strengthbonus,13
param=levelrequire,21
param=attackrate,5
param=slashattack_anim,human_axe_hack
param=crushattack_anim,human_blunt_pound
param=slash_sound,baxe_slash
param=crush_sound,baxe_crush

