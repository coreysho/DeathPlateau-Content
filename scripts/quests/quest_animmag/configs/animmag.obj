// Animal Magnetism's items. Imported from the rev 474 cache (objs 10487-10500) by
// tools/models/import474.py - the 377 cache predates the quest (rev 377 is ~September 2006, the
// quest went live on 12 December 2006), so none of them are in scripts/_unpack/377/all.obj.
// Models are copied byte-for-byte; 474 uses the same model format the 377 client reads.
//
// What the cache does not carry - weight, category, combat params - is filled in here from the
// OSRS wiki's own item pages.

[animmag_undead_chicken]
name=Undead chicken
desc=It's an undead chicken. It doesn't smell great.
model=obj_animmag_undead_chicken
manwear=obj_animmag_undead_chicken,0
womanwear=obj_animmag_undead_chicken,0
2dxof=-9
2dyof=24
2dzoom=1308
2dxan=2047
2dyan=1853
2dzan=1895
iop2=Wield
iop5=Destroy
wearpos=righthand
cost=100
members=yes
tradeable=no
weight=2lb
// Ava's "Well, I have this one which I can use to club people." - it really is wieldable, and it
// really is a terrible weapon.
category=weapon_blunt
param=crushattack,-5
param=strengthbonus,-5
param=attackrate,5
param=crushattack_anim,human_blunt_pound
param=crush_sound,staff_hit

