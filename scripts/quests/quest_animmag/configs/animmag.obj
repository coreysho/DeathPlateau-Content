// AVA'S DEVICES. The cape-slot half of the reward. Stats from the OSRS wiki's own item pages:
// the attractor is +2 ranged attack and +2 magic defence, the accumulator +4 ranged attack,
// +1 slash defence and +4 magic defence. Their behaviour is in scripts/avas_device.rs2.
[avas_attractor]
name=Ava's attractor
desc=A great tangle of string and magnets. It attracts arrows.
model=obj_avas_attractor
manwear=obj_avas_attractor_manwear,0
womanwear=obj_avas_attractor_womanwear,0
2dxof=-4
2dyof=-1
2dzoom=976
2dxan=567
2dyan=1120
2dzan=1923
iop2=Wear
iop3=Toggle-attract
iop5=Destroy
wearop1=Toggle-attract
wearpos=back
cost=769
members=yes
tradeable=no
weight=8oz
category=armour_cape
param=rangeattack,2
param=magicdefence,2

[avas_accumulator]
name=Ava's accumulator
desc=A great tangle of string and magnets. It accumulates arrows.
model=obj_avas_accumulator
manwear=obj_avas_accumulator_manwear,0
womanwear=obj_avas_accumulator_womanwear,0
2dxof=-4
2dyof=-1
2dzoom=976
2dxan=567
2dyan=1120
2dzan=1923
iop2=Wear
iop3=Toggle-attract
iop5=Destroy
wearop1=Toggle-attract
wearpos=back
cost=1000
members=yes
tradeable=no
weight=8oz
category=armour_cape
param=rangeattack,4
param=slashdefence,1
param=magicdefence,4

// The Old Crone mirrors the unused essence of a ghostspeak amulet and binds it with one of Alice's
// golden hairs. It only ever works for Alice and her husband, so it has no iop2=Wear gate of its
// own beyond that - see animmag_farm.rs2.
