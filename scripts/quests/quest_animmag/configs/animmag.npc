// The trees in the Draynor Manor grounds are npcs, not scenery - that is how the cache has them,
// and it is why Ava calls them "the ones that attack rather than the really dead ones". They stand
// still and only answer Chop.
[animmag_undead_tree]
name=Undead tree
desc=It looks like it would rather I did not.
model1=npc_animmag_undead_tree_1
op1=Chop
moverestrict=nomove
recol1s=7296
recol1d=4194
recol2s=6240
recol2d=4194
vislevel=hide

// The chicken Malcolm chases around the farm when the amulet finally lets him talk to his wife.
// (The cache name has a leading space; it is dropped here.)
[animmag_sneaky_fowl]
