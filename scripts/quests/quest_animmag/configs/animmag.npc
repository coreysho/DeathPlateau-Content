// Animal Magnetism's people. Imported from the rev 474 cache (npcs 5198, 5200, 5208, 5209, 5210)
// by tools/models/importnpc474.py; the chathead models the importer does not carry were copied out
// of the same cache by hand. Rev 377 is ~September 2006 and the quest went live on 12 December
// 2006, so none of these are in scripts/_unpack/377/all.npc.
//
// Two of the quest's cast are already here and are NOT re-imported:
//   Alice                 [farming_shopkeeper_4], the Morytania farming shop, m56_55 (43,6)
//   Alice's husband       [ahoy_ghost_farmer], below - moved out of _unpack for his chathead
// and the Old Crone is [ahoy_crone] (Ghosts Ahoy), east of the Slayer Tower on m54_55.

// Ava, in the west wing of Draynor Manor. The cache gives her op1=Talk-to AND op3=Trade; Trade is
// wired in quest_animmag.rs2 - before the quest it is her "I'm busy with my research" brush-off, and
// after it, it is where a lost or upgraded device is bought back.
[animmag_ava]
name=Ava
desc=A scientist, researching the interactions between ghosts and the force of pure science.
model1=npc_animmag_ava_1
model2=npc_animmag_ava_2
model3=npc_animmag_ava_3
model4=npc_animmag_ava_4
model5=npc_animmag_ava_5
model6=npc_animmag_ava_6
head1=npc_animmag_ava_head1
readyanim=human_ready
walkanim=human_walk_f
op1=Talk-to
op3=Trade
recol1s=2340
recol1d=7395
recol2s=6273
recol2d=25362
vislevel=hide

// Helda, "the Witch next door" - the north room of the same wing. She is named Witch in the cache
