[hunt]
// The quest helper plugin reads this to know which leg of the quest you are on. Without
// transmit the client's copy stays 0 for ever and the panel has nothing to show.
scope=perm
transmit=yes

[hunt_store_employed]
scope=perm

// number of bananas in plantation crate
[crate_bananas]
scope=perm

// 1 = rum in plantation crate
// 2 = rum in the food store
[crate_rum]
scope=perm
