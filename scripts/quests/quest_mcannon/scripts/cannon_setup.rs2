// ======================================================================= the decay clock
//
// HOW LONG A CANNON LASTS (Old School, Update: White & Black Graceful, 24 March 2016):
// a fully built cannon BREAKS 25 minutes after it was set up. A broken cannon stops firing and
// can be repaired, which restarts the 25 minutes. Left broken for another 10 minutes it decays
// for good, and Nulodion hands out a free replacement ("I've lost my cannon"). Before that update
// the cannon simply vanished at 25 minutes, which is what this server did until now, and the
// cannonballs went with it as far as the player could tell.
//
// A part-built cannon (base, stand, barrels) never breaks; it vanishes 25 minutes after the last
// part went on, as it always has.
//
// THE ENGINE AND THIS TIMER SHARE THE JOB. The loc's own lifetime is the safety net: a full cannon
// is placed for ^cannon_lifetime (25 + 10 minutes), so one left by a player who logged out goes
// at the 35-minute mark whether or not anyone is here to watch. The break at 25 minutes needs a
// script to swap the loc, so it is done by this softtimer while the owner is online, against
// %cannon_clock (the map_clock the current stage ends). A player who logs back in past the break
// gets it broken on the next check, with whatever is left of the 10 minutes, not a fresh 10.
//
// %cannon_hud and %cannon_hud_ticks are transmitted for the client's Cannon overlay: which state
// the cannon is in and how many ticks that state has left. Both are temp, so 0 after a login
// until the first check, which is how this timer knows not to announce a loss it never saw.
[softtimer,cannon_decay]
~cannon_decay_check;

[proc,cannon_decay_check]
if (%ownedmcannon = null) {
    ~cannon_hud_clear;
    clearsofttimer(cannon_decay);
    return;
}
def_int $left = sub(%cannon_clock, map_clock);
if (loc_find(%ownedmcannon, dwarf_multicannon1) = true) {
    if ($left <= 0) {
        // Whatever the 10 minutes still has. Normally all of it; less after a logout past the
        // break, and never below a tick, which is the engine's own floor.
        def_int $broken_left = max(1, add($left, ^cannon_broken_ticks));
        loc_change(dwarf_multicannon_broken, $broken_left);
        %cannon_clock = add(map_clock, $broken_left);
        %cannon_warned = false;
        cleartimer(cannon_rotate);
        mes("Your cannon has broken!");
        mes("Repair it within <~cannon_time_text($broken_left)> or it will decay.");
        ~cannon_hud(^cannon_hud_broken, $broken_left);
        return;
    }
    if ($left <= ^cannon_warn_ticks & %cannon_warned = false) {
        %cannon_warned = true;
        mes("Your cannon will break in <~cannon_time_text($left)>.");
    }
    ~cannon_hud(^cannon_hud_working, $left);
    return;
}
if (loc_find(%ownedmcannon, dwarf_multicannon_broken) = true) {
    if ($left <= ^cannon_warn_ticks & %cannon_warned = false) {
        %cannon_warned = true;
        mes("Your cannon will decay in <~cannon_time_text($left)> unless you repair it.");
    }
    ~cannon_hud(^cannon_hud_broken, $left);
    return;
}
if (loc_find(%ownedmcannon, multicannon_base) = true | loc_find(%ownedmcannon, multicannon_stand) = true | loc_find(%ownedmcannon, multicannon_barrels) = true) {
    ~cannon_hud(^cannon_hud_building, $left);
    return;
}
// Gone. Only said if this session saw it standing: after a login (hud 0) or the King Black
// Dragon (which says its own line and clears the hud) a missing cannon is not news.
if (%cannon_hud ! ^cannon_hud_none) {
    mes("Your cannon has decayed. Speak to Nulodion to obtain a new one."); // osrs
}
~cannon_hud_clear;
clearsofttimer(cannon_decay);

// A stage begins: the clock, the warning and the overlay start again, and the check is (re)started.
[proc,cannon_stage_start](int $hud, int $ticks)
%cannon_clock = add(map_clock, $ticks);
%cannon_warned = false;
~cannon_hud($hud, $ticks);
softtimer(cannon_decay, 5);

[proc,cannon_hud](int $hud, int $ticks)
%cannon_hud = $hud;
%cannon_hud_ticks = max(0, $ticks);

[proc,cannon_hud_clear]
%cannon_hud = ^cannon_hud_none;
%cannon_hud_ticks = 0;
%cannon_warned = false;

// Called from [login,_]. The cannon outlives a logout, so its check has to start again.
[proc,cannon_login]
if (%ownedmcannon ! null) {
    softtimer(cannon_decay, 5);
}

// "about 12 minutes", rounded up so a warning never promises less time than there is.
[proc,cannon_time_text](int $ticks)(string)
def_int $seconds = divide(multiply(max(0, $ticks), 6), 10);
if ($seconds < 60) {
    return("less than a minute");
}
def_int $minutes = divide(add($seconds, 59), 60);
if ($minutes = 1) {
    return("about a minute");
}
return("about <tostring($minutes)> minutes");

// Check (op3 on both the working and the broken cannon): what the overlay says, in words.
[proc,cannon_check]
if (~cannon_belongs_to_player = false) {
    mes("This is not your cannon."); // osrs
    return;
}
def_int $left = sub(%cannon_clock, map_clock);
if (loc_type = dwarf_multicannon_broken) {
    mes("Your cannon is broken. It will decay in <~cannon_time_text($left)> unless you repair it.");
} else {
    mes("Your cannon will break in <~cannon_time_text($left)>.");
}
if (%rockthrower = 1) {
    mes("It has 1 cannonball loaded.");
} else {
    mes("It has <tostring(max(0, %rockthrower))> cannonballs loaded.");
}

[proc,cannon_belongs_to_player]()(boolean)
if (loc_coord = %ownedmcannon) {
    return(true);
}
return(false);

[proc,cannon_setup_random_coord]()(coord)
def_int $i = 0;
def_coord $coord = coord;
while ($i < 50) {
    switch_int (random(16)) {
        case 0 : $coord = movecoord(coord, -2, 0, 2);
        case 1 : $coord = movecoord(coord, -1, 0, 2);
        case 2 : $coord = movecoord(coord, 0, 0, 2);
        case 3 : $coord = movecoord(coord, 1, 0, 2);
        case 4 : $coord = movecoord(coord, 2, 0, 2);
        case 5 : $coord = movecoord(coord, 2, 0, -2);
        case 6 : $coord = movecoord(coord, 1, 0, -2);
        case 7 : $coord = movecoord(coord, 0, 0, -2);
        case 8 : $coord = movecoord(coord, -1, 0, -2);
        case 9 : $coord = movecoord(coord, -2, 0, -2);
        case 10 : $coord = movecoord(coord, -2, 0, -1);
        case 11 : $coord = movecoord(coord, -2, 0, 0);
        case 12 : $coord = movecoord(coord, -2, 0, 1);
        case 13 : $coord = movecoord(coord, 2, 0, 1);
        case 14 : $coord = movecoord(coord, 2, 0, 0);
        case 15 : $coord = movecoord(coord, 2, 0, -1);
    }
    // checks line of walk both ways in osrs
    if (lineofwalk($coord, coord) = true & lineofwalk(coord, $coord) = true) {
        return ($coord);
    }

    
    $i = add($i, 1);
}
return(null);

[opheld1,twpart1]
if (%mcannon < ^mcannon_complete) {
    mes("You can't set up this cannon.");
    mes("You need to complete the Dwarf Cannon quest."); // osrs
    return;
}
// test: after deleting the cannon with a loc. This message still persists, Meaning they dont loc_find for it!
if (%ownedmcannon ! null) { 
    mes("You cannot construct more than one Cannon at a time."); // osrs
    mes("If you have lost your Cannon, go and see the Dwarf Cannon engineer."); // osrs
    return;
}
// https://oldschool.runescape.wiki/w/Update:Spirit_trees,_clues_%26_more!
// - "Cannons can no longer be setup within the Party room and can now be placed where the Party room used to be."
if (~inzone_coord_pair_table(party_room_zones, coord) = true) {
    mes("Party Pete won't be happy if you set up a cannon here."); // osrs
    return;
}
if (~inzone_coord_pair_table(dwarf_zones, coord) = true) {
    mes("The dwarves won't be happy if you set up a cannon here."); // osrs
    return;
}
if (~inzone_coord_pair_table(bank_zones, coord) = true | ~in_duel_arena(coord) = true | ~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) { // guessing they dont let u set up at duel arena at all, esp with nomovement duels
    mes("You can't set up a cannon here."); // osrs
    return;
}
if (inzone(^arena_lower_coord, ^arena_upper_coord, coord) = true) { // fight arena: https://www.youtube.com/watch?v=fQMD91nYPEk&t=420s, bounds guessed (reworked in both games)
    mes("It is not permitted to set up a cannon inside the Fight Arena.");
    return;
}
if (map_locaddunsafe(movecoord(coord, -1, 0, -1)) = true) {
    mes("There isn't enough space to set up here."); // osrs just checks sw coord for loc's
    return;
}
def_coord $center = coord;
if (map_blocked($center) = true | // center
    map_blocked(movecoord($center, 0, 0, 1)) = true | // north
    map_blocked(movecoord($center, 1, 0, 1)) = true | // north-east
    map_blocked(movecoord($center, 1, 0, 0)) = true | // east
    map_blocked(movecoord($center, 1, 0, -1)) = true | // south-east
    map_blocked(movecoord($center, 0, 0, -1)) = true | // south
    map_blocked(movecoord($center, -1, 0, -1)) = true | // south-west
    map_blocked(movecoord($center, -1, 0, 0)) = true | // west
    map_blocked(movecoord($center, -1, 0, 1)) = true | // north-west
    lineofwalk(movecoord($center, 0, 0, 1), movecoord($center, 0, 0, -1)) = false |
    lineofwalk(movecoord($center, 1, 0, 0), movecoord($center, -1, 0, 0)) = false |
    lineofwalk(movecoord($center, 1, 0, 1), movecoord($center, -1, 0, -1)) = false |
    lineofwalk(movecoord($center, -1, 0, 1), movecoord($center, 1, 0, -1)) = false)
{
    mes("There isn't enough space to set up here."); // osrs
    return;
}
def_coord $setupcoord = ~cannon_setup_random_coord;
// def_coord $setupcoord = map_findsquare(coord, 2, 2, ^map_findsquare_lineofwalk); // seems to be slightly diff than osrs
if ($setupcoord = null) {
    mes("There isn't enough space to set up here.");
    return;
}
~playerwalk3($setupcoord);

facesquare($center);
p_delay(0);

def_coord $origin = movecoord($center, -1, 0, -1); // south-west tile
%ownedmcannon = $origin;
%dropcannon = ^cannon_stage_base;

anim(human_pickupfloor, 0);
inv_del(inv, twpart1, 1);
loc_add($origin, multicannon_base, 0, centrepiece_straight, ^cannon_decay_length);
mes("You place the cannon base on the ground."); // https://youtu.be/TeQXQDaawO0?t=227
~cannon_stage_start(^cannon_hud_building, ^cannon_decay_length);

// ------- cannon base -------
[oploc1,multicannon_base]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You need one free inventory spaces to pick that up."); // osrs
    return;
}
%ownedmcannon = null;
%dropcannon = ^cannon_stage_none;
~cannon_hud_clear;
mes("You pick up the cannon,");
mes("It's really heavy.");
sound_synth(pick, 1, 0);
inv_add(inv, twpart1, 1);
loc_del(1);

[oplocu,multicannon_base]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!");
    return;
}
if (last_useitem = twpart2) {
    anim(human_pickupfloor, 0);
    inv_del(inv, twpart2, 1);
    loc_change(multicannon_stand, ^cannon_decay_length);
    mes("You add the stand.");
    %dropcannon = ^cannon_stage_stand;
    ~cannon_stage_start(^cannon_hud_building, ^cannon_decay_length);
    return;
}
// in osrs, if you use a cannon base on a cannon base, itll have this message...
// i think this is because they just check for category 'cannon_parts'...
// However! 2004 didnt have categories, so either they never checked for other cannon parts
// or they did. If they did, they probably didnt check for the same obj?
if (oc_category(last_useitem) = cannon_parts & last_useitem ! twpart1) { 
    mes("This cannon needs its stand."); // osrs
    return;
}
~displaymessage(^dm_default);
// --------------

// ------- cannon stand -------
[oploc1,multicannon_stand]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!");
    return;
}
if (inv_freespace(inv) < 2) {
    mes("You need two free inventory spaces to pick that up."); // osrs
    return;
}
%ownedmcannon = null;
%dropcannon = ^cannon_stage_none;
~cannon_hud_clear;
mes("You pick up the cannon,");
mes("It's really heavy.");
sound_synth(pick, 1, 0);
inv_add(inv, twpart1, 1);
inv_add(inv, twpart2, 1);
loc_del(1);

[oplocu,multicannon_stand]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!");
    return;
}
if (last_useitem = twpart3) {
    anim(human_pickupfloor, 0);
    inv_del(inv, twpart3, 1);
    loc_change(multicannon_barrels, ^cannon_decay_length);
    mes("You add the barrels.");
    %dropcannon = ^cannon_stage_barrels;
    ~cannon_stage_start(^cannon_hud_building, ^cannon_decay_length);
    return;
}
if (oc_category(last_useitem) = cannon_parts & last_useitem ! twpart2) { 
    mes("This cannon needs its barrels."); // osrs
    return;
}
~displaymessage(^dm_default);
// --------------

// ------- cannon barrels -------
[oploc1,multicannon_barrels]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!");
    return;
}
if (inv_freespace(inv) < 3) {
    mes("You need three free inventory spaces to pick that up."); // osrs
    return;
}
%ownedmcannon = null;
%dropcannon = ^cannon_stage_none;
~cannon_hud_clear;
mes("You pick up the cannon,");
mes("It's really heavy.");
sound_synth(pick, 1, 0);
inv_add(inv, twpart1, 1);
inv_add(inv, twpart2, 1);
inv_add(inv, twpart3, 1);
loc_del(1);

[oplocu,multicannon_barrels]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!");
    return;
}
if (last_useitem = twpart4) {
    anim(human_pickupfloor, 0);
    inv_del(inv, twpart4, 1);
    mes("You add the furnace.");
    loc_change(dwarf_multicannon1, ^cannon_lifetime);
    %dropcannon = ^cannon_stage_full;
    ~cannon_stage_start(^cannon_hud_working, ^cannon_break_ticks);
    return;
}
if (oc_category(last_useitem) = cannon_parts & last_useitem ! twpart3) { 
    mes("This cannon needs its furnace."); // osrs
    return;
}
~displaymessage(^dm_default);
// --------------

// ------- cannon -------
[oploc2,dwarf_multicannon1]
~cannon_pickup_full;

[oploc3,dwarf_multicannon1]
~cannon_check;

// The full cannon and the broken one pick up the same way, cannonballs and all.
[proc,cannon_pickup_full]
if (~cannon_belongs_to_player = false) {
    mes("This is not your cannon."); // osrs
    return;
}
if (inv_freespace(inv) < 4) {
    // yes it does the number 4 here... from osrs at least
    mes("You need 4 free inventory spaces to pick that up."); // osrs
    return;
}
mes("You pick up the cannon,"); // https://youtu.be/TeQXQDaawO0?t=518
mes("It's really heavy.");
sound_synth(pick, 1, 0);
%ownedmcannon = null;
%dropcannon = ^cannon_stage_none;
~cannon_hud_clear;
inv_add(inv, twpart1, 1);
inv_add(inv, twpart2, 1);
inv_add(inv, twpart3, 1);
inv_add(inv, twpart4, 1);

if (%rockthrower > 0) {
    inv_add(inv, mcannonball, min(30, %rockthrower));
}
%rockthrower = 0;
loc_del(1);

[oploc1,dwarf_multicannon1]
if (~cannon_belongs_to_player = false) {
    mes("That isn't your cannon!"); // https://youtu.be/aJDlEmyPpk8?t=140
    return;
}
if (gettimer(cannon_rotate) > 0) {
    mes("Your cannon is already firing."); // https://youtu.be/WWyNTsMXjTE?t=122
    return;
}
if (%rockthrower < 1) {
    // current osrs reloads, but thats wrong for our version
    // https://oldschool.runescape.wiki/w/Update:Happy_Birthday!:
    // - "Left-clicking on your cannon will now let you reload it, even if it isn't currently firing."
    mes("Your cannon is out of ammo!"); // https://youtu.be/TeQXQDaawO0?t=239
    return;
}
settimer(cannon_rotate, 1, 0);

[oplocu,dwarf_multicannon1]
if (last_useitem = mcannonball) {
    if (~cannon_belongs_to_player = false) {
        mes("This is not your cannon."); // osrs
        return;
    }
    if (%rockthrower >= 30) {
        mes("The cannon is already full of ammo."); // osrs
        return;
    }
    def_int $count = min(sub(30, max(%rockthrower, 0)), inv_total(inv, mcannonball));
    // with one cannon ball, it'd still be plural: https://youtu.be/5itKFWuomiM&t=132
    mes("You load the cannon with <tostring($count)> cannonballs."); // https://youtu.be/TeQXQDaawO0?t=239
    %rockthrower = add(%rockthrower, $count);
    inv_del(inv, mcannonball, $count);
} else {
    ~displaymessage(^dm_default);
}
// --------------

// ------- broken cannon -------
// Old School, 24 March 2016: "a repair option which allows you to reset your cannon timer
// without having to pick it up and put it back down". The cannonballs stay loaded through the
// break and the repair; only the clock starts again.
[oploc1,dwarf_multicannon_broken]
if (~cannon_belongs_to_player = false) {
    mes("This is not your cannon."); // osrs
    return;
}
anim(human_pickupfloor, 0);
loc_change(dwarf_multicannon1, ^cannon_lifetime);
mes("You repair your cannon, restoring it to working order.");
~cannon_stage_start(^cannon_hud_working, ^cannon_break_ticks);

[oploc2,dwarf_multicannon_broken]
~cannon_pickup_full;

[oploc3,dwarf_multicannon_broken]
~cannon_check;

[oplocu,dwarf_multicannon_broken]
if (~cannon_belongs_to_player = false) {
    mes("This is not your cannon."); // osrs
    return;
}
if (last_useitem = mcannonball) {
    mes("Your cannon is broken. Repair it before you load it.");
    return;
}
~displaymessage(^dm_default);
// --------------
