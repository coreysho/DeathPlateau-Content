// Creature of Fenkenstrain - the world side: the signpost, the graves, the memorial, the bookcases,
// the brush, the shed, the fireplace, the clock, the conductor and the slab. The talking is in the
// npc file beside this one.

// =========================================================================== the signpost

// "There is a note pinned to the signpost" - the job advertisement, and where the quest starts.
// The loc was in the cache and placed in no map square at all; it stands in the middle of Canifis
// now (3494,3490, maps/m54_54.jm2).
[oploc1,fenk_signpost]
%fenk_read_signpost = 1;
~mesbox("CANIFIS. FENKENSTRAIN'S CASTLE, north-east.||Pinned below it, in a careful hand:|'WANTED: braindead butler. Good prospects. Apply at the castle. Do not knock.'");

// =========================================================================== the graves

// fenk_grave is placed five times: three inside the railed plot north-west of the castle, which is
// an eight-tile pocket the memorial below it is the only way into, and two in the castle grounds
// beside the memorials. fenk_grave_poor fills the paupers' field south-east of Canifis, and one of
// those is where the Lestwit boy was put.
[oploc1,fenk_grave]
if (coordx(loc_coord) < ^fenk_plot_grave_east) {
    ~mesbox("LESTWIT. The rest of the name has gone. Whoever cut it was paid well and worked carelessly.");
    return;
}
~mesbox("Here lies one of the old family. The name has weathered off.");

[oploc1,fenk_grave_poor]
~mesbox("ED LESTWIT, and no date. A pauper's grave, marked with two sticks and a nail.");

[oploc2,fenk_grave]
if (coordx(loc_coord) >= ^fenk_plot_grave_east) {
    mes("This is the family vault. You are not quite that desperate.");
    return;
}
@fenk_dig_limb;

[oploc2,fenk_grave_poor]
@fenk_dig_head;

// The three graves in the plot hold the arms, the legs and the torso. Which one comes up is
// decided by what the player actually HAS, not by the varbit: the varbit is a record that the
// grave gave it up once, and reading it here would refuse to ever hand out another, leaving a
// player who lost a limb stuck with no way back.
[label,fenk_dig_limb]
p_arrivedelay;
if (%fenk_quest ! ^fenk_started & %fenk_quest ! ^fenk_parts_gathered) {
    mes("You have no reason to disturb this, and every reason not to.");
    return;
}
if (inv_total(inv, spade) = 0) {
    mes("You would need a spade.");
    return;
}
def_namedobj $part = null;
if (~obj_gettotal(fenk_arms) = 0) {
    $part = fenk_arms;
} else if (~obj_gettotal(fenk_legs) = 0) {
    $part = fenk_legs;
} else if (~obj_gettotal(fenk_torso) = 0) {
    $part = fenk_torso;
}
if ($part = null) {
    mes("You dig, and find nothing you have not already got.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("There is something down here, but you have no room to lift it out.");
    return;
}
anim(human_pickuptable, 0);
switch_obj ($part) {
    case fenk_arms : %fenk_arms = 1;
    case fenk_legs : %fenk_legs = 1;
    case fenk_torso : %fenk_torso = 1;
}
inv_add(inv, $part, 1);
~mesbox("You dig down, and lift out a set of <lowercase(oc_name($part))>. This is a dreadful thing to be doing.");

// The head. Ed Lestwit was buried in the paupers' field with no coffin to speak of, which is the
// only reason there is anything left of him worth carrying off.
[label,fenk_dig_head]
p_arrivedelay;
if (%fenk_quest ! ^fenk_started & %fenk_quest ! ^fenk_parts_gathered) {
    mes("You have no reason to disturb this, and every reason not to.");
    return;
}
if (inv_total(inv, spade) = 0) {
    mes("You would need a spade.");
    return;
}
if (~obj_gettotal(fenk_head_empty) > 0 | ~obj_gettotal(fenk_head_full) > 0) {
    mes("You dig, and find nothing you have not already got.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("There is something down here, but you have no room to lift it out.");
    return;
}
anim(human_pickuptable, 0);
%fenk_head = 1;
inv_add(inv, fenk_head_empty, 1);
~mesbox("The spade turns up a skull with the jaw still on it. Whatever was inside it rotted away a long time ago.");

// =========================================================================== the memorial

// All three memorials have the six-pointed recess cut in the face, and the star amulet is the shape
// that fits it. Only the one below the railed plot has anything behind it. An approach op with a
// range of eight, because the way back out is the same memorial seen from inside the railings.
[aploc1,fenk_coffin]
if (distance(loc_coord, coord) > 8) {
    p_aprange(8);
    return;
}
if (coordx(loc_coord) ! ^fenk_plot_memorial_x) {
    if (inv_total(inv, fenk_star_amulet) = 0) {
        ~mesbox("The memorial will not shift. Cut into the face of it is a six-pointed recess, about the size of your hand.");
        return;
    }
    anim(human_pickuptable, 0);
    ~mesbox("The amulet turns in the recess and the memorial grinds aside. Underneath is bare earth, undisturbed. Whoever this one was for was never put in it.");
    return;
}
if (inv_total(inv, fenk_star_amulet) = 0) {
    ~mesbox("The memorial will not shift. Cut into the face of it is a six-pointed recess, about the size of your hand - and a path of trodden grass leads up to it from the railings above.");
    return;
}
anim(human_pickuptable, 0);
if (%fenk_coffin = 0) {
    %fenk_coffin = 1;
    ~mesbox("The amulet turns in the recess and the memorial grinds aside. Steps go down, and come back up on the other side of the railings.");
}
// standing inside the railings, which are north of the memorial
if (coordz(coord) >= coordz(^fenk_plot_inside)) {
    p_teleport(^fenk_plot_outside);
    mes("You come back out below the railings.");
    return;
}
p_teleport(^fenk_plot_inside);
mes("You come up inside the railings.");

[oploc2,fenk_coffin]
mes("Nothing is carved on it but the family's own six-pointed star.");

// =========================================================================== the bookcases

// Four bookcases, two down and two up. The two upstairs have the old lord's amulet in them, a half
// in each, pressed into a book like a flower.
[oploc1,fenk_bookcase]
p_arrivedelay;
if (coordz(loc_coord) ! ^fenk_bookcase_upstairs_z) {
    mes("Medical texts, mostly. Nothing you want to read twice.");
    return;
}
if (coordx(loc_coord) = ^fenk_bookcase_west_x) {
    @fenk_bookcase_half(fenk_marble_amulet, "The Joy of Grave Digging", "a triangle of white marble on a cord");
}
if (coordx(loc_coord) = ^fenk_bookcase_east_x) {
    @fenk_bookcase_half(fenk_obsidian_amulet, "Handy Maggot Avoidance Techniques", "a triangle of black glass on a cord");
}
mes("Medical texts, mostly. Nothing you want to read twice.");

[label,fenk_bookcase_half](namedobj $half, string $book, string $what)
if (~obj_gettotal($half) > 0 | ~obj_gettotal(fenk_star_amulet) > 0) {
    ~mesbox("<$book>, and you have already had what was pressed inside it.");
    return;
}
if (inv_freespace(inv) = 0) {
    ~mesbox("<$book>. There is something pressed inside the cover, and no room in your pack for it.");
    return;
}
inv_add(inv, $half, 1);
~mesbox("You pull out a book - <$book> - and <$what> falls out of it into your hand.");

// The two halves make the six-pointed star the memorials are cut to take.
[opheldu,fenk_obsidian_amulet]
if (last_useitem ! fenk_marble_amulet) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_join_amulet;

[opheldu,fenk_marble_amulet]
if (last_useitem ! fenk_obsidian_amulet) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_join_amulet;

[label,fenk_join_amulet]
inv_del(inv, fenk_obsidian_amulet, 1);
inv_del(inv, fenk_marble_amulet, 1);
inv_add(inv, fenk_star_amulet, 1);
mes("The two triangles lock together into a six-pointed star.");

// =========================================================================== the brush and the shed

[oploc1,fenk_broomcupboard]
loc_change(fenk_broomcupboard_open, 200);

// The open cupboard's ops are op2=Search and op3=Shut in the cache - there is no op1 on it. They
// used to be handled as op1/op2, so Search shut the cupboard and the brush could never be taken.
[oploc3,fenk_broomcupboard_open]
loc_change(fenk_broomcupboard, 200);

[oploc2,fenk_broomcupboard_open]
if (~obj_gettotal(fenk_brush0) > 0 | ~obj_gettotal(fenk_brush1) > 0 | ~obj_gettotal(fenk_brush2) > 0 | ~obj_gettotal(fenk_brush3) > 0) {
    mes("You have taken the brush already.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("There is a garden brush in here, but you have no room for it.");
    return;
}
mes("You find a garden brush.");
inv_add(inv, fenk_brush0, 1);

[oploc1,fenk_canepile]
if (inv_freespace(inv) = 0) {
    mes("You have no room for another cane.");
    return;
}
mes("You take a garden cane.");
inv_add(inv, fenk_cane, 1);

// Lashing a cane onto the brush. Three canes and three lengths of bronze wire - a wire a cane - and
// the cache gives exactly four brush states, so the count is the obj rather than a varbit.
[opheldu,fenk_cane] @fenk_extend_brush(last_useitem);
[opheldu,fenk_brush0] @fenk_extend_brush(fenk_brush0);
[opheldu,fenk_brush1] @fenk_extend_brush(fenk_brush1);
[opheldu,fenk_brush2] @fenk_extend_brush(fenk_brush2);

[label,fenk_extend_brush](obj $brush)
if (inv_total(inv, fenk_cane) = 0) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $longer = null;
switch_obj ($brush) {
    case fenk_brush0 : $longer = fenk_brush1;
    case fenk_brush1 : $longer = fenk_brush2;
    case fenk_brush2 : $longer = fenk_brush3;
    case fenk_brush3 :
        mes("The brush is as long as it is going to get without falling apart.");
        return;
}
if ($longer = null) {
    ~displaymessage(^dm_default);
    return;
}
if (stat(crafting) < 20) {
    mes("You need a Crafting level of 20 to make a decent job of this.");
    return;
}
if (inv_total(inv, bronzecraftwire) = 0) {
    mes("The cane needs binding on. A length of bronze wire would do it.");
    return;
}
inv_del(inv, fenk_cane, 1);
inv_del(inv, bronzecraftwire, 1);
inv_del(inv, $brush, 1);
inv_add(inv, $longer, 1);
mes("You bind another cane to the brush with the wire.");

[proc,fenk_shed_amulet]
mes("The bench inside is bare except for forty years of dust.");

// The shed key comes off the gardener's ghost: the broom cupboard is INSIDE the shed (it is only
// reachable from its east side, which is the shed floor), so no brush-and-ledge trick can be the
// way in - the brush is behind the door it would open. The door has to let the player through once
// it is unlocked; it is a wall like any other.
[oploc1,fenk_shed_door]
p_arrivedelay;
if (%fenk_unlocked_shed = 1) {
    ~open_and_close_door2(fenk_shed_door, ~check_axis(coord, loc_coord, loc_angle), door_open);
    return;
}
if (inv_total(inv, fenk_shed_key) = 0) {
    ~mesbox("The shed is locked. The man who kept this garden will have had a key, and he has not been seen in forty years.");
    return;
}
%fenk_unlocked_shed = 1;
sound_synth(unlock, 1, 0);
mes("You unlock the shed.");
~open_and_close_door2(fenk_shed_door, ~check_axis(coord, loc_coord, loc_angle), door_open);

// =========================================================================== the fireplace

// Where the conductor mould is. fenk_fireplace carries no ops at all and is flanked by two
// fenk_fireplace_surround locs whose description is "Mmm.. scented candles" - so the brush has to
// go up the chimney itself, and sweeping the mantelpiece gets you nowhere. That distinction is in
// the cache, and it is the one the quest has always warned about.
[oplocu,fenk_fireplace]
if (last_useitem ! fenk_brush3) {
    if (last_useitem = fenk_brush0 | last_useitem = fenk_brush1 | last_useitem = fenk_brush2) {
        ~mesbox("The chimney goes up a long way. The brush is nowhere near long enough yet.");
        return;
    }
    ~displaymessage(^dm_default);
    return;
}
p_arrivedelay;
if (~obj_gettotal(fenk_lightning_mould) > 0) {
    mes("You have already swept whatever was up there down.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("Something came down with the soot, and you have no room to pick it up.");
    return;
}
anim(human_pickuptable, 0);
inv_add(inv, fenk_lightning_mould, 1);
~mesbox("You put the brush up the chimney and sweep. Down comes forty years of soot, two dead birds, and a mould for casting lightning conductors.");

[oplocu,fenk_fireplace_left] @fenk_sweep_surround;
[oplocu,fenk_fireplace_right] @fenk_sweep_surround;

[label,fenk_sweep_surround]
if (last_useitem ! fenk_brush0 & last_useitem ! fenk_brush1 & last_useitem ! fenk_brush2 & last_useitem ! fenk_brush3) {
    ~displaymessage(^dm_default);
    return;
}
mes("You sweep the surround. It was the chimney itself you wanted.");

// =========================================================================== the clock and the tower

[oploc1,fenk_clock]
if (%fenk_wound_clock = 1) {
    mes("The clock is wound. Somewhere above you, something heavy has moved.");
    return;
}
if (%fenk_quest < ^fenk_creature_alive) {
    mes("The clock has stopped. You have no particular reason to start it.");
    return;
}
anim(human_pickuptable, 0);
%fenk_wound_clock = 1;
sound_synth(lever, 1, 0);
~mesbox("You wind the clock. It begins to tick, and somewhere over your head a counterweight drops and a bolt slides back.");

// The tower door is a wall like any other, so unlocking it has to let the player through as well:
// the ladder up to the creature is on the far side of it. The doctor's key is the way in; the clock
// is the other way, for anyone who has lost it.
[oploc1,fenk_tower_door]
p_arrivedelay;
if (%fenk_unlocked_tower = 1) {
    ~open_and_close_door2(fenk_tower_door, ~check_axis(coord, loc_coord, loc_angle), door_open);
    return;
}
if (%fenk_wound_clock = 0 & inv_total(inv, fenk_tower_key) = 0) {
    mes("The door is locked, and the keyhole has been oiled recently.");
    return;
}
%fenk_unlocked_tower = 1;
sound_synth(unlock, 1, 0);
mes("The tower door swings open.");
~open_and_close_door2(fenk_tower_door, ~check_axis(coord, loc_coord, loc_angle), door_open);

// =========================================================================== the conductor

// The mould makes the conductor out of a silver bar; the conductor goes on the roof.
[opheldu,fenk_lightning_mould]
if (last_useitem ! silver_bar) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_cast_conductor;

[opheldu,silver_bar]
if (last_useitem = agrith_sigil_mould) {
    @agrith_cast_sigil;
}
if (last_useitem ! fenk_lightning_mould) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_cast_conductor;

[label,fenk_cast_conductor]
if (stat(crafting) < 20) {
    mes("You need a Crafting level of 20 to cast this.");
    return;
}
if (~obj_gettotal(fenk_conductor) > 0) {
    mes("You have already cast one conductor. One is enough.");
    return;
}
inv_del(inv, silver_bar, 1);
anim(human_smithing, 0);
inv_add(inv, fenk_conductor, 1);
stat_advance(crafting, 500);
mes("You cast the silver into a lightning conductor.");

[oploc1,fenk_conductor_broken]
p_arrivedelay;
if (%fenk_conductor_repaired = 1) {
    mes("The conductor is fitted and pointing at the sky.");
    return;
}
if (inv_total(inv, fenk_conductor) = 0) {
    mes("The conductor has snapped off at the base. You would need a new one.");
    return;
}
if (%fenk_quest < ^fenk_body_sewn) {
    mes("There would be no point until there is something on the slab worth waking.");
    return;
}
inv_del(inv, fenk_conductor, 1);
%fenk_conductor_repaired = 1;
%fenk_quest = ^fenk_conductor_fitted;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
anim(human_pickuptable, 0);
~mesbox("You fit the new conductor. Above the castle the clouds have not moved all day, and they do not look like moving now.");

// =========================================================================== the slab and the brain

// The sewing itself is the doctor's: he asks for a needle and five thread and does it on the slab
// in front of you, which is what %fenk_needle and %fenk_threads_given are for. The slab itself
// carries no ops in the cache - fenk_table, fenk_table_corpse and the multi that switches between
// them are all examine-only - so there is nothing here to handle.

// The brain goes in the head before any of that.
[opheldu,fenk_brain]
if (last_useitem ! fenk_head_empty) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_fill_head;

[opheldu,fenk_head_empty]
if (last_useitem ! fenk_brain) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_fill_head;

[label,fenk_fill_head]
inv_del(inv, fenk_brain, 1);
inv_del(inv, fenk_head_empty, 1);
inv_add(inv, fenk_head_full, 1);
mes("You pour the vinegar out and put the pickled brain into the head.");

// =========================================================================== completion

[queue,fenk_quest_complete]
%fenk_quest = ^fenk_complete;
stat_advance(thieving, 10000);
session_log(^log_adventure, "Quest complete: Creature of Fenkenstrain");
~send_quest_complete(questlist:creatureoffenkenstrain, ring_of_charos, 250, ^fenk_questpoints, "You have completed the\\nCreature of Fenkenstrain Quest!", "2 Quest Points|1,000 Thieving XP|Ring of Charos");
