[if_button,questlist:creatureoffenkenstrain]
def_string $text;

switch_int (%fenk_quest) {
    case ^fenk_not_started :
        $text = "@dbl@There is a @dre@signpost@dbl@ in the middle of @dre@Canifis@dbl@ with a job|";
        $text = append($text, "@dbl@advertised on it. @dre@Dr Fenkenstrain@dbl@ is at the castle to the|");
        $text = append($text, "@dbl@north-east.||");
        $text = append($text, "@dbl@Requirements:|");
        if (stat_base(crafting) < 20) {
            $text = append($text, "@dre@Level 20 Crafting|");
        } else {
            $text = append($text, "@str@Level 20 Crafting|");
        }
        if (stat_base(thieving) < 25) {
            $text = append($text, "@dre@Level 25 Thieving|");
        } else {
            $text = append($text, "@str@Level 25 Thieving|");
        }
        $text = append($text, "@dbl@Must have completed @dre@Priest in Peril|");
        $text = append($text, "@dbl@I will want an @dre@amulet of ghostspeak@dbl@ for the gardener");

    case ^fenk_started :
        $text = "@str@Dr Fenkenstrain has hired me as his braindead butler and|";
        $text = append($text, "@str@wants a body assembling.|");
        $text = append($text, "@dbl@@dre@Arms@dbl@, @dre@legs@dbl@ and a @dre@torso@dbl@ are in the three graves behind|");
        $text = append($text, "@dbl@the railings north-west of the castle. The @dre@memorial@dbl@ below|");
        $text = append($text, "@dbl@them opens with a @dre@star amulet@dbl@ - the two halves are|");
        $text = append($text, "@dbl@pressed in the two @dre@bookcases@dbl@ upstairs.|");
        $text = append($text, "@dbl@A @dre@head@dbl@ is in the paupers' field south-east of Canifis, and|");
        $text = append($text, "@dbl@the @dre@pickled brain@dbl@ that goes in it is in the @dre@tavern");

    case ^fenk_parts_gathered :
        $text = "@str@The doctor has the parts and cannot sew.|";
        $text = append($text, "@dbl@He wants a @dre@needle@dbl@ and @dre@five thread");

    case ^fenk_body_sewn :
        $text = "@str@The body is sewn and lying on the slab. It wants|";
        $text = append($text, "@str@lightning, and the conductor on the roof snapped off two|");
        $text = append($text, "@str@winters ago.|");
        if (~obj_gettotal(fenk_conductor) > 0) {
            $text = append($text, "@dbl@I should fit the @dre@conductor@dbl@ to the @dre@castle roof");
        } else if (~obj_gettotal(fenk_lightning_mould) > 0) {
            $text = append($text, "@dbl@I should cast the conductor from a @dre@silver bar@dbl@ at a|@dbl@@dre@furnace");
        } else {
            $text = append($text, "@dbl@The @dre@mould@dbl@ is up the @dre@chimney@dbl@ in the west room upstairs.|");
            $text = append($text, "@dbl@I will need the @dre@garden brush@dbl@ from the shed, @dre@three canes|");
            $text = append($text, "@dbl@and @dre@three bronze wire@dbl@ to reach it - the @dre@gardener's ghost|");
            $text = append($text, "@dbl@has the shed key");
        }

    case ^fenk_conductor_fitted :
        $text = "@str@The conductor is on the roof.|";
        $text = append($text, "@dbl@I should tell @dre@Dr Fenkenstrain@dbl@ that it is ready");

    case ^fenk_creature_alive :
        $text = "@str@The thing on the slab is alive, and the doctor says it|";
        $text = append($text, "@str@tried to kill him and is locked in the tower.|");
        $text = append($text, "@dbl@I should get the @dre@tower key@dbl@ off him and go up and talk to|");
        $text = append($text, "@dbl@it");

    case ^fenk_creature_spoke :
        $text = "@str@The creature is Lord Rologarth, who owned this estate|";
        $text = append($text, "@str@until Fenkenstrain sold his tenants to the vampyres and|");
        $text = append($text, "@str@then sold him as well.|");
        $text = append($text, "@dbl@His @dre@ring@dbl@ is on the doctor's finger. I should @dre@pick his|@dbl@@dre@pocket");

    case default :
        $text = "@str@Lord Rologarth has his estate and his ring back, and Dr|";
        $text = append($text, "@str@Fenkenstrain has the top of the tower and a bolt on the|");
        $text = append($text, "@str@inside of the door.||");
        $text = append($text, "@red@QUEST COMPLETE!");
}

~quest_journal("Creature of Fenkenstrain", $text);
