// Dr Fenkenstrain, his creature, and the gardener's ghost.
//
// The two doctor shells and the two creature shells are all placed, all four keyed on %fenk_quest,
// and the swap happens at 8 - so the handlers go on the shells and the endgame needs no npc_add or
// npc_del at all. See the quest's constant file.
//
// fenk_fenkenstrain_model carries op1=Talk-to and **op3=Pickpocket**. The pickpocket is the end of
// the quest: the Ring of Charos is on the doctor's hand, it is obj 4202 in the middle of this
// quest's own obj block, and nothing used to take it off him.

// =========================================================================== Dr Fenkenstrain

[opnpc1,fenk_fenkenstrain]
switch_int (%fenk_quest) {
    case ^fenk_not_started : @fenk_doctor_hire;
    case ^fenk_started : @fenk_doctor_parts;
    case ^fenk_parts_gathered : @fenk_doctor_sew;
    case ^fenk_body_sewn : @fenk_doctor_conductor;
    case ^fenk_conductor_fitted : @fenk_doctor_storm;
    case ^fenk_creature_alive : @fenk_doctor_tower_key;
    case ^fenk_creature_spoke : @fenk_doctor_dismiss;
    case default : @fenk_doctor_dismiss;
}

// At stage 8 this shell is the one standing in the tower, and there is nothing left to say through
// a bolted door.
[opnpc1,fenk_fenkenstrain_in_tower]
// The Great Brain Robbery needs him out of this cell and onto Harmony Island, which is the one
// thing he will open the door for (quests/quest_tgbr/scripts/tgbr_doctor.rs2).
if (~tgbr_doctor_tower = true) {
    return;
}
~chatnpc("<p,angry>Go away! The door is bolted and it is staying bolted!");
~chatplayer("<p,happy>Take your time.");

// --------------------------------------------------------------------------- the interview
[label,fenk_doctor_hire]
~chatnpc("<p,neutral>You are not a local. Locals do not come up here.");
switch_int (~p_choice2("I'm here about the job.", 1, "I'll leave you to it.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>I'll leave you to it.");
        ~chatnpc("<p,neutral>Wise.");
        return;
    case 1 :
        ~chatplayer("<p,neutral>I'm here about the job.");
}
if (%fenk_read_signpost = 0) {
    ~chatnpc("<p,quiz>The job. Which job would that be? I have not advertised in Canifis for a month.");
    ~chatplayer("<p,neutral>...the butler's job.");
    ~chatnpc("<p,neutral>Hmph. Somebody has been reading my signpost. Very well - an interview.");
} else {
    ~chatnpc("<p,happy>The butler's position. Good. An interview, then, and keep it brief.");
}
~chatnpc("<p,quiz>Describe yourself in one word.");
switch_int (~p_choice3("Braindead.", 1, "Hard-working.", 2, "Qualified.", 3)) {
    case 2 :
        ~chatplayer("<p,neutral>Hard-working.");
        ~chatnpc("<p,angry>I have no use for industry. Try again when you have less about you.");
        return;
    case 3 :
        ~chatplayer("<p,neutral>Qualified.");
        ~chatnpc("<p,angry>Qualified! The last thing I want in this house is somebody who has been taught things.");
        return;
    case 1 :
        ~chatplayer("<p,neutral>Braindead.");
}
~chatnpc("<p,happy>Braindead! Excellent. And your best skill?");
switch_int (~p_choice3("Grave-digging.", 1, "Cooking.", 2, "Conversation.", 3)) {
    case 2 :
        ~chatplayer("<p,neutral>Cooking.");
        ~chatnpc("<p,angry>I do not eat. Not in the usual way.");
        return;
    case 3 :
        ~chatplayer("<p,neutral>Conversation.");
        ~chatnpc("<p,angry>Out.");
        return;
    case 1 :
        ~chatplayer("<p,neutral>Grave-digging.");
}
~chatnpc("<p,happy>Grave-digging. You are hired, and you may start at once.");
~chatnpc("<p,neutral>I am assembling a man. I have the slab, I have the theory, and I have a shortage of arms, legs, torsos and heads.");
~chatplayer("<p,shock>You want me to rob graves.");
~chatnpc("<p,happy>I want you to be useful. The old family is buried behind the railings north-west of here and has no further use for any of it.");
~chatnpc("<p,neutral>A head as well - and a head is no use to me empty. There is a pickled brain in a jar over the bar in Canifis; the innkeeper will part with it.");
%fenk_quest = ^fenk_started;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);

// --------------------------------------------------------------------------- the parts
[label,fenk_doctor_parts]
if (inv_total(inv, fenk_arms) = 0 | inv_total(inv, fenk_legs) = 0 | inv_total(inv, fenk_torso) = 0 | inv_total(inv, fenk_head_full) = 0) {
    ~chatnpc("<p,quiz>Arms, legs, a torso and a head with something in it. How many of those am I looking at?");
    ~chatplayer("<p,sad>Not all four.");
    ~chatnpc("<p,neutral>Then we are not having a conversation yet.");
    return;
}
~chatplayer("<p,neutral>All four, and the head is full.");
mes("You hand over an armful of other people.");
inv_del(inv, fenk_arms, 1);
inv_del(inv, fenk_legs, 1);
inv_del(inv, fenk_torso, 1);
inv_del(inv, fenk_head_full, 1);
%fenk_quest = ^fenk_parts_gathered;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
~chatnpc("<p,happy>Splendid. Splendid! Now - I cannot sew.");
~chatplayer("<p,confused>You cannot sew.");
~chatnpc("<p,angry>I am a natural philosopher, not a seamstress. Bring me a needle and five lengths of thread and I will manage well enough.");

[label,fenk_doctor_sew]
if (inv_total(inv, needle) = 0 | inv_total(inv, thread) < ^fenk_threads_wanted) {
    ~chatnpc("<p,quiz>A needle and five thread. Have you them?");
    ~chatplayer("<p,sad>Not yet.");
    ~chatnpc("<p,neutral>Canifis has a general store and I have a body going cold.");
    return;
}
~chatplayer("<p,neutral>A needle, and five thread.");
inv_del(inv, needle, 1);
inv_del(inv, thread, ^fenk_threads_wanted);
%fenk_needle = 1;
%fenk_threads_given = 1;
if_close;
mes("Dr Fenkenstrain sets to work on the slab. It takes a long time and he hums while he does it.");
p_delay(4);
%fenk_quest = ^fenk_body_sewn;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
~mesbox("What is lying on the slab now is not a person. It is a shape that a person would fit into.");
@fenk_doctor_conductor;

// --------------------------------------------------------------------------- the conductor
[label,fenk_doctor_conductor]
~chatnpc("<p,happy>It is a fine body. Now it wants waking, and for that I want lightning.");
~chatnpc("<p,angry>The conductor on my roof snapped off in a gale two winters ago and I have had nothing to cast a new one with.");
if (~obj_gettotal(fenk_lightning_mould) > 0) {
    ~chatnpc("<p,happy>You found the mould. Silver, and a furnace, and get it onto the roof.");
    return;
}
~chatplayer("<p,quiz>What happened to the mould?");
~chatnpc("<p,neutral>Mislaid. This house has forty rooms and I have looked in eleven of them.");
~chatnpc("<p,neutral>Ask the gardener, if you can find him. He had opinions about where things in this house end up.");

[label,fenk_doctor_storm]
~chatplayer("<p,neutral>The conductor's back on the roof.");
~chatnpc("<p,happy>Then stand well back and do not touch anything metal.");
if_close;
mes("Dr Fenkenstrain throws a switch. The whole hill goes white.");
p_delay(3);
%fenk_quest = ^fenk_creature_alive;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
~mesbox("Something on the slab draws a breath.");
~chatnpc("<p,happy>IT LIVES! It lives, it lives, it - ");
~chatnpc("<p,confused>...why is it looking at me like that?");

// Wiki step 22: it went for him, he got it into the tower, and he wants somebody else to go up and
// deal with it.
[label,fenk_doctor_tower_key]
~chatnpc("<p,angry>Your creature tried to kill me.");
~chatplayer("<p,neutral>My creature?");
~chatnpc("<p,angry>You dug it up. I got it up the tower stair and locked the door on it, and it has been quiet since, which I do not like at all.");
~chatnpc("<p,neutral>Go up and see what it wants. You are the butler.");
if (inv_total(inv, fenk_tower_key) > 0) {
    ~chatnpc("<p,neutral>You have the key. Use it.");
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,angry>I would give you the key if you had a hand free for it.");
    return;
}
inv_add(inv, fenk_tower_key, 1);
mes("Dr Fenkenstrain gives you the tower key.");

[label,fenk_doctor_dismiss]
~chatnpc("<p,angry>Not now. I am busy, and you are in the way.");

// --------------------------------------------------------------------------- the pocket
// The ring is the one thing in the castle that proves whose it is, and the doctor wears it. 25
// Thieving, which is the quest's own requirement and the reason for the Thieving reward.
[opnpc3,fenk_fenkenstrain]
if (stat(thieving) < 25) {
    ~mesbox("You need a Thieving level of 25 to do that.");
    return;
}
anim(human_pickpocket, 0);
if (%fenk_quest ! ^fenk_creature_spoke) {
    mes("You go through the doctor's pockets. There is nothing in them but chalk.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("Your hand closes on something on a chain, and there is nowhere to put it.");
    return;
}
sound_synth(pick, 1, 0);
%fenk_quest = ^fenk_has_ring;
inv_add(inv, ring_of_charos, 1);
~objbox(ring_of_charos, "You lift a heavy ring off the doctor's finger. There is a six-pointed star cut into the stone.", 250, 0, 0);
if_close;
p_delay(2);
~mesbox("Behind you a bolt goes back, and something very heavy comes down the tower stair. Dr Fenkenstrain is suddenly nowhere to be seen.");
queue(fenk_quest_complete, 0, 0);

// =========================================================================== the creature

[opnpc1,fenk_creature]
if (%fenk_quest < ^fenk_creature_alive) {
    mes("It is not alive. It is a shape on a slab.");
    return;
}
if (%fenk_quest = ^fenk_creature_alive) {
    @fenk_creature_wakes;
}
~chatnpc("<p,sad>He wears my ring. He has worn it since the night he put the knife in me.");
~chatplayer("<p,neutral>Then I'll take it off him.");
~chatnpc("<p,neutral>Do. And mind his pockets - he has the habit of a man who expects to be robbed.");

[label,fenk_creature_wakes]
~chatnpc("<p,confused>...cold. Everything is cold.");
~chatplayer("<p,shock>Can you understand me?");
~chatnpc("<p,sad>I understand you. I understand a great deal more than he thinks I do.");
~chatnpc("<p,angry>My name was Rologarth. Lord Rologarth, of this estate, until the good doctor came to me with a proposal.");
~chatplayer("<p,quiz>What proposal?");
~chatnpc("<p,angry>That I sell my tenants' labour to the people over the river in Meiyerditch. He had the papers drawn up before he asked.");
~chatnpc("<p,sad>I would not sign. So he signed for me, and then he sold me as well, and the vampyres were not interested in the paperwork.");
~chatplayer("<p,shock>And he has been using the rest of us to build whatever he likes ever since.");
~chatnpc("<p,angry>He has a cellar full of things that used to be people. Stop him.");
~chatnpc("<p,neutral>Begin with my ring. He has no claim on this estate while somebody else is wearing it.");
%fenk_quest = ^fenk_creature_spoke;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);

// At stage 8 the released shell is Lord Rologarth, standing in his own hall, and the quest is over.
[opnpc1,fenk_creature_released]
~chatnpc("<p,happy>The estate is mine again, such as it is. You have my thanks, and the ring - I have no finger left that it fits.");
~chatplayer("<p,happy>What about the doctor?");
~chatnpc("<p,neutral>He has a tower, a bolt and a great deal of time to think. That will do.");

// =========================================================================== the gardener's ghost

// fenk_gardener_multi_2 is the placed shell and its only multinpc entry is 0, so the ghost is
// visible by default and setting fenk_gardener_directions to anything else would simply delete
// him. The conversation is recorded in fenk_spoken_to_gardener instead, which is what that varbit
// is for; fenk_gardener_directions is deliberately left alone.
[opnpc1,fenk_gardener_multi_2]
if (inv_total(worn, amulet_of_ghostspeak) = 0 & inv_total(worn, amulet_of_ghostspeak_enchanted) = 0) {
    ~chatnpc("<p,neutral>Wooo! Wooooo!");
    mes("The ghost seems to be trying to tell you something.");
    return;
}
if (%fenk_spoken_to_gardener = 0) {
    ~chatnpc("<p,sad>Forty years I kept these grounds, and he never once came out to look at them.");
    ~chatplayer("<p,quiz>Dr Fenkenstrain?");
    ~chatnpc("<p,angry>Fenkenstrain. He is not the master here, whatever he tells you. The master was Lord Rologarth and one day he simply was not here any more.");
    %fenk_spoken_to_gardener = 1;
}
if (%fenk_quest >= ^fenk_body_sewn & ~obj_gettotal(fenk_lightning_mould) = 0) {
    ~chatnpc("<p,neutral>He will have told you something is mislaid. Everything in that house is up the chimney in the west room - the sweep stopped coming the same year I did.");
    ~chatplayer("<p,quiz>And how would I get at it?");
    ~chatnpc("<p,neutral>With a brush and three canes off the pile by my shed, bound on with wire. Same as I did it.");
}
if (%fenk_quest >= ^fenk_started & ~obj_gettotal(fenk_star_amulet) = 0 & ~obj_gettotal(fenk_marble_amulet) = 0 & ~obj_gettotal(fenk_obsidian_amulet) = 0) {
    ~chatnpc("<p,neutral>And if it is the family you are digging at, the railings are locked and the memorial below them is the way in.");
    ~chatnpc("<p,neutral>The master kept the key to it in two halves, pressed in two books in his library, and thought that was a great joke.");
}
@fenk_gardener_shed_key;

// The shed key. The broom cupboard is inside the shed - see [oploc1,fenk_shed_door] - so the key
// has to come from somewhere outside it, and the man who kept the garden is where it came from.
[label,fenk_gardener_shed_key]
if (%fenk_unlocked_shed = 1 | inv_total(inv, fenk_shed_key) > 0) {
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>I would give you my key to the shed, if you had a hand free for it.");
    return;
}
~chatnpc("<p,neutral>You will want this. It is my key to the shed. Nobody has been in there since I died.");
inv_add(inv, fenk_shed_key, 1);
mes("The ghost gives you the shed key.");
