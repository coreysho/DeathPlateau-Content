// BURGH DE ROTT HAS THIRTY-ONE PEOPLE IN IT AND EVERY ONE OF THEM HAS A NAME. The 377 cache names
// them - Sorin, Luscion, Sergiu, Radu, Grigore, Ileana, Valeria, Emilia, Florin, Catalina, Ivan,
// Victor, Helena, Teodor, Marius, Gabriela, Vladimir, Calin, Mihail, Nicoleta, Simona, Vasile,
// Razvan, Luminata, Benjamin, Liam, Miala and Verak - and gives all of them op1=Talk-to. Nothing in
// any script mentioned one of them. That is forty of this quest's unreferenced npcs: not scenery,
// the town the quest is about.
//
// FLORIN IS THE ONE WITH A JOB. The walkthrough's fifth step is talking to him through the gate and
// putting a piece of food in the chest before he will open it - forty starving people do not let a
// stranger in off the swamp road for nothing - and burgh_quest_food_chest_closed, op1=Open, is in
// the cache and placed on no map square at all, like the Menaphite leader and the ugthanki dung
// before it. It is added beside the gate when he asks, and taken away when the quest moves on.
//
// WHO LEADS THE VILLAGE: the walkthrough says Razvan and this cache says Elisabeta -
// burgh_vilager_leader is named Elisabeta and is the only villager with a Trade option. The cache
// wins, as it does everywhere else in this rebuild: Elisabeta keeps the leader's conversations that
// are already written, and Razvan is one of the thirty.

// =========================================================================== Florin, and the gate
// FLORIN IS THREE TILES INSIDE HIS OWN GATE, at 3484,3241, and the gate is a wall on the south edge
// of 3484,3244 - so from the swamp road there is no tile adjacent to him and his Talk-to could not
// be reached by anybody who had not already got in. Which is everybody, because getting in is what
// he is for. So the conversation that matters is on the gate, and his own trigger keeps the rest.
[opnpc1,burgh_vilager_8]
if (%myreque_2_quest >= ^m2_arrived) {
    @m2_village_line(^m2_who_florin);
}
if (%myreque_2_quest < ^m2_sent) {
    ~chatnpc("<p,angry>The gate is shut and it stays shut. Go back up the road.");
    return;
}
if (%myreque_2_quest >= ^m2_fed) {
    ~chatnpc("<p,neutral>It is open. Mind the step and do not touch anything that is not yours.");
    return;
}
@m2_florin_gate;

[label,m2_florin_gate]
~chatplayer("<p,quiz>Can you open the gate?");
~chatnpc("<p,angry>No.");
~chatplayer("<p,quiz>I have walked through Mort Myre to get here.");
~chatnpc("<p,sad>So has everything else that comes down that road. The last one to ask me nicely took Vasile's wife.");
~chatnpc("<p,neutral>Put something to eat in the chest. Anything. If you are what you say you are, you can spare it, and if you are not, you cannot touch it.");
// THE CHEST IS ALREADY THERE, and an earlier pass added a second one because nobody had looked:
// burgh_quest_food_chest_open is placed, open, at 3483,3246, with burgh_quest_food_table beside it,
// and that pair is what the walkthrough's "open chest in front of the gate" is. So Florin points at
// it rather than conjuring one, and nothing is added or deleted.
~mesbox("There is a chest and a table on your side of the fence, outside the gate, with a clear view of both from inside it.");

[oploc1,burgh_quest_food_chest_closed]
p_arrivedelay;
mes("You open the chest.");
loc_change(burgh_quest_food_chest_open, 30000);

[oploc2,burgh_quest_food_chest_open]
p_arrivedelay;
~mesbox("An empty chest on the wrong side of a fence, with somebody watching it.");

// Any piece of food will do, and Florin meant that: it is the giving that proves what you are.
[oplocu,burgh_quest_food_chest_open] @m2_feed_florin;
[oplocu,burgh_quest_food_chest_closed] @m2_feed_florin;

[label,m2_feed_florin]
def_obj $food = last_useitem;
// ~is_food_item is the Nature Spirit ghast's own test - the one thing in this game that already
// had to ask "is this a piece of food" about an arbitrary inventory item.
if (~is_food_item($food) = false) {
    ~mesbox("Food. Anything a person could eat.");
    return;
}
p_arrivedelay;
if (%myreque_2_quest >= ^m2_fed) {
    ~mesbox("The chest is doing nobody any good now. The gate is open.");
    return;
}
if_close;
mes("You put <~add_article(oc_name($food))> in the chest and step back.");
p_delay(3);
inv_del(inv, $food, 1);
%myreque_2_quest = ^m2_fed;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
~m2_spawn_marius;
~mesbox("A boy you had not seen comes over the fence, takes it out of the chest, and is gone with it before you have straightened up. | Then the gate opens.");

[oploc1,burgh_fencegate_l] @m2_village_gate;
[oploc1,burgh_fencegate_r] @m2_village_gate;

[label,m2_village_gate]
p_arrivedelay;
if (%myreque_2_quest >= ^m2_fed) {
    ~walk_through_door;
    return;
}
if (coordz(coord) < coordz(loc_coord)) {
    // on the way out, which nobody inside objects to
    ~walk_through_door;
    return;
}
if (%myreque_2_quest < ^m2_sent) {
    ~mesbox("The gate is barred from the inside and there is a man behind it who has not said anything yet.");
    return;
}
// Florin, through his own gate, which is the only angle anybody out here has on him. A loc
// trigger has no active npc, so he has to be found before anything can be put in his mouth.
if (npc_find(coord, burgh_vilager_8, 8, 0) = false) {
    ~mesbox("The gate is barred and whoever was behind it has walked off.");
    return;
}
@m2_florin_gate;

// =========================================================================== the man in the bed
// SIX OF THE THIRTY-ONE ARE NOT ON ANY MAP SQUARE: Marius, Vladimir, and the four who were turned.
// Marius is the one that is simply wrong - his wife Gabriela is placed, in a house at 3514,3209,
// and what she says is "He has not been up in two years", so the man she is talking about has to be
// in the room. He is added beside her the first time the village is entered, for as long as a
// spawn lasts. (Vladimir the blood donor and the four turned villagers belong to the tithe, which
// is the next piece of this rebuild, and their lines are written and waiting above.)
[proc,m2_spawn_marius]()()
if (npc_find(^m2_marius_coord, burgh_bed_man, 2, 0) = true) {
    return;
}
npc_add(^m2_marius_coord, burgh_bed_man, 30000);

// =========================================================================== the thirty
// One line each, and the line changes with what has happened to them: a village being bled, a
// village with a shop and a bank, and a village with six armed strangers living in the inn cellar
// who are the first people in sixty years to have done anything about it.
[opnpc1,burgh_villager_0] @m2_village_line(^m2_who_sorin);
[opnpc1,burgh_villager_0_blood_tithe] @m2_village_line(^m2_who_sorin);
[opnpc1,burgh_vilager_1] @m2_village_line(^m2_who_luscion);
[opnpc1,burgh_vilager_2] @m2_village_line(^m2_who_sergiu);
[opnpc1,burgh_vilager_3] @m2_village_line(^m2_who_radu);
[opnpc1,burgh_vilager_4] @m2_village_line(^m2_who_grigore);
[opnpc1,burgh_vilager_5] @m2_village_line(^m2_who_ileana);
[opnpc1,burgh_vilager_6] @m2_village_line(^m2_who_valeria);
[opnpc1,burgh_vilager_7] @m2_village_line(^m2_who_emilia);
[opnpc1,burgh_vilager_sit1] @m2_village_line(^m2_who_calin);
[opnpc1,burgh_vilager_sit2] @m2_village_line(^m2_who_mihail);
[opnpc1,burgh_vilager_sit3] @m2_village_line(^m2_who_nicoleta);
[opnpc1,burgh_vilager_sit4] @m2_village_line(^m2_who_simona);
[opnpc1,burgh_vilager_rat_1] @m2_village_line(^m2_who_vasile);
[opnpc1,burgh_vilager_rat_2] @m2_village_line(^m2_who_razvan);
[opnpc1,burgh_vilager_rat_3] @m2_village_line(^m2_who_luminata);
[opnpc1,burgh_villager_child1] @m2_village_line(^m2_who_catalina);
[opnpc1,burgh_villager_child2] @m2_village_line(^m2_who_ivan);
[opnpc1,burgh_villager_child3] @m2_village_line(^m2_who_victor);
[opnpc1,burgh_villager_child4] @m2_village_line(^m2_who_helena);
[opnpc1,burgh_farmer] @m2_village_line(^m2_who_teodor);
[opnpc1,burgh_bed_man] @m2_village_line(^m2_who_marius);
[opnpc1,burgh_bed_man_wife] @m2_village_line(^m2_who_gabriela);
[opnpc1,burgh_donor_man] @m2_village_line(^m2_who_vladimir);
[opnpc1,burgh_turned_vampyre_male_ben] @m2_village_line(^m2_who_benjamin);
[opnpc1,burgh_turned_vampyre_male_liam] @m2_village_line(^m2_who_liam);
[opnpc1,burgh_turned_vampyre_male_miala] @m2_village_line(^m2_who_miala);
[opnpc1,burgh_turned_vampyre_male_verak] @m2_village_line(^m2_who_verak);

[label,m2_village_line](int $who)
switch_int ($who) {
    case ^m2_who_florin :
        if (%myreque_2_quest >= ^m2_base) {
            ~chatnpc("<p,happy>Six of them under the inn, armed, and one of them nods at me when he goes past. I have started leaving the gate open in the daytime.");
            return;
        }
        ~chatnpc("<p,neutral>I watch the gate. It is not much of a job and it is the only one in this village that has not stopped.");
    case ^m2_who_sorin :
        if (%blood_tithe_visible = ^m2_tithe_happening) {
            ~chatnpc("<p,worried>Stand still and look at the ground. They count us and they take what they came for and then they go.");
            return;
        }
        ~chatnpc("<p,sad>Sorin. I have buried four people and I am sixty-one and I would like somebody to explain to me what the point of the fence is.");
    case ^m2_who_luscion :
        ~chatnpc("<p,sad>There were two hundred of us when I was a boy. There are forty now and nobody has left.");
    case ^m2_who_sergiu :
        if (~m2_town_done = true) {
            ~chatnpc("<p,happy>A shop. I walked into a shop today and bought a tinderbox like a man in a town.");
            return;
        }
        ~chatnpc("<p,neutral>The roof of the shop has been open to the sky for eleven years. We have all stopped seeing it.");
    case ^m2_who_radu :
        ~chatnpc("<p,angry>Whatever you are selling, we have no money, and whatever you are buying, we have nothing left.");
    case ^m2_who_ileana :
        if (%myreque_2_quest >= ^m2_tithe_broken) {
            ~chatnpc("<p,happy>Somebody took a barrel off them. Off THEM. I have not stopped shaking and it is not fright.");
            return;
        }
        ~chatnpc("<p,worried>They come when the tide is out. You can set a clock by it and we do.");
    case ^m2_who_valeria :
        ~chatnpc("<p,sad>My sister went up the road to Canifis eleven years ago to get help. We are still here.");
    case ^m2_who_emilia :
        ~chatnpc("<p,neutral>There is a bank in this village with no money and no teller and a hole in the wall. Cornelius still comes in and stands behind it.");
    case ^m2_who_grigore :
        ~chatnpc("<p,angry>Do not go into the inn cellar. The floor is rotten and the stairs are worse and nobody has been down there since my father.");
    case ^m2_who_calin :
        ~chatnpc("<p,sad>Sit down. Nobody stands up in this village unless they are made to.");
    case ^m2_who_mihail :
        ~chatnpc("<p,neutral>I have been sat on this bench since the tide turned and I will be sat on it when it turns again.");
    case ^m2_who_nicoleta :
        ~chatnpc("<p,worried>Do not look at them when they come. That is all. Do not look at them.");
    case ^m2_who_simona :
        ~chatnpc("<p,sad>I had a loom. They took the loom, which I have never understood.");
    case ^m2_who_vasile :
        ~chatnpc("<p,angry>They took my wife eleven years ago and I asked them to take me instead and they laughed at me.");
    case ^m2_who_razvan :
        if (%myreque_2_quest >= ^m2_base) {
            ~chatnpc("<p,happy>The strangers in the cellar asked me where the quiet ways out of the village are. Nobody has ever asked me anything before.");
            return;
        }
        ~chatnpc("<p,neutral>If you want somewhere out of the way in this village: the inn cellar, and the old temple road. Both of them are shut and both of them could be opened.");
    case ^m2_who_luminata :
        ~chatnpc("<p,sad>The rats came back before the people did. I take that as a good sign and nobody agrees with me.");
    case ^m2_who_catalina :
        ~chatnpc("<p,happy>Are you a soldier? Ivan says you are a soldier. Ivan says a lot of things.");
    case ^m2_who_ivan :
        ~chatnpc("<p,happy>I am going to be a Myreque when I am older. I know what they are. Everybody knows what they are.");
    case ^m2_who_victor :
        ~chatnpc("<p,neutral>We are not allowed out after the tide. That is the rule and it is a stupid rule and I keep it.");
    case ^m2_who_helena :
        ~chatnpc("<p,sad>My mother says the man at the gate is the only reason we are all here. My mother says a lot of things too.");
    case ^m2_who_teodor :
        ~chatnpc("<p,sad>I farm salt marsh. Nothing grows in it and I go out every morning and look at it anyway.");
    case ^m2_who_marius :
        ~chatnpc("<p,worried>I have not been out of this bed in two years and I can still hear the tide and I know exactly what time it is.");
    case ^m2_who_gabriela :
        ~chatnpc("<p,sad>He has not been up in two years. If you are the sort of person who fixes things, fix something for him.");
    case ^m2_who_vladimir :
        if (%myreque_2_quest >= ^m2_tithe_broken) {
            ~chatnpc("<p,happy>They did not take mine this time. Sixty years and that is the first time anybody has said no for me.");
            return;
        }
        ~chatnpc("<p,worried>I give blood. That is what I am for. It is a barrel a month between the village and I give more than my share because I have no children left to give it instead.");
    case ^m2_who_benjamin :
        ~chatnpc("<p,worried>Do not come near me after dark. I am asking you nicely and I will not be able to ask you nicely for much longer.");
    case ^m2_who_liam :
        ~chatnpc("<p,sad>They turned me and then they left me here, which is the part nobody expects. I live at the end of the village and I do not go out.");
    case ^m2_who_miala :
        ~chatnpc("<p,angry>Look at me properly. Go on. That is what they do to the ones who argue.");
    case ^m2_who_verak :
        ~chatnpc("<p,sad>My own daughter keeps the door locked and she is right to.");
}
