// In Aid of the Myreque - a town nobody has repaired in sixty years, and a resistance that needs
// somewhere to live that is not a hole under a werewolf village.

// =========================================================================== Veliaf, in the Hollows
[label,myreque2_veliaf]
switch_int (%myreque_2_quest) {
    case ^m2_not_started :
        if (%routequest < ^route_complete) {
            @myreque2_veliaf_idle;
        }
        @m2_start;
    case ^m2_sent :
        ~chatnpc("<p,neutral>Burgh de Rott. South, past the boat, and keep walking after you think you have arrived.");
        return;
    case ^m2_arrived :
        ~chatnpc("<p,neutral>Then fix it. I am not moving six people into a town that cannot feed them.");
        return;
    case ^m2_rebuilt :
        ~chatnpc("<p,neutral>A shop and a bank and a working furnace. Now find out who has been taking from them.");
        return;
    case ^m2_tithe_broken :
        ~chatnpc("<p,happy>You took a barrel off Gadderanks. We are coming. Open the inn cellar and we are coming.");
        return;
    case ^m2_base : @m2_veliaf_moved_in;
    case ^m2_escort : @m2_veliaf_escort;
    case ^m2_escorted : @m2_veliaf_escort;
    case ^m2_temple : @m2_veliaf_temple;
    case ^m2_books : @m2_veliaf_books;
    case ^m2_tomb : @m2_recipe;
    case ^m2_recipe : @m2_veliaf_recipe_idle;
    case ^m2_mould : @m2_veliaf_recipe_idle;
    case ^m2_rod : @m2_veliaf_recipe_idle;
    case ^m2_charged : @m2_finish;
    case default :
        if (%myreque_2_quest >= ^m2_complete) {
            ~chatnpc("<p,happy>Ivandis Seergaze. Two hundred years and it turns out somebody had already worked out how to kill them, and then died before he could tell anyone who mattered.");
            return;
        }
        @myreque2_veliaf_idle;
}
return;

// Everything Veliaf has to say that is not this quest.
[label,myreque2_veliaf_idle]
if (%myreque_2_quest = ^m2_base) {
    ~chatnpc("<p,happy>Good cellar. Dry, one way in, and forty people upstairs who would rather we were here than not.");
    return;
}
if (%routequest >= ^route_complete) {
    ~chatnpc("<p,neutral>The road south is open and the tavern is empty. I do not trust either of those things and I am grateful for both.");
    return;
}
~chatnpc("<p,neutral>Keep your voice down and mind the ladder.");

[label,m2_start]
if (~m2_requirements = false) {
    return;
}
~chatnpc("<p,neutral>You opened a road and I have spent three weeks looking at it and I have decided I do not want a road. I want a town.");
~chatplayer("<p,quiz>There aren't any towns down there.");
~chatnpc("<p,neutral>There is one. Burgh de Rott. It is on the coast at the bottom of the swamp and it has about forty people left in it and no trade and no bank and no shop and a hole in the roof of every building.");
~chatnpc("<p,neutral>It also has a cellar under the inn that six people could live in, and it is a very long way from anything Drakan pays attention to.");
switch_int (~p_choice2("Why hasn't anyone helped them?", 1, "Forty people is not a town.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>Forty people is not a town.");
        ~chatnpc("<p,angry>Six people is not a resistance. We take what we are given.");
    case 1 :
        ~chatplayer("<p,quiz>Why hasn't anyone helped them?");
        ~chatnpc("<p,sad>Because to help them you have to walk through Mort Myre, and everybody who has tried has been eaten in it.");
}
%myreque_2_quest = ^m2_sent;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
~chatnpc("<p,neutral>Go and look at it. Then come back and tell me whether I am being a fool.");

// The wiki asks for 25 Agility, 25 Crafting, 15 Mining and 7 Magic on top of In Search of the
// Myreque, and nothing was checking any of the four. Each one is in here for a reason: Agility for
// the swamp road, Crafting for the repairs, Mining for the pickaxe at the inn wall, and Magic
// because the sapphire in the rod has to be enchanted before the well will do anything for it.
[proc,m2_requirements]()(boolean)
if (stat_base(agility) < ^m2_agility_needed) {
    ~mesbox("You need an Agility level of <tostring(^m2_agility_needed)> to start this quest.");
    return(false);
}
if (stat_base(crafting) < ^m2_crafting_needed) {
    ~mesbox("You need a Crafting level of <tostring(^m2_crafting_needed)> to start this quest. There is a town to rebuild.");
    return(false);
}
if (stat_base(mining) < ^m2_mining_needed) {
    ~mesbox("You need a Mining level of <tostring(^m2_mining_needed)> to start this quest.");
    return(false);
}
if (stat_base(magic) < ^m2_magic_needed) {
    ~mesbox("You need a Magic level of <tostring(^m2_magic_needed)> to start this quest. Something in it has to be enchanted.");
    return(false);
}
return(true);

[label,m2_veliaf_moved_in]
~chatnpc("<p,happy>Six of us, in a dry cellar, in a town that is glad we are here. I have not had a week like this since I was nineteen.");
~chatplayer("<p,quiz>So what now?");
%myreque_2_quest = ^m2_escort;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
@m2_veliaf_temple;

[label,m2_veliaf_temple]
~chatnpc("<p,neutral>Silver works on them and we have known that for sixty years and it is not enough. Silver hurts them. It does not finish them.");
~chatnpc("<p,neutral>Somebody once did better. There is a name in the Paterdomus histories - Ivandis Seergaze - and the priests down there will not discuss him.");
~chatnpc("<p,neutral>Go and read. The catacombs under the temple have a library and I have never been able to get into it.");
~chatnpc("<p,neutral>And take Ivan with you.");
~chatplayer("<p,quiz>Who is Ivan?");
~chatnpc("<p,neutral>Ivan Strom. Nineteen, reads everything, wants to be a priest, and the nearest man who could ordain him is Drezel, on the other side of Mort Myre. He has been waiting four years for somebody to walk him up that road.");
~chatnpc("<p,sad>Do not let him go alone. They know what he is.");
@m2_ivan_place;

// He is in the cellar, or he is in the swamp behind you, or he is dead and this puts him back by
// the ladder - which is the only way to start the walk again.
[label,m2_veliaf_escort]
if (~m2_ivan_walking = true) {
    ~chatnpc("<p,neutral>He is behind you. Keep him there.");
    return;
}
if (~m2_ivan_alive = true) {
    ~chatnpc("<p,neutral>Ivan is by the ladder with a bronze sword and a gown. Give him something better than that before you take him out of here.");
    return;
}
~chatnpc("<p,sad>He came back on his own. He will not say how.");
%myreque_2_quest = ^m2_escort;
@m2_ivan_place;

[label,m2_veliaf_books]
~chatnpc("<p,shock>A tomb. Under the Hollows. We have been walking past it for twenty years.");
~chatnpc("<p,neutral>The boards on that door were put there by somebody who did not want it found and I had always assumed they were structural.");

// He reads the fragment. It is a recipe, and that is where the rod starts.
[label,m2_recipe]
~chatplayer("<p,neutral>The tomb is open.");
if_close;
mes("Veliaf reads the plaster fragment twice and then a third time.");
p_delay(5);
~mesbox("Ivandis Seergaze was one of seven warrior priests, and he is the only one of the seven who is not in the histories, and the reason he is not in the histories is that what he worked out was not something the temple wanted written down. | It is a recipe. It is a way of making silver do to a vampyre what it has always very nearly done.");
p_delay(3);
%myreque_2_quest = ^m2_recipe;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
~chatnpc("<p,neutral>Silver and mithril cast together, with a sapphire for the head, and the stone enchanted. Then it wants charging, and the fragment is specific about where: the well under Paterdomus, which has never been blessed.");
~chatnpc("<p,neutral>The mould is the carving itself. Take clay to the lid.");

[label,m2_veliaf_recipe_idle]
if (%myreque_2_quest = ^m2_mould) {
    ~chatnpc("<p,neutral>You have the shape of it. Silver and mithril and a sapphire, at a furnace.");
    return;
}
if (%myreque_2_quest = ^m2_rod) {
    ~chatnpc("<p,neutral>A beautiful rod that does nothing. Enchant the stone, then charge it down the well.");
    return;
}
~chatnpc("<p,neutral>Clay against the carving on the lid. That is your mould.");

[label,m2_finish]
~chatplayer("<p,happy>It is made, and it is charged.");
~chatnpc("<p,shock>...give me that.");
if_close;
mes("Veliaf turns the rod over twice and does not let go of it.");
p_delay(5);
inv_del(inv, burgh_rod_command_final_10, 1);
~mesbox("\"Sixty years,\" he says. \"Sixty years of hurting them and running, and a dead priest had the answer written on his own coffin lid the whole time.\" | He hands it straight back. \"You made it. You carry it. There are ten charges in that and I want to know what happens to the first thing you use one on.\"");
p_delay(3);
inv_add(inv, burgh_rod_command_final_10, 1);
%myreque_2_quest = ^m2_complete;
// ...and Temple Trekking opens. The six volunteers are spawned in Burgh de Rott already and hidden
// behind multivar=templetrek_npcs_visible; this is the write that makes them visible.
~trek_unlock;
%blood_tithe_visible = ^m2_tithe_over;
stat_advance(attack, ^m2_reward_xp);
stat_advance(strength, ^m2_reward_xp);
stat_advance(defence, ^m2_reward_xp);
stat_advance(crafting, ^m2_reward_xp);
session_log(^log_adventure, "Quest complete: In Aid of the Myreque");
~send_quest_complete(questlist:myreque_2, burgh_plaster_inscription_ivandis, 200, ^m2_questpoints, "You have completed\\nIn Aid of the Myreque!", "2 Quest Points|2,000 Attack XP|2,000 Strength XP|2,000 Defence XP|2,000 Crafting XP|Burgh de Rott|The Myreque have a home");

// =========================================================================== the village leader
[opnpc1,burgh_vilager_leader]
switch_int (%myreque_2_quest) {
    case ^m2_not_started :
        ~chatnpc("<p,sad>There is nothing here. I am not being modest. There is nothing here.");
    // ^m2_sent WAS A DEAD CASE. You cannot be standing in front of her at ^m2_sent, because
    // getting through Florin's gate is what moves the quest to ^m2_fed - so the village leader
    // never briefed anybody and the three repairs, which are all gated on ^m2_arrived, could not
    // be started. The quest stopped at its second step.
    case ^m2_sent : @m2_leader_brief;
    case ^m2_fed : @m2_leader_brief;
    case ^m2_arrived : @m2_leader_check;
    case ^m2_rebuilt :
        ~chatnpc("<p,happy>The shop has stock and the bank has a teller and the furnace is lit, and now we will find out how long we are allowed to keep them.");
    case ^m2_tithe :
        ~chatnpc("<p,sad>They come for the tithe. They have always come for the tithe. That is the arrangement and the arrangement is why there are still forty of us.");
    case default :
        ~chatnpc("<p,happy>Six armed strangers moved into the inn cellar and the whole village slept through the night for the first time in my life.");
}

[label,m2_leader_brief]
~chatnpc("<p,sad>You walked through Mort Myre. On purpose.");
~chatplayer("<p,neutral>I'm told this place used to be a port.");
~chatnpc("<p,sad>It was. Now it is forty people and a hole in every roof.");
~chatnpc("<p,neutral>The shop has no stock and half a roof. The bank has a broken booth and no teller, because the man who would be the teller will not stand behind a booth that is falling over. The furnace has been cold since my father was alive.");
~chatnpc("<p,sad>And we cannot light a fire, because there is nothing in this village dry enough to burn and nowhere to buy a tinderbox.");
%myreque_2_quest = ^m2_arrived;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);

[label,m2_leader_check]
if (~m2_town_done = false) {
    ~chatnpc("<p,neutral>The shop, the bank and the furnace.");
    if (%burgh_store_stocked = ^m2_off) {
        ~chatnpc("<p,neutral>The store roof leaks, the wall is out and the shelves are bare. All three.");
    }
    if (%burgh_bank_booth_open = ^m2_off | %burgh_bank_wall = ^m2_off) {
        ~chatnpc("<p,neutral>The bank booth and the wall behind it.");
    }
    if (%burgh_furnace_fix < ^m2_furnace_fired) {
        ~chatnpc("<p,neutral>The furnace: mend it, load it, light it.");
    }
    return;
}
~chatnpc("<p,shock>You have done all of it.");
~chatnpc("<p,happy>There is a shop. There is a bank. There is smoke coming out of the furnace and every fire in this village is lit off it.");
%myreque_2_quest = ^m2_rebuilt;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
// Which is the moment the people who take a cut of this town notice that there is a cut to take.
%blood_tithe_visible = ^m2_tithe_happening;
%myreque_2_quest = ^m2_tithe;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
if_close;
mes("Somebody outside starts shouting, and then stops shouting, which is worse.");

[proc,m2_town_done]()(boolean)
if (%burgh_store_stocked = ^m2_off) { return(false); }
if (%burgh_store_roof = ^m2_off) { return(false); }
if (%burgh_store_wall = ^m2_off) { return(false); }
if (%burgh_bank_booth_open = ^m2_off) { return(false); }
if (%burgh_bank_wall = ^m2_off) { return(false); }
if (%burgh_furnace_fix < ^m2_furnace_fired) { return(false); }
return(true);

// =========================================================================== getting into the village
// Burgh de Rott is fenced in, and neither the gate on the swamp road nor the low fence on the west
// side had a handler - so nobody could get into the village this quest rebuilds. The inn's front
// door (ahoy_harbour_door, the same door Port Phasmatys uses) is in doors/scripts. The broken back
// wall of the inn, over which the trapdoor and its rubble are reached, had no handler either.
// The gate itself is in scripts/myreque2_village.rs2 now, because it is Florin's gate: it does not
// open until something to eat has gone in the chest, which is the walkthrough's fifth step.

[oploc1,burgh_agility_shortcut_fence]
// NOT A WAY ROUND FLORIN. It is a low fence on the west side of the village and hopping it got you
// in without ever feeding him, which is the one thing the walkthrough makes you do to get in at all.
// Out is always allowed; in needs the gate to have been opened for you once.
if (%myreque_2_quest < ^m2_fed & coordx(coord) < coordx(loc_coord)) {
    ~mesbox("There is a fence, and beyond the fence there are forty people watching you look at it. Somebody will be at the gate.");
    return;
}
anim(human_jump_hurdle, 0);
~walk_through_door;

[oploc1,burgh_inn_climb_over]
anim(human_jump_hurdle, 0);
~walk_through_door;

// =========================================================================== the general store
[opnpc1,burgh_general_store_owner]
if (%myreque_2_quest < ^m2_arrived) {
    ~chatnpc("<p,sad>I have a shop. I have had a shop for thirty years. I have not had any stock for eleven.");
    return;
}
// THE GADDERHAMMER, which the walkthrough has him hand over and which nothing in this build was
// handing over at all. gadderanks_warhammer is in the cache and was reachable from nowhere.
if (%myreque_2_quest >= ^m2_tithe_broken & ~obj_gettotal(gadderanks_warhammer) = 0) {
    @m2_aurel_hammer;
}
if (%burgh_store_stocked = ^m2_on) {
    ~chatnpc("<p,happy>Tinderboxes, axes and <~m2_food_name>. It is not much of a range and it is the first range this village has had since I was a young man.");
    return;
}
if (%burgh_store_roof = ^m2_off) {
    ~chatplayer("<p,quiz>Can I do anything about the shop?");
    ~chatnpc("<p,sad>Not while it rains inside it. The roof is up the ladder. Planks, a hammer and nails, and I will thank you for the rest of my life.");
    return;
}
if (%burgh_store_wall = ^m2_off) {
    ~chatnpc("<p,neutral>The roof is done. The wall is still open to the street and I am not stocking shelves that anybody can reach from outside.");
    return;
}
// Roof and wall done, and now the stock, which is his own step: scripts/myreque2_crate.rs2.
@m2_aurel_crate;

[label,m2_aurel_hammer]
~chatnpc("<p,shock>He had this on him. I am not keeping it in my shop and nobody in this village will touch it.");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Come back with a hand free.");
    return;
}
inv_add(inv, gadderanks_warhammer, 1);
~objbox(gadderanks_warhammer, "Gadderanks' own warhammer, which he used on people who could not pay. It is badly balanced and it hits like a falling wall.", 250, 0, divide(^objbox_height, 2));
~chatnpc("<p,neutral>Take it with you. Use it on one of them.");

// The repairs take what the wiki says they take: 3 planks and 12 steel nails for the roof and for
// each wall, 2 planks, 8 nails and a swamp paste for the bank booth, and a hammer for all of it -
// 11 planks and 44 nails. The cache gives these locs Search and nothing else, so Search does the
// repair once you are carrying everything, and so does using any of the materials on them.
[oploc1,burgh_general_store_roof_multiloc] @m2_fix_roof;
[oplocu,burgh_general_store_roof_multiloc]
if (~m2_repair_item(last_useitem) = false) {
    ~displaymessage(^dm_default);
    return;
}
@m2_fix_roof;

[label,m2_fix_roof]
if (%burgh_store_roof = ^m2_on) {
    ~mesbox("A repaired roof, from above, which is the only angle it looks convincing from.");
    return;
}
p_arrivedelay;
if (%myreque_2_quest < ^m2_arrived) {
    ~mesbox("There is more sky in this roof than roof.");
    return;
}
if (~m2_has_repair(^m2_wall_planks, ^m2_wall_nails, false) = false) {
    ~mesbox("Three planks, twelve steel nails and a hammer.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(5);
inv_del(inv, woodplank, ^m2_wall_planks);
inv_del(inv, nails, ^m2_wall_nails);
%burgh_store_roof = ^m2_on;
stat_advance(crafting, 3000);
mes("It is not a good roof. It is a roof.");

// Planks, nails, the hammer, and the swamp paste the booth wants - anything else used on a repair
// does nothing.
[proc,m2_repair_item](obj $item)(boolean)
if ($item = woodplank | $item = nails | $item = hammer | $item = swamppaste) {
    return(true);
}
return(false);

[proc,m2_has_repair](int $planks, int $nails, boolean $paste)(boolean)
if (inv_total(inv, woodplank) < $planks | inv_total(inv, nails) < $nails | inv_total(inv, hammer) = 0) {
    return(false);
}
if ($paste = true & inv_total(inv, swamppaste) = 0) {
    return(false);
}
return(true);

[oploc1,burgh_general_store_wall_multiloc] @m2_board_wall(^m2_store_wall);
[oploc1,burgh_bank_wall_multiloc] @m2_board_wall(^m2_bank_wall);
[oplocu,burgh_general_store_wall_multiloc]
if (~m2_repair_item(last_useitem) = false) {
    ~displaymessage(^dm_default);
    return;
}
@m2_board_wall(^m2_store_wall);
[oplocu,burgh_bank_wall_multiloc]
if (~m2_repair_item(last_useitem) = false) {
    ~displaymessage(^dm_default);
    return;
}
@m2_board_wall(^m2_bank_wall);

[label,m2_board_wall](coord $wall)
p_arrivedelay;
if ($wall = ^m2_store_wall & %burgh_store_wall = ^m2_on) {
    ~mesbox("A wall.");
    return;
}
if ($wall = ^m2_bank_wall & %burgh_bank_wall = ^m2_on) {
    ~mesbox("A wall.");
    return;
}
if (%myreque_2_quest < ^m2_arrived) {
    ~mesbox("The wall has fallen out and somebody has leaned boards against the hole.");
    return;
}
if (~m2_has_repair(^m2_wall_planks, ^m2_wall_nails, false) = false) {
    ~mesbox("Three planks, twelve steel nails and a hammer.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(4);
inv_del(inv, woodplank, ^m2_wall_planks);
inv_del(inv, nails, ^m2_wall_nails);
if ($wall = ^m2_store_wall) {
    %burgh_store_wall = ^m2_on;
    mes("The shop wall is a wall again.");
} else {
    %burgh_bank_wall = ^m2_on;
    mes("The bank wall is a wall again.");
    ~m2_bank_teller_check;
}
stat_advance(crafting, 2000);

[oploc1,burgh_ladder_generalstore_up]
p_arrivedelay;
mes("You climb up.");
// The constants are the ladders' own tiles, which a ladder blocks; land beside them.
p_teleport(movecoord(^m2_store_ladder_down, 0, 0, 1));

[oploc1,burgh_ladder_generalstore_down]
p_arrivedelay;
mes("You climb down.");
p_teleport(movecoord(^m2_store_ladder_up, 0, 0, 1));

// =========================================================================== the bank
// burgh_bankbooth_repaired declares op1=Use and op2=Use-quickly, which is the same pair the real
// bank booths use, so once it stands up it is a bank booth and behaves like one.
[oploc1,burgh_bank_booth_multiloc]
if (%burgh_bank_booth_open = ^m2_on) {
    @openbank;
}
@m2_fix_booth;

[oplocu,burgh_bank_booth_multiloc]
if (%burgh_bank_booth_open = ^m2_on | ~m2_repair_item(last_useitem) = false) {
    ~displaymessage(^dm_default);
    return;
}
@m2_fix_booth;

[label,m2_fix_booth]
p_arrivedelay;
if (%myreque_2_quest < ^m2_arrived) {
    ~mesbox("A bank booth with one leg and no bank behind it.");
    return;
}
if (~m2_has_repair(^m2_booth_planks, ^m2_booth_nails, true) = false) {
    ~mesbox("Two planks, eight steel nails, some swamp paste and a hammer.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(4);
inv_del(inv, woodplank, ^m2_booth_planks);
inv_del(inv, nails, ^m2_booth_nails);
inv_del(inv, swamppaste, 1);
%burgh_bank_booth_open = ^m2_on;
stat_advance(crafting, 2000);
mes("The booth stands up on its own.");
~m2_bank_teller_check;

// The man who would be the teller will not stand behind a booth that falls over, and will not stand
// in front of a hole in the wall either. Both, and he takes the job.
[proc,m2_bank_teller_check]()()
if (%burgh_bank_booth_open = ^m2_off | %burgh_bank_wall = ^m2_off) {
    return;
}
if (%burgh_bank_teller = ^m2_on) {
    return;
}
%burgh_bank_teller = ^m2_on;
~mesbox("Somebody who has been standing near that booth doing nothing for eleven years walks round behind it and starts doing something.");

[oploc2,burgh_bank_booth_multiloc]
if (%burgh_bank_booth_open = ^m2_off) {
    ~mesbox("It has one leg.");
    return;
}
@openbank;

[opnpc1,burgh_actual_bank_teller_multinpc]
~chatnpc("<p,happy>Burgh de Rott has a bank. I have a job. Both of those sentences are new to me.");
@openbank;

[opnpc1,burgh_potential_bank_teller_multinpc]
if (%burgh_bank_booth_open = ^m2_off) {
    ~chatnpc("<p,sad>I was a bank teller. There is a booth over there with one leg on it and I am not standing behind that.");
    return;
}
if (%burgh_bank_wall = ^m2_off) {
    ~chatnpc("<p,sad>The booth stands up now. The wall behind it does not, and a bank with a hole in the back of it is a pile of coins in a field.");
    return;
}
~chatnpc("<p,neutral>...both of them. Right.");
~m2_bank_teller_check;

// =========================================================================== the furnace
[oploc1,burgh_furnace_multiloc]
switch_int (%burgh_furnace_fix) {
    case ^m2_furnace_repaired : @m2_furnace_load;
    case ^m2_furnace_coal : @m2_furnace_light;
    case ^m2_furnace_fired : @m2_furnace_smelt;
}
p_arrivedelay;
if (%myreque_2_quest < ^m2_arrived) {
    ~mesbox("The furnace is cracked from the base to the flue and has been cold long enough for things to be nesting in it.");
    return;
}
if (inv_total(inv, bucket_water) = 0 | inv_total(inv, softclay) = 0) {
    ~mesbox("A crack that wide wants clay and water, not planks.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(5);
inv_del(inv, softclay, 1);
inv_del(inv, bucket_water, 1);
%burgh_furnace_fix = ^m2_furnace_repaired;
stat_advance(crafting, 3000);
mes("You pack the crack and smooth it off. It will hold.");

[label,m2_furnace_load]
p_arrivedelay;
if (inv_total(inv, coal) < 5) {
    ~mesbox("Mended and empty. Five coal would start it.");
    return;
}
inv_del(inv, coal, 5);
%burgh_furnace_fix = ^m2_furnace_coal;
mes("You load the furnace.");

[label,m2_furnace_light]
p_arrivedelay;
if (inv_total(inv, tinderbox) = 0) {
    ~mesbox("Loaded, and nothing in this village to light it with. That is rather the whole problem.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(4);
%burgh_furnace_fix = ^m2_furnace_fired;
stat_advance(firemaking, 4000);
// burgh_furnace_smoke_multiloc reads the same varbit and puts smoke over the roof at 3.
~mesbox("It catches, and then it roars, and there is smoke coming out of a Burgh de Rott chimney for the first time in forty years. People come out of their houses to look at it.");

[label,m2_furnace_smelt]
~mesbox("A working furnace, in a town that has not had one since before anybody here was born.");
return;

// =========================================================================== the blood tithe
[opnpc1,burgh_gadderanks_multinpc]
if (%blood_tithe_visible ! ^m2_tithe_happening) {
    ~chatnpc("<p,angry>Move.");
    return;
}
~chatnpc("<p,angry>Queue up or clear off. The tithe is the tithe.");
~chatplayer("<p,quiz>They're bleeding into a barrel.");
~chatnpc("<p,laugh>Into a barrel, and the barrel goes north, and in return nothing happens to the other thirty-nine of them. It is the best arrangement anybody in this swamp has.");
~chatplayer("<p,neutral>Not today.");
~chatnpc("<p,angry>You are going to regret being memorable.");
if_close;
~m2_tithe_fight;

// IT WAS A MESBOX. Four lines of narration, twelve points of self-damage and a stage change, for
// the fight this quest is remembered for - while the cache was holding three npcs for it and using
// none of them: burgh_gadderanks_attackable (level 35, Attack, no statblock, placed nowhere),
// burgh_gadderanks_wounded (size 2, a fall-over ready animation, Talk-to) and two Vampyre Juvinates
// with full statblocks of their own. So he is spawned and fought, he falls over rather than dying,
// and what he has to say he says lying in the mud.
//
// NO SILVER REQUIREMENT. The walkthrough wants Efaritay's aid or a silver weapon, and this build has
// no vampyre damage rules anywhere - adding them is a combat subsystem and not this quest's job, so
// the juvinates here can be hurt by anything.
[proc,m2_tithe_fight]()()
mes("Gadderanks puts the villager down and turns round, and the two juvinates behind him stop looking bored.");
p_delay(4);
npc_add(^m2_gadderanks_spot, burgh_gadderanks_attackable, ^m2_fight_duration);
npc_setmode(opplayer2);
npc_add(^m2_juve1_spot, burgh_vampire_juve_1, ^m2_fight_duration);
npc_setmode(opplayer2);
npc_add(^m2_juve2_spot, burgh_vampire_juve_2, ^m2_fight_duration);
npc_setmode(opplayer2);
~mesbox("Three of them, in a street with forty people watching. | There is a table in the shop behind you and the juvinates are not clever about tables.");

[ai_queue3,burgh_gadderanks_attackable]
def_coord $at = npc_coord;
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// He is not dead. He is beaten, and the cache has a body for that.
npc_add($at, burgh_gadderanks_wounded, ^m2_fight_duration);
queue(m2_gadderanks_down, 0, 0);

[queue,m2_gadderanks_down]
if (%myreque_2_quest >= ^m2_tithe_broken) {
    return;
}
~mesbox("He goes down in the mud beside his own barrel and does not get up, and he is still talking.");

// Lying in the mud, with the whole village standing round him.
[opnpc1,burgh_gadderanks_wounded]
if (%myreque_2_quest >= ^m2_tithe_broken) {
    ~chatnpc("<p,sad>Go on then.");
    return;
}
~chatnpc("<p,sad>You have no idea what you have just done.");
~chatplayer("<p,quiz>Who sends you?");
~chatnpc("<p,angry>Vanstrom Klause. And he did not send me for blood, he sent me for a count - how many of them are left and which of them is worth taking.");
~chatnpc("<p,sad>He has known about your lot for twenty years. He has been letting you run.");
~chatplayer("<p,quiz>Why?");
~chatnpc("<p,laugh>Because a resistance you can see is worth more than one you cannot.");
if_close;
mes("He stops talking.");
p_delay(4);
%blood_tithe_visible = ^m2_tithe_myreque;
%myreque_2_quest = ^m2_tithe_broken;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
stat_advance(attack, 8000);
stat_advance(defence, 8000);
npc_del;
~mesbox("The juvinates that are left look at him, and at you, and at forty villagers who have all stopped moving, and they go. | Somebody who has walked here from the Hollows is standing where the villager was. | Aurel is coming up the street with something heavy in both hands.");

[opnpc1,burgh_villager_tithe_multinpc]
if (%blood_tithe_visible = ^m2_tithe_myreque) {
    @myreque2_veliaf;
}
if (%blood_tithe_visible = ^m2_tithe_happening) {
    ~chatnpc("<p,sad>Don't. It is quicker if nobody does anything.");
    return;
}
~chatnpc("<p,sad>Eleven years I have been in that queue.");

[opnpc1,burgh_juve1_multinpc] ~mesbox("It does not acknowledge you. Gadderanks does the talking.");
[opnpc1,burgh_juve2_multinpc] ~mesbox("It does not acknowledge you. Gadderanks does the talking.");

// =========================================================================== the inn cellar
// FIXED: this was [oploc1,...] and BOTH children of the multiloc - burgh_inn_rubble_blocked and
// burgh_inn_rubble_cleared - carry no ops at all, so the trigger could never fire and the inn
// cellar could not be opened. It comes out a bucket at a time, so the bucket does the asking:
// [oplocu] needs no op on the loc.
// THE RUBBLE, which the walkthrough does in three motions and this build was doing in one. The
// cache has all three: burgh_inn_rubble_rock carries Mine/Prospect, burgh_rubble_bucket_1/2/3 are
// one bucket at three fill levels with iop4=Empty on each, and burgh_outside_rubble_pile is placed
// at 3489,3227 with a Search op and - until now - no handler at all, which is the pile the
// walkthrough says to empty the buckets onto.
//
// So: a pickaxe breaks the rubble (which is what the wiki's 15 Mining is for and the only thing in
// this quest that wants it), a spade fills a bucket a stage at a time, and a bucket emptied on the
// pile credits as many loads as it was holding. Three loads and the wall is off the trapdoor.
//
// burgh_inn_rubble_rock and burgh_rubble_a_1..4 are in the cache and placed on no map square, so
// the inn's own collapsed wall is the rubble and the pickaxe goes on that.
[oplocu,burgh_inn_colapsed_wall_multiloc]
// p_arrivedelay corrupts last_useitem, so it is read before the walk, not after.
def_obj $used = last_useitem;
p_arrivedelay;
if (%burgh_inn_colapsed_wall = ^m2_on) {
    ~mesbox("Where the back wall of the inn used to be. There is a trapdoor in the floor.");
    return;
}
if (%myreque_2_quest < ^m2_tithe_broken) {
    ~mesbox("The inn's back wall came down at some point and nobody has moved it, because moving it takes four people and there are not four spare people in Burgh de Rott.");
    return;
}
if ($used ! spade & $used ! bucket_empty) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, spade) = 0) {
    ~mesbox("It comes out a bucket at a time and you have nothing to shovel it with. A spade.");
    return;
}
if (~m2_pickaxe = false) {
    ~mesbox("Half of it is one piece. You would want a pickaxe.");
    return;
}
if (stat_base(mining) < ^m2_mining_needed) {
    ~mesbox("You need a Mining level of <tostring(^m2_mining_needed)> to break this up.");
    return;
}
def_obj $bucket = ~m2_rubble_bucket;
if ($bucket = null) {
    ~mesbox("Every bucket you are carrying is full. There is a pile to empty them on south-west of the bar.");
    return;
}
anim(human_mining_bronze_pickaxe, 0);
p_delay(4);
if ($bucket = bucket_empty) {
    inv_del(inv, bucket_empty, 1);
    inv_add(inv, burgh_rubble_bucket_1, 1);
    mes("You break a piece off and shovel it into the bucket.");
    return;
}
if ($bucket = burgh_rubble_bucket_1) {
    inv_del(inv, burgh_rubble_bucket_1, 1);
    inv_add(inv, burgh_rubble_bucket_2, 1);
    mes("The bucket is nearly full.");
    return;
}
inv_del(inv, burgh_rubble_bucket_2, 1);
inv_add(inv, burgh_rubble_bucket_3, 1);
mes("The bucket will not take any more. There is a pile south-west of the bar.");

// A pickaxe of any kind, held or wielded.
[proc,m2_pickaxe]()(boolean)
if (inv_total(inv, bronze_pickaxe) > 0 | inv_total(inv, iron_pickaxe) > 0 | inv_total(inv, steel_pickaxe) > 0) {
    return(true);
}
if (inv_total(inv, mithril_pickaxe) > 0 | inv_total(inv, adamant_pickaxe) > 0 | inv_total(inv, rune_pickaxe) > 0) {
    return(true);
}
if (inv_total(worn, bronze_pickaxe) > 0 | inv_total(worn, iron_pickaxe) > 0 | inv_total(worn, steel_pickaxe) > 0) {
    return(true);
}
if (inv_total(worn, mithril_pickaxe) > 0 | inv_total(worn, adamant_pickaxe) > 0 | inv_total(worn, rune_pickaxe) > 0) {
    return(true);
}
return(false);

// The emptiest bucket being carried, or null if every one of them is full.
[proc,m2_rubble_bucket]()(obj)
if (inv_total(inv, bucket_empty) > 0) { return(bucket_empty); }
if (inv_total(inv, burgh_rubble_bucket_1) > 0) { return(burgh_rubble_bucket_1); }
if (inv_total(inv, burgh_rubble_bucket_2) > 0) { return(burgh_rubble_bucket_2); }
return(null);

// The pile south-west of the bar. A bucket emptied on it credits what it was holding.
[oplocu,burgh_outside_rubble_pile]
def_obj $used = last_useitem;
p_arrivedelay;
def_int $loads = 0;
if ($used = burgh_rubble_bucket_1) { $loads = 1; }
if ($used = burgh_rubble_bucket_2) { $loads = 2; }
if ($used = burgh_rubble_bucket_3) { $loads = 3; }
if ($loads = 0) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, $used, 1);
inv_add(inv, bucket_empty, 1);
anim(human_pickupfloor, 0);
p_delay(3);
if (%burgh_inn_colapsed_wall = ^m2_on) {
    mes("You tip it onto the pile.");
    return;
}
%burgh_inn_rubble_pile = add(%burgh_inn_rubble_pile, $loads);
if (%burgh_inn_rubble_pile >= ^m2_rubble_loads) {
    %burgh_inn_colapsed_wall = ^m2_on;
    stat_advance(strength, 4000);
    ~mesbox("That is the last of it. There is a floor under the inn's back wall, and a trapdoor in the floor.");
    return;
}
mes("You tip it onto the pile. There is more of it in the inn.");

[oploc1,burgh_outside_rubble_pile]
p_arrivedelay;
if (%burgh_inn_colapsed_wall = ^m2_on) {
    ~mesbox("The back wall of the inn, in a heap, in the street, where it is at least not on top of a trapdoor.");
    return;
}
~mesbox("Where the village has been putting rubble for sixty years. There is room for a good deal more of it.");

// iop4=Empty on each of the three fill states tips the bucket out where you stand, and anywhere is
// not the pile, so it does not count for anything - general_use/scripts/containers_generated.rs2
// already covers all three of them and does exactly that.

[oploc1,burgh_inn_trapdoor_multiloc]
p_arrivedelay;
if (%burgh_inn_trapdoor = ^m2_on) {
    mes("You climb down.");
    p_teleport(movecoord(^m2_cellar_ladder, 0, 0, -1)); // the ladder's own tile is blocked
    return;
}
if (%burgh_inn_colapsed_wall = ^m2_off) {
    ~mesbox("There is half a wall on top of it.");
    return;
}
mes("You pull the trapdoor open.");
%burgh_inn_trapdoor = ^m2_on;
if (%myreque_2_quest = ^m2_tithe_broken) {
    %myreque_2_quest = ^m2_base;
    ~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
    // The Myreque come down from the Hollows.
    %burgh_route_myreque_party_visible = ^m2_on;
    ~mesbox("A dry stone cellar the length of the inn, with a ladder, and nothing living in it. | Six people could hold this against a great deal.");
}

[oploc2,burgh_inn_trapdoor_multiloc]
%burgh_inn_trapdoor = ^m2_off;
mes("You close the trapdoor.");

[oploc1,burgh_inn_basement_ladderup]
p_arrivedelay;
mes("You climb up.");
// The trapdoor sits under the rubble's footprint, which blocks; come up beside it, inside the inn.
p_teleport(movecoord(^m2_inn_trapdoor, 1, 0, 0));

[oploc1,burgh_inn_wall_plaque]
~mesbox("BURGH DE ROTT | A free port of the Kingdom of Hallowland | and this is as much of it as is still legible.");

// =========================================================================== Veliaf, in the cellar
[opnpc1,burgh_rescue_veliaf_hurtz_talk] @myreque2_veliaf;

// =========================================================================== Paterdomus
// The catacombs under Paterdomus. holy_barrier.rs2 already puts the player one room away.
[oploc1,burgh_library_keyhole]
p_arrivedelay;
if (%myreque_2_quest < ^m2_temple) {
    ~mesbox("A keyhole in a wall with no door in it, which is the sort of thing that stops being strange once you have been in these catacombs for a while.");
    return;
}
if (%burgh_temple_trapdoor = ^m2_on) {
    ~mesbox("The trapdoor beside it is already open.");
    return;
}
if (inv_total(inv, burgh_key) = 0) {
    ~mesbox("There is a keyhole and no door. Whatever it opens is in the floor, and it is locked, and the priests upstairs keep the key and will tell you they do not.");
    return;
}
mes("The key turns and something heavy moves in the floor.");
p_delay(3);
%burgh_temple_trapdoor = ^m2_on;
~mesbox("A trapdoor has opened where there was no trapdoor. The temple library has not been opened in two hundred years and the priests upstairs have spent all of it not mentioning that it exists.");

[oploc1,burgh_temple_trapdoor_multiloc]
p_arrivedelay;
mes("You climb down into the library.");
p_delay(2);
p_teleport(movecoord(^m2_library_ladder, 0, 0, -1)); // the ladder's own tile is blocked

[oploc1,burgh_temple_library_ladder_up]
p_arrivedelay;
mes("You climb up.");
p_teleport(movecoord(^m2_temple_trapdoor, 0, 0, -1)); // the trapdoor sits on a blocked tile

[oploc1,burgh_library_bookcase_history]
p_arrivedelay;
if (inv_total(inv, burgh_book_sevenwarriors) > 0 | %myreque_2_quest > ^m2_temple) {
    ~mesbox("Histories, and one gap on the shelf where you took the useful one.");
    return;
}
if (inv_freespace(inv) < 2) {
    mes("You have no room.");
    return;
}
inv_add(inv, burgh_book_sevenwarriors, 1);
inv_add(inv, burgh_book_historiesofhallowland, 1);
~mesbox("Two books come off the shelf together, because somebody shelved them together on purpose. | One is a history of Hallowland. The other is about seven warrior priests, and it was written two hundred years ago.");

[oploc1,burgh_library_bookcase_ivandis]
p_arrivedelay;
if (inv_total(inv, burgh_book_sevenwarriors) = 0 & %myreque_2_quest <= ^m2_temple) {
    ~mesbox("This case is all one hand and it is not indexed. You would need to know what you were looking for.");
    return;
}
if (%myreque_2_quest > ^m2_temple) {
    ~mesbox("The case where the seventh name was not.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room.");
    return;
}
if_close;
mes("You work along the case with the seven names in front of you. Six of them are here.");
p_delay(5);
inv_add(inv, burgh_efaritay_info_scroll, 1);
%myreque_2_quest = ^m2_books;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
~mesbox("The seventh is Ivandis Seergaze, and there is nothing under his name at all - not a removal, not a gap, nothing. Somebody went through this library and took him out of it. | Behind where he should have been there is a scroll. It is not about him. It is a man called Sialathin writing to his wife about getting her out of Hallowvale, and it is the sort of thing that ends up behind a shelf when somebody is hiding one document properly and everything else in a hurry.");

// =========================================================================== Ivandis's tomb
// FIXED: same defect. burgh_ivandis_boardedupdoor carries no ops, so this could never fire and
// the tomb could not be opened. It is two hundred years of nails, so the hammer does the asking.
[oplocu,burgh_ivandis_tombdoor_board_multiloc]
def_obj $used = last_useitem;
p_arrivedelay;
if ($used ! hammer) {
    ~displaymessage(^dm_default);
    return;
}
if (%ivandis_tomb_boards = ^m2_on) {
    ~mesbox("The door the boards were on.");
    return;
}
if (%myreque_2_quest < ^m2_books) {
    ~mesbox("A door in the Hollows that somebody boarded up a very long time ago. Everybody down here has assumed for twenty years that it was structural.");
    return;
}
anim(human_pickupfloor, 0);
p_delay(5);
%ivandis_tomb_boards = ^m2_on;
%myreque_2_quest = ^m2_tomb;
~send_quest_progress(questlist:myreque_2, %myreque_2_quest, ^m2_complete);
~mesbox("The boards come off. Behind them is a passage that has not had air in it since Efaritay put the last nail in.");

[oploc1,burgh_ivandis_tomb_entrance]
p_arrivedelay;
if (%ivandis_tomb_boards = ^m2_off) {
    ~mesbox("There are boards over it.");
    return;
}
mes("You go in.");
p_delay(2);
p_teleport(movecoord(^m2_tomb_exit, 0, 0, -1)); // the exit's own tile is blocked

[oploc1,burgh_ivandis_tomb_exit]
p_arrivedelay;
mes("You come back out into the Hollows.");
p_delay(2);
p_teleport(movecoord(^m2_tomb_entrance, -1, 0, -1)); // the entrance's own tile is blocked

[oploc1,burgh_ancient_coffin]
p_arrivedelay;
if (inv_total(inv, burgh_plaster_inscription_ivandis) > 0 | %myreque_2_quest >= ^m2_complete) {
    ~mesbox("Ivandis Seergaze, who is not in the histories because somebody made sure of it.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You have no room.");
    return;
}
mes("The wall above the tomb has been plastered over, and the plaster is coming away.");
p_delay(3);
inv_add(inv, burgh_plaster_inscription_ivandis, 1);
~mesbox("Under the plaster there is carving, and the plaster itself has taken the impression of it. | A fragment comes away in your hand with the whole of it on the back.");

// =========================================================================== the chest in the cellar
// IT DOES NOT HOLD THE LIBRARY KEY. It used to, because the quest had no way of reaching Drezel
// and the key had to come from somewhere; the guide has Drezel hand it over when you bring Ivan to
// him, and now the escort does. The chest is a chest.
[oploc1,burgh_chest_closed]
p_arrivedelay;
~mesbox("Locked, and nobody in Burgh de Rott has ever claimed it. Whatever is in it has been in it longer than the people upstairs have been alive.");
