// In Aid of the Myreque.
//
// The largest thing left unbuilt: 206 burgh_ locs, 65 burgh_ npcs, 33 objs and thirty-two varbits
// across two varps, and not one line of script. Most of it is a town.
//
// ---------------------------------------------------------------------------- the town
// myreque_2_main_var is Burgh de Rott, bit by bit, and every multiloc on it reads the same way -
// index 0 is the ruin and the last index is the repair:
//
//   burgh_inn_colapsed_wall   0 rubble blocked   -> 1 rubble cleared
//   burgh_inn_trapdoor        0 closed           -> 1 open
//   burgh_store_roof          0 broken           -> 1 fixed
//   burgh_store_wall          0 damaged (clickable) -> 1 repaired
//   burgh_bank_booth_open     0 damaged          -> 1 repaired
//   burgh_bank_wall           0 damaged          -> 1 repaired
//   burgh_bank_teller         0 a villager       -> 1 a bank teller
//   burgh_furnace_fix         0 broken -> 1 repaired -> 2 coal loaded -> 3 fired
//                             and burgh_furnace_smoke_multiloc puts smoke over the roof at 3
//   burgh_store_stocked       one bit, and SIX locs read it: three crates, three sets of shelves,
//                             and burgh_fires_multiloc, which is how the village fires get lit
//   burgh_temple_trapdoor     index 1 only - there is no trapdoor until there is
//   ivandis_tomb_boards       index 0 only - the boards are there until they are not
//
// One bit stocking a shop and lighting four fires across the village is the nicest thing in here.
// The shop opens and the town has something to burn.
//
// ---------------------------------------------------------------------------- the blood tithe
//   blood_tithe_visible, two bits, and four npcs and a barrel read it:
//     0  a plain barrel, nobody
//     1  a blood barrel, Gadderanks, two juvinates and a villager being bled
//     2  a blood barrel, and where the villager was standing there is now Veliaf Hurtz
//     3  a plain barrel, nobody
//
// The scene is written into the config. It happens, it is broken up, the Myreque arrive on the spot
// where it happened, and then the square is quiet.
//
// ---------------------------------------------------------------------------- the map convention
// Underground squares are the surface square's z plus 100, and the tile does not move:
//   m54_50  Burgh de Rott      m54_150  the inn basement
//   m54_53  the Canifis swamp  m54_153  the Hollows
//   m53_54  Paterdomus         m53_154  the temple catacombs
// which is how the inn trapdoor at (34,32) and the basement ladder at (34,32) are the same hole.
^m2_not_started = 0
^m2_sent = 10           // Veliaf has named Burgh de Rott
^m2_fed = 12            // Florin has had something to eat and opened the gate
^m2_arrived = 20        // the village leader has explained what is wrong with it
^m2_rebuilt = 30        // shop, bank and furnace
^m2_tithe = 40          // the vampyres came to collect
^m2_tithe_broken = 50   // Gadderanks did not leave with a full barrel
^m2_base = 60           // the inn cellar is open
^m2_arrived_myreque = 70
// IVAN STROM, the guide's steps 31-35: Veliaf asks you to walk the boy who wants to be a priest
// through Mort Myre to Drezel, and the cache has the two of him - with a bronze sword and with a
// silver sickle - and the two level 75s who are waiting at the gate.
^m2_escort = 72         // Veliaf has asked, and Ivan is in the cellar
^m2_escorted = 74       // the ambush is behind you
^m2_temple = 80         // Drezel has the library key, and the catacombs
^m2_books = 90          // the histories read, the library opened
^m2_tomb = 100          // Ivandis's tomb opened
// THE ROD, which is what the quest is for. The fragment off the tomb is a recipe, and the cache has
// every piece of what it describes: the clay mould, the silvthrill rod, the enchanted rod and ten
// charge states of the Rod of Ivandis. The new stages go in the gaps, so nobody halfway through
// loses their place.
^m2_recipe = 102        // Veliaf has read the fragment and said what it is
^m2_mould = 104         // soft clay against the carving on the coffin
^m2_rod = 106           // cast at a furnace: silver, mithril and a sapphire
^m2_charged = 108       // lowered down the well under Paterdomus
^m2_complete = 110

// Casting the rod. The walkthrough gives no Crafting level for it, so this is the level the rest of
// the silver panel's quest pieces sit at and the experience a sapphire ring pays.
^m2_rod_crafting = 20
^m2_rod_crafting_xp = 1000

// ---------------------------------------------------------------------------- requirements
// The wiki lists four skills and the build was checking none of them. Mining is the one that was
// hardest to account for until the rubble was done properly: it is a pickaxe at the inn wall.
^m2_agility_needed = 25
^m2_crafting_needed = 25
^m2_mining_needed = 15
^m2_magic_needed = 7

// 2,000 each in Attack, Strength, Defence and Crafting, and stats are kept in tenths. Strength was
// missing and the quest points were 3; the wiki says two of them.
^m2_reward_xp = 20000

^m2_off = 0
^m2_on = 1

^m2_furnace_broken = 0
^m2_furnace_repaired = 1
^m2_furnace_coal = 2
^m2_furnace_fired = 3

^m2_tithe_none = 0
^m2_tithe_happening = 1
^m2_tithe_myreque = 2
^m2_tithe_over = 3

// THE RUBBLE. burgh_rubble_bucket_1/2/3 are not three buckets: they are one bucket "partially
// filled", "almost full" and "totally filled", each with iop4=Empty. So a spadeful fills the bucket
// a stage at a time and emptying it on the pile credits as many loads as it was holding - which is
// also why the wiki's item list says one to five buckets and recommends five.
^m2_rubble_loads = 3

// the repairs, as the wiki has them: 11 planks and 44 steel nails, and a swamp paste for the booth
^m2_wall_planks = 3     // the store roof, the store wall and the bank wall
^m2_wall_nails = 12
^m2_booth_planks = 2
^m2_booth_nails = 8

// ---------------------------------------------------------------------------- Burgh de Rott
^m2_leader = 0_54_50_34_41
^m2_store_owner = 0_54_50_61_41
