// waiting on the Paterdomus side of the gate. See scripts/myreque2_escort.rs2.
^m2_cellar_ivan = 0_54_150_35_32       // by the cellar ladder, which is where Veliaf says he is
^m2_ivan_duration = 3000
^m2_ivan_tick = 3
^m2_ivan_follow_range = 12
