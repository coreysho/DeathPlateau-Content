^m2_rubble_pile = 0_54_50_33_27         // 3489,3227, the pile south-west of the bar

// Where the tithe turns into a fight. burgh_gadderanks_attackable is level 35 with an Attack op and
// no statblock, and burgh_gadderanks_wounded is size 2 with a fall-over ready animation and a
// Talk-to - which is a man who is beaten, lying in the mud, and still has something to say. Neither
// of them is placed on any map square, because both of them are spawned.
^m2_gadderanks_spot = 0_54_50_58_39    // 3514,3239, in front of his own barrel
^m2_juve1_spot = 0_54_50_57_40         // 3513,3240
^m2_juve2_spot = 0_54_50_59_41         // 3515,3241
^m2_fight_duration = 1000

// ---------------------------------------------------------------------------- the inn cellar
^m2_cellar_ladder = 0_54_150_34_32
^m2_cellar_veliaf = 0_54_150_38_28
^m2_cellar_plaque = 0_54_150_38_32
^m2_cellar_chest = 0_54_150_37_32

// ---------------------------------------------------------------------------- Paterdomus
// holy_barrier.rs2 already drops the player at 0_53_154_48_31, one room from the trapdoor.
^m2_temple_trapdoor = 0_53_154_49_43
^m2_temple_keyhole = 0_53_154_51_42
^m2_library_ladder = 2_53_154_22_12
