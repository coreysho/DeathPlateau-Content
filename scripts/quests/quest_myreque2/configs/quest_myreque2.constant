// ---------------------------------------------------------------------------- Ivandis
// Off the Hollows, which is the map In Search of the Myreque opened up.
^m2_tomb_boards = 0_54_153_27_40
^m2_tomb_entrance = 0_54_153_28_40
^m2_tomb_exit = 2_54_153_5_30
^m2_hollows_veliaf = 0_54_153_50_46

// ---------------------------------------------------------------------------- the village
// Thirty-one people, and the cache names every one of them. See scripts/myreque2_village.rs2.
// Florin watches the gate and will not open it until something to eat has gone in the chest -
// burgh_quest_food_chest_closed, which is in the cache and placed on no map square, so it is
// added beside the gate when he asks for it and taken away when he has had it.
// The chest IS placed, open, at 3483,3246, with a table beside it - the pair of them is what the
// walkthrough's "open chest in front of the gate" means. An earlier pass added a second,
// closed one at 3485,3245 because nobody had looked.
^m2_food_chest_coord = 0_54_50_27_46    // 3483,3246, outside the fence
^m2_marius_coord = 0_54_50_59_9        // 3515,3209, beside Gabriela, who is placed and he is not
^m2_who_florin = 1
^m2_who_sorin = 2
