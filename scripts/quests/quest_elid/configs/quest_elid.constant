// Spirits of the Elid.
//
// %elidquest is NOT free. Two multilocs in Nardah switch on it and between them they enumerate
// every legal value:
//
//   [elid_fountain_multiloc]   (all.loc:67020, placed once at abs 3425,2915)
//   [elid_statuette_multiloc]  (all.loc:67037, placed once at abs 3426,2930)
//       both list 0, 10, 20, 25, 27, 30, 35, 40, 50, 55, 60 and nothing else
//
// Any other value and Nardah's fountain and the shrine plinth stop rendering entirely - there is
// no matching multiloc entry and the shell resolves to nothing. So the stages below are the
// cache's eleven values, not a scheme of mine. 60 is the only one where the fountain flows and
// elid_statuette_placed (op1=Pray-at) exists, so 60 is completion and placing the statuette is
// what reaches it.
^elid_not_started = 0
^elid_asked_mayor = 10
^elid_spoke_ghaslor = 20
^elid_has_robes = 25
^elid_entered_shrine = 27
^elid_met_spirits = 30
^elid_channels_done = 35
^elid_has_statuette = 40
^elid_shown_ghaslor = 50
^elid_told_mayor = 55

// The three channel bits are the cache's own varbits on elid_main, one per trial, and each drives
// three multilocs: the obstacle, the water in that stretch, and the pour effect.
//   elid_miningchannel   - blocked with rock,  op1=Clear
//   elid_thievingchannel - spike trap,         op1=Clear
//   elid_rangingchannel  - a target to shoot;  also drives elid_ranging_target_multinpc
//
// elid_waterchannel_mining_water_multiloc is the one shell of the nine that the maps never place -
// the mining stretch has plain elid_water_channel_water hard-placed at abs (3378,9545) and
// (3378,9546) instead, so that stretch looks wet from the start. Nothing here depends on it.

// The three golem doors. The golems themselves (level 75, black/white/grey) are not placed
// anywhere and are not multinpc children, so they are spawned when their door is opened.
^elid_golem_despawn = 500

// The crevice down into the shrine is at m52_45 local(45,22)-(45,27) and (46,24)-(46,26). The way
// back up, elid_underground_exit, is a 3x3 at m52_148 local(19,61), and the landing used to be the
// tile beside it - but m52_148 is an empty square in this cache, every tile of it blocked, so the
// crevice dropped you into solid rock with nothing in reach. The exit's top edge meets the south end
// of the water source's vestibule (m52_149 local 21,0), so you land at the foot of that corridor
// with the exit behind you.
^elid_shrine_below = 0_52_149_21_1
^elid_shrine_above = 0_52_45_46_23

// The genie's cave is directly under the crevice (m52_145), and nothing led into it: the climbing
// rope at local(45,25) had no trigger. You land beside the rope, and it takes you back up.
^elid_genie_below = 0_52_145_46_26

// Inside each golem's room. The white golem's used to be local(38,6), which is a blocked tile; its
// room is south of the door, and (38,4) is in it.
// ---------------------------------------------------------------------------- what was unused
// Five objs in this quest's own block were referenced by nothing, and four of them are walkthrough
// steps:
//
//   elid_robetop_torn, elid_robebottoms_torn  "This robe is too torn to wear."
//   elid_ballad                               "The Ballad of Jareesh."
//   elid_shoes                                "Awusah's Shoes."
//   elid_sole                                 "Awusah's Sole."
//
// The cupboard used to hand over two wearable robes; what is in it is two torn ones, and a needle
// and thread make them wearable. Ghaslor's ballad is what the shrine door listens for as well as
// the robes. And the genie does not hand the statuette over for a kind word - he wants the soles off
// the mayor's shoes, which is the one joke in this quest.
//
// elid_key_outline is an obj with no name and no fields at all, so the walkthrough's telekinetic
// grab through a walled pocket has nothing in the cache to grab: Shiratti keeps the key, which is
// the only other thing she can be for. That is the one step of this quest that is not the
// walkthrough's.
^elid_shoes_spot = 0_53_45_50_31    // 3442,2911, beside Awusah, who does not look round

// NEVER THE TILE THE DOOR PUTS YOU ON. The grey and black golems used to be at (47,11) and
// (45,20), which are exactly the tiles their own doors walk the player onto - so npc_add was
// putting a golem under somebody's feet and there was no golem in the world afterwards. One tile
// further into each room. The white one's room is entered from the north and (38,4) is already
// clear of the landing tile.
^elid_golem_black_spawn = 0_52_149_46_20   // 3374,9556
^elid_golem_white_spawn = 0_52_149_38_4    // 3366,9540
^elid_golem_grey_spawn = 0_52_149_48_11    // 3376,9547
