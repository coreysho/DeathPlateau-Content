// Haunted Mine.
//
// Two varps and no varbits on either of them, which for once means the bit field is mine to lay
// out. hauntedmine is the progress; hauntedmine_bits is eight point levers and three flags.
//
// ---------------------------------------------------------------------------- the obj descriptions
// The four objs are the walkthrough:
//
//   Zealot's key      "I stole this from a Saradominist I met South of Mort'ton."
//   Crystal-mine key  "A key I found in the lower levels of the Morytanian mines."
//   Salve shard       "An unstrung crystal imbued with the power of Saradomin."
//   Salve amulet      "Increases the wearer's strength and accuracy by 15% when fighting the undead."
//
// "I stole this" is not a hint, it is an instruction: saradominist_zealot carries op1=Talk-to and
// op3=Pickpocket, and neither had a handler. He is at 3444,3258, which is south of Mort'ton.
//
// ---------------------------------------------------------------------------- the mine's shape
// The mine is six mapsquares and the ladders between them are named for the direction they move you:
//
//   hauntedmine_laddertop_1e   m42_70 (8,17) -> hauntedmine_ladder_1w   m43_70 (8,17)
//   hauntedmine_laddertop_1sw  m43_71 (45,55) -> hauntedmine_ladder_1ne m42_70 (45,55)
//
// Same tile, next square. 1e is one square east, 1w one west, 1sw one square down and left, 1ne the
// reverse. The plain pair, hauntedmine_laddertop and hauntedmine_ladder, do the same between
// m53_150 and m43_71, which are nowhere near each other, so that one is a fixed jump.
//
// ---------------------------------------------------------------------------- the points
// Eight point levers, all op1=Pull, in two banks - five around (33,36) and three at (17,53) - and
// then hauntedmine_point_lever_flooded9, 10 and 11 at (17-19,50), which carry no ops at all. Three
// of the eleven points are under water and cannot be thrown, which is the puzzle: the route has to
// be made out of the eight that are still above it.
^hm_not_started = 0
^hm_refused = 1         // the zealot has said no
^hm_key = 2             // the zealot's key
^hm_points = 3          // the points are set and the lift works
^hm_bottom = 4          // been down
^hm_treus = 5           // Treus Dayth, and the crystal-mine key
^hm_complete = 6

// hauntedmine_bits
^hm_bit_lever1 = 0
^hm_bit_lever2 = 1
^hm_bit_lever3 = 2
^hm_bit_lever4 = 3
^hm_bit_lever5 = 4
^hm_bit_lever6 = 5
^hm_bit_lever7 = 6
^hm_bit_lever8 = 7
^hm_bit_treus = 8
^hm_bit_crystal = 9

// Three more flags, because the quest has three things to remember besides the levers: whether a
// glowing fungus is riding in the loading cart, whether the cart has carried one to the far side,
// and whether the water is running. The valve is the one that can go back to nought on its own -
// a mischievous ghost shuts it again if the lift is not ridden.
^hm_bit_fungus_in_cart = 10
^hm_bit_cart_arrived = 11
^hm_bit_valve = 12

// Treus Dayth goes out of reach and comes back somewhere else. The faded shell carries no Attack
// option, which is the half of this the walkthrough means by "you cannot attack him while he is
// invisible", and it keeps his hitpoints: npc_changetype_keepall passes reset=false, and
// Npc.changeType only re-reads the stats when that flag is true.
//
// Two minutes in reach, six seconds out of it. A short window does not work: losing the Attack
// option drops whatever interaction the player had, so a fade in the middle of the walk across
// the chamber cancels the walk - with twenty-five ticks he could be chased for six thousand ticks
// without ever landing a blow, which is what the first run of this did.
^hm_treus_visible_ticks = 200
^hm_treus_faded_ticks = 10
^hm_treus_lifetime = 2000

// How many times he goes and comes back before the cycle lets go of the player's queue. Ten
// turns at two hundred ticks apiece outlast the two thousand he is alive for.
^hm_treus_turns = 10

// Where he comes back, and where he starts. Four tiles a player can stand on AND reach from the
// door, which in this chamber is a short list: the floor is cut into cells by crates, barrels,
// stalagmites and two-by-two rockslides, and the key's own crate (2788,4455) seals the pocket
// north of it - 2788,4456..4459 can be stood on and cannot be walked into from anywhere. He was
// being put in exactly that pocket, which is why the fight reported him as unreachable.
^hm_treus_spot1 = 0_43_69_37_38          // 2789,4454, beside the crate
^hm_treus_spot2 = 0_43_69_33_38          // 2785,4454, the west end of the same corridor
^hm_treus_spot3 = 0_43_69_39_37          // 2791,4453
^hm_treus_spot4 = 0_43_69_32_46          // 2784,4462, the long north gallery

// How long the water stays on before the mischievous ghost shuts the valve again. The
// walkthrough has you running for the lift, but this map puts the valve three tiles from it, so
// a short fuse would only be a trap: six minutes punishes somebody who wanders off and nobody
// who is doing the quest.
^hm_valve_ticks = 200

// 35 Crafting cuts a shard off the outcrop, and 22,000 Strength is the reward for the quest.
^hm_crafting_needed = 35
// Experience is stored in tenths - Player.addXp keeps stats scaled by ten so the client can show
// a decimal point - so 22,000 experience is written as 220,000. The old reward was
// stat_advance(mining, 22000): the wrong skill AND a tenth of the right number.
^hm_strength_reward = 220000


// Levers 1, 3, 4, 6 and 8 thrown; 2, 5 and 7 left alone. That is bits 0, 2, 3, 5 and 7, and it is
// written on hauntedmine_points_info, which carries op1=Check and had nothing behind it.
^hm_points_answer = 173

^hm_off = 0
^hm_on = 1

// ---------------------------------------------------------------------------- places
^hm_zealot = 0_53_50_52_58            // 3444,3258  south of Mort'ton
^hm_crawl_secondary = 0_53_50_48_32
^hm_crawl_secondary_in = 0_53_150_45_37
^hm_crawl_back1 = 0_53_50_38_33
^hm_crawl_back1_in = 0_53_150_12_31
^hm_crawl_back2 = 0_53_50_37_25
^hm_crawl_back2_in = 0_53_150_16_23

^hm_valve = 0_43_70_56_16
^hm_points_sign = 0_43_70_17_42
^hm_boss_door = 0_43_69_47_37
// the lift comes down onto the level-5 track (2724,4450), west of the dark stairs down to the
// boss level; 0_43_69_47_36 was a two-tile pocket behind the boss door with nothing else in it
^hm_boss_landing = 0_42_69_36_34
^hm_lift_top = 0_43_70_55_16            // 2807,4496, beside the valve
^hm_reward_door = 0_43_69_21_34
