// Regicide - the Elf Tracker, south of the Poison Waste (checklist item #6).
// Identity confirmed from scripts/_unpack/377/all.npc: [regicide_old_camp_tracker] has
// name=Elf Tracker, desc=An elf tracker. - not a name-guess like the good_elf/evil_elf npcs,
// this one is unambiguous.
//
// Confirms the crystal pendant lets the player cross the dense-forest obstacle without 56
// Agility. The actual mechanical unlock is the pendant-in-inventory OR-condition added to
// regicide_isafdar_obstacles.rs2's dense forest branch in this same change - this script is
// just the narration/confirmation of that, plus the onward directions to Tyras Camp.

[opnpc1,regicide_old_camp_tracker]
switch_int(%regicide_quest) {
    case ^regicide_not_started, ^regicide_started, ^regicide_met_elves :
        ~chatnpc("<p,neutral>Best not linger here, traveller - this is dangerous ground for a human.");
        return;
    case ^regicide_met_iorwerth :
        if(inv_total(inv, regicide_crystal_pendant) < 1) {
            ~chatnpc("<p,confused>You don't have Lord Iorwerth's pendant. Go back and see him first.");
            return;
        }
        ~chatplayer("<p,neutral>Lord Iorwerth sent me. He said you could help me get further into Tirannwn.");
        ~chatnpc("<p,happy>Ah, so he trusted you with the pendant. Good - that means our dense forest won't give you any trouble now.");
        ~chatnpc("<p,neutral>Just hold it while you cross, and the forest will let you through, agility or no agility.");
        ~chatplayer("<p,quiz>And beyond the forest?");
        ~chatnpc("<p,worried>Tyras Camp lies further south, but it's guarded. One of Tyras' men stands watch on the path - a tough fighter, so be careful.");
        ~chatnpc("<p,neutral>If you get past him, you'll find General Hining at the camp. Good luck.");
        %regicide_quest = ^regicide_met_tracker;
    case ^regicide_met_tracker :
        // She has sent the player on and they have come back without having got there. The tracks
        // are the thing they have walked past, so she says so.
        ~chatplayer("<p,quiz>Which way is Tyras Camp, exactly?");
        ~chatnpc("<p,neutral>West of here there are boot prints crossing the path - a man's, going into the trees. Follow them. They come out at a camp nobody has used in years.");
        ~chatnpc("<p,neutral>Keep going west from there and you will find Tyras' men. Mind the traps; the forest is full of them, and not all of them are ours.");
    case ^regicide_at_tyras_camp :
        // The return trip. Hining has just thrown the player out, and the tracker is who they were
        // told to report back to - she is the one who sends them on to Iorwerth rather than letting
        // them wander back on their own.
        ~chatplayer("<p,angry>Hining won't let anyone near King Tyras. He wouldn't even hear me out.");
        ~chatnpc("<p,neutral>No. He wouldn't. That camp has been closed to everyone since the spring, elf and human alike.");
        ~chatplayer("<p,quiz>Doesn't that strike you as strange?");
        ~chatnpc("<p,sad>It strikes me as a man with something behind him he doesn't want seen. Whatever is whispering in Tyras' ear, it does not want visitors.");
        ~chatnpc("<p,neutral>Go back to Lord Iorwerth and tell him what you have told me. He has been waiting a long time for someone to say it out loud.");
        %regicide_quest = ^regicide_told_tracker;
    case ^regicide_told_tracker :
        ~chatnpc("<p,neutral>Lord Iorwerth is north, at the camp. Tell him what Hining told you.");
    case default :
        ~chatnpc("<p,neutral>Keep that pendant safe, and watch yourself around Tyras' guards.");
}

// The tracks themselves. Two ground decorations on the path west of the tracker, op1=Follow, and
// nothing had ever handled them - see the note on ^regicide_old_camp_landing for why that mattered
// rather more than a missing bit of flavour.
[oploc1,regicide_old_camp_footprints]
p_arrivedelay;
if (%regicide_quest < ^regicide_met_tracker) {
    ~mesbox("Boot prints in the soft ground, crossing the path and going away west into the trees. They are not fresh.");
    return;
}
mes("You follow the tracks west, pushing through the trees as they go...");
p_delay(0);
~forcemove(^regicide_old_camp_landing);
~mesbox("...and come out where they end. Somebody camped here and left in a hurry: a ring of blackened stones, a tent pole lying where it fell, and nothing else. The path goes on west.");
