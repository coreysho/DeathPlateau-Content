[oploc1,_bookcase]
// https://youtu.be/YT_tGdVMjGs?t=259
// todo: confirm for other bookcase loc's
p_arrivedelay;
//mes(~coord_tostring(loc_coord));
switch_coord (loc_coord) {
    case 0_52_52_38_4, 0_52_52_36_4, 0_52_52_36_6, 0_52_52_38_7, 0_52_52_36_7, 0_52_52_39_8 : @exam_centre_bookcase; // exam centre bookcases
    case ^tgbr_bookcase : @tgbr_bookcase_search; // Edgeville monastery's south-west shelf,
        // which holds The Great Brain Robbery's prayer book (quests/quest_tgbr)
    case default : @search_bookcase;
}

// KELDAGRIM'S RED AXE SHELVES, 22 placed and answering nothing. Deliberately NOT category=bookcase:
// the default above prints "none of them look very interesting", and this loc's own description is
// "These books contain all sorts of data on the Red Axe." A player who reads the examine and then
// searches should not be told the opposite. The Red Axe is real content here - quest_giantdwarf and
// quest_forget both know the name - but nothing in the build reads these shelves, so this says what
// is in them and stops there rather than inventing a step for a quest that may yet want one.
[oploc1,dwarf_keldagrim_metal_bookcase]
p_arrivedelay;
mes("You search the shelves...");
p_delay(1);
~mesbox("Ledgers, contracts and consignment notes, all of them the Red Axe's and all of them in a dwarven hand you cannot read.");

[label,search_bookcase]
mes("You search the bookcase...");
p_delay(1);
def_int $rand = random(4);
if($rand = 0) {
    mes("None of them look very interesting.");
} else if ($rand = 1) {
    mes("You find nothing to interest you.");
} else if ($rand = 2) {
    mes("You don't find anything that you'd ever want to read.");
} else {
    mes("It's full of books, but none of them look very interesting.");
}
