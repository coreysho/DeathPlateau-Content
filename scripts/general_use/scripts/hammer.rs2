[opheldu,hammer]
switch_obj (last_useitem) {
    case red_topaz, opal, jade, uncut_red_topaz, uncut_opal, uncut_jade : mes("You can't think of any reason to do this.");
    // Animal Magnetism: the Witch's selected iron becomes a magnet under a hammer blow, in the right
    // place. quests/quest_animmag/scripts/animmag_magnet.rs2 has the other way round and the rules.
    case animmag_selected_iron : @animmag_make_magnet;
    // A coconut is cracked open with a hammer, which is the first step of coconut milk and so of
    // every antidote potion. skill_herblore/scripts/brewing/coconut_milk.rs2 has the rest.
    case coconut : @coconut_crack;
    // A mithril bar under a hammer is a mith grapple tip, the first of Old School's three stages
    // for the God Wars grapple. bosses/godwars/scripts/gwd_grapple.rs2 has the other two and says
    // why the tip is made here rather than at the anvil the wiki uses.
    case mithril_bar : @gwd_grapple_tip;
    case default : ~displaymessage(^dm_default);
}
