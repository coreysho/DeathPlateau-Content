// ~slash_checker looks at the weapon hand AND the backpack (general/scripts/slash_checker.rs2),
// so the one-click Slash no longer needs the blade equipped.
[oploc1,bigweb_slashable]
def_obj $item = ~slash_checker;

if ($item = null) {
    mes("Only a sharp blade can cut through this sticky web.");
    return;
}
@cut_web($item);

[oplocu,bigweb_slashable]
def_obj $item = last_useitem;
if (~can_slash_with($item) = false) {
    mes("Only a sharp blade can cut through this sticky web.");
    return;
}
@cut_web($item);

[label,cut_web](obj $item)
if ($item = knife) {
    anim(human_knife_slash, 0);
} else {
    anim(oc_param($item, slashattack_anim), 0);
}
sound_synth(hacksword_slash, 1, 15);

// A 1-in-2 roll for everybody except the owner of a Wilderness sword, which always cuts
// (general/scripts/diary_rewards/diary_passives.rs2).
if (random(2) = 1 | ~wilderness_sword_carried = true) {
    mes("You slash the web apart.");
    p_delay(1); // osrs
    // Temp note: dur does not need updated
    loc_change(bigweb_slashed, 100);
} else {
    mes("You fail to cut through it.");
}
