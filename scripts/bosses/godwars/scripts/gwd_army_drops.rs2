} else if ($random < 123) {                              // 2/127
    obj_add(npc_coord, adamant_battleaxe, 1, ^lootdrop_duration);
} else if ($random < 124) {                              // 1/127
    obj_add(npc_coord, adamant_2h_sword, 1, ^lootdrop_duration);
} else if ($random < 125) {                              // 1/127
    obj_add(npc_coord, rune_longsword, 1, ^lootdrop_duration);
} else if ($random < 126) {                              // 1/127
    obj_add(npc_coord, rune_halberd, 1, ^lootdrop_duration);
} else if ($random < 127) {                              // 1/127
    obj_add(npc_coord, rune_kiteshield, 1, ^lootdrop_duration);
}

// ---------------------------------------------------------------- Spiritual ranger
// Left out: adamant fire arrow (2/128), iron arrowtips (11/128), adamant arrowtips (9/128), broken
// arrow (1/128) and oak longbow (u) (9/128) - none of the five is in this cache.
[ai_queue3,_gwd_spiritual_ranger]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
~trail_hardcluedrop(^trail_hard_droprate, npc_coord);
def_int $random = random(128);
if ($random < 18) {                                      // 18/128
    obj_add(npc_coord, bow_string, 7, ^lootdrop_duration);
} else if ($random < 33) {                               // 15/128
    obj_add(npc_coord, iron_arrow, 12, ^lootdrop_duration);
} else if ($random < 46) {                               // 13/128
    obj_add(npc_coord, bronze_arrow, 16, ^lootdrop_duration);
} else if ($random < 57) {                               // 11/128
    obj_add(npc_coord, mithril_arrow_p+, 1, ^lootdrop_duration);
} else if ($random < 67) {                               // 10/128
    obj_add(npc_coord, headless_arrow, 12, ^lootdrop_duration);
} else if ($random < 72) {                               // 5/128
    obj_add(npc_coord, oak_shortbow, 1, ^lootdrop_duration);
} else if ($random < 76) {                               // 4/128
    obj_add(npc_coord, maple_longbow, 1, ^lootdrop_duration);
} else if ($random < 80) {                               // 4/128
    obj_add(npc_coord, steel_arrow, 12, ^lootdrop_duration);
} else if ($random < 84) {                               // 4/128
    obj_add(npc_coord, bodyrune, 12, ^lootdrop_duration);
} else if ($random < 87) {                               // 3/128
    obj_add(npc_coord, steel_crossbow, 1, ^lootdrop_duration);
} else if ($random < 90) {                               // 3/128
    obj_add(npc_coord, adamant_arrow_p++, 3, ^lootdrop_duration);
} else if ($random < 92) {                               // 2/128
    obj_add(npc_coord, rune_arrow, 5, ^lootdrop_duration);
} else if ($random < 93) {                               // 1/128
    obj_add(npc_coord, magic_shortbow, 1, ^lootdrop_duration);
} else if ($random < 94) {                               // 1/128
    obj_add(npc_coord, bronze_arrow_p+, 1, ^lootdrop_duration);
} else if ($random < 95) {                               // 1/128
    obj_add(npc_coord, adamant_arrow, 12, ^lootdrop_duration);
}

// ---------------------------------------------------------------- Aviansie
// Bones and feathers every time, and the adamantite bars are what the place is actually farmed for.
[ai_queue3,_gwd_aviansie]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
obj_add(npc_coord, bones, 1, ^lootdrop_duration);
obj_add(npc_coord, feather, ~random_range(1, 6), ^lootdrop_duration);
~trail_hardcluedrop(^trail_hard_droprate, npc_coord);
def_int $random = random(128);
if ($random < 30) {                                      // 30/128
    obj_add(npc_coord, adamantite_bar, 4, ^lootdrop_duration);
} else if ($random < 48) {                               // 18/128
    obj_add(npc_coord, airrune, 15, ^lootdrop_duration);
} else if ($random < 63) {                               // 15/128 - the herb table
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 76) {                               // 13/128
    obj_add(npc_coord, waterrune, 30, ^lootdrop_duration);
} else if ($random < 87) {                               // 11/128
    obj_add(npc_coord, rune_dagger_p+, 1, ^lootdrop_duration);
} else if ($random < 97) {                               // 10/128
    obj_add(npc_coord, silver_ore, 1, ^lootdrop_duration);
} else if ($random < 101) {                              // 4/128
    obj_add(npc_coord, lawrune, 2, ^lootdrop_duration);
} else if ($random < 105) {                              // 4/128
    obj_add(npc_coord, naturerune, 9, ^lootdrop_duration);
} else if ($random < 108) {                              // 3/128
    obj_add(npc_coord, chaosrune, 3, ^lootdrop_duration);
} else if ($random < 111) {                              // 3/128 - the gem table
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
} else if ($random < 113) {                              // 2/128
    obj_add(npc_coord, bodyrune, 12, ^lootdrop_duration);
} else if ($random < 115) {                              // 2/128
    obj_add(npc_coord, bloodrune, 11, ^lootdrop_duration);
} else if ($random < 116) {                              // 1/128
    obj_add(npc_coord, mindrune, 5, ^lootdrop_duration);
} else if ($random < 117) {                              // 1/128
    obj_add(npc_coord, chaosrune, 16, ^lootdrop_duration);
} else if ($random < 118) {                              // 1/128
    obj_add(npc_coord, runite_limbs, 1, ^lootdrop_duration);
}
