} else if ($random < 105) {                              // 5/127
    obj_add(npc_coord, black_warhammer, 1, ^lootdrop_duration);
} else if ($random < 109) {                              // 4/127
    obj_add(npc_coord, iron_plateskirt, 1, ^lootdrop_duration);
} else if ($random < 113) {                              // 4/127 - the gem table
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
} else if ($random < 116) {                              // 3/127
    obj_add(npc_coord, iron_sword, 1, ^lootdrop_duration);
} else if ($random < 119) {                              // 3/127
