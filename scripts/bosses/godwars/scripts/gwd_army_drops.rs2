} else if ($random < 78) {                               // 8/127
    obj_add(npc_coord, mithril_axe, 1, ^lootdrop_duration);
} else if ($random < 86) {                               // 8/127
    obj_add(npc_coord, adamant_full_helm, 1, ^lootdrop_duration);
} else if ($random < 93) {                               // 7/127
    obj_add(npc_coord, steel_sword, 1, ^lootdrop_duration);
} else if ($random < 100) {                              // 7/127
