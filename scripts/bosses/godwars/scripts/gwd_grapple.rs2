// THE MITH GRAPPLE, AND WHERE IT COMES FROM, which until now was nowhere at all.
//
// gwd_encampments.rs2 gates the Armadyl chasse crossing on carrying one - 70 Ranged, a crossbow in
// hand and a grapple fired at the pillar across the gap - and the obj had sat in the pack since the
// 474 import with no shop, no drop and no recipe behind it, so that crossing could not be made by
// anybody. obtainable.py had it in the "mentioned, never given out" bucket and the two sims that
// test the crossing hand one over with ::give, which is why nothing had ever said so out loud.
// skillcape_perks.rs2 still notes "Fletching (no mithril grapple)" for the same reason.
//
// OLD SCHOOL'S THREE STAGES, which is what this is - the wiki's ingredients, skills, levels and
// experience, checked against the item pages rather than remembered:
//
//   mithril bar + hammer        -> mith grapple tip      59 Smithing,  50 experience
//   tip + mithril bolts         -> mith grapple (unf)    59 Fletching, 11 experience
//   unf + rope                  -> mith grapple          59 Fletching, no experience
//
// The two half-made objs were not in the pack. They are imported from the 474 cache beside the
// grapple itself - configs/gwd_grapple.obj says which ids, and what the cache did not carry for the
// unfinished one.
//
// THE ANVIL IS THE ONE THING LOST. Old School smiths the tip at an anvil, and the 377 smithing
// window cannot show it: the five columns are the cache's own art, column 5 has labels for three
// rows against an inv of five, so a fourth product has nowhere to be drawn - and the "other" row
// that bronze, iron and steel use for their odd one out (bronze wire, an iron spit, steel studs) is
// display-only here, with no inv slot behind it. So the tip is made the way this build already turns
// the Witch's iron into a magnet and cracks a coconut: a hammer used on the bar, from the switch in
// general_use/scripts/hammer.rs2. The hammer is the tool Old School asks for; the anvil is what is
// missing, and putting it back means new components in a cache interface.
//
// EACH STEP TAKES THE PAIR EITHER WAY ROUND. The engine looks an [opheldu] up on the clicked obj
// first and then on the one used, so one trigger on the half-made piece answers both orders - the
// same reason skill_fletching/scripts/bolts.rs2 checks both sides inside one trigger. That is also
// why neither rope nor mithril_bolts gets a trigger of its own here: rope is used on a dozen things
// across the game and the bolts' own fletching is reached through their category, and a name
// trigger on either would shadow all of it.

// =========================================================================== the tip, from the bar
// BOTH WAYS ROUND, and they arrive by different doors. The engine looks an [opheldu] up on the
// clicked obj first and then on the one used, so "bar used on hammer" is answered by the switch in
// general_use/scripts/hammer.rs2 (which is why a case went in there) and "hammer used on bar" needs
// a trigger on the bar - this one. animmag_magnet.rs2 splits the Witch's iron across two files for
// the same reason and says so.
[opheldu,mithril_bar]
if (last_item ! hammer & last_useitem ! hammer) {
    ~displaymessage(^dm_default);
    return;
}
@gwd_grapple_tip;

[label,gwd_grapple_tip]
if (map_members = ^false) {
    mes(^mes_members_skill);
    return;
}
if (stat(smithing) < ^gwd_grapple_tip_level) {
    ~doubleobjbox(hammer, mithril_bar,
        "You need a Smithing level of <tostring(^gwd_grapple_tip_level)> to beat the bar into a grapple tip.", 200);
    return;
}
p_arrivedelay;
anim(human_blunt_pound, 0);
sound_synth(anvil, 1, 0);
mes("You hammer the mithril bar into a grapple tip.");
p_delay(3);
if (inv_total(inv, mithril_bar) < 1) {
    return;
}
inv_del(inv, mithril_bar, 1);
inv_add(inv, mith_grapple_tip, 1);
~smithing_xp(^gwd_grapple_tip_xp);

// =========================================================================== the tip onto a bolt
[opheldu,mith_grapple_tip]
if (last_item ! mithril_bolts & last_useitem ! mithril_bolts) {
    ~displaymessage(^dm_default);
    return;
}
if (map_members = ^false) {
    mes(^mes_members_skill);
    return;
}
if (stat(fletching) < ^gwd_grapple_fletch_level) {
    ~doubleobjbox(mith_grapple_tip, mithril_bolts,
        "You need a Fletching level of <tostring(^gwd_grapple_fletch_level)> to fit the tip to a bolt.", 200);
    return;
}
p_arrivedelay;
anim(human_pickupfloor, 0);
mes("You fit the grapple tip to a mithril bolt.");
p_delay(2);
if (inv_total(inv, mith_grapple_tip) < 1 | inv_total(inv, mithril_bolts) < 1) {
    return;
}
inv_del(inv, mith_grapple_tip, 1);
inv_del(inv, mithril_bolts, 1);
inv_add(inv, mith_grapple_unf, 1);
stat_advance(fletching, ^gwd_grapple_unf_xp);

// =========================================================================== and the rope
[opheldu,mith_grapple_unf]
if (last_item ! rope & last_useitem ! rope) {
    ~displaymessage(^dm_default);
    return;
}
if (map_members = ^false) {
    mes(^mes_members_skill);
    return;
}
if (stat(fletching) < ^gwd_grapple_fletch_level) {
    ~doubleobjbox(mith_grapple_unf, rope,
        "You need a Fletching level of <tostring(^gwd_grapple_fletch_level)> to bind the rope on.", 200);
    return;
}
p_arrivedelay;
anim(human_pickupfloor, 0);
mes("You bind the rope to the grapple.");
p_delay(2);
if (inv_total(inv, mith_grapple_unf) < 1 | inv_total(inv, rope) < 1) {
    return;
}
inv_del(inv, mith_grapple_unf, 1);
inv_del(inv, rope, 1);
inv_add(inv, mith_grapple, 1);
// no experience for this step, which is the wiki's own 0
~objbox(mith_grapple, "A mithril grapple. A crossbow will fire it across a gap.", 250, 0, divide(^objbox_height, 2));
