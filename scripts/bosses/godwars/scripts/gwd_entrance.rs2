// God Wars Dungeon: the rope down the shaft.
//
// Getting as far as the shaft is gwd_surface.rs2's business now - the boulder, the crack and the
// hole are all out on the battlefield. What is left here is the rope at the bottom of the hole,
// which is the step Old School has between the shaft floor and the chamber the four faction doors
// open onto: loc 26422 "Climb-down" on the upper floor, loc 26370 "Climb" on the lower, both on
// the same tile.
//
// The two ends are the same tile on different floors, so each lands you BESIDE the rope rather than
// inside it - a rope blocks the tile it hangs on.

[oploc1,gwd_rope_top]
mes("You climb down the rope.");
anim(human_pickupfloor, 0);
p_delay(2);
p_telejump(^gwd_rope_bottom);

[oploc1,gwd_rope_down]
mes("You climb up the rope.");
anim(human_pickupfloor, 0);
p_delay(2);
p_telejump(^gwd_rope_topside);
