// God Wars Dungeon.

// Which god an npc follows. On every npc in the dungeon, read at its death to decide whose
// killcount goes up. 0 is the default and means "not one of theirs", which is every other npc in
// the game - so the death hook costs one param read and returns.
^gwd_god_none = 0
^gwd_god_armadyl = 1
^gwd_god_bandos = 2
^gwd_god_saradomin = 3
^gwd_god_zamorak = 4

// Kills of a god's followers needed to be let through that god's door, and spent when you are.
// Forty, as Old School has always had it.
^gwd_killcount_needed = 40

// Where each door puts you down: the tile on the room side of it. Not guessed - each one is the
// door-adjacent tile whose walkable region contains that god's altar, which is what makes it the
// inside rather than the corridor (tools/sim/gwd.ts asserts the same thing).
^gwd_inside_armadyl = 2_44_82_23_48
^gwd_inside_bandos = 2_44_83_48_42
^gwd_inside_zamorak = 2_45_83_45_19
^gwd_inside_saradomin = 0_45_82_27_17

// ---------------------------------------------------------------- the way in
// The boulder is at 2898,3716, which is where Old School has it.
//
// It took a map graft to get there. The 377 square had the entire God Wars valley as solid rock -
// the dungeon opened in August 2007, a year after this revision, and the valley was cut into
// Trollheim then. 2898,3716 existed as a single isolated walkable tile with nothing adjoining it,
// so no climbing rock could ever have led to it and no amount of scripting would have helped. The
// 813 tiles of ground Old School has up there and we did not are now grafted in, joining our
// mountain at its north-east shoulder; gwd_surface.loc carries the detail.
//
// _outside is the tile you stand on to click it, immediately south of its 4x3 footprint.
^gwd_entrance_strength = 60
^gwd_entrance_agility = 60

// The two sides of the boulder. Its footprint is x2898..2901, z3716..3718 and it blocks, so these
// are the standing tiles either side of it rather than neighbours.
^gwd_boulder_south = 0_45_58_18_3
^gwd_boulder_north = 0_45_58_18_7

// The two ends of the little crack, Old School's Agility way past the same rock: 2900,3713 and
// 2904,3719. _divide is the z that separates them - south of it you are coming up from Trollheim.
^gwd_crack_south = 0_45_58_19_1
^gwd_crack_north = 0_45_58_24_8
^gwd_crack_divide = 3716

// The hole itself is at 2917,3745, 4x4; this is the tile beside it that you stand on and come back
// out onto.
^gwd_hole_side = 0_45_58_37_32

// AND THE HOLE DROPS YOU STRAIGHT INTO THE CHAMBER. It used to land on plane 3 of m45_82, on the
// strength of Old School having a shaft floor between the hole and the rope - but PLANE 3 OF THAT
// SQUARE HAS NO TERRAIN. The graft brought 2,061 locs across for it and not one tile of floor, so
// every tile up there is undrawn: the black square the owner was standing on, with nothing under
// it and no npc on the whole plane. Plane 2 is the dungeon - 1,829 drawn tiles and all eighteen
// spiritual spawns - so the hole goes there, beside the rope, which is where climbing down the
// rope used to put you.
^gwd_entrance_inside = 2_45_82_0_62

// AND CLIMBING BACK UP COMES OUT ON THE SURFACE, next to the hole. It used to go to plane 3 as
// well, which left the only way out of the dungeon leading into the same void. gwd_rope_top, the
// matching loc up there, is unreachable now and should be: there is no room for it to stand in.
^gwd_rope_bottom = 2_45_82_0_62
^gwd_rope_topside = 0_45_58_37_32

// ---------------------------------------------------------------- the four ways through
// Old School gates each encampment behind one level-70 skill. The obstacles are the cache's own
// locs, and which is which was read off the map rather than guessed: each one has the entrance
// region on one side and exactly one faction's region on the other.
^gwd_encampment_level = 70

// Armadyl's Eyrie: 70 Ranged, a crossbow and a mithril grapple, fired across the chasm at x=2871.
^gwd_grapple_from = 2_44_82_55_31
^gwd_grapple_to = 2_44_82_55_21

// Bandos' Stronghold: 70 Strength and a hammer, to strike the gong on the big door. That is why
// this door's option is Bang and the other three are Open.
^gwd_gong_east = 2_44_83_36_21
^gwd_gong_west = 2_44_83_34_21

// Zamorak's Fortress: 70 Hitpoints to cross the ice bridge, which empties your prayer doing it.
^gwd_icebridge_south = 2_45_83_5_20
^gwd_icebridge_north = 2_45_83_5_33
^gwd_icebridge_middle = 5338

// Saradomin's Encampment: 70 Agility, NOT boostable, and two ropes - one per rock - tied once and
// left tied. Two floors down: the upper rock drops to level 1, the lower one to the encampment.
^gwd_rope_upper_down = 1_45_82_35_52
^gwd_rope_lower_down = 0_45_82_39_26

// ---------------------------------------------------------------- the altars
// "Can recharge prayer points every 10 minutes, which also gives a +1 Prayer bonus for every piece
// of equipment affiliated to the correct deity", and "every altar has the option to teleport
// players outside of the general's lair".
^gwd_altar_minutes = 10

// The corridor side of each faction door - where Teleport puts you down, which is what "outside
// the general's lair" means. The room side is ^gwd_inside_* above.
^gwd_outside_armadyl = 2_44_82_23_46
^gwd_outside_bandos = 2_44_83_46_42
^gwd_outside_zamorak = 2_45_83_45_21
^gwd_outside_saradomin = 0_45_82_29_17

// ---------------------------------------------------------------- General Graardor
// "He slams the ground, hitting all players in the room" for an even 15 to 35. His melee is a
// separate thing and hits up to 60.
^graardor_slam_min = 15
^graardor_slam_max = 35

// ---------------------------------------------------------------- K'ril Tsutsaroth
// Melee up to 46 (his stats and strength bonus carry that), magic 10-30, and the special 35-49
// which ignores protection prayers and takes half your remaining prayer with it.
^kril_magic_min = 10
^kril_magic_max = 30
^kril_special_min = 35
^kril_special_max = 49

// ---------------------------------------------------------------- Commander Zilyana
// "a minimum hit of 10 should it successfully hit", and 20 at the top.
^zilyana_magic_min = 10
^zilyana_magic_max = 20

// ---------------------------------------------------------------- Kree'arra
// Ranged 69 - the biggest hit in the dungeon - magic 21, melee 25 (his strength bonus carries that).
^kreearra_ranged_max = 69
^kreearra_magic_max = 21

// THE DUNGEON, as a box. Four map squares - 44_82, 45_82, 44_83 and 45_83 - and the killcount
// reset needs to know whether a player who just left one of them left the dungeon or only walked
// into the next square along.
^gwd_dungeon_x1 = 2816
^gwd_dungeon_x2 = 2943
^gwd_dungeon_z1 = 5248
^gwd_dungeon_z2 = 5375

// THE SKIRMISH. The timer on each follower fires every ^gwd_skirmish_ticks, and a swing comes out
// of one firing in ^gwd_skirmish_odds - so a given follower swings about every half a minute. Slow
// on purpose: the chamber should look like a running battle, not empty itself in a minute, and a
// follower killed by another follower drops nothing and respawns.
^gwd_skirmish_ticks = 10
^gwd_skirmish_odds = 5
^gwd_skirmish_maxhit = 4
