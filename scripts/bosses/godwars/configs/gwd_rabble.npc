// THE REST OF THE FOUR ARMIES: the rank and file that fill the main chamber alongside the
// spirituals and the aviansies. Old School's dungeon holds ogres, jogres, cyclopes, hobgoblins and
// goblins for Bandos, and hellhounds, werewolves, bloodvelds, pyrefiends, icefiends and imps for
// Zamorak, and this build had none of them in there.
//
// NOTHING IS IMPORTED HERE. Every one of these is a monster the 377 cache already draws and this
// build already animates, so each entry is that art with God Wars numbers on it rather than a
// second copy of the same model brought over from a later cache. The ones with no 2006 ancestor -
// the orks, the gorak, the priest and the knights - are the eight in configs/gwd_army.npc.
//
// WHY THEY ARE SEPARATE NPCS rather than the existing ogre/hellhound/imp with a param added: the
// param is what pays God Wars killcount (scripts/gwd_killcount.rs2 reads it and returns for every
// npc that is not one of the four gods), so putting it on the general-game monster would pay
// Bandos killcount for an ogre killed in the Feldip Hills. The devotion aggression and the
// free-for-all timer are the same story.
//
// Stats and levels are Old School's own for the God Wars version of each - the cache that carries
// them - so a God Wars hellhound is the level 127 one, not the level 122 Taverley dungeon dog.

// ------------------------------------------------------------------------------ Bandos
[gwd_ogre]
name=Ogre
desc=A large dim looking humanoid.
model1=npc_ogre
model2=npc_ogrei2
size=2
walkanim=ogre_walk
readyanim=ogre_ready
op2=Attack
vislevel=58
// Old School npc 2233.
attack=46
defence=43
strength=48
hitpoints=70
ranged=1
magic=1
param=attackrate,6
param=damagetype,^crush_style
param=attack_anim,ogre_attack
param=defend_anim,ogre_block
param=death_anim,ogre_death
param=attack_sound,giant_attack
param=defend_sound,giant_hit
param=death_sound,giant_death
param=death_drop,big_bones
param=slayer_category,^slayer_ogre
param=gwd_god,^gwd_god_bandos
huntmode=gwd_aggressive_bandos
huntrange=8
category=gwd_army
timer=^gwd_skirmish_ticks

