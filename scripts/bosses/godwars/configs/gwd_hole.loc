// OSRS locs imported by tools/models/importosrslocs.py (osrslocimport.py).
// Models re-encoded by osrs2ob2.py with the loc recolours baked in.

[gwd_hole_tied]
// OSRS loc 26418
name=Hole
model=gwd_hole_tied
width=4
length=4
blockrange=no
active=yes
sharelight=yes
op1=Climb-down

// THE HOLE at the top of the God Wars battlefield - the way down into the dungeon.
//
// Two states, as Old School has them: unroped it offers Tie-rope, and once you have tied one on it
// offers Climb-down for good ("the hole stays roped"). That is a multiloc on gwd_rope_tied, which
// is per-player and permanent, so each player ties their own rope once and never again.
//
// Old School places loc 26419 here, a multiloc whose two children are 26417 (Tie-rope, unroped
// model) and 26418 (Climb-down, roped). The graft imported 26417 with the map; 26418 came in
// separately as gwd_hole_tied. This parent is ours, because 26419 carries its state in a varbit
// this build has no equivalent of.

// NOT PLACED, AND HERE AS A RECORD. This is Old School's arrangement and it is the right
// one: Tie-rope while the hole is bare, Climb-down for ever after. In this client it draws
// as a flat black square the size of its 4x4 footprint, which is what was reported from
// play, and it stayed one through all of:
//
//   placing it at shape 10 rather than shape 0, which Old School does and we did not;
//   giving the parent a model of its own to fall back on;
//   driving it from a varbit instead of a varp, which is what every working multiloc here uses;
//   adding the spare default slot the client sizes its list for.
//
// The models are not the problem - rendered on their own they are a proper rim and shaft, and
// placed as the plain child gwd_hole_untied the hole draws correctly. Multilocs in general are
// not the problem either; millbase renders. So the map places the plain loc and the script
// does both states in one click, and this waits here for someone who can work out the rest.
[gwd_hole]
multivar=gwd_rope_tied
multiloc=0,gwd_hole_untied
multiloc=1,gwd_hole_tied
width=4
length=4
blockrange=no
active=yes
sharelight=yes

