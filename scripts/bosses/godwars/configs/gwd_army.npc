// Imported from the rev 474 cache by tools/models/importnpc474batch.py: models copied
// byte-for-byte, chatheads brought across, and one copy of each model shared between
// every npc that wears it. Combat stats, huntmode and drops are by hand - the cache
// carries none of them.
// Combat numbers are Old School's own - 474 carries no stats - matched npc for npc by name and level.

[gwd_ork_1]
// rev 474 npc 6271
name=Ork
desc=Ork.
model1=npc_gwd_ork_1_1
model2=npc_gwd_ork_1_2
model3=npc_gwd_ork_1_3
size=1
readyanim=gwd_seq_4318
walkanim=gwd_seq_4319
op2=Attack
vislevel=107
param=attack_anim,gwd_seq_4320
param=defend_anim,gwd_seq_4322
param=death_anim,gwd_seq_4321
// No loot table of its own yet, so the bones it leaves are all it leaves.
param=death_drop,bones
param=gwd_god,^gwd_god_bandos
// Old School npc 2237: its stats, from the cache that carries them - 474 does not.
attack=100
defence=60
strength=100
hitpoints=110
ranged=1
magic=1
huntmode=gwd_aggressive_bandos
huntrange=8
category=gwd_army
// [ai_timer] does not fire without one - see scripts/gwd_skirmish.rs2.
timer=^gwd_skirmish_ticks

