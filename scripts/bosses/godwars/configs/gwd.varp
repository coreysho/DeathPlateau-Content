// Killcount, one per god. Kills of that god's followers, spent forty at a time on its door.
// perm: it survives logging out, as it does in Old School.
//
// protect=no IS WHAT MAKES THIS WORK AT ALL, and it is the same answer boss_kills.varp spent four
// builds finding. A varp is PROTECTED by default, and writing a protected varp needs the
// p_active_player pointer - which an npc-context death does not have, whatever npc_findhero
// returns. Without it the build fails with "p_active_player required here" on the write and
// "corrupted here" at the call site in npc_death.rs2; moving the guard, swapping switch_int for
// if/else and reordering the proc all change nothing, because none of them is the cause.
//
// NOT TRANSMITTED. Nothing client-side reads these.

[gwd_kc_armadyl]
scope=perm
protect=no

[gwd_kc_bandos]
scope=perm
protect=no

[gwd_kc_saradomin]
scope=perm
protect=no

[gwd_kc_zamorak]
scope=perm
protect=no

// The two ropes into Saradomin's Encampment, tied once and left tied - "2 ropes for first-time
// entry only". protect=no for the same reason the killcounts carry it.
//
// NOT type=boolean. A boolean varp reads -1 on a player who has never set it, not false, so the
// script's `if ($tied = false)` was never true and the tie-a-rope block was skipped entirely:
// both rocks let anyone down without carrying a rope, which is what was reported from play.
// gwd_rope_tied below is a plain int, reads 0, and its rope check has always worked.
[gwd_rope_upper]
scope=perm
protect=no

[gwd_rope_lower]
scope=perm
protect=no

// world_minute of the last prayer recharged at a God Wars altar - one clock for all four, as the
// ten minutes is the player's and not the altar's. perm, so it survives a logout the way the
// imbued heart's does.
[gwd_altar_minute]
scope=perm

// Whether this player has tied a rope to the hole on the God Wars battlefield. Permanent: Old
// School's hole "stays roped" once you have done it, so the rope is spent once and the Climb-down
// option is yours from then on. It drives the gwd_hole multiloc, so the model changes with it.
[gwd_rope_tied]
scope=perm
protect=no
type=int

