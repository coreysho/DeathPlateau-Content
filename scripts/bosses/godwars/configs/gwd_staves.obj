// THE TWO GOD WARS STAVES AND THE LIGHT THAT JOINS THEM.
//
// Imported from a modern OSRS cache by tools/models/importosrs.py (objs 11791, 13256, 22296).
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.
//
// THE BONUSES AND THE REQUIREMENTS ARE THE CACHE'S OWN, read by tools/models/fillosrsstats.py out
// of the item table rather than transcribed from the wiki: 55 stab, 70 slash, +17 magic attack,
// +72 strength, and 75 Attack with 75 Magic to wield (params 434/436 and 435/437).
//
// NOT CARRIED ACROSS, and both for the same reason - there is nothing here to carry them into:
//
//   THE +15% MAGIC DAMAGE. This build has no magic damage percentage anywhere, in gear or in the
//   spell code, because 2006 had none. A param nothing reads would be a promise in an examine box.
//
//   THE RUNE SAVING. Old School's staff of the dead has a 1/8 chance to cast a combat spell for
//   free. That is a hook in the rune cost path rather than a number on an obj, and it is not built.
//
// POWER OF DEATH IS NOW BUILT, and the note that used to sit here was right about why it could not
// be: it is not a modifier on the attack, so it could not live in the spec dispatch, and a bar that
// did nothing would have been worse than no bar. Both halves exist now - the effect in the
// player-hit path and the click on the tab's own button - and the two params below are what joins
// them. See the params on each staff.
//
// WHAT IS CARRIED: the God Wars alignment, which this build does read. The staff of the dead is a
// Zamorakian item (cache param 41) and the staff of light is BOTH Zamorakian and Saradominist
// (params 41 and 40) - the only item in the dungeon that walks through two doors.
//
// ALL THREE ATTACK ANIMATIONS AND SOUNDS ARE REACHABLE NOW. These used to be weapon_staff, whose
// table is three crushes - Bash, Pound and Focus - so whatever style you picked the hit rolled
// crush and swung the crush animation, and the 55 stab and 70 slash below were bonuses on nothing.
// weapon_bladed_staff is Old School's Jab, Swipe and Fend: stab accurate, slash aggressive, crush
// defensive. Fend still needs crush_sound, which rs2check rule 19 caught both of these shipping
// without - sound_synth handed a null ends the session on the first attack.
//
// THE ANIMATIONS ARE OLD SCHOOL'S OWN, and every one of the five ids is already in the 377 cache.
// From the beta-world dump (rune-server 697435): stance 813, stab 428, slash 440, crush 419,
// defence 420 - human_staffready, human_spear_spike, human_scythe_sweep, human_stafforb_pummel
// and human_stafforb_block.
//
// The note that used to sit here reasoned its way to the one-handed SWORD's stab and slash and
// called the spear's "wrong because two-handed". It was wrong twice: Jagex uses the spear's spike
// for Jab and the scythe's sweep for Swipe, and it was the crush and the block that were borrowed
// from somewhere else entirely - 414 and 415, which the same dump names as the Kodai wand's. So
// this was a staff swinging a sword and blocking like a wand.

[staff_of_the_dead]
name=Staff of the Dead
desc=A ghastly weapon with evil origins.
model=obj_staff_of_the_dead
manwear=obj_staff_of_the_dead_manwear,0
womanwear=obj_staff_of_the_dead_womanwear,0
wearpos=righthand
2dzoom=1490
2dxan=138
2dyan=1300
2dxof=-5
2dyof=2
recol1s=14861
recol1d=15950
recol2s=27483
recol2d=15950
recol3s=15681
recol3d=15950
recol4s=15855
recol4d=15950
weight=1500g
cost=1000005
members=yes
iop2=Wield
// Nothing in this build to copy from, so these are Old School's own.
category=weapon_bladed_staff
param=attackrate,4
param=stabattack,55
param=slashattack,70
param=magicattack,17
param=slashdefence,3
param=crushdefence,3
param=magicdefence,17
param=strengthbonus,72
param=ready_baseanim,human_staffready
param=stabattack_anim,human_spear_spike
param=slashattack_anim,human_scythe_sweep
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=stab_sound,staff_stab
param=slash_sound,staff_hit
param=crush_sound,staff_hit
param=gwd_prot_zamorak,1
// POWER OF DEATH (and POWER OF LIGHT on the staff of light, the same mechanic renamed): 100% of
// the special attack energy for one minute of halved incoming melee. It is NOT a modifier on the
// attack - it changes every melee hit you take for 100 ticks - so the effect itself lives in the
// player-hit path (skill_combat/scripts/npc/npc_combat_melee.rs2 and scripts/pvp/pvp_melee.rs2)
// and the click lives on the spec bar's own button, not in player_special_attack's switch_obj.
// These two params are only what puts the bar on the tab and prices the click.
param=specwep,^true
param=sa_energy,1000

// Zilyana's, and the only thing it does here is make the staff of light. Old School's Consume -
// which permanently lifts the darkness in Zamorak's fortress - is NOT given an op, because this
// build's God Wars Dungeon has no darkness to lift: an option that says nothing is the fault this
// repo has spent whole rounds removing.
[saradomins_light]
name=Saradomin's light
desc=The starlight enlightens your mind to dispel the darkness of Zamorakian evil.
model=obj_saradomins_light
2dzoom=905
2dxan=374
2dyan=270
2dxof=3
2dyof=1
weight=250g
cost=34600
members=yes

[staff_of_light]
name=Staff of Light
desc=A ghastly weapon with evil origins combined with a holy light.
model=obj_staff_of_light
manwear=obj_staff_of_light_manwear,0
womanwear=obj_staff_of_light_womanwear,0
wearpos=righthand
2dzoom=1853
2dxan=364
2dyan=1508
2dxof=1
2dyof=21
weight=1500g
cost=1000005
members=yes
iop2=Wield
// Field for field the staff of the dead's, which is what Old School's own table says: combining
// changes the look, the autocast and the alignment, and no number at all.
category=weapon_bladed_staff
param=attackrate,4
param=stabattack,55
param=slashattack,70
param=magicattack,17
param=slashdefence,3
param=crushdefence,3
param=magicdefence,17
param=strengthbonus,72
param=ready_baseanim,human_staffready
param=stabattack_anim,human_spear_spike
param=slashattack_anim,human_scythe_sweep
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=stab_sound,staff_stab
param=slash_sound,staff_hit
param=crush_sound,staff_hit
// BOTH GODS, which is the whole point of making one: cache params 40 and 41 together. In this
// dungeon that is a Saradomin door and a Zamorak door open to the same player.
param=gwd_prot_saradomin,1
param=gwd_prot_zamorak,1
// POWER OF DEATH (and POWER OF LIGHT on the staff of light, the same mechanic renamed): 100% of
// the special attack energy for one minute of halved incoming melee. It is NOT a modifier on the
// attack - it changes every melee hit you take for 100 ticks - so the effect itself lives in the
// player-hit path (skill_combat/scripts/npc/npc_combat_melee.rs2 and scripts/pvp/pvp_melee.rs2)
// and the click lives on the spec bar's own button, not in player_special_attack's switch_obj.
// These two params are only what puts the bar on the tab and prices the click.
param=specwep,^true
param=sa_energy,1000
