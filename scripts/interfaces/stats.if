// x=63, not 62: construction_row sits at x=0 with its background starting at local x=-1, which
// Hunter, stat 22 (2026-09-22). Column 2 of the bottom row.
//
// x=63, not 62: construction_row sits at x=0 with its background starting at local x=-1, which
// puts that background on absolute 61..123 - one short of where column 2 of every row above it
// starts. Offsetting this layer by 63 lands bg1 on 62 and bg2 on 92, and the icon, level and base
// numbers on 68/96/108, which is column 2 of com_0..com_35 to the pixel.
//
// staticons2 ships six drawn 25x25 cells: 0 runecraft, 1 slayer, 2 farming, 3 a spade (unused),
// 4 hunter, 5 construction. Cell 4 held a brown long-tailed creature in the 377 cache - a rat,
// not the Hunter icon it was first mistaken for - and now holds OSRS's paw print.

[hunter_row]
type=layer
x=63
y=224
width=62
height=36

[hunter_bg1]
layer=hunter_row
type=graphic
x=-1
y=-1
width=30
height=36
graphic=miscgraphics,4

[hunter_bg2]
