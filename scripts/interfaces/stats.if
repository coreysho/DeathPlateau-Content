colour=0xFFFF00

[hunter_base]
layer=hunter_row
type=text
x=45
y=17
width=15
height=12
script1op1=stat_base_level,hunter
center=yes
font=p11_full
shadowed=yes
text=%1
colour=0xFFFF00
// This used to be 126 wide at x=62, spanning the bottom row's last TWO cells, with Total Lvl
// the panel is now one cell at x=125 - column 3 of the rows above it - and 63 wide, which is 55px
// The summary cell - Combat, Total level and quest points.
//
// This used to be 126 wide at x=62, spanning the bottom row's last TWO cells, with Total Lvl
// across the top and Combat and QP side by side underneath. Hunter needs one of those cells, so
// the panel is now one cell at x=125 - column 3 of the rows above it - and 63 wide, which is 55px
// of usable interior. "Total Lvl: 2277" does not fit in 55px at p12_full, and neither do Combat
// and QP beside each other, so the cell keeps the number that belongs on the stats tab and the
// other two move one hover away, to total_hover below.
//
// The stats tab is the only place in the game that shows quest points - the quest list tab does
// not, and inter_238 is the quest-complete screen - so QP had to keep a home, not be dropped.

[com_42]
type=layer
x=125
y=224
width=63
height=36

[total_cell_l]
layer=com_42
type=graphic
x=0
y=-1
width=36
height=36
graphic=osrsstat_total_l,0

[total_cell_r]
layer=com_42
type=graphic
x=30
y=-1
width=36
height=36
graphic=osrsstat_total_r,0

[total_label]
layer=com_42
type=text
x=6
y=7
width=55
height=14
center=yes
font=p11_full
shadowed=yes
text=Total level:
colour=0xFFFF00

[com_66]
layer=com_42
type=text
x=6
y=17
width=55
height=14
script1op1=op9
center=yes
font=p11_full
shadowed=yes
text=%1
colour=0xFFFF00
// component's overlayer on `overlayer >= 0` and the bounds alone, so this shows the panel without
// it. font= and shadowed= are here although this draws nothing: PackShared.nameToFont returns -1
// It is also skipped by genxplock.py's skill-box scan, which needs buttontype=normal.
// The hover target. No buttontype and no option on purpose: Client.handleInterfaceInput raises a
// component's overlayer on `overlayer >= 0` and the bounds alone, so this shows the panel without
// adding a right-click entry - and therefore without a menu option that has no [if_button] behind
// it. font= and shadowed= are here although this draws nothing: PackShared.nameToFont returns -1
// for a missing font and Component.decode indexes an array of four with it, which kills the client
// at "Unpacking interfaces" before the login screen. genxplock.py's header records that lesson.
//
// It is also skipped by genxplock.py's skill-box scan, which needs buttontype=normal.

[total_hover_target]
type=text
x=126
y=226
width=62
height=32
overlayer=total_hover
font=p12_full
shadowed=yes

[total_hover]
type=layer
x=0
y=0
width=190
height=261
hide=yes

[total_hover_label]
layer=total_hover
type=text
x=126
y=226
clientcode=329
width=62
height=32
font=p12_full

