[proc,slayer_new_target]()(int)
def_int $previous = %slayer_target;
def_dbrow $table = null;
switch_npc(npc_type) {
    case slayer_master_1 : $table = turael_task_table; %slayer_task_master = 1;
    case slayer_master_2 : $table = mazchna_task_table; %slayer_task_master = 2;
    case slayer_master_3 : $table = vannaka_task_table; %slayer_task_master = 3;
    case slayer_master_4 : $table = chaeldar_task_table; %slayer_task_master = 4;
    case slayer_master_5 : $table = duradel_task_table; %slayer_task_master = 5;
}
if ($table ! null) {
    // Slayer cape: 10% chance of being given the task you just finished again, if this master
    // assigns it (skillcapes/scripts/skillcape_perks.rs2)
    if ($previous > 0 & ~skillcape_worn(slayer) = true & random(10) = 0 & ~slayer_repeat_task($table, $previous) = true) {
        mes("Your Slayer cape lets you take on the same assignment again.");
    } else {
        ~generate_slayer_task($table);
    }
}

// the row in this master's table for $target, with its own kill range; false if he doesn't give it
[proc,slayer_repeat_task](dbrow $master, int $target)(boolean)
if (~validate_slayer_target($target) = false) {
    return(false);
}
def_int $i = 0;
def_dbrow $task_data;
while ($i < db_getfieldcount($master, slayer_task_table:task)) {
    $task_data = db_getfield($master, slayer_task_table:task, $i);
    if (db_getfield($task_data, slayer_master_task:task, 0) = $target) {
        %slayer_target = $target;
        %slayer_count = ~random_range(db_getfield($task_data, slayer_master_task:min_amount, 0), db_getfield($task_data, slayer_master_task:max_amount, 0));
        ~slayer_apply_extend;
        return(true);
    }
    $i = add($i, 1);
}
return(false);

[proc,generate_slayer_task](dbrow $master)
def_int $i = 0;
def_int $total = db_getfield($master, slayer_task_table:total, 0);
def_int $weight;
def_int $slayer_target;
def_int $slayer_count;
def_int $min;
def_int $max;
def_dbrow $task_data;
def_int $rand = random($total);
while($i < db_getfieldcount($master, slayer_task_table:task)) {
    $task_data = db_getfield($master, slayer_task_table:task, $i);
    $weight = db_getfield($task_data, slayer_master_task:weight, 0);
    $min = db_getfield($task_data, slayer_master_task:min_amount, 0);
    $max = db_getfield($task_data, slayer_master_task:max_amount, 0);
    $total = sub($total, $weight);
    if($rand >= $total) {
        $slayer_target = db_getfield($task_data, slayer_master_task:task, 0);
        if(~validate_slayer_target($slayer_target) = true) {
            %slayer_target = $slayer_target;
            %slayer_count = ~random_range($min, $max);
            ~slayer_apply_extend; // bought longer tasks (slayer_rewards.rs2)
            return;
        }
    }
    // failsafe but should prob just leave a no-req task at the end of the table since they're static anyways
    if($total <= 0) {
        ~generate_slayer_task($master);
        return;
    }
    $i = add($i, 1);
}

[proc,validate_slayer_target](int $target)(boolean)
if (~slayer_is_blocked($target) = true) { // blocked with Slayer points (slayer_points.rs2)
    return (false);
}
if (stat_base(slayer) < enum(int, int, slayer_req, $target)) { // slayer req check
    return (false);
}
// TODO: should combat reqs exist? seems like they might of https://oldschool.runescape.wiki/w/Update:Slayer_Assignment_Rework
if(~player_combat_level < enum(int, int, combat_req, $target)) {
    return (false);
}
// quest reqs, this can possibly be done in dbtable/enum as well?
// just defaulting any unimplemented quests to false for now
// https://oldschool.runescape.wiki/w/Update:Valentine%27s_Day no agil req for earth warriors
// https://oldschool.runescape.wiki/w/Update:Patch_Notes_(25_April_2013) no fm for harpie bugs
// https://oldschool.runescape.wiki/w/Update:Patch_Notes_(4_April_2013) no def level reqs (mirror shield)
switch_int($target) {
    // FIXED 2026-09-10: Priest in Peril is in the game, so the Morytania tasks it gates are given
    // once it is done. These are the ones with tagged, spawned npcs (crawling hands, banshees,
    // bloodvelds, aberrant spectres, gargoyles, nechryael, abyssal demons in the Slayer Tower; the
    // Canifis werewolves; ghouls - which were tagged as ghosts until now).
    //
    // FIXED 2026-10-08: the infernal mages and the vampires join them. Both were refused for having
    // no npc that counted - the Slayer Tower's five mages carried category=slayer_infernalmage,
    // which is not what npc_death reads, and nothing at all carried the vampire category. Both are
    // tagged now, and both live in Morytania, so they belong under the same quest as the rest.
    case ^slayer_crawlinghand, ^slayer_banshee, ^slayer_bloodveld, ^slayer_aberrantspecter,
            ^slayer_gargoyle, ^slayer_nechryael, ^slayer_abyssaldemon, ^slayer_ghoul, ^slayer_werewolf,
            ^slayer_infernalmage, ^slayer_vampire :
        if (%priestperil < ^priestperil_complete) {
            return (false);
        }
        return (true);
    case ^slayer_otherworldlybeing :
        if(%zanaris < ^zanaris_complete) {
            return (false);
        }
        return (true);
    // BUILT 2026-10-08: the zygomites and the fever spiders are real monsters now, so each asks for
    // what stands between a player and the place it lives rather than being refused.
    //
    // The zygomites are in Zanaris, behind Lost City, and OSRS sells the task as an unlock
    // ('Shroom Sprayer) because killing one needs the fungicide that unlock pays for the use of -
    // see skill_slayer/scripts/npcs/zygomite.rs2.
    case ^slayer_mutatedzygomite :
        if (%zanaris < ^zanaris_complete) {
            return (false);
        }
        if (testbit(%slayer_unlocks, ^slayer_unlock_shroom_sprayer) = ^false) {
            return (false);
        }
        return (true);
    // Rum Deal is implemented, and the slayer gloves it pays are what this monster needs.
    case ^slayer_feverspider :
        if (%deal_quest < ^deal_complete) {
            return (false);
        }
        return (true);
    // STILL REFUSED: nothing spawns a shade. The six in the cache belong to Mort'ton, which is not
    // in this build, and the prayer random event's are not a place you can go and hunt.
    case ^slayer_shade :
        return (false);
    case ^slayer_killerwatt :
        if(%haunted < ^haunted_complete) {
            return (false);
        }
        return (true);
    case ^slayer_shadowwarrior :
        if(%legendsquest < ^legends_complete) {
            return (false);
        }
        return (true);
    case ^slayer_dagannoth : // horror from the deep - see quests/quest_horror
        if(%horror < ^horror_complete) {
            return (false);
        }
        return (true);
    // BUILT 2026-10-08: the Elf warriors of Tirannwm carry the category now, and Regicide is what
    // opens the valley they stand in.
    case ^slayer_elf :
        if (%regicide_quest < ^regicide_complete) {
            return (false);
        }
        return (true);
    // BUILT 2026-10-08: red dragons and aviansies are Duradel's two unlock-only rows, the way OSRS
    // sells them - the monsters were always here, the task never was.
    case ^slayer_reddragon :
        if (testbit(%slayer_unlocks, ^slayer_unlock_seeing_red) = ^false) {
            return (false);
        }
        return (true);
    case ^slayer_aviansie :
        if (testbit(%slayer_unlocks, ^slayer_unlock_watch_the_birdie) = ^false) {
            return (false);
        }
        return (true);
    // FIXED 2026-09-16: this was a bare refusal, written when Desert Treasure was not implemented.
    // It is now - dt_pyramid.rs2 sets %deserttreasure = ^deserttreasure_complete and hands out the
    // Ancient Magicks - and the 19 dust devils live in that quest's own smoke dungeon, m50_146,
    // which ^dt_smoke_dungeon_sw names. So the task was refused even to players who had finished
    // the quest that opens the only place the monster exists. Same shape as the Horror from the
    // Deep case above, which is what this should always have been.
    case ^slayer_dustdevil :
        if(%deserttreasure < ^deserttreasure_complete) {
            return (false);
        }
        return (true);
    // STILL REFUSED, and the reason moved on 2026-10-08. Mourning's End Part II IS implemented now
    // (it was made completable on 2026-09-24), so that half of the old note is gone - but there is
    // still no way to WALK to a dark beast. The mourner hideout's ladder is the only handled way
    // down into Part I's mines and it opens into a 93-tile room; the eleven beasts stand outside it,
    // in a pocket nothing scripts an entrance to. Flooded out of the engine's own collision map.
    // Opening this would hand out a task nobody can start - tools/superior_battery.py group 7 keeps
    // the Night beast waiting on the same fact.
    case ^slayer_darkbeast : // mep2, and no way into the mines
        return (false);
    // BUILT 2026-10-08: a fishing explosive on the Mudskipper Point fishing spot brings one up
    // (skill_slayer/scripts/npcs/mogre.rs2), which is how OSRS does it. Skippy's miniquest, which
    // OSRS also asks for, is not in this build - the monster and the task are, and asking for a
    // quest nobody can start would put this straight back where it was.
}
return (true);

[proc,slayer_taskname]()(string)
return(enum(int, string, task_name, %slayer_target));

[proc,slayer_task_tip]()(string)
return(enum(int, string, task_tip, %slayer_target));

[proc,has_turael_task]()(boolean)
// this doesnt actually check for tasks assigned by turael, but rather the types he assigns
if(%slayer_target = ^slayer_rat | %slayer_target = ^slayer_monkey | %slayer_target = ^slayer_cow | %slayer_target = ^slayer_bird 
    | %slayer_target = ^slayer_spider | %slayer_target = ^slayer_dwarf | %slayer_target = ^slayer_lizard | %slayer_target = ^slayer_cavebug
    | %slayer_target = ^slayer_scorpion | %slayer_target = ^slayer_zombie | %slayer_target = ^slayer_bat | %slayer_target = ^slayer_bear
    | %slayer_target = ^slayer_ghost | %slayer_target = ^slayer_cavecrawler | %slayer_target = ^slayer_icefiend | %slayer_target = ^slayer_kalphite
    | %slayer_target = ^slayer_caveslime | %slayer_target = ^slayer_dog | %slayer_target = ^slayer_goblin | %slayer_target = ^slayer_wolf
    | %slayer_target = ^slayer_skeleton | %slayer_target = ^slayer_crawlinghand | %slayer_target = ^slayer_banshee) {
        return (true);
}
return (false);

[proc,check_progress_task](int $key)
// if the hero and the last attacker don't match, the xp/kc is split between them
if(npc_findhero = ^true) { 
    if(.finduid(%npc_aggressive_player) = true & uid ! .uid) {
        if(%slayer_target = $key) {
            if_close;
            queue*(progress_task_split, 0)(npc_uid);
        }
        if(.%slayer_target = $key) {
            .if_close;
            .queue*(progress_task_split, 0)(npc_uid);
        }
    } else if(%slayer_target = $key) {
        if_close;
        queue*(progress_task, 0)(npc_uid);
    }
} else if(finduid(%npc_aggressive_player) = true) {
    // Nothing to split down here. npc_findhero said false just above and HeroPoints.findHero only
    // reads, so this npc has no hero to find - the player it was last aggressive to is the only
    // claimant there is.
    //
    // This branch was branch one copied with the two roles swapped, and it asked again with
    // .npc_findhero. The dot form wants a SECOND active npc (engine ScriptOpcodePointers:
    // require2 active_npc2), and a death never sets one, so it threw "Attempt to access null
    // active_npc" - which aborted npc_death at the ~check_progress_task on its first line and took
    // everything after it with it: the drop, the death animation, the kill counts and npc_del, so
    // the corpse stayed standing. Seen in the live log on skeletons and a guard. Even with a second
    // npc in hand the test could never have passed, for the same reason the first one failed.
    if(%slayer_target = $key) {
        if_close;
        queue*(progress_task, 0)(npc_uid);
    }
}

[queue,progress_task](npc_uid $uid)
if(%slayer_count <= 0) {
    return;
}
if(npc_finduid($uid) = true) {
    %slayer_count = sub(%slayer_count, 1);
    stat_advance(slayer, calc(10 * npc_basestat(hitpoints)));
    ~imbue_scroll_kill_roll; // Scroll of imbuing (imbue_scroll.rs2) - weighted by the same hitpoints
    // Death tokens: paid only for a kill that counts AND happens in the Wilderness, which is why
    // the roll lives here rather than in npc_death (area_wilderness/scripts/death_token.rs2).
    ~death_token_roll;
    if(%slayer_count = 0) ~complete_task;
    ~slayer_superior_roll(npc_type); // Bigger and Badder (superiors.rs2) - keep last, it swaps the active npc
}

[queue,progress_task_split](npc_uid $uid)
if(%slayer_count <= 0) {
    return;
}
if(npc_finduid($uid) = true) {
    %slayer_count = sub(%slayer_count, 1);
    stat_advance(slayer, calc(10 * (npc_basestat(hitpoints) / 2)));
    // The SPLIT kill halves the xp but not the scroll: a drop cannot be halved, and both players
    // get their own roll, which is what two players sharing a kill would each have got alone.
    //
    // Death tokens are the same: each player rolls their own, in their own place, so two people
    // sharing a kill at the ditch do not between them get what one person deep in would.
    ~imbue_scroll_kill_roll;
    ~death_token_roll;
    if(%slayer_count = 0) ~complete_task;
    ~slayer_superior_roll(npc_type);
}

[proc,complete_task]
// https://youtu.be/xq8oz9of6Ck?si=WgGJ5L-rC1sCCh2F&t=66
%slayer_streak = add(%slayer_streak, 1);
// every task ever, for the quest tab's Player Statistics - the streak above is reset by Turael
%slayer_tasks_done = add(%slayer_tasks_done, 1);
def_int $points = ~slayer_task_points;
if ($points > 0) {
    %slayer_points = add(%slayer_points, $points);
    mes("You've completed <tostring(%slayer_streak)> tasks in a row and received <tostring($points)> points, with a total of <tostring(%slayer_points)>; return to a Slayer master.");
} else {
    mes("You've completed your task; return to a Slayer master.");
}
midi_jingle("advance slayer");
