// task (^slayer_*) -> 1 + extend index; 0 = no extension exists for it
[slayer_task_extend]
inputtype=int
outputtype=int
default=0
val=^slayer_abyssaldemon,1
val=^slayer_blackdemon,2
val=^slayer_greaterdemon,3
val=^slayer_bloodveld,4
val=^slayer_aberrantspecter,5
val=^slayer_gargoyle,6
val=^slayer_nechryael,7
val=^slayer_basilisk,8
val=^slayer_blackdragon,9
val=^slayer_bronzedragon,10
val=^slayer_skeletalwyvern,11
val=^slayer_irondragon,10
val=^slayer_steeldragon,10

// ============================================================================ the rewards window
//
// The five unlocks, the three things to buy, and what each of them says when you select it in the
// Slayer Rewards window (skill_slayer/scripts/slayer_ui.rs2, generated by tools/genslayerui.py).
// Names and prices are OSRS's, from oldschool.runescape.wiki/w/Slayer_Rewards, limited to what
// exists in this build - the header of slayer_rewards.rs2 lists what is missing and why.
//
// A DESCRIPTION IS KEYED index * 3 + line, three lines per entry, blank lines left out and
// answered by default=. One table per tab beats three tables per tab, and the window asks for
// line 0, 1 and 2 of whatever is selected without caring how many it has. Battery group 4
// measures every line against the panel's real width with the font this build draws it in.

[slayer_unlock_name]
inputtype=int
outputtype=string
default=null
val=0,Bigger and Badder
val=1,Gargoyle Smasher
val=2,Slug Salter
val=3,Reptile Freezer
val=4,Ring Bling
// custom (2026-10-08) - the three the monsters arrived for. 'Shroom Sprayer gates the zygomites
// now that they can be fought, and the other two are what OSRS sells to put a monster INTO the task
// list: red dragons and aviansies are both in this build and neither was ever assigned.
val=5,'Shroom Sprayer
val=6,Seeing Red
val=7,Watch the Birdie
// custom (2026-10-13) - the fourth of the same kind, and the deepest. Lava dragons were imported
// for the Wilderness and nobody assigned them either. The name is in OSRS's register for these
// (Seeing Red, Watch the Birdie) but is not one of OSRS's: there is no lava dragon unlock there,
// because Krystilia gives them as a Wilderness task and this build has no Wilderness master.
val=8,Playing with Fire

// The bit each one owns in %slayer_unlocks. NOT the row order: these are the bits the unlocks were
// first written with (slayer_rewards.rs2 and the monsters that read them), and renumbering them
// would silently re-grant or revoke whatever players already have.
[slayer_unlock_bit]
inputtype=int
outputtype=int
default=-1
val=0,4
val=1,0
val=2,1
val=3,2
val=4,3
// 7, 8, 9 and NOT 5, 6, 7: the Cosmetics tab's two unlocks have owned bits 5 and 6 since the window
// was written (slayer_cosmetic_bit below), and both tabs write the same %slayer_unlocks. Added on
// 2026-10-08 as 5-7, which quietly made 'Shroom Sprayer hand over the Unholy Helmet recolour and
// Seeing Red hand over Kalphite Khat; corrected the same day, before either could be bought on a
// live world.
val=5,7
val=6,8
val=7,9
// 11, skipping 10, which the King Black Bonnet below has owned since the Cosmetics tab was written.
val=8,11

[slayer_unlock_cost]
inputtype=int
outputtype=int
default=0
val=0,50
val=1,120
val=2,10
val=3,10
val=4,150
val=5,80
val=6,75
val=7,80
// The dearest of the four unlock-only task rows, because it is the best of them: a lava dragon is
// 230 hitpoints of level 252 dragon standing in level 37 Wilderness, and its bones are the reason
// anybody goes. 100 is a third of a task's points at Duradel's rate.
val=8,100

[slayer_unlock_desc]
inputtype=int
outputtype=string
default=
val=0,On task, a monster with a superior form has a 1 in 200 chance
val=1,of summoning it when it dies.
val=3,Gargoyles you beat are smashed for you, as long as you are
val=4,carrying a rock hammer.
val=6,Rockslugs you beat are salted for you, as long as you are
val=7,carrying a bag of salt.
val=9,Desert lizards you beat are frozen for you, as long as you
val=10,are carrying a bucket of icy water.
val=12,Learn to craft Slayer rings: an enchanted gem on a furnace
val=13,with a gold bar and a ring mould, at 75 Crafting.
// FILLED IN 2026-10-13. Rows 5, 6 and 7 had no description at all - default= is blank, so three
// unlocks costing 75 to 80 points each said nothing about what they did, and the window has a
// panel for exactly this. Two lines apiece, the width the other eight keep.
val=15,Mutated zygomites you beat are sprayed for you, as long as
val=16,you are carrying a fungicide spray.
val=18,Red dragons join Duradel's assignment list. He does not
val=19,give them to anybody who has not bought this.
val=21,Aviansies join Duradel's assignment list. He does not
val=22,give them to anybody who has not bought this.
val=24,Lava dragons join Duradel's assignment list. They live on
val=25,their island in deep Wilderness, so the task is a trip there.

// The Cosmetics tab: the slayer helmet recolours. OSRS keeps them in a tab of their own and so does
// this, which is why they are not in slayer_unlock_* above even though they are unlocks like any
// other - same bits, same points, different tab. slayer_helm_colours.rs2 reads bits 5 and 6.
[slayer_cosmetic_name]
inputtype=int
outputtype=string
default=null
val=0,Unholy Helmet
val=1,Kalphite Khat
// custom (2026-10-08) - the third colour with a source. tools/slayerhelmspec.json is where the
// helmet end of it lives; this is the row that sells the unlock.
val=2,King Black Bonnet

[slayer_cosmetic_bit]
inputtype=int
outputtype=int
default=-1
val=0,5
val=1,6
val=2,10

[slayer_cosmetic_cost]
inputtype=int
outputtype=int
default=0
val=0,1000
val=1,1000
val=2,1000

[slayer_cosmetic_desc]
inputtype=int
outputtype=string
default=
val=0,Use an abyssal head on a slayer helmet to turn it red.
val=1,Abyssal demons drop the head.
val=3,Use a Kq head on a slayer helmet to turn it green.
val=4,The Kalphite Queen drops the head.
val=6,Use Kbd heads on a slayer helmet to turn it black.
val=7,The King Black Dragon drops the heads.

// EVERY ROW OF THE BUY TAB IS AN ITEM. Row 3 used to be the imbue - a service with no obj, which
// ~slayer_ui_name had to special-case - and the imbue is a Scroll of imbuing drop now
// (skill_slayer/scripts/imbue_scroll.rs2), so the row is gone and the rune pouch has moved down
// into it. The rows have to stay contiguous from 0: ~slayer_ui_rows counts them with
// enum_getoutputcount(slayer_buy_cost) and a gap would draw a blank row.
[slayer_buy_obj]
inputtype=int
outputtype=namedobj
default=null
val=0,slayer_ring_8
val=1,herb_sack
val=2,looting_bag
val=3,rune_pouch

[slayer_buy_cost]
inputtype=int
outputtype=int
default=0
val=0,75
val=1,750
val=2,10
val=3,750

[slayer_buy_desc]
inputtype=int
outputtype=string
default=
val=0,Eight teleports to the Slayer Tower or the Fremennik
val=1,dungeon, and it checks your task when you operate it.
val=3,Holds 30 of each grimy herb, so a long task does not fill
val=4,your inventory with them.
val=6,Holds 28 items you would otherwise leave on the floor.
val=7,Everything in it is lost if you die.
val=9,Holds 16,000 each of three kinds of rune, and spells cast
val=10,straight from it. A needle and thread make it hold four.

// Every price the Slayer Rewards window can show, grouped. The engine
// has no command that formats a number and a row that says 1000 reads
// as noise. GENERATED by tools/genslayerui.py from the four cost tables
// and the three cost constants, so a new price cannot arrive ungrouped.
[slayer_cost_text]
inputtype=int
outputtype=string
val=10,10
val=30,30
val=50,50
val=75,75
val=80,80
val=100,100
val=120,120
val=150,150
val=200,200
val=750,750
val=1000,1,000
