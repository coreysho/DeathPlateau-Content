val=1,black demon
val=2,greater demon
val=3,bloodveld
val=4,aberrant spectre
val=5,gargoyle
val=6,nechryael
val=7,basilisk
val=8,black dragon
val=9,bronze, iron and steel dragon
val=10,skeletal wyvern

[slayer_extend_min]
inputtype=int
outputtype=int
