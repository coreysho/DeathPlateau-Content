// Skill cape sellers, trimming and the Skillcape emote.
//
// Every skill has a master who sells its cape and hood for 99,000 coins once the player has 99 in
// it. Existing npcs that are the masters call ~skillcape_offer(<stat>) at the top of their Talk-to
// trigger: a player without 99 sees the npc's normal dialogue unchanged; a player with 99 is first
// offered the cape, and choosing "Something else." falls through to the normal dialogue.
//
//   Attack       Ajjat (Warriors' Guild)          Magic        Magic Guild store owner
//   Strength     Sloane (Warriors' Guild, 1st fl) Runecraft    Aubury
//   Defence      Melee combat tutor (Lumbridge)   Hitpoints    Surgeon General Tafani (Duel Arena)
//   Ranged       Ranging Guild armour salesman    Agility      Cap'n Izzy No-Beard (Brimhaven)
//   Prayer       Brother Jered (Monastery)        Herblore     Kaqemeex (Taverley)
//   Thieving     Martin Thwait (Rogues' Den)      Crafting     Master crafter (Crafting Guild)
//   Fletching    Hickton (Catherby)               Slayer       Duradel (Shilo Village)
//   Mining       Dwarf at the Mining Guild        Smithing     Thurgo (Port Sarim)
//   Fishing      Master fisher (Fishing Guild)    Cooking      Head chef (Cooking Guild)
//   Firemaking   Ignatius Vulcan (Seers' forest)  Woodcutting  Woodsman tutor (Lumbridge)
//   Farming      Martin the Master Gardener       Quest points Wise Old Man (Draynor)
//
// A player with two or more 99s gets the trimmed cape, and on reaching a second 99 (or logging in
// with two) every untrimmed cape they hold - inventory, worn or banked - is swapped for the trimmed
// one (~skillcape_trim_all, called from [label,levelup] and [login,_]).

// THE SKILLS THE MAX CAPE COUNTS. This used to be the stats enum outright, on the reasoning that
// "every skill there is" is what that enum means. Hunter (stat 22, 2026-09-22) broke that: it is a
// real stat that levels and saves, but nothing in the world trains it, it has no cape entry in
// skillcape_cape, and no Hunter emote has been converted out of the OSRS cache. Counting it would
// have made the Max cape unbuyable AND unwearable - including for anyone already holding one,
// because [opheld2,max_cape] re-checks on every equip.
//
// So the count is now "skills with a cape you can earn", which is skillcape_cape - the one table
// that knows. Adding `val=hunter,hunter_cape` to it (plus the hood, the trim and an emote) is the
// single edit that makes the Max cape 23 skills, Mac's price go up, and the emote pick include it,
// with nothing here to change.
[proc,skillcape_stats]()(int)
def_int $count = 0;
def_int $i = 1;
while ($i <= enum_getoutputcount(stats)) {
    if (enum(stat, namedobj, skillcape_cape, enum(int, stat, stats, $i)) ! null) {
        $count = add($count, 1);
    }
    $i = add($i, 1);
}
return($count);

[proc,skillcape_count_99s]()(int)
def_int $count = 0;
def_int $i = 1;
while ($i <= enum_getoutputcount(stats)) {
    if (enum(stat, namedobj, skillcape_cape, enum(int, stat, stats, $i)) ! null
        & stat_base(enum(int, stat, stats, $i)) >= 99) {
        $count = add($count, 1);
    }
    $i = add($i, 1);
}
return($count);

// One of the caped skills, uniformly. Walks to the $pick-th skill that has a cape rather than
// indexing the stats enum directly, because a stat without a cape would otherwise come up null and
// the Max cape emote would refuse itself - "You need to be wearing a Skillcape" while wearing one.
[proc,skillcape_random_cape]()(namedobj)
def_int $pick = random(~skillcape_stats);
def_int $i = 1;
def_namedobj $cape = null;
while ($i <= enum_getoutputcount(stats)) {
    $cape = enum(stat, namedobj, skillcape_cape, enum(int, stat, stats, $i));
    if ($cape ! null) {
        if ($pick = 0) {
            return($cape);
        }
        $pick = sub($pick, 1);
    }
    $i = add($i, 1);
}
return(null);

// Offered at the top of a master's Talk-to. Returns true when the cape conversation replaced the
// npc's normal dialogue, so the caller should stop.
[proc,skillcape_offer](stat $stat)(boolean)
if (stat_base($stat) < 99) {
    return(false);
}
// A stat can exist without a cape - Hunter did, from 2026-09-22 until its cape opened on the 23rd -
// and ~skillcape_sell would hand out a null obj. Every stat has one again, so this cannot be reached
// today; it stays because "every stat has a cape" is an invariant that has broken once already.
if (enum(stat, namedobj, skillcape_cape, $stat) = null) {
    return(false);
}
def_string $skill = enum(stat, string, stat_names, $stat);
if (~p_choice2("Can I buy a Skillcape of <$skill>?", 1, "Something else.", 2) ! 1) {
    return(false);
}
~chatplayer("<p,quiz>Can I buy a Skillcape of <$skill>?");
def_namedobj $cape = enum(stat, namedobj, skillcape_cape, $stat);
if (~skillcape_count_99s >= 2) {
    $cape = enum(stat, namedobj, skillcape_cape_t, $stat);
}
~skillcape_sell($cape, enum(stat, namedobj, skillcape_hood, $stat));
return(true);

[proc,skillcape_sell](namedobj $cape, namedobj $hood)
~chatnpc("<p,happy>Certainly! Right when you give me 99,000 coins.");
if (~p_choice2("Okay, here you go.", 1, "No thanks.", 2) ! 1) {
    ~chatplayer("<p,neutral>No thanks.");
    ~chatnpc("<p,neutral>Come back if you change your mind.");
    return;
}
~chatplayer("<p,happy>Okay, here you go.");
if (inv_total(inv, coins) < ^skillcape_price) {
    ~chatplayer("<p,sad>But, unfortunately, I don't have enough money with me.");
    ~chatnpc("<p,neutral>Well, come back and see me when you do.");
    return;
}
// the cape comes with its hood, so two free spaces - the coins' slot counts if they all go
def_int $space = inv_freespace(inv);
if (inv_total(inv, coins) = ^skillcape_price) {
    $space = add($space, 1);
}
if ($space < 2) {
    ~chatnpc("<p,neutral>Unfortunately you don't have enough room for the cape and its hood. Come back when you have two free spaces in your inventory.");
    return;
}
inv_del(inv, coins, ^skillcape_price);
inv_add(inv, $cape, 1);
inv_add(inv, $hood, 1);
~doubleobjbox($cape, $hood, "You hand over 99,000 coins and receive a <lowercase(oc_name($cape))> and a hood.", 200);
~chatnpc("<p,happy>Excellent! Wear that cape with pride, my friend.");

// Swap every untrimmed cape the player holds for its trimmed version. Returns true if any changed.
[proc,skillcape_trim_all]()(boolean)
def_boolean $changed = false;
def_boolean $worn_changed = false;
def_namedobj $cape = null;
def_namedobj $trim = null;
def_int $count = 0;
def_int $i = 0;
while ($i < enum_getoutputcount(skillcape_untrimmed)) {
    $cape = enum(int, namedobj, skillcape_untrimmed, $i);
    $trim = enum(int, namedobj, skillcape_trimmed, $i);
    // capes do not stack in the inventory: inv_changeslot swaps one slot per call
    while (inv_total(inv, $cape) > 0) {
        inv_changeslot(inv, $cape, $trim, 1);
        $changed = true;
    }
    $count = inv_total(bank, $cape);
    if ($count > 0) {
        if (inv_total(bank, $trim) > 0) {
            // merge into the existing trimmed stack rather than leave two stacks of one item
            inv_del(bank, $cape, $count);
            inv_add(bank, $trim, $count);
        } else {
            inv_changeslot(bank, $cape, $trim, $count);
        }
        $changed = true;
    }
    if (inv_getobj(worn, ^wearpos_back) = $cape) {
        inv_setslot(worn, ^wearpos_back, $trim, 1);
        $changed = true;
        $worn_changed = true;
    }
    $i = add($i, 1);
}
if ($worn_changed = true) {
    ~update_all(inv_getobj(worn, ^wearpos_rhand));
}
return($changed);

// [label,levelup] - runs from the engine queue, so it has protected access to bank and worn
[proc,skillcape_levelup](stat $stat)
if (stat_base($stat) < 99) {
    return;
}
if (~skillcape_count_99s < 2) {
    return;
}
if (~skillcape_trim_all = true) {
    mes("Your Skillcapes have been trimmed to reflect your mastery of more than one skill.");
}

[proc,skillcape_login]
if (~skillcape_count_99s < 2) {
    return;
}
if (~skillcape_trim_all = true) {
    mes("Your Skillcapes have been trimmed to reflect your mastery of more than one skill.");
}

// The Skillcape emote on the emotes tab plays the worn cape's animation and graphic.
[if_button,emotes:skill_cape]
if (p_finduid(uid) = false) {
    return;
}
def_obj $cape = inv_getobj(worn, ^wearpos_back);
// THE MAX CAPE HAS NO EMOTE OF ITS OWN HERE. OSRS's is a 2015 animation - the skill icons circling
// overhead - and it is not the 24-wide block of skillcape emotes this build imported, so there is
// nothing to look up and nothing worth guessing at (claude/black-mask-slayer-helm-ma2.md is what
// guessing at an unseen asset costs). The cape that stands for all 23 skills performs one of their
// emotes instead, picked at random each time. Every skill WITH A CAPE has both an emote and a
// graphic - battery check 8 holds that - so the pick can never come up empty. It is ~skillcape_stats
// wide, not the stats enum: a stat with no cape (Hunter, until 2026-09-23) picked null.
// A VARIANT emotes the same way, which is the one thing OSRS lets a variant keep besides the
// four guild-and-warmth perks. Written as one condition with the plain cape rather than a second
// copy of the random pick: the variant IS a Max cape underneath, and if the real animation is ever
// identified there is still only one line to change.
if ($cape = max_cape | enum(obj, namedobj, maxvariant_source, $cape) ! null) {
    $cape = ~skillcape_random_cape;
}
def_seq $seq = null;
if ($cape ! null) {
    $seq = enum(obj, seq, skillcape_emote_seq, $cape);
}
if ($seq = null) {
    mes("You need to be wearing a Skillcape in order to perform that emote.");
    return;
}
if_close;
p_stopaction;
anim($seq, 0);
// Looked up separately and guarded: the seq table and the spot table are two tables, and a cape
// present in one but not the other used to emit spotanim 0 - the dragonfire breath.
def_spotanim $spot = enum(obj, spotanim, skillcape_emote_spot, $cape);
if ($spot ! null) {
    spotanim_pl($spot, 0, 0);
}

// ---- masters who are new npcs, or existing npcs with no Talk-to until now ----

[proc,skillcape_master](stat $stat, string $greeting)
~chatnpc($greeting);
if (~skillcape_offer($stat) = true) {
    return;
}
def_string $skill = enum(stat, string, stat_names, $stat);
if (~p_choice2("What is that cape you're wearing?", 1, "Goodbye.", 2) ! 1) {
    ~chatplayer("<p,neutral>Goodbye.");
    return;
}
~chatplayer("<p,quiz>What is that cape you're wearing?");
~chatnpc("<p,happy>This is a Skillcape of <$skill>. I was given the honour of selling them, as no one knows more about <lowercase($skill)> than I do.");
if (stat_base($stat) >= 99) {
    ~chatnpc("<p,happy>And you've mastered it too! Talk to me again and I'll sell you one for 99,000 coins.");
    return;
}
~chatnpc("<p,neutral>Only those who have reached level 99 in <$skill> may wear one. Come and see me when you have, and I'll sell you one for 99,000 coins.");

[opnpc1,skillcape_sloane] ~skillcape_master(strength, "<p,happy>Hello there! I'm Sloane. I keep an eye on the shot put and the kegs - strength is my business.");
[opnpc1,skillcape_harlan] ~skillcape_master(defence, "<p,neutral>Greetings, adventurer. I teach the ways of melee combat, and there's no one better at keeping a blade off themselves than me.");
[opnpc1,skillcape_wilfred] ~skillcape_master(woodcutting, "<p,happy>Hello! I'm Wilfred. If it's a tree, I've cut it down.");
[opnpc1,skillcape_ignatius] ~skillcape_master(firemaking, "<p,happy>Hello, I'm Ignatius Vulcan. Fire is my passion - there's nothing finer than a well-built blaze.");
// A Fairy Tale Part I starts with him, because he is the man in the kingdom who would notice every
// allotment failing on the same day. Hooked in ahead of the skillcape dialogue.
[opnpc1,martin_the_master_farmer]
if (~fairy_martin = true) {
    return;
}
~skillcape_master(farming, "<p,happy>Hello, I'm Martin. I know all there is to know about growing things.");

// The Wise Old Man sells the Quest point cape to players who have finished every quest. He is
// spawned as wom_multi (a multinpc on %swansong), and npc triggers resolve on the spawned type.
// [opnpc1,wom_multi] itself lives in areas/area_draynor/scripts/wise_old_man.rs2 now, because two
// quests want a word with him before the cape comes up; it jumps here when neither does.
[label,wom_cape_talk]
~chatnpc("<p,neutral>Greetings, adventurer. What brings you to the house of the Wise Old Man?");
if (%qp >= ~max_questpoints) {
    if (~p_choice2("Can I buy a Quest point cape?", 1, "Nothing, thanks.", 2) = 1) {
        ~chatplayer("<p,quiz>Can I buy a Quest point cape?");
        ~chatnpc("<p,happy>You have completed every quest in the land - you've earned it.");
        ~skillcape_sell(quest_point_cape, quest_point_hood);
        return;
    }
    ~chatplayer("<p,neutral>Nothing, thanks.");
    return;
}
if (~p_choice2("What is that cape you're wearing?", 1, "Nothing, thanks.", 2) ! 1) {
    ~chatplayer("<p,neutral>Nothing, thanks.");
    return;
}
~chatplayer("<p,quiz>What is that cape you're wearing?");
~chatnpc("<p,neutral>This is a Quest point cape. Only those who have completed every quest in the land may wear one.");
~chatnpc("<p,neutral>You have <tostring(%qp)> of the <tostring(~max_questpoints)> quest points there are. Come back when you have them all and I'll sell you one for 99,000 coins.");

// Masters whose Talk-to comes from their npc category: offer the cape, then the category dialogue.
[opnpc1,roguesden_trader]
if (~skillcape_offer(thieving) = true) {
    return;
}
@shop_keeper_talk;

[opnpc1,slayer_master_5]
if (~skillcape_offer(slayer) = true) {
    return;
}
@slayer_master_talk;

[opnpc1,duel_nurse3]
if (~skillcape_offer(hitpoints) = true) {
    return;
}
@healer_talk;
// ============================================================================ the Max cape
//
// Mac sells it, and his price is OSRS's: 99,000 a skill, which comes to 2,376,000 there for 24
// skills and to ^skillcape_price x the stats enum here. Counted rather than written down, so a
// skill added to that enum raises the price and the requirement together - the same reason
// ~maxcape_ready counts instead of naming: ~skillcape_stats is the number of skills with a cape,
// which is the only place that knows, and it moves on its own when one is added.
//
// A lost cape or hood is replaced free, as in OSRS. %maxcape_bought remembers only that you once
// bought one; what happened to it is not Mac's business.

[proc,maxcape_price]()(int)
return(calc(^skillcape_price * ~skillcape_stats));

[proc,maxcape_ready]()(boolean)
if (~skillcape_count_99s >= ~skillcape_stats) {
    return(true);
}
return(false);

// How many of the two pieces the player does not have anywhere - inventory, bank or worn. A player
// who lost only the hood gets a hood, and needs one free slot rather than two.
[proc,maxcape_missing]()(int)
// (2026-10-19) A variant counts (max_cape_variants.rs2, generated): fusing the Max cape into one is not
// losing it, and counting only max_cape made Mac hand out a free one - split the variant with a knife
// and that was a spare Max cape to alch, as often as you liked.
def_int $missing = 0;
if (calc(~obj_gettotal(max_cape) + ~maxvariant_owned_capes) = 0) {
    $missing = add($missing, 1);
}
if (calc(~obj_gettotal(max_hood) + ~maxvariant_owned_hoods) = 0) {
    $missing = add($missing, 1);
}
return($missing);

[opnpc1,skillcape_mac]
~chatnpc("<p,happy>Hello there. I'm Mac. I keep an eye on the ones who have finished the lot.");
if (~maxcape_ready = false) {
    ~chatnpc("<p,neutral>The Max cape is for those who have reached level 99 in all <tostring(~skillcape_stats)> skills. You have <tostring(~skillcape_count_99s)> of them.");
    ~chatnpc("<p,happy>Come back when you've got the rest and I'll sell you one for <tostring(~maxcape_price)> coins.");
    return;
}
if (%maxcape_bought = 1) {
    if (~maxcape_missing = 0) {
        ~chatnpc("<p,happy>You've got yours already. Wear it with pride.");
        return;
    }
    if (~p_choice2("I've lost my Max cape.", 1, "Something else.", 2) ! 1) {
        return;
    }
    ~chatplayer("<p,sad>I've lost my Max cape.");
    ~chatnpc("<p,neutral>Careless. Here, you've earned it once - you don't have to earn it twice.");
    ~maxcape_give;
    return;
}
if (~p_choice2("Can I buy a Max cape?", 1, "Something else.", 2) ! 1) {
    return;
}
~chatplayer("<p,quiz>Can I buy a Max cape?");
~chatnpc("<p,happy>All <tostring(~skillcape_stats)> skills mastered - not many manage that. <tostring(~maxcape_price)> coins and it's yours, hood and all.");
if (~p_choice2("Okay, here you go.", 1, "No thanks.", 2) ! 1) {
    ~chatplayer("<p,neutral>No thanks.");
    ~chatnpc("<p,neutral>Come back if you change your mind.");
    return;
}
~chatplayer("<p,happy>Okay, here you go.");
if (inv_total(inv, coins) < ~maxcape_price) {
    ~chatplayer("<p,sad>But, unfortunately, I don't have enough money with me.");
    ~chatnpc("<p,neutral>Well, come back and see me when you do.");
    return;
}
// the coins' slot counts towards the room needed if all of them go
def_int $space = inv_freespace(inv);
if (inv_total(inv, coins) = ~maxcape_price) {
    $space = add($space, 1);
}
if ($space < 2) {
    ~chatnpc("<p,neutral>You'll want room for the cape and the hood both. Come back with two free spaces.");
    return;
}
inv_del(inv, coins, ~maxcape_price);
%maxcape_bought = 1;
inv_add(inv, max_cape, 1);
inv_add(inv, max_hood, 1);
~doubleobjbox(max_cape, max_hood, "You hand over <tostring(~maxcape_price)> coins and receive a Max cape and its hood.", 200);
~chatnpc("<p,happy>There you go. Every skill in the game on one back.");

// The replacement path: only the pieces that are missing, and only if there is room for them.
[proc,maxcape_give]
def_int $missing = ~maxcape_missing;
if (inv_freespace(inv) < $missing) {
    ~chatnpc("<p,neutral>You haven't the room. Come back with <tostring($missing)> free space.");
    return;
}
if (~obj_gettotal(max_cape) = 0) {
    inv_add(inv, max_cape, 1);
}
if (~obj_gettotal(max_hood) = 0) {
    inv_add(inv, max_hood, 1);
}
