// TzRek-Jad, from TzTok-Jad in the Fight Cave (OSRS npc 5892, imported by importosrsnpc.py).
//
// The mesh is npc_tztok_jad_1: OSRS model 9319, TzTok-Jad's own, shared with the full-size
// Jad in the Fight Cave. One file, two npcs, a resize apart.
// resizeh/resizev 20 is the cache's own - a Jad rendered at a sixth of his size, which is the joke.
// BOTH seqs are converted from OSRS rather than one of each: ready and walk are the pair the client
// walk-merges, and it only merges two animations that share a base (see
// skill_slayer/configs/superiors.seq). 377 has lordmagmus_ready and it would have been the cheaper
// ready, on a different base, and the merge would have been the thing that broke.
[bosspet_tzrek_jad]
name=TzRek-Jad
desc=This is not going to hurt... but it might tickle.
model1=npc_tztok_jad_1
head1=npc_bosspet_tzrek_jad_head1
size=1
resizeh=20
resizev=20
readyanim=osrs_seq_2650
walkanim=osrs_seq_5805
vislevel=hide
timer=1
minimap=no
op1=Pick-up
op3=Talk-to
op4=Metamorphosis
category=bosspet
follower=yes
param=pet_item_id,bosspet_tzrek_jad_item
param=metamorph_next,bosspet_jalrek_jad

// JalRek-Jad, what TzRek-Jad becomes (OSRS npc 10620). The cache carries a second record for each
// pet with a "Metamorphosis" op on it (5893 and 10625), which is how Old School lets you switch
// between the two forms; here the Fire cape exchange is what performs the change, once, and the
// npc it leaves you with is this one.
//
// resizeh/resizev 20 again, and BOTH seqs from OSRS for the walk-merge reason the record above
// gives. ambient is the cache's -10: this mesh is meant to glow rather than be lit.
[bosspet_jalrek_jad]
name=JalRek-Jad
desc=Small, troublesome, cute.
model1=npc_bosspet_jalrek_jad_1
head1=npc_bosspet_jalrek_jad_head1
size=1
resizeh=20
resizev=20
readyanim=osrs_seq_7589
walkanim=osrs_seq_8857
ambient=-10
vislevel=hide
timer=1
minimap=no
op1=Pick-up
op3=Talk-to
op4=Metamorphosis
category=bosspet
follower=yes
param=pet_item_id,bosspet_jalrek_jad_item
param=metamorph_next,bosspet_tzrek_jad
