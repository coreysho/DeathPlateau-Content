// The King Black Dragon is OSRS's own art, not the 377 red dragon recoloured black. Its five
// models carry their recolours baked in (osrs2ob2 bakes what the npc config used to say), so the
// recol pairs that used to be here are gone, and it needs no resize: the cache states 128 and the
// mesh is authored at the size it should be - taller and longer than the 377 one it replaces.
//
// Every one of its five animations was identified with tools/models/posepreview.py, which poses
// the mesh with the frame's own transforms and draws it. 89 rears up and settles (block), 91
// lunges head-down (attack), 92 collapses flat (death); their priorities are the ones the 377
// anims they replace carried - none, 6 and 10 - which is a second, independent agreement.
//
// Elvarg and the chromatic dragons still share npc_king_dragon, the 377 mesh, and are untouched.
[king_dragon]
name=King black dragon
desc=The biggest, meanest dragon around.
model1=npc_king_dragon_1
model2=npc_king_dragon_2
model3=npc_king_dragon_3
model4=npc_king_dragon_4
model5=npc_king_dragon_5
size=5
walkanim=osrs_seq_4635
readyanim=osrs_seq_90
op2=Attack
vislevel=276
wanderrange=20
maxrange=20
attackrange=15
respawnrate=150
hitpoints=240
attack=240
strength=240
defence=240
param=stabdefence,70
param=slashdefence,90
param=crushdefence,90
param=magicdefence,80
param=rangedefence,70
param=damagetype,^stab_style
param=attack_anim,osrs_seq_91
param=defend_anim,osrs_seq_89
param=death_anim,osrs_seq_92
param=attack_sound,dragon_attack
param=defend_sound,dragon_hit
param=death_sound,dragon_death
param=death_drop,dragon_bones
param=slayer_category,^slayer_blackdragon
param=fiery,yes
param=draconic,yes
huntrange=20
huntmode=cowardly

