[ai_spawn,_] ~npc_spawn_defaults;

// WHAT EVERY NPC NEEDS AT SPAWN, as a proc rather than only as the wildcard's body.
//
// A trigger written for ONE npc REPLACES the wildcard for that npc - the engine picks the most
// specific and runs only that - so an [ai_spawn,something] silently costs that npc its combat xp
// multiplier, its start coord and its spawn facing unless it asks for them. The Spinolyps in the
// Waterbirth maze had been doing exactly that since their suspicious-water cycle was added.
// Anything that needs its own ai_spawn calls this first.
//
// AND A RECURRING TIMER IS NOT A REASON TO WRITE ONE. npc_settimer here does not last:
// Npc.resetDefaults writes timerInterval back to the npc TYPE's own timer field, and it runs every
// time an npc drops a target - so a timer armed at spawn is gone a few ticks into the first fight.
// timer=<ticks> in the .npc config is the version that survives, because the reset is what reads
// it. Measured on the King Black Dragon: armed from an ai_spawn its [ai_timer] fired twice in a
// sixty-tick chase, and from the config field, every tick of it.
[proc,npc_spawn_defaults]
%npc_combat_xp_multiplier = npc_param(combat_xp_multiplier);
%npc_start_coord = npc_coord;
// Which way it stands, for the npcs that care - see npc/configs/npc_spawn.param. The default of -1
// leaves the npc facing south, as every npc did before this existed.
~npc_spawn_face(npc_param(spawn_face));

// A spawn facing, from one of engine.constant's four ^exact_* directions. npc_facesquare sets both
// faceAngle (what a client is told when it first sees the npc) and faceSquare (a direction update to
// clients already watching), and nothing resets either until the npc moves or interacts - so an npc
// that never does keeps this. One that does will face whoever it is talking to, which is right.
[proc,npc_spawn_face](int $dir)
switch_int ($dir) {
    case ^exact_north : npc_facesquare(movecoord(npc_coord, 0, 0, 1));
    case ^exact_east : npc_facesquare(movecoord(npc_coord, 1, 0, 0));
    case ^exact_south : npc_facesquare(movecoord(npc_coord, 0, 0, -1));
    case ^exact_west : npc_facesquare(movecoord(npc_coord, -1, 0, 0));
}
