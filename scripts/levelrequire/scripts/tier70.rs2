// A broken piece cannot be put back on until Bob repairs it. It is not force-removed if it
// breaks while worn - that matches the real behaviour - it just cannot be re-equipped.
[opheld2,barrows_ahrim_body_broken] ~barrows_broken_refuse;
[opheld2,barrows_ahrim_head_broken] ~barrows_broken_refuse;
