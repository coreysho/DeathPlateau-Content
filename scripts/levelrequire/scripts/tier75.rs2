// God Wars Dungeon - the two staves. 75 Magic AND 75 Attack, which is the cache record's own
// pair of requirement params (435/437 and 434/436) rather than the wiki's prose.
[opheld2,staff_of_the_dead] @levelrequire_magic_and_attack(75, 75, last_slot);
[opheld2,staff_of_light] @levelrequire_magic_and_attack(75, 75, last_slot);
// The toxic staff of the dead, both records - the staff of the dead's own requirement, kept by the
// fang (area_zulrah/configs/toxic_staff.obj).
[opheld2,toxic_staff_uncharged] @levelrequire_magic_and_attack(75, 75, last_slot);
[opheld2,toxic_staff_of_the_dead] @levelrequire_magic_and_attack(75, 75, last_slot);

// God Wars Dungeon - godswords
[opheld2,armadyl_godsword] @levelrequire_attack(75, last_slot);
[opheld2,bandos_godsword] @levelrequire_attack(75, last_slot);
[opheld2,saradomin_godsword] @levelrequire_attack(75, last_slot);
[opheld2,zamorak_godsword] @levelrequire_attack(75, last_slot);

// Repaints and renames of items already in this file, found by tools/wearreq.py:
// same slot, same bonuses, so the same armour and the same requirement. They went
// on at level 1 because nobody had typed a line for them.
[opheld2,armadyl_godsword_or] @levelrequire_attack(75, last_slot);

// The dragonfire shield: 75 Defence and Dragon Slayer, as Old School has it. Both records, so
// the tradeable uncharged one is gated too.
[opheld2,dragonfire_shield] @levelrequire_dragon_slayer_quest_defence(75, last_slot);
[opheld2,dragonfire_shield_uncharged] @levelrequire_dragon_slayer_quest_defence(75, last_slot);

// Variants that went on at level 1 because nothing gated them (security review, 2026-10-19):
// coloured whips, ornament godswords, trimmed/gold/god skirts and hides, heraldic rune.
// The generic [opheld2,_] equip checks no stats, so every wearable needs its own line.
[opheld2,bandos_godsword_or] @levelrequire_attack(75, last_slot);
[opheld2,saradomin_godsword_or] @levelrequire_attack(75, last_slot);
[opheld2,zamorak_godsword_or] @levelrequire_attack(75, last_slot);
