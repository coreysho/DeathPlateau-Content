[opnpc1,fairy_lunderwin]
~chatnpc("<p,neutral>Buying cabbage am I, not have such thing where I from. Will pay money much handsome for wondrous object, cabbage you called.");
~chatnpc("<p,neutral>Say I 100 gold coins each fair price to be giving yes?");
if(inv_total(inv, cabbage) > 0) {
    switch_int(~p_choice2("Yes, I will sell you all my cabbages.", 1, "No, I will keep my cabbbages.", 2)) {
        case 1 :
            ~chatplayer("<p,neutral>Yes, I'll sell you all my cabbages.");
            if_close;
            // ONE AT A TIME, AS OLD SCHOOL DOES, BUT WITH NO DELAY (DeathPlateau-Bugs#86).
            //
            // This comment used to say "RSC sells 1 at a time with delay, OSRS technically does as
            // well but with no delay, we'll copy RSC here" - and RSC's delay was a tick per
            // cabbage, so a full pack froze the player for about 17 seconds with every click of
            // theirs DISCARDED rather than queued. The owner's call was Old School's pacing. The
            // per-item line stays, because that is what Old School prints.
            //
            // COUNTED, NOT RE-READ. Dropping the p_delay out of a `while` that re-reads the
            // inventory leaves a loop with no yield in it, which is a hang rather than a freeze if
            // inv_del ever removes nothing. The count is taken once and spent down, so the loop is
            // bounded by construction.
            def_int $cabbages = inv_total(inv, cabbage);
            while ($cabbages > 0) {
                mes("You sell a cabbage.");
                inv_del(inv, cabbage, 1);
                inv_add(inv, coins, 100);
                $cabbages = calc($cabbages - 1);
            }
            ~chatnpc("<p,neutral>Business good doing with you! Please, again come, buying always.");
        case 2 : ~chatplayer("<p,neutral>No, I will keep my cabbbages.");
    }
    return;
}
~chatplayer("<p,sad>Alas, I have no cabbages either...");
~chatnpc("<p,sad>Pity be that, I want badly do.");
