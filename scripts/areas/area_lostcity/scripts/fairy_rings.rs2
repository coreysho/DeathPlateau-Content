// The fairy ring network: six rings, one dial, and a quest that has to be finished first.
//
// WHAT 377 GAVE US AND WHAT IT DID NOT. Eight mushroom rings are placed on this map and the
// models, the vanish and appear animations and the Zanaris hub all ship with the revision. What
// does not ship is any way to dial one, because in RuneScape the network unlocks in Fairytale II
// and 377 predates it: there is no fairy ring panel in the cache and no varbit for a code. So the
// rings sat rendering as mushrooms you walked over - six of them without even a name - and the
// one script in this file sent you from Zanaris to the Lumbridge Swamp shed and nowhere else.
//
// THE DIAL IS A HAND-WRITTEN PANEL, see ../interfaces/fairy_rings.if for why, and every
// measurement in it is the Legends' Quest combination door's so that the two look alike. This
// file is the door's script with three dials instead of four: quest_totem.rs2 is where the
// getbit_range/setbit_range_toint pattern and the enum-per-dial idea come from.
//
// GATED ON FAIRYTALE PART I, as asked. RuneScape wants rather more - The Restless Ghost, Priest
// in Peril, Nature Spirit, Lost City, Fairytale I and part of Fairytale II, plus a dramen staff
// in your hand - and Part I alone is a deliberate simplification of that, not an oversight. The
// check is one line and is easy to tighten later if you want the staff back.
//
// AN UNKNOWN CODE DOES NOTHING, loudly enough to be clear and quietly enough not to be a slap:
// 64 codes are diallable and 6 go anywhere. That is what RuneScape does with an unused code too.

// ---------------------------------------------------------------- the rings themselves
//
// EVERY RING DIALS. There is no "nearest ring" shortcut and no fixed pairing, because a network
// where each ring reaches one other place is not a network. The Zanaris ring by Fairy Nuff is the
// single exception and it is additive: it keeps its old one-way step out to the swamp AS WELL as
// the dial, so the route players already use is still there.
[oploc1,64_fairy_mushroom_ring] @fairy_ring_use;
[oploc1,1_fairy_mushroom_ring] @fairy_ring_use;
[oploc1,6_fairy_mushroom_ring] @fairy_ring_use;
[oploc1,27_fairy_mushroom_ring] @fairy_ring_use;
[oploc1,37_fairy_mushroom_ring] @fairy_ring_use;
[oploc1,47_fairy_mushroom_ring] @fairy_ring_use;
[oploc1,fairy_mushroom_ring3] @fairy_ring_use;

[oploc1,fairy_mushroom_ring]
p_walk(loc_coord);
if (%fairy_farmers_quest < ^fairy_complete) {
    // the swamp step has never needed the quest, so it still does not
    @fairy_ring_swamp;
    return;
}
switch_int(~p_choice2("Dial a code.", 1, "Step through to the swamp.", 2)) {
    case 1 : @fairy_ring_open;
    case 2 : @fairy_ring_swamp;
}

[label,fairy_ring_swamp]
anim(human_fairy_vanish, 0);
p_telejump(^fairy_to_swamp);
anim(human_fairy_appear, 0);
p_delay(0);

[label,fairy_ring_use]
p_walk(loc_coord);
if (%fairy_farmers_quest < ^fairy_complete) {
    // SAID AS THE RING, not as a quest requirement, because a player who has not met a fairy yet
    // has no reason to connect a mushroom circle with a farmer's missing secateurs.
    ~mesbox("The mushrooms are pretty, and nothing more. Perhaps somebody who|knows about fairies could tell you why.");
    return;
}
@fairy_ring_open;

[label,fairy_ring_open]
~fairy_ring_refresh;
if_openmain(fairy_rings);

// ---------------------------------------------------------------- the dial
//
// Two bits per dial and four letters per dial, so every stored value is a letter and there is no
// invalid state: turning past the end wraps, which is what a ring does.
[proc,fairy_dial_get](int $dial)(int)
switch_int($dial) {
    case 1 : return (getbit_range(%fairy_ring_dial, ^fairy_dial1_lo, ^fairy_dial1_hi));
    case 2 : return (getbit_range(%fairy_ring_dial, ^fairy_dial2_lo, ^fairy_dial2_hi));
    case 3 : return (getbit_range(%fairy_ring_dial, ^fairy_dial3_lo, ^fairy_dial3_hi));
}
return (0);

[proc,fairy_dial_set](int $dial, int $value)
switch_int($dial) {
    case 1 : %fairy_ring_dial = setbit_range_toint(%fairy_ring_dial, $value, ^fairy_dial1_lo, ^fairy_dial1_hi);
    case 2 : %fairy_ring_dial = setbit_range_toint(%fairy_ring_dial, $value, ^fairy_dial2_lo, ^fairy_dial2_hi);
    case 3 : %fairy_ring_dial = setbit_range_toint(%fairy_ring_dial, $value, ^fairy_dial3_lo, ^fairy_dial3_hi);
}

// Put what is stored on the dials. Called when the panel opens as well as on every turn, so a
// player who dialled DKR last week sees DKR rather than AIP.
[proc,fairy_ring_refresh]
if_settext(fairy_rings:letter1, enum(int, string, fairy_dial1, ~fairy_dial_get(1)));
if_settext(fairy_rings:letter2, enum(int, string, fairy_dial2, ~fairy_dial_get(2)));
if_settext(fairy_rings:letter3, enum(int, string, fairy_dial3, ~fairy_dial_get(3)));

[label,fairy_ring_turn](int $dial, int $change)
def_int $next = calc(~fairy_dial_get($dial) + $change);
if ($next > 3) {
    $next = 0;
} else if ($next < 0) {
    $next = 3;
}
~fairy_dial_set($dial, $next);
~fairy_ring_refresh;

[if_button,fairy_rings:left1] @fairy_ring_turn(1, -1);
[if_button,fairy_rings:left2] @fairy_ring_turn(2, -1);
[if_button,fairy_rings:left3] @fairy_ring_turn(3, -1);
[if_button,fairy_rings:right1] @fairy_ring_turn(1, 1);
[if_button,fairy_rings:right2] @fairy_ring_turn(2, 1);
[if_button,fairy_rings:right3] @fairy_ring_turn(3, 1);

// ---------------------------------------------------------------- and the lever
[if_button,fairy_rings:enter_box]
if_close;
// THE QUEST IS CHECKED AGAIN HERE. The panel can only be opened by a ring and a ring checks, but
// a button trigger is reachable by anything that can send its id - and a teleport network is
// exactly what somebody would try to reach that way.
if (%fairy_farmers_quest < ^fairy_complete) {
    return;
}
// THE SIX BITS, NOT A SUM OF THE THREE DIALS. Computing a key here would be a second encoding
// of a thing the varp already encodes, and the two disagreed for a while - see the long note in
// fairy_rings.constant. The dials ARE the code.
def_int $code = getbit_range(%fairy_ring_dial, ^fairy_dial1_lo, ^fairy_dial3_hi);
switch_int($code) {
    case ^fairy_code_bks : @fairy_ring_travel(^fairy_to_zanaris);
    case ^fairy_code_akq : @fairy_ring_travel(^fairy_to_piscatoris);
    case ^fairy_code_als : @fairy_ring_travel(^fairy_to_mcgrubor);
    case ^fairy_code_dkr : @fairy_ring_travel(^fairy_to_edgeville);
    case ^fairy_code_cjr : @fairy_ring_travel(^fairy_to_sinclair);
    case ^fairy_code_aiq : @fairy_ring_travel(^fairy_to_portsarim);
    case default :
        // 58 of the 64 codes land here, and most of them are real RuneScape codes whose
        // destination is 2015-2025 content. Saying "nothing happens" is honest about that in a
        // way "invalid code" would not be.
        mes("The ring hums for a moment, and settles. Nothing happens.");
}

[label,fairy_ring_travel](coord $dest)
anim(human_fairy_vanish, 0);
p_telejump($dest);
anim(human_fairy_appear, 0);
p_delay(0);
