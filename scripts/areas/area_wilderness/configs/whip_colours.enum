// GENERATED by tools/genwhipcolours.py - do not hand-edit, regenerate.
//
// Two directions of the same pairing. The kit carries param=whip_colour and looks its result up in
// the first; a coloured whip carries the same number and looks its kit up in the second, so Revert
// hands back the kit that made it.

[whip_colour_result]
inputtype=int
outputtype=namedobj
// WITHOUT A DEFAULT A MISS RETURNS OBJ 0, which is a real item - so whip_colours.rs2's
// `if ($into = null)` guard, which it has, could never fire and a bad key would hand over whatever
// obj 0 happens to be. rs2check rule 17 is the one that catches this.
default=null
val=1,abyssal_whip_volcanic
val=2,abyssal_whip_frozen
val=3,abyssal_whip_venom
val=4,abyssal_whip_gilded
val=5,abyssal_whip_shadow
val=6,abyssal_whip_bloodbark
val=7,abyssal_whip_tempest
val=8,abyssal_whip_bone
val=9,abyssal_whip_gravedigger

[whip_colour_kit]
inputtype=int
outputtype=namedobj
default=null
val=1,whip_kit_volcanic
val=2,whip_kit_frozen
val=3,whip_kit_venom
val=4,whip_kit_gilded
val=5,whip_kit_shadow
val=6,whip_kit_bloodbark
val=7,whip_kit_tempest
val=8,whip_kit_bone
val=9,whip_kit_gravedigger
