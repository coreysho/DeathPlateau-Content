// THE NINE ABYSSAL WHIP RECOLOURS AND THEIR KITS.
//
// GENERATED by tools/genwhipcolours.py - do not hand-edit, regenerate.
//
// Each whip is a field-for-field copy of [abyssal_whip] in scripts/_unpack/377/all.obj with its
// recolour pairs in front of it, because that record carries the whip's attack bonuses, its
// special, its five animations and its hit sound - a colour must not quietly be a worse weapon
// than the whip it is a colour of. See the generator's header for where the three source colours
// come from and why there are three rather than two.

// ---------------------------------------------------------------- Volcanic
[abyssal_whip_volcanic]
name=Volcanic abyssal whip
desc=A weapon from the abyss, in volcanic colours.
recol1s=6210
recol1d=31169
model=obj_abyssal_whip
2dxof=-2
2dyof=56
2dzoom=840
2dxan=280
iop2=Wield
wearpos=righthand
manwear=obj_abyssal_whip_manwear,0
womanwear=obj_abyssal_whip_manwear,6
members=yes
cost=100001
category=weapon_whip
weight=1lb
param=stabattack,0
param=slashattack,82
param=crushattack,0
param=slashdefence,0
param=strengthbonus,82
param=slashattack_anim,osrs_whip_attack
param=defend_anim,osrs_whip_defend
param=slash_sound,whip
param=specwep,^true
param=sa_energy,500
param=walk_f_baseanim,osrs_whip_walk
param=walk_b_baseanim,osrs_whip_walk
param=walk_l_baseanim,osrs_whip_walk
param=walk_r_baseanim,osrs_whip_walk
param=running_baseanim,osrs_whip_run
param=ready_baseanim,osrs_human_ready
param=turnonspot_baseanim,osrs_human_turnonspot
tradeable=no
iop5=Revert
param=whip_from,abyssal_whip
param=whip_colour,1

// The kit. The whip's own inventory model in the colour it makes, so the shop window and the
// backpack both show what is being bought. Untradeable, which also means the Undertaker cannot buy
// it back - ~can_sell_obj refuses untradeables at every shop in this build.
[whip_kit_volcanic]
name=Volcanic whip kit
desc=Use it on an abyssal whip to recolour it. Revert takes it back off.
model=obj_abyssal_whip
recol1s=6210
recol1d=31169
2dxof=-2
2dyof=56
2dzoom=840
2dxan=280
cost=500
members=yes
tradeable=no
category=whip_kit
param=whip_colour,1

