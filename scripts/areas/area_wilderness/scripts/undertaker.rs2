// THE UNDERTAKER AND THE VETERAN (Corey, 2026-10-08) - the two ends of the Death token.
//
// The veteran stands on the Wilderness line north of Edgeville and tells you what the tokens are;
// the Undertaker stands by the Edgeville bank and takes them. Neither of them explains the drop
// rate, because a player who has just been handed one already knows where it came from.
//
// NEITHER OF THEM SAYS "DITCH". There is no ditch in this game and there was none in 2006 - it was
// dug in late 2007, with the trade limits. What marks the boundary here is a row of warning signs
// (wild_sign_civil1..4 along z 3506-3519, then wild_sign inside), and the line itself is nothing
// but a change of z. A character who tells you to mind a ditch is describing a different game.

// ---------------------------------------------------------------------------------------------
// The Undertaker
// ---------------------------------------------------------------------------------------------

[opnpc1,undertaker]
~chatnpc("<p,neutral>Business or burial?");
switch_int (~p_choice4("What have you got?", 1, "What are death tokens?", 2, "What does your outfit do?", 3, "Nothing, sorry.", 4)) {
    case 1 : ~openshop_activenpc;
    case 2 : @undertaker_explain;
    case 3 : @undertaker_outfit;
    case default : ~chatplayer("<p,neutral>Nothing, sorry.");
}

[opnpc4,undertaker] ~openshop_activenpc;

[label,undertaker_explain]
~chatplayer("<p,quiz>What are death tokens?");
~chatnpc("<p,neutral>What the Wilderness pays out, when somebody is working. Kill what your Slayer master sent you for, do it past the warning signs, and now and then you will find one on the body.");
~chatplayer("<p,quiz>And you want them because...?");
~chatnpc("<p,shifty>Because they are no use to anybody else. You cannot sell them, you cannot give them away, and I am the only man in Edgeville who will take them off you.");
if (inv_total(inv, death_token) > 0) {
    ~chatnpc("<p,happy>And you have some. Let me show you what they are worth.");
    ~openshop_activenpc;
}

// ---------------------------------------------------------------------------------------------
// What the outfit does, asked for on 13 October 2026
// ---------------------------------------------------------------------------------------------
// He sells seven things that are his own and the shop window says nothing about any of them, so a
// player buying a hat for two hundred tokens could not find out what it is for, that it cannot be
// protected, or that wearing it past the signs is the whole point of it.
//
// THE NUMBERS ARE READ OUT OF THE CONFIG, not written here. oc_cost is the token price - one shop,
// one multiplier at 1000 per mille, so an item's cost IS its price - and pvp_token_bounty is what a
// killer is paid for it. Both come off the hat, which carries the same pair as the coat, trousers,
// boots and cane; the cape is dearer and pays more, and he says so without naming its figures
// because one example is enough to explain a rule. Written this way so retuning the stake in
// configs/undertaker_outfit.obj cannot leave him lying about it.
[label,undertaker_outfit]
~chatplayer("<p,quiz>What does your outfit do?");
~chatnpc("<p,neutral>Nothing whatsoever.");
~chatplayer("<p,confused>Nothing?");
~chatnpc("<p,neutral>Not one thread of it will turn a blade or help you land one. The cane is a cane - hold it and you are holding a cane instead of a weapon. It is not armour. It is a uniform.");
switch_int (~p_choice3("Then why would anyone wear it?", 1, "What happens if I die in it?", 2, "I see.", 3)) {
    case 1 : @undertaker_outfit_why;
    case 2 : @undertaker_outfit_death;
    case default : ~chatplayer("<p,neutral>I see.");
}

[label,undertaker_outfit_why]
~chatplayer("<p,quiz>Then why would anyone wear it?");
~chatnpc("<p,shifty>Because nobody can buy it. You earned every token on it past the signs, and it cannot be sold, lent or handed to a friend - so a man in my coat has been somewhere, and everyone who sees him knows it.");
~chatnpc("<p,neutral>That is what you are paying for. Nothing else.");
@undertaker_outfit_death;

[label,undertaker_outfit_death]
// Read here rather than in [label,undertaker_outfit]: @ is a jump and a label has its own locals,
// so anything declared up there is out of scope by the time it is spoken down here.
def_int $price = oc_cost(undertaker_hat);
def_int $bounty = oc_param(undertaker_hat, pvp_token_bounty);
~chatplayer("<p,quiz>What happens if I die in it?");
// TWO BOXES, NOT ONE. As a single line this ran to five and the chatbox holds four, so it spilled
// onto a second page and put "The Undertaker" in the middle of the sentence - "...and no prayer
// The Undertaker protects it." The sim checks the phrase is contiguous, which is what catches that.
~chatnpc("<p,neutral>Past the warning signs? It is gone. Every piece of mine you have on you or in your pack, ruined where you fell.");
~chatnpc("<p,neutral>And you cannot keep it back. It is never one of the three things you hold on to, and no prayer protects it.");
~chatplayer("<p,shock>And I just paid for it.");
~chatnpc("<p,happy>You did. <tostring($price)> tokens for the hat, and the same for the coat, the trousers, the boots and the cane. The cape costs more.");
~chatnpc("<p,shifty>And whoever put you down comes to me with what is left of it. I pay them <tostring($bounty)> for the hat. A quarter, near enough, of what you gave me.");
~chatplayer("<p,quiz>So they profit and I lose.");
~chatnpc("<p,neutral>They profit a little. You lose four times as much. That is not an accident - it is why the tokens do not pile up, and why a man wearing my coat in the Wilderness means something.");
~chatnpc("<p,neutral>Die to something that is not a man up there and it is still ruined. A dragon has no use for my tokens, so nobody is paid at all.");
~chatplayer("<p,quiz>And south of the signs?");
~chatnpc("<p,neutral>Then it is only clothing, and clothing does not burn. Drop dead in Lumbridge and you can pick it back up.");

// ---------------------------------------------------------------------------------------------
// The veteran on the line
// ---------------------------------------------------------------------------------------------

[opnpc1,wilderness_veteran]
~chatnpc("<p,neutral>Going up, are you?");
switch_int (~p_choice3("What's up there?", 1, "What happened to your arm?", 2, "Just passing.", 3)) {
    case 1 : @veteran_up_there;
    case 2 : @veteran_arm;
    case default : ~chatplayer("<p,neutral>Just passing.");
}

[label,veteran_up_there]
~chatplayer("<p,quiz>What's up there?");
~chatnpc("<p,neutral>Everything your Slayer master has ever asked you to kill, and everyone who would rather you did not.");
~chatnpc("<p,neutral>Work a task up there and you will start finding death tokens. The Undertaker by the bank takes them - nobody else will.");
~chatplayer("<p,quiz>Is it worth it?");
~chatnpc("<p,shifty>The further in you go, the more of them you find. That is not a recommendation.");

// WHO TOOK IT. The arm used to be "one level further in than I had planned to" - true to the
// character and true to nothing else. Naming KrazyFaken makes it a thing that HAPPENED, to someone,
// at a place the player is about to walk into, and it costs the npc nothing to carry a name.
//
// He never says what KrazyFaken is - player, legend, rumour - because the veteran would not draw
// that line and neither should the script. Whoever the player decides he is, the warning lands.
[label,veteran_arm]
~chatplayer("<p,quiz>What happened to your arm?");
~chatnpc("<p,sad>KrazyFaken happened to it.");
~chatplayer("<p,quiz>Who?");
~chatnpc("<p,neutral>You will know when you meet him. Everyone does, once.");
~chatnpc("<p,sad>I had a task, a full pack, and about four steps of confidence left. He had patience, and a better idea of where I was than I did.");
~chatplayer("<p,quiz>And he took your arm?");
~chatnpc("<p,neutral>He took everything. The arm I lost on the way out - that is just the part I got to keep a story about.");
~chatplayer("<p,sad>I'm sorry.");
~chatnpc("<p,neutral>Do not be. I came back, which is more than most. Just mind the signs. There is nothing on that line but boards on sticks, and it is still the last safe step you take.");
