// THE ZAROS MAGE ARENA CAPE and the kit that makes it.
//
// WHAT IT IS: a repaint of an imbued god cape, bought from the Undertaker for Death tokens. The
// icon is Old School's own - obj 29448, the "Imbued mage arena cape", imported by
// tools/models/importosrs.py - and the worn half is this build's imbued cape model with its hue
// turned to Zaros purple by tools/genzaroscape.py. Old School has no worn Zaros cape to import:
// 29448 carries an inventory model and no wearpos at all, because there it is the unlock token.
//
// THREE RECORDS AND NOT ONE, which is the whole design decision here. An imbued god cape is not
// only a cape: it answers a god (configs/god_cape.enum, generated) and the Saradomin and Zamorak
// ones carry a God Wars protection param. One shared Zaros cape would have to either drop that -
// quietly taking a god spell and a protection off a player who bought a cosmetic - or carry all
// three, which hands out a protection nobody earned. So the kit makes the Zaros version OF THE
// CAPE IT WAS USED ON: same god, same params, same everything but the colour, and Revert gives
// back exactly the cape that went in. The three look identical in the bank; the examine text says
// which god each one is, which is the only way a player can tell and the only time they need to.
//
// THE SHELF SELLS STATUS, NOT POWER (death_token_shop.inv). These three change no number at all -
// they are field-for-field copies of the imbued capes in mage_arena_2.obj - and the kit is
// untradeable, so the colour cannot become a market.

[zaros_cape_kit]
name=Zaros cape kit
desc=Use it on an imbued god cape to repaint it. Revert takes it back off.
model=obj_imbued_zaros_cape
2dzoom=2140
2dxan=424
2dyan=528
2dxof=-1
2dyof=-2
weight=9g
cost=500
members=yes
tradeable=no
category=zaros_cape_kit

// ---------------------------------------------------------------- Saradomin
[imbued_zaros_cape_saradomin]
name=Imbued Zaros cape
desc=A Saradomin cape, repainted for the empty lord. Revert gives the Saradomin cape back.
model=obj_imbued_zaros_cape
manwear=obj_imbued_zaros_cape_manwear,0
womanwear=obj_imbued_zaros_cape_womanwear,0
wearpos=back
2dzoom=2140
2dxan=424
2dyan=528
2dxof=-1
2dyof=-2
weight=453g
cost=80000
members=yes
tradeable=no
iop2=Wear
iop5=Revert
category=armour_godcape
param=magicattack,15
param=stabdefence,3
param=slashdefence,3
param=crushdefence,3
param=magicdefence,15
param=gwd_prot_saradomin,1
param=zaros_cape_from,imbued_saradomin_cape

