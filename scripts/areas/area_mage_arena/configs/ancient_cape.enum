// Which imbued god cape becomes which ancient cape. The other direction is a param on the result
// (ancient_cape_from) rather than a second enum, because a remade cape knows what it was made from
// and a plain cape has to be looked up.
//
// WITHOUT default=null A MISS RETURNS OBJ 0, which is a real item - so the `if ($into = null)`
// guard in ancient_cape.rs2 could never fire and a fabric used on the wrong cape would hand over
// whatever obj 0 happens to be. rs2check rule 17 is the one that catches this.
[ancient_cape_result]
inputtype=obj
outputtype=namedobj
default=null
val=imbued_saradomin_cape,imbued_ancient_cape_saradomin
val=imbued_guthix_cape,imbued_ancient_cape_guthix
val=imbued_zamorak_cape,imbued_ancient_cape_zamorak
