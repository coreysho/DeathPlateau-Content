// REPAINTING AN IMBUED GOD CAPE FOR ZAROS, and taking it back off.
//
// The kit comes off the Undertaker's shelf for Death tokens, like the nine whip colours, and this
// is the same two clicks: use it on the cape, or Revert the cape. configs/zaros_cape.obj carries
// the three repaints and says why there are three; configs/zaros_cape.enum pairs them with the
// capes they are made from.
//
// ONE TRIGGER FOR THE USE, ON THE KIT ITSELF. [opheldu,X] is looked up on both halves of a use and
// the engine swaps last_item/last_useitem so last_item is always the half that carried the trigger
// (network/game/client/handler/OpHeldUHandler.ts), so this catches the click whichever way round
// the player does it. There is one kit, so it is named rather than given a category.
//
// THREE TRIGGERS FOR THE REVERT, and it has to be three. An obj has ONE category and a repaint's
// is armour_godcape, inherited from the cape it copies and what the god-cape code reads; a
// category=zaros_cape line would REPLACE that (the packer writes code 94 per category= line and
// ObjType.decode assigns), which would take the cape out of every check that looks for a god cape.
// whip_revert.rs2 has the same three paragraphs for the same reason, at nine lines instead of
// three.

[opheldu,zaros_cape_kit]
~zaros_cape_repaint(last_item, last_useitem, last_useslot);

// $kit is the kit, $cape what it was used on and $capeslot where that is in the pack.
[proc,zaros_cape_repaint](obj $kit, obj $cape, int $capeslot)
// ALREADY REPAINTED IS CHECKED FIRST. A repaint is a copy of the imbued cape's record, so it keeps
// category=armour_godcape and would pass the test below - and a second kit on it would be eaten
// with no message and no way to get it back. param=zaros_cape_from is the thing only a repaint
// carries.
if (oc_param($cape, zaros_cape_from) ! null) {
    mes("That cape has already been repainted. Revert it first.");
    return;
}
def_namedobj $into = enum(obj, namedobj, zaros_cape_result, $cape);
if ($into = null) {
    mes("The kit only works on an imbued god cape.");
    return;
}
inv_del(inv, $kit, 1);
inv_setslot(inv, $capeslot, $into, 1);
~objbox($into, "You repaint the cape in the colours of the empty lord.", 250, 0, 0);

// ---------------------------------------------------------------------------------------------
// Revert
// ---------------------------------------------------------------------------------------------
// Hands back BOTH the god cape and the kit, so the colour can be moved from cape to cape for
// nothing - the promise the whip kits, the graceful kits and ornament_kit.rs2 all make, and the
// reason none of them needs a confirmation box on the way in.
//
// TWO ITEMS ARRIVE WHERE ONE LEFT, so a full pack needs a free slot. Checked before anything is
// deleted: the alternative is a kit on the floor, and this is the one place a player would not be
// looking for it.

// WEARING ONE NEEDS ITS OWN TRIGGER, and finding that out is what the client harness is for. A god
// cape is not equipped by the generic Wear handler: god_gear.rs2 carries an [opheld2] per cape so
// it can refuse the cape of one god while the staff of another is in hand, and an obj with no
// trigger of its own simply does nothing when you click Wear. The six Max cape variants are hooked
// up the same way from skillcapes/scripts/max_cape_variants.rs2, into these same two labels.
[opheld2,imbued_zaros_cape_saradomin] @god_cape_equip(^god_saradomin);
[opheld2,imbued_zaros_cape_guthix] @god_cape_equip(^god_guthix);
[opheld2,imbued_zaros_cape_zamorak] @god_cape_equip(^god_zamorak);

[opheld5,imbued_zaros_cape_saradomin] @zaros_cape_revert;
[opheld5,imbued_zaros_cape_guthix] @zaros_cape_revert;
[opheld5,imbued_zaros_cape_zamorak] @zaros_cape_revert;

[label,zaros_cape_revert]
def_obj $item = last_item;
def_int $slot = last_slot;
def_namedobj $plain = oc_param($item, zaros_cape_from);
if ($plain = null) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You need a free inventory space to take the paint off.");
    return;
}
inv_setslot(inv, $slot, $plain, 1);
inv_add(inv, zaros_cape_kit, 1);
~objbox(zaros_cape_kit, "You strip the paint back off the cape.", 250, 0, 0);
