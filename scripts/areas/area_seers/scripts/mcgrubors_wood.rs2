[oploc1,_mcgrubor_gate]
if(coordz(coord) > coordz(loc_coord)) {
    mes("The gate is locked.");
    sound_synth(locked, 1, 0);
    return;
}
~chatnpc_specific("Forester", mcgruborforester, "<p,angry>Hey! You can't come through here!|This is private land!");
~mesbox("You will need to find another way in.");

[opnpc1,mcgruborforester] mes("He doesn't seem interested in talking to you.");

[oploc1,mcgruborlooserailing]
p_delay(0);
def_coord $start = movecoord(coord, 0, 0, calc(coordz(loc_coord) - coordz(coord))); 
def_int $mod = 1;
def_int $dir = ^exact_east;
if(~check_axis(coord, loc_coord, loc_angle) = true) {
    $mod = -1;
    $dir = ^exact_west;
}
mes("You squeeze through the loose railing.");
// THE RAILING'S OWN ANIMATION. This said "OSRS uses an anim not in 225, just guessing here"
// and guessed with human_into_sidestep - the twenty-cycle ENTRY into a sidestep, which every
// other caller in the build uses as an entry and follows with a sidestep walk. Played alone
// over a glide that runs to cycle 90 it left the player sliding forty cycles in their idle
// pose. railing_squeeze is in this cache, used by nothing, named for this obstacle, and at
// seq 3844 - the id a RuneLite plugin's list gives OSRS's own RAILING_SQUEEZE. It lasts 91
// cycles, so the 15->90 glide now sits inside it rather than running past the end.
~agility_exactmove(railing_squeeze, 0, 3, $start, movecoord($start, $mod, 0, 0), 15, 90, $dir, false);

[oploc1,_red_vine] @dig_red_vine;

[oplocu,_red_vine]
if(last_useitem = spade) {
    @dig_red_vine;
} else {
    ~displaymessage(^dm_default);
}

[label,dig_red_vine]
if(inv_total(inv, spade) = 0) {
    mes("You need a spade to dig up this vine.");
    return;
}
anim(human_dig, 0);
mes("You use your spade with the vine.");
p_delay(0);
mes("You dig in amoungst the vines.");
mes("You find a red vine worm.");
if(inv_freespace(inv) = 0 & inv_total(inv, red_vine_worm) = 0) {
    mes("You do not have enough space to carry this.");
    return;
}
inv_add(inv, red_vine_worm, 1);
