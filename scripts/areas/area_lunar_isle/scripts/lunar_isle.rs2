// Lunar Isle (2026-09-23): the map is 474's (configs/lunar_isle.loc has how it came in), and three
// things on it do something - the Astral altar, the bank, and the boat.
//
// 2026-09-28: Lunar Diplomacy arrived (scripts/quests/quest_lunar), and it is the quest the island
// was always waiting for. Two things changed here:
//   * the altar no longer hands out the Lunar spellbook for 65 Magic. The Moonclan's magic is the
//     Oneiromancer's to give, at the end of her quest, exactly as she says: "Simply pray at the
//     altar behind me to gain the knowledge." Before that the altar says what it says in 2006 -
//     "You don't have permission yet to use this altar."
//   * Lokar sails Rellekka to Pirates' Cove, which is where he sailed in 2006, and Captain Bentley
//     takes it from there. He will not take a passenger who has not started the quest: he has no
//     reason to, and the Moon Clan would kill anyone arriving without a Seal of Passage.

// ================================================================================ the Astral altar
//
// Craft-rune is runecrafting's own (category rc_altar; the astral row of runecraft.dbrow). Pray is
// the spellbook: once Lunar Diplomacy is done the altar trades Lunar for the normal book and back,
// as the Desert Treasure altar does with Ancients, and the Magic cape will offer Lunar too.
// Praying while already on Lunar always returns the standard book.

[oploc2,astral_altar]
// %lunar_unlocked as well as the quest: anyone who was given the book by the old 65-Magic altar
// before Lunar Diplomacy existed keeps the right to switch back and forth here.
if (%lunar_quest < ^lunar_complete & %lunar_unlocked ! true) {
    ~mesbox("You don't have permission yet to use this altar.|You have to earn the right to use the altar.");
    return;
}
def_int $choice = -1;
if (%spellbook = ^spellbook_lunar) {
    $choice = ~p_choice2("Return to the normal spellbook.", 1, "Leave the altar alone.", 2);
} else {
    $choice = ~p_choice2("Switch to the Lunar spellbook.", 1, "Leave the altar alone.", 2);
}
if ($choice ! 1) {
    return;
}
if_close;
mes("You kneel at the altar.");
anim(human_pray, 0);
sound_synth(magical_barrier, 1, 0);
p_delay(3);
if (%spellbook = ^spellbook_lunar) {
    ~set_spellbook(^spellbook_normal);
    mes("Lunar spells deactivated!");
    return;
}
~set_spellbook(^spellbook_lunar);
mes("Lunar spells activated!");

// ================================================================================ the bank

// 474's own booth: 377 never had Lunar Isle, so it came in as a loc of its own and not as a
// bankbooth. The Sirsal Banker stands beside it (quest_lunar/scripts/lunar_island.rs2 has his
// Seal of Passage check, which is the one thing the Moon Clan never waive).
[oploc1,lunar_bankbooth] @lunar_isle_bank;
[oploc2,lunar_bankbooth] @lunar_isle_bank;

[label,lunar_isle_bank]
if (~lunar_has_seal = false) {
    @lunar_no_seal;
}
@openbank;

// ================================================================================ the boat
//
// Lokar Searunner, on the Rellekka pier and at Pirates' Cove. Which end he is at is which side of
// z 3800 his coord falls; the island itself is served by Captain Bentley's ship, not by him.

[opnpc1,lokar_searunner]
if (coordz(coord) > ^lunar_isle_south_z) {
    ~chatnpc("<p,neutral>Had enough of the Cove? I'm sailing back to Rellekka whenever you're ready.");
    def_int $back = ~p_choice2("Take me to Rellekka.", 1, "Not yet.", 2);
    if ($back = 1) {
        @lunar_isle_sail;
    }
    return;
}
if (%lunar_quest = ^lunar_not_started) {
    @lunar_lokar_start;
}
~chatnpc("<p,neutral>Arrr! Yar! Ready to be on our way, yar?");
def_int $go = ~p_choice2("Take me to Pirates' Cove.", 1, "No thanks.", 2);
if ($go = 1) {
    @lunar_isle_sail;
}

[opnpc3,lokar_searunner]
if (coordz(coord) < ^lunar_isle_south_z & %lunar_quest = ^lunar_not_started) {
    @lunar_lokar_start;
}
@lunar_isle_sail;

[label,lunar_isle_sail]
if_close;
if (coordz(coord) > ^lunar_isle_south_z) {
    mes("You board the boat, and Lokar sets a course south.");
    p_delay(4);
    p_telejump(^lunar_isle_rellekka_pier);
    ~mesbox("The boat arrives at Rellekka.");
    return;
}
mes("You board the boat, and Lokar sets a course north.");
p_delay(4);
p_telejump(^lunar_cove_dock);
~mesbox("The boat arrives at Pirates' Cove.");
