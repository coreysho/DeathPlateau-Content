// Imported from the rev 474 cache by scratchpad/import474locs.py (import474map.import_loc).
// The states no map square places: the quest swaps them in. The statue has three (plain, loose
// after Brother Tranquility names it, moved aside once pulled), the ship's locker two, the tunnel's
// east stairs a repaired one, and the crate at Fenkenstrain's castle four.

[harmony_statue]
// rev 474 loc 22352 (import474map.py)
name=Statue
model=harmony_statue
model2=harmony_statue_2
length=2
active=yes
mapscene=7
ambient=20
contrast=20

[harmony_statue_moved]
// rev 474 loc 22354 (import474map.py)
name=Statue
model=harmony_statue_moved
model2=harmony_statue_moved_2
length=2
active=yes
mapscene=7
ambient=20
contrast=20
op1=Climb-down

