// ------------------------------------------------------------------ the open halves
// The three doors on the island, opened. A door in this build is two loc records - ~open_door
// deletes the closed one and adds its next_loc_stage a tile over, turned a quarter - and the open
// half is never placed on a map square, so a map import cannot see it. Written by hand on the same
// models, as Lunar Isle's and Keldagrim's are.
[harmony_monastery_door_open]
name=Door
model=harmony_monastery_door
active=yes
ambient=30
contrast=30
op1=Close
category=door_opened
param=next_loc_stage,harmony_monastery_door

