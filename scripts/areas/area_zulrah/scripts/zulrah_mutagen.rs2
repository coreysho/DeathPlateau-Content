// THE TWO MUTAGENS (2026-10-04). Zulrah's rarest drops: a tanzanite mutagen and a magma mutagen,
// each of which permanently recolours a serpentine helm.
//
// A MUTAGEN IS PAINT AND NOTHING ELSE. The tanzanite and magma helms have the serpentine helm's
// numbers exactly, take the same scales, degrade on the same clock and check the same way - which
// is why serpentine_helm.rs2 now works off the category and two params instead of naming its two
// records in six places. The mutated pairs got all of that for free.
//
// AND IT IS PERMANENT, which is the one thing here that cannot be undone. Old School does not let
// you take a mutagen back off, so this asks first - the only confirmation in either of these two
// files, and it earns it.
//
// EITHER STATE OF THE HELM takes a mutagen and the result keeps that state: charged in, charged
// out, with the scales untouched (they live in %serpentine_helm_charges, on the player, so the
// swap never touches them). That is what the second param slot is for.
//
// There is no [opheldu,] on the mutagens. The helm already carries one for its scales and
// OpHeldUHandler tries both halves of a use, so a second trigger here would be two scripts racing
// for the same click - serpentine_helm.rs2 hands the mutagen straight to this file instead.

[label,zulrah_mutagen_use](obj $mutagen, obj $helm, int $slot)
def_namedobj $into = null;
if ($helm = oc_param($mutagen, mutagen_from)) {
    $into = oc_param($mutagen, mutagen_into);
} else if ($helm = oc_param($mutagen, mutagen_from2)) {
    $into = oc_param($mutagen, mutagen_into2);
}
if ($into = null) {
    // An already-mutated helm is the likely wrong target: it is a serpentine helm in every way
    // that matters and a player may well not remember which one they are holding.
    if (oc_category($helm) = serpentine_helm) {
        mes("That helm has already been mutated.");
    } else {
        ~displaymessage(^dm_default);
    }
    return;
}
def_int $keep = %serpentine_helm_charges;
~mesbox("Using the <lowercase(oc_name($mutagen))> on your <lowercase(oc_name($helm))> cannot be undone.");
if (~p_choice2("Use the <lowercase(oc_name($mutagen))>.", 1, "Leave it alone.", 2) ! 1) {
    return;
}
if (inv_getobj(inv, $slot) ! $helm) {
    return;    // they moved it while the box was up
}
inv_del(inv, $mutagen, 1);
inv_setslot(inv, $slot, $into, 1);
// The scales are the player's varp and the swap does not touch them; this only says so, because
// "will I lose my charges" is the question anybody holding a 1,100-scale helm would be asking.
%serpentine_helm_charges = $keep;
~objbox($into, "The mutagen soaks into the helm. It is a <lowercase(oc_name($into))> now, and its scales are untouched.", 250, 0, 0);

// ---------------------------------------------------------------------------------------------
// Restore: putting a mutated helm back
// ---------------------------------------------------------------------------------------------
// THE OPTION WAS IN THE MENU AND NOTHING ANSWERED IT. All four mutated records carry iop4=Restore
// (it is Old School's own menu - the wiki lists "Wear, Check, Restore, Uncharge" charged and
// "Restore, Drop" uncharged) and the family answered iop2, iop3, iop5 and opheldu but had no
// [opheld4,...], so Restore was a click that did nothing at all. tools/silentobjops.py is how it
// was found and this is it answered.
//
// THE MUTAGEN DOES NOT COME BACK. "The mutagen is consumed upon use" - it is spent the moment it
// soaks in, so restoring puts the helm back to the serpentine record it came from and returns
// nothing. That makes Restore as one-way as the mutation was, which is why it asks first, in the
// same two lines the mutation asks in.
//
// THE SCALES ARE UNTOUCHED, for the same reason they survive the mutation: they are the player's
// varp and not the item's, so the swap cannot disturb them. It is said out loud because a player
// holding a full helm will not take that on trust.
[opheld4,_serpentine_helm]
def_int $slot = last_slot;
def_obj $helm = last_item;
def_namedobj $back = oc_param($helm, mutagen_restore);
if ($back = null) {
    // the plain serpentine helm, which has nothing to go back to and no Restore in its menu either
    ~displaymessage(^dm_default);
    return;
}
def_int $keep = %serpentine_helm_charges;
~mesbox("Restoring your <lowercase(oc_name($helm))> cannot be undone. The mutagen was used up when it went in and will not come back.");
if (~p_choice2("Restore it to a <lowercase(oc_name($back))>.", 1, "Leave it alone.", 2) ! 1) {
    return;
}
if (inv_getobj(inv, $slot) ! $helm) {
    return;    // they moved it while the box was up
}
inv_setslot(inv, $slot, $back, 1);
%serpentine_helm_charges = $keep;
~objbox($back, "The colour drains out of the helm. It is a <lowercase(oc_name($back))> again, and its scales are untouched.", 250, 0, 0);
