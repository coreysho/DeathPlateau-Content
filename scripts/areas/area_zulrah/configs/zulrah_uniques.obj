desc=Teleports you to Zul-Andra.
model=obj_zul_andra_teleport
2dzoom=842
2dxan=566
2dxof=1
weight=1g
cost=10
members=yes
stackable=yes
iop1=Teleport

// The pet item, wired like every other boss pet's (npc/configs/boss_pets.obj says what each line
// is for): category=bosspet for the shared Drop-to-put-down trigger, param=follower_id for what
// gets spawned, tradeable=no because a pet is not a commodity.
[bosspet_snakeling_item]
name=Pet Snakeling
desc=A slithering serpent spawn of Zulrah.
model=obj_bosspet_snakeling_item
2dzoom=4000
2dyan=67
2dyof=-89
weight=15g
members=yes
tradeable=no
category=bosspet
param=follower_id,bosspet_snakeling

// A NOTE FOR MAHOGANY LOGS. Zulrah drops 50 of them noted (8/249) and this cache ships mahogany
// logs with no note at all - teak has one, mahogany does not. Fifty unnoted logs are a pile nobody
// can pick up, so the note is made here rather than the drop being dropped.
[cert_mahogany_logs]
certlink=mahogany_logs
certtemplate=template_for_cert
