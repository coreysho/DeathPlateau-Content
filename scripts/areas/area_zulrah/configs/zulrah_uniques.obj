// ZULRAH'S UNIQUES and the things they make. Imported from a modern OSRS cache by
// tools/models/importosrs.py: objs 12927 (visage), 12929/12931 (the helm, uncharged and charged),
// 12932 (magic fang), 12900/12899 (the swamp trident, uncharged and charged), 12936 (jar of
// swamp), 12938 (Zul-andra teleport) and 12921 (the pet). Models are RE-ENCODED from OSRS model
// format into the 317-family format (tools/models/osrs2ob2.py), every one round-trip verified;
// wearpos/wearpos2 and the 2d cameras are the cache's. Names, examines, weights and values are the
// cache's too.
//
// The bonuses are the wiki's infoboxes, read as wikitext rather than as a rendered table
// (/w/Serpentine_helm, /w/Trident_of_the_Swamp, Sept 2026).
//
// The fourth unique, the uncut onyx, is already in this cache and already has a use: a chisel cuts
// it (skill_crafting/scripts/gem/uncut_gem.rs2). Nothing here is needed for it.
//
// NOTES: the tradeable ones get theirs, which is what OSRS gives them - the charged helm and the
// charged trident are untradeable in OSRS and get none, exactly as the charged blowpipe gets none.

[serpentine_visage]
name=Serpentine visage
desc=Maybe you could use a chisel to craft this into a helmet.
model=obj_serpentine_visage
2dzoom=716
2dxan=498
2dzan=1656
2dxof=-18
2dyof=7
weight=1000g
cost=105000
members=yes

[cert_serpentine_visage]
certlink=serpentine_visage
certtemplate=template_for_cert

// Uncharged: it "cannot be equipped if it is uncharged, except when it's fully degraded while
// equipped", so it has a wearpos - a helm that runs dry on your head stays there as this - and no
// Wear. "In its uncharged form it retains the negative bonuses, but loses all positive bonuses and
// passive effects", which is the -5/-5 below and nothing else.
[serpentine_helm_uncharged]
name=Serpentine helm (uncharged)
desc=Needs to be charged with Zulrah's scales.
model=obj_serpentine_helm_uncharged
manwear=obj_serpentine_helm_uncharged_manwear,0
womanwear=obj_serpentine_helm_uncharged_womanwear,0
manhead=obj_serpentine_helm_uncharged_manhead
womanhead=obj_serpentine_helm_uncharged_womanhead
wearpos=hat
wearpos2=head
2dzoom=700
2dyan=1724
2dxof=-1
2dyof=-1
weight=900g
cost=110000
members=yes
param=magicattack,-5
param=rangeattack,-5

[cert_serpentine_helm_uncharged]
certlink=serpentine_helm_uncharged
certtemplate=template_for_cert

// Charged. 75 Defence to wear (scripts/serpentine_helm.rs2), and while it holds scales it makes the
// wearer immune to poison and venom and helps them envenom what they hit.
[serpentine_helm]
name=Serpentine helm
desc=Protects the wearer from poison and venom, and helps envenom monsters.
model=obj_serpentine_helm
manwear=obj_serpentine_helm_manwear,0
womanwear=obj_serpentine_helm_womanwear,0
manhead=obj_serpentine_helm_manhead
womanhead=obj_serpentine_helm_womanhead
wearpos=hat
wearpos2=head
2dzoom=700
2dxan=215
2dyan=1724
2dyof=-17
weight=900g
cost=110000
members=yes
tradeable=no
iop2=Wear
iop3=Check
iop5=Uncharge
wearop1=Check
param=magicattack,-5
param=rangeattack,-5
param=stabdefence,52
param=slashdefence,55
param=crushdefence,58
param=rangedefence,50
param=strengthbonus,5

[magic_fang]
name=Magic fang
desc=This can be attached to a Trident of the Seas.
model=obj_magic_fang
2dzoom=1095
2dxan=579
2dyan=1832
2dxof=7
weight=300g
cost=102000
members=yes

[cert_magic_fang]
certlink=magic_fang
