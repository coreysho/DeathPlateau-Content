// THE TRIDENT OF THE SWAMP. The seas' trident with a magic fang chiselled into it at 59 Crafting,
// and it comes apart again. 78 Magic to wield, 2,500 charges, and a charge costs a death rune, a
// chaos rune, five fire runes and one of Zulrah's scales - the scale standing where the seas'
// trident wants ten coins. Its spell hits for floor(Magic / 3) - 2, two harder than the seas'
// throughout. Four ticks a cast and a reach of 7, like the seas'.
[trident_of_the_swamp]
name=Trident of the Swamp
desc=A toxic weapon from the deep.
model=obj_trident_of_the_swamp
manwear=obj_trident_of_the_swamp_manwear,0
womanwear=obj_trident_of_the_swamp_womanwear,0
wearpos=righthand
2dzoom=2421
2dxan=1549
2dyan=1818
2dzan=377
2dyof=9
weight=1814g
cost=78500
members=yes
tradeable=no
iop2=Wield
iop3=Check
iop4=Uncharge
iop5=Dismantle
wearop1=Check
category=weapon_powered_staff
param=magicattack,25
param=stabdefence,2
param=slashdefence,3
param=crushdefence,1
param=magicdefence,15
param=attackrate,4
param=ready_baseanim,human_staffready
param=crushattack_anim,human_stafforb_pummel
param=defend_anim,human_stafforb_block
param=crush_sound,staff_hit
param=attackrange,7

[trident_of_the_swamp_uncharged]
name=Uncharged toxic trident
desc=It needs to be charged with death runes, chaos runes, fire runes and Zulrah's scales.
model=obj_trident_of_the_swamp_uncharged
manwear=obj_trident_of_the_swamp_uncharged_manwear,0
womanwear=obj_trident_of_the_swamp_uncharged_womanwear,0
