// THE RUNS, in phase order. Kind and count.
[zulrah_run_kind]
inputtype=int
outputtype=int
default=0
// phase 0 (rotation 1 phase 1)
// 4 x venom barrage
val=0,^zulrah_act_venom
// phase 1 (rotation 1 phase 2)
// 2 x melee
val=1,^zulrah_act_melee
// phase 2 (rotation 1 phase 3)
// 4 x magic/ranged
val=2,^zulrah_act_mage
// phase 3 (rotation 1 phase 4)
// 5 x ranged
val=3,^zulrah_act_range
// 2 x snakeling orb
val=4,^zulrah_act_orb
// 2 x venom barrage
val=5,^zulrah_act_venom
