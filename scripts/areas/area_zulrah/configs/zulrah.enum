// ZULRAH'S FOUR ROTATIONS, and the pieces the fight reads them with. Transcribed from the wiki's
// own four rotation tables (oldschool.runescape.wiki/w/Zulrah/Strategies, Sept 2026), phase for
// phase, in the order the tables give them; the comment on each row is that table's own wording,
// so a row and its source can be read against each other without leaving the file.
//
// A ROTATION IS A LIST OF PHASES. A PHASE IS A PLACE, A COLOUR AND A LIST OF RUNS. A RUN is one
// thing done a number of times - "ranged 5 times", "2 snakeling orbs" - and every repetition of it
// costs one 3-tick beat, which is the unit the wiki's tables count in. The two "alternating" runs
// and the two "Jad" runs flip between two actions inside one run rather than needing five or ten
// rows each.
//
// ALL FOUR ROTATIONS ARE HERE IN FULL, not a subset, because a subset is the one thing that would
// make the fight unlearnable: Old School players read the second phase to tell which rotation they
// are on and pray the rest of it from memory, and half a table teaches the wrong thing. Once the
// runs above existed, forty-seven phases were data rather than work.
//
// The fight does not stop at the end of a rotation: "Zulrah will then continue on to the starting
// phase of the next rotation", so zulrah_fight.rs2 rolls a fresh rotation and carries on.


// Rotation number (1-4) -> the phase index it begins at, and how many phases it has.
[zulrah_rotation_start]
inputtype=int
outputtype=int
default=0
// rotation 1 "Crimson A"
val=1,0
// rotation 2 "Crimson B"
val=2,11
// rotation 3 "Serp"
val=3,22
// rotation 4 "Tanz"
val=4,34

[zulrah_rotation_length]
inputtype=int
outputtype=int
default=0
val=1,11
val=2,11
val=3,12
val=4,13

// Every phase of every rotation, end to end. The wiki's phase 1 is this list's entry 0.
[zulrah_phase_pos]
inputtype=int
outputtype=int
default=0
// --- rotation 1, "Crimson A" ---
// phase 1: 4 venom cloud barrages
val=0,^zulrah_p_middle
// phase 2: melee twice
val=1,^zulrah_p_middle
// phase 3: magic and/or ranged 4 times
val=2,^zulrah_p_middle
// phase 4: ranged 5 times, 2 snakeling orbs, 2 venom barrages, 2 snakeling orbs
val=3,^zulrah_p_south
// phase 5: melee twice
val=4,^zulrah_p_middle
// phase 6: magic and/or ranged 5 times
val=5,^zulrah_p_west
// phase 7: 3 venom barrages, 4 snakeling orbs
val=6,^zulrah_p_south
// phase 8: magic and/or ranged 5 times, then 5 alternating snakeling orbs and venom barrages
val=7,^zulrah_p_south
// phase 9: JAD PHASE: 10 alternating ranged and magic, starting with ranged; then 4 venom barrages
val=8,^zulrah_p_west
// phase 10: melee twice
val=9,^zulrah_p_middle
// phase 11: ranged 5 times, 4 venom barrages
val=10,^zulrah_p_middle
// --- rotation 2, "Crimson B" ---
// phase 1: 4 venom cloud barrages
val=11,^zulrah_p_middle
// phase 2: melee twice
val=12,^zulrah_p_middle
// phase 3: magic and/or ranged 4 times
val=13,^zulrah_p_middle
// phase 4: 3 venom barrages, 4 snakeling orbs
val=14,^zulrah_p_west
// phase 5: magic and/or ranged 5 times, 2 snakeling orbs, 2 venom barrages, 2 snakeling orbs
val=15,^zulrah_p_south
// phase 6: melee twice
val=16,^zulrah_p_middle
// phase 7: ranged 5 times
val=17,^zulrah_p_east
// phase 8: magic and/or ranged 5 times, then 5 alternating snakeling orbs and venom barrages
val=18,^zulrah_p_south
// phase 9: JAD PHASE: 10 alternating ranged and magic, starting with ranged; then 4 venom barrages
val=19,^zulrah_p_west
// phase 10: melee twice
val=20,^zulrah_p_middle
// phase 11: ranged 5 times, 4 venom barrages
val=21,^zulrah_p_middle
// --- rotation 3, "Serp" ---
// phase 1: 4 venom cloud barrages
val=22,^zulrah_p_middle
// phase 2: ranged 5 times, then 3 snakeling orbs
val=23,^zulrah_p_east
// phase 3: 6 alternating venom barrages and snakeling orbs, then melee twice
val=24,^zulrah_p_middle
// phase 4: magic and/or ranged 5 times
val=25,^zulrah_p_west
// phase 5: ranged 5 times
val=26,^zulrah_p_south
// phase 6: magic and/or ranged 5 times
val=27,^zulrah_p_east
// phase 7: 3 venom barrages, then 3 snakeling orbs
val=28,^zulrah_p_middle
// phase 8: ranged 5 times
val=29,^zulrah_p_west
// phase 9: magic and/or ranged 5 times, 2 venom barrages, 3 snakeling orbs
val=30,^zulrah_p_middle
// phase 10: JAD PHASE: 10 alternating magic and ranged, starting with magic
val=31,^zulrah_p_east
// phase 11: 4 snakeling orbs
val=32,^zulrah_p_middle
// phase 12: ranged 5 times, 4 venom barrages
val=33,^zulrah_p_middle
// --- rotation 4, "Tanz" ---
// phase 1: 4 venom cloud barrages
val=34,^zulrah_p_middle
// phase 2: 4 snakeling orbs, then magic and/or ranged 6 times
val=35,^zulrah_p_east
// phase 3: ranged 4 times, 2 venom barrages
val=36,^zulrah_p_south
// phase 4: 4 snakeling orbs, then magic and/or ranged 4 times
val=37,^zulrah_p_west
// phase 5: melee twice, 2 venom barrages
val=38,^zulrah_p_middle
// phase 6: ranged 4 times
val=39,^zulrah_p_east
// phase 7: 6 snakeling orbs, then 3 venom barrages
val=40,^zulrah_p_south
// phase 8: magic and/or ranged 5 times, then 4 snakeling orbs
val=41,^zulrah_p_west
// phase 9: ranged 4 times
val=42,^zulrah_p_middle
// phase 10: magic and/or ranged 4 times, 3 venom barrages
val=43,^zulrah_p_middle
// phase 11: JAD PHASE: 8 alternating magic and ranged, starting with magic
val=44,^zulrah_p_east
// phase 12: 4 snakeling orbs
val=45,^zulrah_p_middle
// phase 13: ranged 5 times, 4 venom barrages
val=46,^zulrah_p_middle

