// and the four places, as coordinates in the shrine template (zulrah.constant).
[zulrah_pos_coord]
inputtype=int
outputtype=coord
default=null
val=0,^zulrah_pos_middle
val=1,^zulrah_pos_south
val=2,^zulrah_pos_west
val=3,^zulrah_pos_east

// One dive animation per colour - OSRS seqs 5071/5072/5073, three 21-frame animations on
// the one frame group, which is what a per-colour animation looks like.
[zulrah_dive_anim]
inputtype=npc
outputtype=seq
default=zulrah_dive_serpentine
val=zulrah,zulrah_dive_serpentine
val=zulrah_magma,zulrah_dive_magma
val=zulrah_tanzanite,zulrah_dive_tanzanite
