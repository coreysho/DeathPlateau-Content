[zulrah_venom_spray]
// OSRS seq 5068 - THE VENOM SPRAY, and the barrage's own animation. It used to be OSRS 5069, the
// single spit, which is why the owner's "attack animations are a bit off" covered this one too: a
// barrage of nine clouds was thrown with the same two-tick flick the snake uses for one orb.
//
// 5068 and 5069 are the same frame group (5694, the mouth) and 5068's first fifteen frames ARE
// 5069, frame for frame: 1,7,3,8,5,6,11,9,4,14,2,15,13,10,12. Where 5069 stops, 5068 holds the
// jaws open and oscillates - 10,12,10,13,15,2,15,13 three times over - for six ticks in all.
// Rendered on Zulrah's mesh (tools/models/posepreview.py, npc 2042), 5069 is a rear-back and a
// lunge that closes, and 5068 is the same lunge with the mouth held wide and spraying. That is the
// difference between spitting one orb and filling a platform, and the cache has one of each.
priority=6
duplicatebehaviour=reset
frame1=anim_osrs_5694_1
delay1=5
frame2=anim_osrs_5694_7
delay2=5
frame3=anim_osrs_5694_3
delay3=5
frame4=anim_osrs_5694_8
delay4=5
