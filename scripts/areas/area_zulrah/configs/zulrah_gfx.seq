// The animations Zulrah's four graphics spin on. Converted from the OSRS cache by
// tools/models/animconvosrs.py; they play on their own base (base_osrs_*), not the 377 one,
// because the client only walk-merges two animations that share a base (ClientPlayer/NpcType
// patch).

[zulrah_orb_spin]
// OSRS seq 5358 - the orb's own spin, and the reason 1044 and 1047 read as things in flight:
// loops=8 is in the cache record, so the graphic keeps turning for the whole journey instead of
// freezing after 40 cycles. Both orbs use it, which is what OSRS does - 1044 and 1047 name the
// same seq.
loops=8
frame1=anim_osrs_4665_1
delay1=5
frame2=anim_osrs_4665_2
delay2=5
frame3=anim_osrs_4665_3
delay3=5
frame4=anim_osrs_4665_4
delay4=5
frame5=anim_osrs_4665_5
delay5=5
frame6=anim_osrs_4665_4
delay6=5
frame7=anim_osrs_4665_3
delay7=5
frame8=anim_osrs_4665_2
delay8=5

[zulrah_venom_cloud]
// THE CLOUD FORMS ONCE AND THEN LIES THERE, for the whole 25 ticks it burns.
//
// This is the mole mud cloud's own animation (all.seq), not OSRS 7759 - the mesh changed, and a
// frame list is bound to the skeleton it was made for. Frames 1-19 are the puff billowing up and
// settling. Frames 20-23, which are it dispersing, are deliberately left out: this graphic has to
// still be there in fourteen seconds, and an animation that ends is a MapSpotAnim the client
// takes away.
//
// After it has settled the last frame is simply held, in chunks, out to 750 cycles - the
// ^zulrah_cloud_ticks life. No loop, no restart, nothing to pulse. The previous version replayed
// a one-tick sequence 25 times and that is what the owner saw flickering.
//
// GENERATED by tools - if ^zulrah_cloud_ticks changes this has to be regenerated to match.
frame1=anim_25850
delay1=4
frame2=anim_25861
delay2=4
frame3=anim_25866
delay3=4
frame4=anim_25867
delay4=4
frame5=anim_25868
delay5=4
frame6=anim_25869
delay6=4
frame7=anim_25870
delay7=4
frame8=anim_25871
delay8=4
frame9=anim_25872
delay9=4
frame10=anim_25851
delay10=4
frame11=anim_25852
delay11=4
frame12=anim_25853
delay12=4
frame13=anim_25854
delay13=4
frame14=anim_25855
delay14=4
frame15=anim_25856
delay15=4
frame16=anim_25857
delay16=4
frame17=anim_25858
delay17=3
frame18=anim_25859
delay18=3
frame19=anim_25860
delay19=3
frame20=anim_25860
delay20=100
frame21=anim_25860
delay21=100
frame22=anim_25860
delay22=100
frame23=anim_25860
delay23=100
frame24=anim_25860
delay24=100
frame25=anim_25860
delay25=100
frame26=anim_25860
delay26=77
[zulrah_venom_orb_spin]
// OSRS seq 3151, the non-looping half of the orb rig (frame group 4665), at the cache's own delays.
// This is spotanim 1045's animation and it now does only 1045's job: the barrage's two orbs spin
// once on their way to the tile and then hold, which is what a non-looping projectile graphic does.
// It used to be re-timed to 30 cycles because the same seq was being drawn on the ground as a
// cloud; nothing is drawn on the ground with it any more, so it is back to the cache's timing.
frame1=anim_osrs_4665_1
delay1=5
frame2=anim_osrs_4665_2
delay2=5
frame3=anim_osrs_4665_3
delay3=5
frame4=anim_osrs_4665_4
delay4=5
frame5=anim_osrs_4665_5
delay5=5

[zulrah_magic_spin]
// OSRS seq 6648, at the cache's own delays. This one is a projectile and nothing else - it is
// never drawn on the ground - so there is no reason to re-time it: twelve cycles of flame and then
// the last frame holds for the rest of the flight.
frame1=anim_osrs_13182_1
delay1=2
frame2=anim_osrs_13182_2
delay2=2
frame3=anim_osrs_13182_3
delay3=2
frame4=anim_osrs_13182_4
delay4=2
frame5=anim_osrs_13182_5
delay5=2
frame6=anim_osrs_13182_6
delay6=2
