// The animations Zulrah's four graphics spin on. Converted from the OSRS cache by
// tools/models/animconvosrs.py; they play on their own base (base_osrs_*), not the 377 one,
// because the client only walk-merges two animations that share a base (ClientPlayer/NpcType
// patch).

[zulrah_orb_spin]
// OSRS seq 5358 - the orb's own spin, and the reason 1044 and 1047 read as things in flight:
// loops=8 is in the cache record, so the graphic keeps turning for the whole journey instead of
// freezing after 40 cycles. Both orbs use it, which is what OSRS does - 1044 and 1047 name the
// same seq.
loops=8
frame1=anim_osrs_4665_1
delay1=5
frame2=anim_osrs_4665_2
delay2=5
frame3=anim_osrs_4665_3
delay3=5
frame4=anim_osrs_4665_4
delay4=5
frame5=anim_osrs_4665_5
delay5=5
frame6=anim_osrs_4665_4
delay6=5
frame7=anim_osrs_4665_3
delay7=5
frame8=anim_osrs_4665_2
delay8=5

[zulrah_venom_cloud]
// ONE PLAY FOR THE WHOLE LIFE OF THE CLOUD, not one play per tick.
//
// The nine frames of OSRS 7759 total 30 client cycles - one 600ms tick exactly - and
// [queue,zulrah_cloud] used to re-play them every tick of the cloud's 25-tick life. That is 25
// restarts in fifteen seconds, and a graphic that restarts is a graphic that pulses. The client
// harness (javaclient/tools/clienttests/run_zulrahshots.py) counted the map spotanims on the
// floor frame by frame and watched them go 18, 15, 9, 18, 16, 9 - nine cloud centres, each
// holding two overlapping copies for part of every tick as the next play started over the top
// of the last. That is what the owner reports as flickering clouds.
//
// So the sequence now runs for the whole 25 ticks itself: the same nine frames, 25 times over,
// 225 frames and 750 cycles. It is played ONCE, on the tick the cloud lands, and the client
// animates it continuously from there. Written out rather than looped because a 377 seq has no
// loop that stops - and a MapSpotAnim that never ends is one the client never takes away.
//
// GENERATED. If ^zulrah_cloud_ticks changes, this has to be regenerated to match, or the cloud
// stops animating before it stops hurting.
frame1=anim_osrs_7759_1
delay1=4
frame2=anim_osrs_7759_6
delay2=4
frame3=anim_osrs_7759_2
delay3=3
frame4=anim_osrs_7759_7
delay4=3
