// The animations Zulrah's four graphics spin on. Converted from the OSRS cache by
// tools/models/animconvosrs.py; they play on their own base (base_osrs_*), not the 377 one,
// because the client only walk-merges two animations that share a base (ClientPlayer/NpcType
// patch).

[zulrah_orb_spin]
// OSRS seq 5358 - the orb's own spin, and the reason 1044 and 1047 read as things in flight:
// loops=8 is in the cache record, so the graphic keeps turning for the whole journey instead of
// freezing after 40 cycles. Both orbs use it, which is what OSRS does - 1044 and 1047 name the
// same seq.
loops=8
frame1=anim_osrs_4665_1
delay1=5
frame2=anim_osrs_4665_2
delay2=5
frame3=anim_osrs_4665_3
delay3=5
frame4=anim_osrs_4665_4
delay4=5
frame5=anim_osrs_4665_5
delay5=5
frame6=anim_osrs_4665_4
delay6=5
frame7=anim_osrs_4665_3
delay7=5
frame8=anim_osrs_4665_2
delay8=5

[zulrah_venom_cloud]
// OSRS seq 876 - the cloud's own billow, and the animation that belongs with the model 1043 names.
// It replaces OSRS 3151, which is the orb pair's spin and has moved to [zulrah_venom_orb_spin]
// below; the graphic and the animation were both the projectile's and both had to move.
//
// RE-TIMED TO EXACTLY ONE GAME TICK, and that re-timing is the one thing here that is not the
// cache's. The cache has nine frames at 5,5,5,5,4,4,4,4,4 - forty 20ms cycles. A MapSpotAnim plays
// its sequence once and the client then drops it (jagex2/dash3d/MapSpotAnim.method486), and
// zulrah_fight.rs2 re-plays this graphic on every tick a cloud is burning, so at forty cycles the
// last two frames would never be reached before the next play restarted it. Thirty cycles is one
// 600ms tick on the nose: the whole billow shows, once per tick, and one play ends on the boundary
// the next begins on so the cloud burns continuously instead of strobing.
frame1=anim_osrs_7759_1
delay1=4
frame2=anim_osrs_7759_6
delay2=4
frame3=anim_osrs_7759_2
delay3=3
frame4=anim_osrs_7759_7
delay4=3
frame5=anim_osrs_7759_3
delay5=3
frame6=anim_osrs_7759_8
delay6=3
frame7=anim_osrs_7759_4
delay7=3
frame8=anim_osrs_7759_9
delay8=4
frame9=anim_osrs_7759_5
// THIRTEEN, NOT THREE, AND THE EXTRA TEN ARE NEVER SEEN. The eight frames above total 27
// client cycles and this one ran for 3, making 30 exactly - one 600ms tick - because
// [queue,zulrah_cloud] re-plays the graphic every tick and the two were meant to butt up
// against each other perfectly.
//
// Perfectly is the problem. A MapSpotAnim that ends on the same cycle its replacement is due
// has no margin at all: the replacement arrives with the tick packet, and a packet that lands
// even one cycle late leaves the tile empty until it does. That is the flicker the owner sees,
// and it gets worse the further away they are playing from the server.
//
// Holding the last frame ten cycles longer costs nothing when the packet is on time - the
// replacement still arrives at cycle 30 and restarts the sequence, so frames 1-9 play exactly
// as before - and covers a fifth of a second of lateness when it is not.
delay9=13

[zulrah_venom_orb_spin]
// OSRS seq 3151, the non-looping half of the orb rig (frame group 4665), at the cache's own delays.
// This is spotanim 1045's animation and it now does only 1045's job: the barrage's two orbs spin
// once on their way to the tile and then hold, which is what a non-looping projectile graphic does.
// It used to be re-timed to 30 cycles because the same seq was being drawn on the ground as a
// cloud; nothing is drawn on the ground with it any more, so it is back to the cache's timing.
frame1=anim_osrs_4665_1
delay1=5
frame2=anim_osrs_4665_2
delay2=5
frame3=anim_osrs_4665_3
delay3=5
frame4=anim_osrs_4665_4
delay4=5
frame5=anim_osrs_4665_5
delay5=5

[zulrah_magic_spin]
// OSRS seq 6648, at the cache's own delays. This one is a projectile and nothing else - it is
// never drawn on the ground - so there is no reason to re-time it: twelve cycles of flame and then
// the last frame holds for the rest of the flight.
frame1=anim_osrs_13182_1
delay1=2
frame2=anim_osrs_13182_2
delay2=2
frame3=anim_osrs_13182_3
delay3=2
frame4=anim_osrs_13182_4
delay4=2
frame5=anim_osrs_13182_5
delay5=2
frame6=anim_osrs_13182_6
delay6=2
