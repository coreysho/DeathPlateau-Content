// ZULRAH (OSRS, 8 January 2015 - so it is ported as OSRS has it, not as 2006 would have had it).
// OSRS npcs imported by tools/models/importosrsnpc.py; models re-encoded by osrs2ob2.py with the
// npc recolours baked in. Stats and combat level are the cache's own six-value array (1/300/1/500/
// 300/300 and 725); the bonuses, speeds and caps below are the OSRS wiki's (oldschool.runescape.wiki
// /w/Zulrah, Sept 2026). Examines are ours - npc examine text is not in a modern OSRS cache.
//
// THREE RECORDS FOR ONE SNAKE. OSRS gives each colour its own npc id - 2042 green (serpentine),
// 2043 red (magma), 2044 blue (tanzanite) - and the colour is the whole fight: it is the only thing
// that tells you which prayer to use. Which id is which colour was not remembered, it was RENDERED:
// tools/models/posepreview.py on 2042/2043/2044 with their own ready animation, one picture each.
//
// The fight keeps one snake alive across all of them with npc_changetype_keepall, so its hitpoints,
// its hero points and everything the engine tracks survive a colour change - see
// scripts/zulrah_fight.rs2.
//
// WHICH ANIMATION IS WHICH was derived the way the Fight Cave round derived Jad's three, from frame
// counts, priorities and frame groups rather than from memory. Zulrah's rig is frame groups
// 5693-5698 and every seq on them has classic frames, so all of them convert:
//   5070   9 frames, no priority, group 5698          the idle - the npc record itself names it
//   5069  15 frames, 60 client cycles = 2 ticks,      the spit: the only one that fits a 3-tick
//         priority 6                                  attack speed, and the only attack-length one
//   5068  36 frames, priority 6, group 5694 with 5069 surfacing - the same group as the attack,
//                                                     which is the group the head and neck live in
//   5071/5072/5073  21 frames each, group 5696,       diving, ONE PER COLOUR (priorities 9/8/9) -
//                   priorities 9/8/9                  three of a kind on one group is what a
//                                                     per-colour animation looks like. They are NOT
//                                                     the same length: 105, 60 and 60 client cycles,
//                                                     which is 3.5, 2 and 2 ticks, and the fight
//                                                     waits each colour's own (zulrah_dive_ticks)
//   5804  49 frames, priority 10, group 5693          the death: priority 10 is the highest on the
//                                                     rig and nothing else on the model is that long
// 5806 (55 frames, 7.00 ticks) and 5807 (53, 6.67) are the rig's tail swipe, and THEY ARE NOW
// CONVERTED AND TOLD APART - configs/zulrah_tail.seq carries both and its header carries the
// evidence. The short version: their first 35 frames are identical (the rear-up and stare), then
// 5806 loops frames 18-26 twice over and 5807 breaks into frames 40-45, which appear nowhere else
// on the rig. A hold loop is a wait; a new excursion is a strike. 5807 is the swipe and it is what
// the magma record plays below.
//
// 5808 (9 frames, 1.00 tick, frame group 5697) is the rig's last seq and is still unidentified and
// unconverted. Nothing in the fight needs a one-tick animation, so nothing guesses at it.
//
// moverestrict=nomove on all three, like the Kraken: Zulrah surfaces in water, never walks, and is
// put where the rotation says with npc_tele.

[zulrah]
// OSRS npc 2042 - GREEN, "serpentine". Ranged, and weak to Magic.
name=Zulrah
desc=The Great One.
model1=npc_zulrah_1
size=5
readyanim=osrs_seq_5070
walkanim=osrs_seq_5070
op2=Attack
vislevel=725
moverestrict=nomove
wanderrange=0
respawnrate=50
attackrange=15
maxrange=25
attack=1
defence=300
strength=1
hitpoints=500
ranged=300
magic=300
param=attackrate,^zulrah_attackrate
// NO BLOCK ANIMATION, which is what Old School gives it - Zulrah never flinches. Without
// this it inherits defend_anim's default, human_unarmed_def, and a player animation off the
// human rig was being played on a model rigged to frame groups 5693-5698. Measured in a real
// 900-tick fight (Engine-TS tools/sim/zulrahvis.ts): human_unarmed_def was the single most
// played animation in the fight, 152 times, more than the spit - once for every hit landed
// on it. That is the reported "it disappears for a tick and comes back".
param=defend_anim,null
param=attack_anim,osrs_seq_5069
param=death_anim,osrs_seq_5804
// OSRS seq 5808, and the fight's last unnamed sequence - see zulrah.seq for what it is and why it
// cannot cut an attack short.
// "Damage at Zulrah is capped at 50" - the wiki, in so many words.
param=max_dealt,^zulrah_damage_cap
// The wiki's defensive block: stab, slash and crush 0, Ranged +50.
//
// AND THE MAGIC DEFENCE IS PER COLOUR, which is the whole reason the fight makes you carry two
// attack styles. It is the cache's own npc param 8, read off 2042/2043/2044 with tools/models'
// osrsnpc.py: -45 on the green, 0 on the red, +300 on the blue. -45 is also the number the wiki
// prints, which is what pins param 8 to magic defence and not to something else. The port gave all
// three the green form's -45, so magic killed the blue form as fast as the green one and there was
// nothing to switch for.
param=magicdefence,-45
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
// AND THE RANGED DEFENCE IS PER COLOUR TOO, which the port missed the same way it missed the magic
// defence: the wiki's infobox prints three Ranged defence figures beside the three Magic ones -
// +50 on the green, +300 on the red, 0 on the blue - and all three records here carried the green
// form's +50. So the blue form, the one the whole fight tells you to put the bow on, defended
// against Ranged exactly as well as the green form did, and the red form, which you are supposed to
// be unable to range at all, defended no better than either.
param=rangedefence,50
// Its own table, in scripts/zulrah_drops.rs2 - not the engine's death_drop.
param=death_drop,null

[zulrah_magma]
// OSRS npc 2043 - RED, "magma". A typeless tail swipe that Protect from Melee stops.
name=Zulrah
desc=The Great One.
model1=npc_zulrah_magma_1
size=5
readyanim=osrs_seq_5070
walkanim=osrs_seq_5070
op2=Attack
vislevel=725
moverestrict=nomove
wanderrange=0
respawnrate=50
attackrange=15
maxrange=25
attack=1
defence=300
strength=1
hitpoints=500
ranged=300
magic=300
param=attackrate,^zulrah_melee_attackrate
// NO BLOCK ANIMATION, which is what Old School gives it - Zulrah never flinches. Without
// this it inherits defend_anim's default, human_unarmed_def, and a player animation off the
// human rig was being played on a model rigged to frame groups 5693-5698. Measured in a real
// 900-tick fight (Engine-TS tools/sim/zulrahvis.ts): human_unarmed_def was the single most
// played animation in the fight, 152 times, more than the spit - once for every hit landed
// on it. That is the reported "it disappears for a tick and comes back".
param=defend_anim,null
// THE RED FORM DOES NOT SPIT, IT SWINGS ITS TAIL, and it now has the animation for it: OSRS seq
// 5807, converted this round (configs/zulrah_tail.seq says how it was told apart from 5806). Every
// form used to play the spit, 5069, which is why the tail swipe looked like a ranged attack with
// nothing coming out of it. attack_anim is still the param every other npc reads; the magma record
// is simply the one where it is not 5069.
// BISECT, NOT A FIX - see zulrah_fight.rs2 where the venom spray is played. Blue never blinks
// and blue only ever plays the spit; this makes red do the same. Put the tail swipe back the
// moment this has answered.
param=attack_anim,osrs_seq_5069
param=death_anim,osrs_seq_5804
// OSRS seq 5808, and the fight's last unnamed sequence - see zulrah.seq for what it is and why it
// cannot cut an attack short.
param=max_dealt,^zulrah_damage_cap
// OSRS npc 2043's own param 8: the red form is neither weak nor strong to magic.
param=magicdefence,0
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
// The wiki's infobox: +300 on the red form. You do not range the magma snake.
param=rangedefence,300
param=death_drop,null

[zulrah_tanzanite]
// OSRS npc 2044 - BLUE, "tanzanite". Magic and Ranged, and weak to Ranged.
name=Zulrah
desc=The Great One.
model1=npc_zulrah_tanzanite_1
size=5
readyanim=osrs_seq_5070
walkanim=osrs_seq_5070
op2=Attack
vislevel=725
moverestrict=nomove
wanderrange=0
respawnrate=50
attackrange=15
maxrange=25
attack=1
defence=300
strength=1
hitpoints=500
ranged=300
magic=300
param=attackrate,^zulrah_attackrate
// NO BLOCK ANIMATION, which is what Old School gives it - Zulrah never flinches. Without
// this it inherits defend_anim's default, human_unarmed_def, and a player animation off the
// human rig was being played on a model rigged to frame groups 5693-5698. Measured in a real
// 900-tick fight (Engine-TS tools/sim/zulrahvis.ts): human_unarmed_def was the single most
// played animation in the fight, 152 times, more than the spit - once for every hit landed
// on it. That is the reported "it disappears for a tick and comes back".
param=defend_anim,null
param=attack_anim,osrs_seq_5069
param=death_anim,osrs_seq_5804
// OSRS seq 5808, and the fight's last unnamed sequence - see zulrah.seq for what it is and why it
// cannot cut an attack short.
param=max_dealt,^zulrah_damage_cap
// OSRS npc 2044's own param 8: +300. The blue form is the one you put the bow away for - "Blue
// (Tanzanite): weak to Ranged" - and 300 is what makes a magic attack on it worthless.
param=magicdefence,300
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
// The wiki's infobox: 0 on the blue form. "Blue (Tanzanite): weak to Ranged" is this number and
// the +300 magic defence above it, together - one form you shoot, one form you cast at.
param=rangedefence,0
param=death_drop,null

// THE SNAKELINGS. "Despite their combat level of 90, they have extremely low defence and only 1
// Hitpoint", and they make "incredibly accurate attacks, which can hit up to 15". One hitpoint is
// the cache's own and the wiki's both, so that is what they have: anything that touches one kills
// it. The accuracy is the cache's too - 140 Attack on the melee one, 185 Magic on the mage - and
// the 15 is a max hit no cache and no param in this build can carry, so both snakelings attack
// through a proc of their own in zulrah_fight.rs2 rather than the engine's, which would derive
// something near forty out of that 138 Strength.
//
// They have no attack animation and no death animation IN THE CACHE: frame groups 5577 and 5578
// hold exactly one seq each, the walk and the idle, and nothing else on the rig. So they strike
// without one, which is what OSRS shows.

[zulrah_snakeling]
// OSRS npc 2045 - the melee one
name=Snakeling
desc=A spawn of the Great One.
model1=npc_zulrah_snakeling_1
size=1
readyanim=osrs_seq_1721
// No block animation either, for the same reason as the three forms above: readyanim is OSRS seq
// 1721 off the snakeling's own rig, and defend_anim's default is a human one.
param=defend_anim,null
walkanim=osrs_seq_2405
op2=Attack
vislevel=90
huntmode=aggressive_melee
huntrange=10
attackrange=1
maxrange=12
wanderrange=10
respawnrate=50
attack=140
defence=1
strength=138
hitpoints=1
ranged=1
magic=1
param=attackrate,^zulrah_snakeling_attackrate
param=death_drop,null

[zulrah_snakeling_mage]
// OSRS npc 2046 - the magic one
name=Snakeling
desc=A spawn of the Great One.
// The same mesh as the melee one - OSRS gives both npcs model 10415, and the importer writes
// a shared mesh once.
model1=npc_zulrah_snakeling_1
size=1
readyanim=osrs_seq_1721
// No block animation either, for the same reason as the three forms above: readyanim is OSRS seq
// 1721 off the snakeling's own rig, and defend_anim's default is a human one.
param=defend_anim,null
walkanim=osrs_seq_2405
op2=Attack
vislevel=90
huntmode=aggressive_ranged
huntrange=10
attackrange=8
maxrange=12
wanderrange=10
respawnrate=50
attack=1
defence=1
strength=1
hitpoints=1
ranged=1
magic=185
param=attackrate,^zulrah_snakeling_attackrate
param=death_drop,null

// THE PET. OSRS npc 2127, the green Snakeling, wired like every other boss pet in this tree
// (npc/configs/boss_pets.npc says what each line is for): size=1, vislevel=hide, timer=1 so
// [ai_timer,_bosspet] can teleport it back to its owner, category=bosspet for the shared ops and
// follower=yes for the minimap dot and the owner-only right-clicks.
//
// OSRS's Pet snakeling has THREE colours and a Metamorphosis right-click (npcs 2130/2131/2132).
// That is not wired here: a metamorphosis ring lives in the shared npc/configs/pet_forms.npc and
// npc/configs/pet_forms.constant, and three batteries count what is in those files. The Kraken pet
// took the same shape for the same reason. The other two colours are a later round's; this one is
// green, which is the form OSRS gives you.

[bosspet_snakeling]
name=Pet Snakeling
desc=A slithering serpent spawn of Zulrah.
model1=npc_bosspet_snakeling_1
head1=npc_bosspet_snakeling_head1
size=1
readyanim=osrs_seq_1721
walkanim=osrs_seq_2405
vislevel=hide
timer=1
op1=Pick-up
op3=Talk-to
category=bosspet
follower=yes
param=pet_item_id,bosspet_snakeling_item

// ZUL-ANDRA'S TWO PRIESTESSES. Both are OSRS's own records; their animations are OSRS's player
// skeleton, which animconvosrs.py puts on its own base (base_osrs_*) so the client never tries to
// walk-merge them with a 377 one.

[zulandra_high_priestess]
// OSRS npc 1616. She is the one you volunteer to.
name=High Priestess Zul-Harcinqa
desc=The high priestess of Zul-Andra.
model1=npc_zulandra_high_priestess_1
model2=npc_zulandra_high_priestess_2
model3=npc_zulandra_high_priestess_3
model4=npc_zulandra_high_priestess_4
head1=npc_zulandra_high_priestess_head1
size=1
readyanim=osrs_seq_7086
walkanim=osrs_seq_819
op1=Talk-to
vislevel=hide
wanderrange=0
moverestrict=nomove

[zulandra_priestess]
// OSRS npc 2033. She rows the boat, and she keeps what you died with.
name=Priestess Zul-Gwenwynig
desc=She rows sacrifices out to the shrine.
model1=npc_zulandra_priestess_1
head1=npc_zulandra_priestess_head1
size=1
readyanim=osrs_seq_808
walkanim=osrs_seq_819
op1=Talk-to
op3=Collect
vislevel=hide
wanderrange=0
moverestrict=nomove
