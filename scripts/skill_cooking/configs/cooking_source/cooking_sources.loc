// ---------------------------------------------------------------------------------------------
// The ranges that looked like ranges and were not
// ---------------------------------------------------------------------------------------------
// Reported from play as "Rimmington range isn't coded", and it was one of five. Cooking is driven
// entirely off category: [oplocu,_cooking_oven] in skill_cooking/scripts/cooking.rs2 fires for
// anything categorised cooking_oven and for nothing else. These five sat in all.loc with no
// category at all - each one named Range or Cooking range, each one describing itself as ideal for
// cooking on, each one placed on a real map square, and not one of them able to cook anything.
//
//   rimmington_poor_range   m46_50 (Rimmington), m47_57, m51_61
//   ahoy_range              m57_54
//   elf_village_range       m36_49 (Lletya)
//   fairy_range             m37_69 (Zanaris)
//   loc_14919               m36_57
//
// They are moved here rather than categorised where they lay, because this file is already where
// the cooking sources live - [range] and its three siblings were taken out of all.loc the same way.
//
// THREE OTHER UNCATEGORISED RANGES ARE LEFT ALONE, deliberately: carnilleanrange, newbierange and
// viking_seer_range each have their own [oplocu] handler in a quest or the tutorial, and a specific
// trigger beats a category one - so categorising them would change nothing except to suggest a
// second path that can never run.
bgsound=fire_crackling_small,5

[rimmington_poor_range]
name=Range
desc=Ideal for cooking on.
model=rimmington_poor_range
length=2
forceapproach=east
category=cooking_oven

[ahoy_range]
name=Cooking range
desc=An appliance for cooking with.
model=cooksquestrange
recol1s=3171
recol1d=3235
recol2s=8456
recol2d=7430
recol3s=17633
recol3d=10496
length=2
forceapproach=east
category=cooking_oven
bgsound=fire_crackling_small,3

[elf_village_range]
name=Cooking range
desc=I can cook here.
model=elf_village_range
length=2
forceapproach=east
category=cooking_oven
bgsound=cooking_loop_2,3

[fairy_range]
name=Range
desc=Ideal for cooking on.
model=fairy_range
length=2
forceapproach=east
category=cooking_oven
bgsound=fire_crackling_small,3

[loc_14919]
name=Range
desc=Smells of fried fish.
model=100_dave_stove
length=2
forceapproach=east
category=cooking_oven
bgsound=cooking_loop_1,3

// ---------------------------------------------------------------------------------------------
// The fires that looked like fires and were not
// ---------------------------------------------------------------------------------------------
// Reported from play as "Fire doesn't work in HAM Hideout - try using food on either fire in the
// dungeon", and it was the same fault as the five ranges above, one family along: cooking runs off
// category and nothing else, so a fire with no category cooks nothing. favour_campfire is the HAM
// Hideout's pair of fires AND six more around Burthorpe and the Troll Stronghold - eight placements
// that have never cooked anything. The other three here are twins of sources that DO cook, down to
// the name and description:
//
//   favour_campfire                        "Fire" / "Hot!"                        = [fire]
//   farm_fireplace                         "Fireplace" / "A grand old fireplace." = [grandfireplace]
//   qip_sheep_shearer_fireplacecookingpot  "Cooking pot" / "Something is cooking nicely here."
//                                                                                 = [fireplacecookingpot]
//   elid_clay_oven                         "Clay Oven" / "A clay oven for cooking with."
//
// Categorised in their own area or quest file rather than moved here, because that file already
// owns them: viking_house_fire and viking_longhall_fire (Rellekka), the four
// dwarf_keldagrim_*_fireplace types (each one describing itself as "a lovely place to cook meat"),
// 100_dave_stove and loc474_16893 ("Cooking range").
//
// LEFT ALONE, and listed so the next person does not have to find them again. Each is a placed loc
// that calls itself a fire, a fireplace or a range and cannot cook, and for each one the question
// is whether it should - which is a judgment about the place, not about this file:
//
//   roving_fire          "Looks to me like a quickly built fire."  Roving Elves' camp, 2290,3146
//   draynor_fireplace    "Oh for a marshmallow on a stick!"        x3
//   boardgames_fireplace "A nice and cosy fire."                   x4, the games room
//   loc_5631             "Glowing embers."                         x5
//   ogre_fire            "Hot stuff."                              Gu'Tanoth
//   viking_pig_roast     "Finger licking good!"                    Rellekka
//   osrsloc_26185        no description                            2820,3555
//   osrsloc_10660        no description                            x3

[favour_campfire]
category=cooking_fire
name=Fire
desc=Hot!
model=troll_stronghold_camp_fire
anim=fire
blockrange=no
ambient=75
contrast=75

