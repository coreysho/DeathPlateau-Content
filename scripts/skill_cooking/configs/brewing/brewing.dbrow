// The ten brews, in the cache's own order: drink n has its hops state at 4 + 6n, so Dwarven Stout
// is 4, Asgarnian Ale 10, and cider - the last index and the lowest level - is 58.

[brewing_dwarven_stout]
table=brewing
data=hops_state,4
data=ingredient,hammerstone_hops
data=ingredient_count,4
data=name,Dwarven Stout
data=level,19
data=experience,2150
