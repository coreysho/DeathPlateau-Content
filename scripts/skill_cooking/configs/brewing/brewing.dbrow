// Cider: four buckets of apple mush and the yeast, and nothing else. "This vat contains some apple
// mush" is the whole of state 58 - no water, no malt - and a failed batch is bad cider, not bad ale.
[brewing_cider]
table=brewing
data=hops_state,58
data=ingredient,apple_mush
