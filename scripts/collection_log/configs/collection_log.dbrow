// REWARDS. See collection_log.dbtable for the columns and collection_log.rs2
// (~collection_log_rewards) for how they are paid. Each needs its OWN bit, forever.
[collection_log_reward_first_item]
table=collection_log_reward
data=bit,0
data=threshold,1
data=message,"Your collection log is open for business - read it from the Collection Log page of your quest tab."

[collection_log_reward_complete]
table=collection_log_reward
data=bit,1
data=threshold,-1
data=message,"You have completed the entire collection log!"
