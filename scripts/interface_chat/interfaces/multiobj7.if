// SEVEN OBJECTS AND A TITLE - the multiobj family, stretched to the sandwich lady's tray.
// multiobj2/3/4 are the same file at two, three and four columns wide; nothing here is new
// except the arithmetic. 480 across the chatbox / 7 = a 67px column, so the labels sit UNDER
// the models rather than over them the way multiobj4 puts them, and a name too wide for 66px
// is passed in already broken over two lines. The widest of the seven foods is "Chocolate" at
// 60px in q8_full, measured with tools/ifrender.py, so two lines is always enough.

[com_0]
type=graphic
x=2
y=5
width=57
height=13
graphic=sworddecor,1

