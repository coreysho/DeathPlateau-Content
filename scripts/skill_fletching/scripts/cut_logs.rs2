// logs
[opheldu,_category_22]
switch_obj(last_useitem) {
    case knife : @fletch_log(last_item);
    case tinderbox : @light_logs_inv(last_slot);
    case default : ~displaymessage(^dm_default);
}

[label,fletch_log](obj $log)
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
db_find(fletch_bow_table:log, $log);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $obj1 = arrow_shaft;
def_int $shaft_count = db_getfield($data, fletch_bow_table:shafts, 0);
def_namedobj $obj2;
def_namedobj $obj3;
$obj2, $obj3 = db_getfield($data, fletch_bow_table:objchoices, 0);
// a crossbow stock too, from every log that makes one (474); teak and mahogany make nothing else
def_namedobj $stock;
def_int $stock_level;
def_int $stock_experience;
$stock, $stock_level, $stock_experience = db_getfield($data, fletch_bow_table:stock, 0);
def_string $wood = ~string_removeright(oc_name($log), 5);
// MAKE X / 10 / 5 / 1, which is what skillmulti is and multiobj is not. The two families look
// alike and are not: multiobjN asks WHICH and nothing else, so fletching answered "which" and then
// silently cut the entire inventory. skillmultiN asks which AND how many, and it is the same panel
// the spinning wheel and the glassblowing pipe already use.
//
// skillmulti1 has Make All / X / 5 / 1 and no 10, which is 474's own layout for the one-product
// panel; the two-, three- and four-product ones all carry X / 10 / 5 / 1.
def_namedobj $product;
def_int $requested = 0;
if ($obj2 = null) {
    $product, $requested = ~skillmulti1($stock);
} else if ($shaft_count < 1 & $stock = null) {
    $product, $requested = ~skillmulti2($obj2, $obj3);
} else if ($shaft_count < 1) {
    $product, $requested = ~skillmulti3($obj2, $obj3, $stock);
} else {
    $product, $requested = ~skillmulti4($obj1, $obj2, $obj3, $stock);
}
if ($product = null | $requested = null | $requested < 1) {
    return;
}
def_int $level = 1;
// How many products ONE log yields - 1 for a bow or a stock, fifteen for arrow shafts. Renamed
// from $count when the panel started returning a count of its own: the two numbers are different
// things and sharing a name between them is how a Make 5 turns into five times fifteen shafts.
def_int $per_log = 1;
def_int $fletching_experience = multiply($shaft_count, 5);
def_string $message;
// 2005-osrs, rsc
if ($product = $stock) {
    $level = $stock_level;
    $fletching_experience = $stock_experience;
    $message = "You carefully cut the wood into a crossbow stock.";
} else if ($product = $obj2) {
    $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:shortbow, 0);
    $message = "You carefully cut the wood into a shortbow.";
} else if ($product = $obj3) {
    $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:longbow, 0);
    $message = "You carefully cut the wood into a longbow.";
} else {
    $message = "You carefully cut the wood into <tostring($shaft_count)> arrow shafts.";
    $per_log = $shaft_count;
    $fletching_experience = multiply($shaft_count, 5);
}
if (stat(fletching) < $level) {
    // osrs has a level 1 fail message for arrow shafts but i doubt 2004 used it
    ~doubleobjbox($log, $product, "You need a Fletching level of at least <tostring($level)> to make <~add_article(lowercase(oc_name($product)))>.", 200);
    return;
}
// AS MANY AS WERE ASKED FOR, counted down through the chain - see bows.rs2, which had the same
// problem, and carries the long version of why the repeat is a queue and not p_delay: p_delay sets
// player.delayed, input is dropped while that is set, and the loop could not be stopped at all.
// The product chosen at the top is kept for the whole run, so this does not ask again per log.
@fletch_log_one($log, $product, $per_log, $fletching_experience, $message, $requested);

[label,fletch_log_one](obj $log, namedobj $product, int $per_log, int $experience, string $message, int $left)
if (%action_delay > map_clock) {
    return;
}
if ($left < 1) {
    return;
}
if (inv_total(inv, $log) < 1) {
    return;
}
inv_del(inv, $log, 1);
// human_fletching is the 377 cache's knife-in-hand animation, the one viking_olaf.rs2 and the max
// cape rack already cut with. Fletching had none at all: the log vanished and the shafts appeared.
anim(human_fletching, 0);
mes($message);
stat_advance(fletching, $experience);
inv_add(inv, $product, $per_log);
$left = calc($left - 1);
if ($left > 0 & inv_total(inv, $log) > 0) {
    %action_delay = calc(map_clock + 3);
    weakqueue*(fletch_cut_log, 3)($log, $product, $per_log, $experience, $message, $left);
}

[queue,fletch_cut_log](obj $log, namedobj $product, int $per_log, int $experience, string $message, int $left)
@fletch_log_one($log, $product, $per_log, $experience, $message, $left);
