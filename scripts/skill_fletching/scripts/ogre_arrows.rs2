[opheldu,wolf_bones]
switch_obj(last_useitem) {
    case chisel : @make_wolf_bone_tips;
    case default : ~displaymessage(^dm_default);
}

[opheldu,ogre_arrow_shaft]
switch_obj(last_useitem) {
    case feather : @make_ogre_headless_arrows;
    case default : ~displaymessage(^dm_default);
}

// A flighted ogre arrow takes a wolf bone tip, which is Big Chompy Bird Hunting, or the blunt
// flat end of a nail, which is Zogre Flesh Eaters - "instead of arrowtips, the brutal arrows use
// the blunt flat sides of nails, therefore being brutal". Seven metals, and the cache has had all
// seven arrows in it with no stats and no way of making one.
[opheldu,ogre_headless_arrow]
switch_obj(last_useitem) {
    case wolfbone_arrowheads : @make_ogre_arrows;
    case nails_bronze : @make_brutal_arrows(nails_bronze, zogre_brutal_bronze, 7, 14);
    case nails_iron : @make_brutal_arrows(nails_iron, zogre_brutal_iron, 18, 26);
    case nails : @make_brutal_arrows(nails, zogre_brutal_steel, 33, 51);
    case nails_black : @make_brutal_arrows(nails_black, zogre_brutal_black, 38, 65);
    case nails_mithril : @make_brutal_arrows(nails_mithril, zogre_brutal_mithril, 49, 75);
    case nails_adamant : @make_brutal_arrows(nails_adamant, zogre_brutal_adamant, 62, 102);
    case nails_rune : @make_brutal_arrows(nails_rune, zogre_brutal_rune, 77, 125);
    case default : ~displaymessage(^dm_default);
}

// Six at a time, with a hammer, and only once Sithik has taught you how - which is what
// thzfe_makebrutalarrow has been set for at the end of the quest with nothing reading it.
[label,make_brutal_arrows](obj $nails, namedobj $arrow, int $level, int $xp)
if (map_members = ^false) {
    mes(^mes_members_fletching);
    return;
}
if (%thzfe_makebrutalarrow = 0) {
    mes("You have no idea what to do with these.");
    return;
}
if (inv_total(inv, hammer) < 1) {
    mes("You need a hammer to hit the nails in with.");
    return;
}
if (stat(fletching) < $level) {
    ~mesbox("You need a Fletching level of <tostring($level)> to make <lowercase(oc_name($arrow))> arrows.");
    return;
}
def_int $count = min(inv_total(inv, ogre_headless_arrow), 6);
if (min(inv_total(inv, $nails), 6) < $count) {
    $count = min(inv_total(inv, $nails), 6);
}
inv_del(inv, ogre_headless_arrow, $count);
inv_del(inv, $nails, $count);
inv_add(inv, $arrow, $count);
if ($count > 1) {
    mes("You attach <tostring($count)> <lowercase(oc_name($nails))> to <tostring($count)> flighted ogre arrows.");
} else {
    mes("You attach a nail to a flighted ogre arrow.");
}
stat_advance(fletching, multiply($count, $xp));

[label,make_ogre_shafts]
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
if (%chompybird < 1) {
    // osrs
    mes("You're not sure what you would make with these logs.");
    return;
}
if (stat(fletching) < 5) {
    // osrs
    ~mesbox("You need a Fletching level of 5 to make those arrow shafts.");
    return;
}
def_int $shaft_count = ~random_range(2, 6); // osrs
inv_del(inv, achey_tree_logs, 1);
inv_add(inv, ogre_arrow_shaft, $shaft_count);

mes("You carefully cut the wood into <tostring($shaft_count)> arrow shafts.");

stat_advance(fletching, multiply($shaft_count, 18));


[label,make_wolf_bone_tips]
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
if (%chompybird < ^chompybird_started) {
    mes("You're not sure what you would make with these."); // osrs
    return;
}
if (stat(fletching) < 5) {
    ~mesbox("You need a Fletching level of 5 to do that.");
    return;
}
if (stat(crafting) < 5) {
    ~mesbox("You need a Crafting level of 5 to do that.");
    return;
}
def_int $tip_count = ~random_range(2, 6);
inv_del(inv, wolf_bones, 1);
inv_add(inv, wolfbone_arrowheads, $tip_count);

mes("You chisel <tostring($tip_count)> wolf bone arrow tips.");

stat_advance(fletching, multiply($tip_count, 25));
stat_advance(crafting, multiply($tip_count, 25));


[label,make_ogre_headless_arrows]
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
if (%chompybird < ^chompybird_started) {
    mes("You're not sure what you would make with these."); // osrs
    return;
}
if (stat(fletching) < 5) {
    ~mesbox("You need a Fletching level of 5 to do that.");
    return;
}
if(inv_total(inv, feather) < 4) {
    mes("You need at least 4 matching feathers to make an ogre arrow.");
    return;
}

def_int $feather_count = divide(min(inv_total(inv, feather), 24), 4);
def_int $shaft_count = min(inv_total(inv, ogre_arrow_shaft), 6);
def_int $arrow_count = min($feather_count, $shaft_count);

if(inv_itemspace(inv, ogre_headless_arrow, $arrow_count, inv_size(inv)) = false & (inv_total(inv, feather) > 4 | inv_total(inv, ogre_arrow_shaft) > 1)) {
    mes("You don't have enough inventory space to feather any shafts."); // OSRS
    return;
}

if ($arrow_count > 1) {
    mes("You attach <tostring(multiply($arrow_count, 4))> feathers to <tostring($arrow_count)> ogre arrow shafts.");
} else {
    mes("You attach four feathers to an ogre arrow shaft.");
}
inv_del(inv, feather, multiply($arrow_count, 4));
inv_del(inv, ogre_arrow_shaft, $arrow_count);

inv_add(inv, ogre_headless_arrow, $arrow_count);

stat_advance(fletching, multiply($arrow_count, 15));


[label,make_ogre_arrows]
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
if (%chompybird = ^chompybird_not_started) {
    mes("You're not sure what you would make with these."); // osrs
    return;
}
if (stat(fletching) < 5) {
    ~mesbox("You need a Fletching level of 5 to do that.");
    return;
}
def_int $headless_count = min(inv_total(inv, ogre_headless_arrow), 6);
def_int $tip_count = min(inv_total(inv, wolfbone_arrowheads), 6);
def_int $arrow_count = min($headless_count, $tip_count);

// no inv space check
if ($arrow_count > 1) {
    mes("You make <tostring($arrow_count)> ogre arrows.");
} else {
    mes("You make an ogre arrow.");
}

inv_del(inv, ogre_headless_arrow, $arrow_count);
inv_del(inv, wolfbone_arrowheads, $arrow_count);

inv_add(inv, ogre_arrow, $arrow_count);

// todo tbc exact mechanism
if (%chompybird ! ^chompybird_complete) {
    %chompybird_kills = setbit(%chompybird_kills, ^chompybird_varbit_made_arrows);
}

stat_advance(fletching, multiply($arrow_count, 10));
