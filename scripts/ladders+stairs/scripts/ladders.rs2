// Ship ladder (climb up)
[oploc1,shipladder_angled]
p_arrivedelay;
switch_int (loc_angle) {
	case 0 : p_teleport(movecoord(coord, 0, 1, 2));
	case 1 : p_teleport(movecoord(coord, 2, 1, 0));
	case 2 : p_teleport(movecoord(coord, 0, 1, -2));
	case 3 : p_teleport(movecoord(coord, -2, 1, 0));
}

// Ship ladder (climb down)
[oploc1,shipladder_top_angled]
p_arrivedelay;
switch_int (loc_angle) {
	case 0 : p_teleport(movecoord(coord, 0, -1, 2));
	case 1 : p_teleport(movecoord(coord, 2, -1, 0));
	case 2 : p_teleport(movecoord(coord, 0, -1, -2));
	case 3 : p_teleport(movecoord(coord, -2, -1, 0));
}

// Climb Up
[oploc1,ship_ladder]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

// Climb Down
[oploc1,ship_laddertop]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

// Climb-down op
[oploc1,wizards_tower_laddertop]
def_coord $coord = loc_coord();

// wizard tower level 0
if ($coord = 0_48_49_32_26) {
    ~climb_ladder(0_48_149_32_40, false);
} else {
    mes("unhandled ladder <~coord_tostring($coord)>");
}

[oploc1,laddertop]
p_arrivedelay;
switch_coord (loc_coord) {
    case 2_47_54_17_57 : ~climb_ladder(1_47_54_17_58, false); // black knights fortress ladder
    case 1_44_79_46_36 : ~climb_ladder(0_44_79_46_35, false); // Rat Catchers party mansion
    case default : ~climb_ladder(movecoord(coord(), 0, -1, 0), false);   
}

// Braindeath Island (Rum Deal): brewery floor <-> fever spider cellar, and brewery floor <-> the
// hopper room. Both had an op and no trigger.
[oploc1,deal_ladder_up]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

[oploc1,deal_laddertop]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

[oploc1,ladder]
p_arrivedelay;
switch_coord (loc_coord) {
    case 0_40_53_10_49 : @ladder_to_dwarf_remains; // Ladder to Dwarf Guard Tower
    case 0_44_79_46_36 : ~climb_ladder(1_44_79_46_35, true); // Rat Catchers party mansion
    case default : ~climb_ladder(movecoord(coord(), 0, 1, 0), true);
}

[oploc1,laddermiddle]
p_arrivedelay;
// One Small Favour: the Seers' first-floor ladder goes on up to the weathervane platform, which
// is on level 3 (there is only roof on level 2)
if (loc_coord = ^osf_seer_ladder) {
    @ladder_options(^osf_seer_roof, movecoord(coord(), 0, -1, 0));
}
@ladder_options(movecoord(coord(), 0, 1, 0), movecoord(coord(), 0, -1, 0));

[oploc2,laddermiddle]
p_arrivedelay;
if (loc_coord = ^osf_seer_ladder) {
    ~climb_ladder(^osf_seer_roof, true);
    return;
}
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

[oploc3,laddermiddle]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), true);

[oploc1,loc_1749]
p_arrivedelay;
switch_coord (loc_coord) {
    case 1_47_54_14_62 : 
        // https://youtu.be/6RNx7Sbut8A?t=423
        ~climb_ladder(movecoord(coord(), 0, -1, 0), false); // black knights
        ~black_knights_aggro(coord, 0_47_54_17_59); // checks from player coord! - osrs
        return;
}
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

[oploc1,loc_1750]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

[oploc1,loc_1754]
p_arrivedelay;
// THE CARNILLEAN CELLAR PUTS YOU IN THE ROCK. This ladder lands the player on their OWN tile plus
// 6400, which is right wherever the room below is at least as wide as the room above. The cellar
// under the Carnillean house is not: it is 2564-2570 x 9668-9672, and the ladder stands at
// 2570,3267 with 2571,3267 a perfectly ordinary tile beside it. Approach from the east, which is
// the side the front door is on, and the click lands you at 2571,9667 - solid rock, with nothing
// adjacent to walk to. Checked with opfrom: 2570,3268 and 2571,3268 land at 2570,9668 and work;
// 2571,3267 does not. The cellar has one landing tile, so name it rather than deriving it.
if (loc_coord = 0_40_51_10_3) {
    ~climb_ladder(0_40_151_10_4, false);
    return;
}
~climb_ladder(movecoord(coord(), 0, 0, 6400), false);

[oploc1,loc_1755] // mining guild ladder
def_coord $coord = loc_coord;
p_arrivedelay;
if(loc_coord = 0_50_149_22_52) { // Zanaris ladder (entrance room)
    ~climb_ladder(0_50_49_1_33, true);
    return;
}
~climb_ladder(movecoord(coord(), 0, 0, -6400), true);

// THE WILDERNESS DUNGEON LADDER, which is loc_1755's mirror and nothing more.
//
// wild_laddertop_dungeon sits at 3005,3963 with Climb-down and had no handler, so opsweep had
// it and climbladders listed it under CANNOT BE A VERTICAL LINK - correctly, because it is on
// level 0 and there is no level below to telejump to. The owner said where it goes: down to the
// dungeon.
//
// The destination needed no guessing. loc_1755 is placed at 3005,10363 - the SAME x and z,
// 6400 south, which is where this build keeps the underground - and its own handler a few lines
// up is ~climb_ladder(movecoord(coord(), 0, 0, -6400), true). This is that line with the sign
// turned round, so the two ends agree by construction rather than by my arithmetic.
//
// Not a category: _ladder_down means one level down on the same tile, which is what would have
// put a player inside the ground here. The dungeon ladders in this file are all explicit for
// the same reason - loc_1767 p_teleports into the Lava Maze, loc_1765 to the KBD lair.
[oploc1,wild_laddertop_dungeon]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 0, 6400), false);

[oploc1,loc_1757] 
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 0, -6400), true);

[oploc1,loc_1759]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 0, 6400), false);

[oploc1,loc_1765]
def_coord $coord = loc_coord();
p_arrivedelay;
switch_coord ($coord) {
    case 0_40_50_1_22 : ~climb_ladder(0_40_150_1_21, false); // Monk's Friend hidden ladder
    case 0_47_60_9_9 : p_teleport(0_47_160_61_15); // kdb entrance (yes its a p_teleport)
    case default : mes("unhandled ladder <~coord_tostring($coord)>");
}

