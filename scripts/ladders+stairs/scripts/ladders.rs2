// Ship ladder (climb up)
[oploc1,shipladder_angled]
p_arrivedelay;
switch_int (loc_angle) {
	case 0 : p_teleport(movecoord(coord, 0, 1, 2));
	case 1 : p_teleport(movecoord(coord, 2, 1, 0));
	case 2 : p_teleport(movecoord(coord, 0, 1, -2));
	case 3 : p_teleport(movecoord(coord, -2, 1, 0));
}

// Ship ladder (climb down)
[oploc1,shipladder_top_angled]
p_arrivedelay;
switch_int (loc_angle) {
	case 0 : p_teleport(movecoord(coord, 0, -1, 2));
	case 1 : p_teleport(movecoord(coord, 2, -1, 0));
	case 2 : p_teleport(movecoord(coord, 0, -1, -2));
	case 3 : p_teleport(movecoord(coord, -2, -1, 0));
}

// Climb Up
[oploc1,ship_ladder]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

// Climb Down
[oploc1,ship_laddertop]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

// Climb-down op
[oploc1,wizards_tower_laddertop]
def_coord $coord = loc_coord();

// wizard tower level 0
if ($coord = 0_48_49_32_26) {
    ~climb_ladder(0_48_149_32_40, false);
} else {
    mes("unhandled ladder <~coord_tostring($coord)>");
}

[oploc1,laddertop]
p_arrivedelay;
switch_coord (loc_coord) {
    case 2_47_54_17_57 : ~climb_ladder(1_47_54_17_58, false); // black knights fortress ladder
    case 1_44_79_46_36 : ~climb_ladder(0_44_79_46_35, false); // Rat Catchers party mansion
    case default : ~climb_ladder(movecoord(coord(), 0, -1, 0), false);   
}

// Braindeath Island (Rum Deal): brewery floor <-> fever spider cellar, and brewery floor <-> the
// hopper room. Both had an op and no trigger.
[oploc1,deal_ladder_up]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

[oploc1,deal_laddertop]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

[oploc1,ladder]
p_arrivedelay;
switch_coord (loc_coord) {
    case 0_40_53_10_49 : @ladder_to_dwarf_remains; // Ladder to Dwarf Guard Tower
    case 0_44_79_46_36 : ~climb_ladder(1_44_79_46_35, true); // Rat Catchers party mansion
    case default : ~climb_ladder(movecoord(coord(), 0, 1, 0), true);
}

[oploc1,laddermiddle]
p_arrivedelay;
// One Small Favour: the Seers' first-floor ladder goes on up to the weathervane platform, which
// is on level 3 (there is only roof on level 2)
if (loc_coord = ^osf_seer_ladder) {
    @ladder_options(^osf_seer_roof, movecoord(coord(), 0, -1, 0));
}
@ladder_options(movecoord(coord(), 0, 1, 0), movecoord(coord(), 0, -1, 0));

[oploc2,laddermiddle]
p_arrivedelay;
if (loc_coord = ^osf_seer_ladder) {
    ~climb_ladder(^osf_seer_roof, true);
    return;
}
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

[oploc3,laddermiddle]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, -1, 0), true);

[oploc1,loc_1749]
p_arrivedelay;
switch_coord (loc_coord) {
    case 1_47_54_14_62 : 
        // https://youtu.be/6RNx7Sbut8A?t=423
        ~climb_ladder(movecoord(coord(), 0, -1, 0), false); // black knights
        ~black_knights_aggro(coord, 0_47_54_17_59); // checks from player coord! - osrs
        return;
}
~climb_ladder(movecoord(coord(), 0, -1, 0), false);

[oploc1,loc_1750]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 1, 0), true);

[oploc1,loc_1754]
p_arrivedelay;
~climb_ladder(movecoord(coord(), 0, 0, 6400), false);

