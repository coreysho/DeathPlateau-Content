    case default : @unhandled_stairs(loc_coord);
}

[oploc2,fai_wiztower_spiralstairs_middle]
switch_coord (loc_coord) {
    case 1_48_49_31_23 : p_telejump(2_48_49_32_25); // Wizard's Tower - Level 1 -> Level 2
    case default : @unhandled_stairs(loc_coord);
}

[oploc3,fai_wiztower_spiralstairs_middle]
switch_coord (loc_coord) {
    case 1_48_49_31_23 : p_telejump(0_48_49_32_25); // Wizard's Tower - Level 1 -> Ground Floor
    case default : @unhandled_stairs(loc_coord);
}

[oploc1,fai_wiztower_spiralstairstop]
switch_coord (loc_coord) {
    case 2_48_49_32_24 : p_telejump(1_48_49_32_25); // Wizard's Tower - Level 2 -> Level 1
    case default : @unhandled_stairs(loc_coord);
}

[oploc1,wild6_spiralstairs]
// arrive delay?
switch_coord (loc_coord) {
    case default : @unhandled_stairs(loc_coord);
}

[oploc1,wild6_spiralstairs_middle]
// arrive delay?
switch_coord (loc_coord) {
    case default : @unhandled_stairs(loc_coord);
}

[oploc2,wild6_spiralstairs_middle]
// arrive delay?
switch_coord (loc_coord) {
    case default : @unhandled_stairs(loc_coord);
}

[oploc3,wild6_spiralstairs_middle]
// arrive delay?
switch_coord (loc_coord) {
    case default : @unhandled_stairs(loc_coord);
}

[oploc1,wild6_spiralstairstop]
// arrive delay?
switch_coord (loc_coord) {
    case default : @unhandled_stairs(loc_coord);
}
// ---

[label,stair_options](coord $up, coord $down)
def_int $option = ~p_choice2_header("Climb up the stairs.", 1, "Climb down the stairs.", 2, "Climb up or down the stairs?");
if ($option = 1) {
    p_telejump($up);
} else if ($option = 2) {
    p_telejump($down);
}

[label,unhandled_stairs](coord $coord)
mes("Unhandled stairs: <lc_debugname(loc_type)> at");
mes(~coord_tostring($coord)); // split line because its so hard to see the coord
