    case 1_55_55_17_32 : p_telejump(0_55_55_17_32); // west staircase - level 1
    case 1_55_55_39_32 : p_telejump(0_55_55_39_32); // east staircase - level 1
    case default : @unhandled_stairs(loc_coord);
}

// THE ECTOFUNTUS SLIME CAVERN (m57_154) is a four-level spiral pit and these are its three
// flights. Both halves of a flight stand on the SAME tile one level apart, and each flight is a 3x3
// block the cavern only lets you reach from one side - so the landing tile is on the far side from
// the approach, which is what sends you round the rim to find the next one. Level 3 is the rim you
// arrive on from the trapdoor and level 0 is the floor with the Pool of Slime, so in this cavern
// down the pit and down a level are the same direction.
//
// The order is 3689 (lvl 3) -> 3672 (lvl 2) -> 3684 (lvl 1) -> the slime, which is the wiki's "walk
// to the opposite side of the cavern and climb down the stairs, then repeat for the next two sets".
// Every landing below was taken from the cavern's own walkability rather than guessed: the other
// side of each flight is solid rock. The Ectofuntus itself is skill_prayer/scripts/ectofuntus.rs2.
[oploc1,ahoy_cavern_stairs]
p_arrivedelay;
switch_coord (loc_coord) {
