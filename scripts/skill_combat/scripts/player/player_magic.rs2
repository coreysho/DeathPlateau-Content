// to add a new combat spell:
// create a constant (^spellname) in ../configs/magic/spells.constant
// add it to the spell table in ../configs/magic/magic_combat_spells.dbrow
// create an apnpct trigger for it in this script

[label,player_magic_attack]
if (~npc_is_attackable = false) { // test: wormbrain's special mes shows before if you dont have enough runes to autocast a specific spell
    return;
}
// the twinflame staff turns the autocast into the target's elemental weakness (elemental_weakness.rs2)
def_dbrow $spell_data = ~get_spell_data(~twinflame_autocast_spell(%autocast_spell));
if (~check_spell_requirements($spell_data) = false) {
    if (%autocast_spell = db_getfield($spell_data, magic_spell_table:spell, 0)) { // matches osrs behavior
        ~player_autocast_reset;
    }
    return;
}
p_opnpct(db_getfield($spell_data, magic_spell_table:spellcom, 0));

// osrs's opnpct triggers are unused
[apnpct,magic:wind_strike]
if (%tutorial < ^tutorial_complete) {
 ~pvm_tutorial_spell(^wind_strike);
} else {
   ~pvm_default_spell(^wind_strike);
}

[apnpct,magic:water_strike] ~pvm_default_spell(^water_strike);
[apnpct,magic:earth_strike] ~pvm_default_spell(^earth_strike);
[apnpct,magic:fire_strike] ~pvm_default_spell(^fire_strike);
[apnpct,magic:wind_bolt] ~pvm_default_spell(^wind_bolt);
[apnpct,magic:water_bolt] ~pvm_default_spell(^water_bolt);
[apnpct,magic:earth_bolt] ~pvm_default_spell(^earth_bolt);
[apnpct,magic:fire_bolt] ~pvm_default_spell(^fire_bolt);
[apnpct,magic:wind_blast] ~pvm_default_spell(^wind_blast);
[apnpct,magic:water_blast] ~pvm_default_spell(^water_blast);
[apnpct,magic:earth_blast] ~pvm_default_spell(^earth_blast);
[apnpct,magic:fire_blast] ~pvm_default_spell(^fire_blast);
[apnpct,magic:wind_wave] ~pvm_default_spell(^wind_wave);
[apnpct,magic:water_wave] ~pvm_default_spell(^water_wave);
[apnpct,magic:earth_wave] ~pvm_default_spell(^earth_wave);
[apnpct,magic:fire_wave] ~pvm_default_spell(^fire_wave);
[apnpct,magic:curse] 
if (npc_type = ungadulu_good) {
   ~legends_spell_usage(^curse);
} else {
   ~pvm_default_spell(^curse);
}
[apnpct,magic:weaken]
if (npc_type = ungadulu_good) {
   ~legends_spell_usage(^weaken);
} else {
   ~pvm_default_spell(^weaken);
}
[apnpct,magic:confuse]
if (npc_type = ungadulu_good) {
   ~legends_spell_usage(^confuse);
} else {
   ~pvm_default_spell(^confuse);
}
[apnpct,magic:bind] ~pvm_default_spell(^bind);
[apnpct,magic:snare] ~pvm_default_spell(^snare);
[apnpct,magic:entangle] ~pvm_default_spell(^entangle);
[apnpct,magic:vulnerability] ~pvm_default_spell(^vulnerability);
[apnpct,magic:enfeeble] ~pvm_default_spell(^enfeeble);
[apnpct,magic:stun] ~pvm_default_spell(^stun);

[apnpct,magic:magic_dart] ~pvm_default_spell(^magic_dart);

[proc,pvm_default_spell](int $spell)
def_dbrow $spell_data = ~get_spell_data($spell);
if (~pvm_combat_spell_checks($spell_data) = false) {
    return;
}
if (~pvm_freeze_allowed($spell_data) = false) {
    return;
}
if (~pvm_debuff_allowed($spell_data) = false) {
    return;
}
def_int $duration = ~pvm_spell_cast($spell_data);
// Black mask (i) / slayer helmet (i): 15% to the accuracy roll and the max hit against monsters on
// the player's current slayer task. The PLAIN mask gives nothing here - only the imbued pair do,
// which is the whole reason to buy the imbue. ~black_mask_imbued_on_task is in
// skill_slayer/scripts/black_mask.rs2 and shares its "on task" test with the melee bonus.
def_int $mask_num = 1;
def_int $mask_div = 1;
if (~black_mask_imbued_on_task = true) {
    $mask_num = 23;
    $mask_div = 20;
}
// Elemental weakness and the twinflame staff: their percent onto the accuracy roll here, and onto
// the max hit below as a flat share of the spell's own (skill_combat/scripts/player/elemental_weakness.rs2).
def_int $bonus = ~spell_bonus_pct($spell);
// if player DOESNT splash. The Dagannoth Mother (quest_horror) makes every spell of the wrong element
// for her current colour splash (RS wiki, Horror from the Deep: "Using the wrong type of attack incurs
// splash damage"); ~dagmother_spell_splashes is false for everything else.
if (~dagmother_spell_splashes($spell) = false & ~player_npc_hit_roll_boosted(^magic_style, multiply($mask_num, add(100, $bonus)), multiply($mask_div, 100)) = true) {
    def_int $maxhit = ~magic_spell_maxhit($spell_data);
    def_int $base = $maxhit;
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    $maxhit = scale($mask_num, $mask_div, $maxhit);
    $maxhit = add($maxhit, scale($bonus, 100, $base));
    if((npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) & $spell ! ^magic_dart) {
        $maxhit = 0;
    }    
    ~pvm_spell_success($spell_data, $maxhit, $duration);
    ~pvm_stat_change_effect($spell_data);
    ~pvm_freeze_effect($spell_data);
} else {
    ~pvm_spell_fail($spell_data, $duration);
}
// Ancient Burst and Barrage spells also hit everything in the 3x3 around the primary target. Runs
// whether or not the primary connected - accuracy is rolled per target, so a splash on the main
// target does not cancel the rest.
if (db_getfieldcount($spell_data, magic_spell_table:aoe) > 0) {
    ~pvm_spell_aoe($spell_data, $duration);
}

// Area effect for the eight Ancient Burst/Barrage spells (aoe column in magic_spell_table; 1 = the
// 3x3 grid). Two passes, because the damage ops all act on the PRIMARY npc pointer and the search
// runs on the secondary one: collect the uids first with .npc_findnext, then switch the primary
// pointer onto each in turn. This is the same shape pvm_rune_thrownaxe_hunt/_hit already use for the
// rune thrownaxe special, including its multiway rule - the caster and the extra target must both be
// in a multiway zone, so in singles a barrage still only hits what you aimed at.
//
// Eight is the whole rest of a 3x3, so the cap can never truncate a legitimate target.
[proc,pvm_spell_aoe](dbrow $spell_data, int $duration)
def_npc_uid $primary = npc_uid;
def_coord $centre = npc_coord;
if (map_multiway(coord) = false) {
    return;
}
def_npc_uid $t1;
def_npc_uid $t2;
def_npc_uid $t3;
def_npc_uid $t4;
def_npc_uid $t5;
def_npc_uid $t6;
def_npc_uid $t7;
def_npc_uid $t8;
def_int $found = 0;
npc_huntall($centre, db_getfield($spell_data, magic_spell_table:aoe, 0), ^vis_lineofsight);
while (.npc_findnext = true) {
    if (.npc_uid ! $primary & $found < 8 & map_multiway(.npc_coord) = true) {
        switch_int ($found) {
            case 0 : $t1 = .npc_uid;
            case 1 : $t2 = .npc_uid;
            case 2 : $t3 = .npc_uid;
            case 3 : $t4 = .npc_uid;
            case 4 : $t5 = .npc_uid;
            case 5 : $t6 = .npc_uid;
            case 6 : $t7 = .npc_uid;
            case 7 : $t8 = .npc_uid;
        }
        $found = add($found, 1);
    }
}
~pvm_spell_aoe_target($spell_data, $t1, $duration);
~pvm_spell_aoe_target($spell_data, $t2, $duration);
~pvm_spell_aoe_target($spell_data, $t3, $duration);
~pvm_spell_aoe_target($spell_data, $t4, $duration);
~pvm_spell_aoe_target($spell_data, $t5, $duration);
~pvm_spell_aoe_target($spell_data, $t6, $duration);
~pvm_spell_aoe_target($spell_data, $t7, $duration);
~pvm_spell_aoe_target($spell_data, $t8, $duration);
// Put the pointer back on whatever the player actually aimed at. Tested rather than discarded -
// npc_finduid returns a boolean and a bare call warns - and false simply means the primary target
// died to the area damage, in which case there is nothing left to restore.
if (npc_finduid($primary) = false) {
    return;
}

[proc,pvm_spell_aoe_target](dbrow $spell_data, npc_uid $target, int $duration)
if ($target = null) {
    return;
}
if (npc_finduid($target) = false) {
    return;
}
if (~npc_is_attackable = false) {
    return;
}
// nothing splashed onto a corpse either, for the same reason as pvm_combat_spell_checks
if (npc_stat(hitpoints) = 0) {
    return;
}
// Its own lookup: this is a different proc from the single-target cast above, so that one's
// $mask_num is not in scope here. Each extra target of a multi-target spell rolls separately, so
// the mask has to be asked again for each of them anyway.
def_int $mask_num = 1;
def_int $mask_div = 1;
if (~black_mask_imbued_on_task = true) {
    $mask_num = 23;
    $mask_div = 20;
}
if (~player_npc_hit_roll_boosted(^magic_style, $mask_num, $mask_div) = true) {
    def_int $maxhit = scale($mask_num, $mask_div, ~magic_spell_maxhit($spell_data));
    ~pvm_spell_success($spell_data, $maxhit, $duration);
    ~pvm_stat_change_effect($spell_data);
    // an already-frozen secondary target is left alone rather than having its freeze refreshed
    if (%npc_stunned < map_clock) {
        ~pvm_freeze_effect($spell_data);
    }
} else {
    ~pvm_spell_fail($spell_data, $duration);
}

// NOTHING IS CAST AT A MONSTER THAT IS ALREADY DEAD. A monster's death takes several ticks from the
// hitsplat that caused it - the queued hit takes its hitpoints to 0, its death script runs the tick
// after, and that waits out an arrive delay of up to two ticks, plays the death animation and then
// delays one more before it despawns. A cast goes off every five, so the autocast queued up by the
// cast that killed it came due squarely inside that window, found the corpse still standing and a
// valid target, and cast at it: an animation, a projectile into thin air, and a set of runes gone.
// Reported from play as "attacking any npc with magic will sometimes result in your character using
// the spell again on the npc that's already died/dying".
//
// This test sits above the rune check, so nothing is spent and autocast is not dropped for a target
// that simply died. Melee (player_melee.rs2) and Ranged (player_ranged.rs2) have always had it; the
// magic path left it out for the slayer monsters that must be finished off with an item, but none
// of them sits at 0 hitpoints - a rockslug, gargoyle or desert lizard whose death script declines
// to kill it heals it back to 1 first (skill_slayer/scripts/npcs/), and the item that finishes it is
// an opnpcu and not a spell either way.
[proc,pvm_combat_spell_checks](dbrow $spell_data)(boolean)
if_close;
p_stopaction;
if (map_clock < %action_delay) {
    p_opnpct(db_getfield($spell_data, magic_spell_table:spellcom, 0));
    return(false);
}
if (npc_stat(hitpoints) = 0) {
    return(false);
}
if (~check_spell_requirements($spell_data) = false) {
    if (%autocast_spell = db_getfield($spell_data, magic_spell_table:spell, 0)) { // matches osrs behavior
        ~player_autocast_reset;
    }
    return(false);
}
if (~player_in_combat_check = false) {
    return(false);
}
// check if npc is attackable
if (~npc_is_attackable_opt = false) {
    return(false);
}
return(true);

[proc,pvm_freeze_allowed](dbrow $spell_data)(boolean)
// ONLY THE HOLD SPELLS - Bind, Snare, Entangle, the freeze spells that do no damage (maxhit -1) - are
// refused on a target already held or still immune. The ice spells freeze too, and used to be
// refused here as well: one landed hit and the next Rush or Barrage would not cast at all for the
// freeze plus five ticks, up to twenty-odd seconds. They are cast, and do their damage; it is only
// their freeze that skips a held or immune target, in pvm_freeze_effect.
if (db_getfield($spell_data, magic_spell_table:freeze_time, 0) > 0 & db_getfield($spell_data, magic_spell_table:maxhit, 0) < 1) {
    if (npc_category = castlewars_barricade) {
        switch_int (db_getfield($spell_data, magic_spell_table:spell, 0)) {
            case ^snare : mes("You can't snare that."); // osrs
            case ^bind : mes("You can't bind that."); // osrs 
            case ^entangle : mes("You can't entangle that."); // guess
        }
        return(false);
    }
    
    if (%npc_stunned > map_clock) {
        mes("Your target is already held by a magical force.");
        return(false);
    }
    // immune message existed in 2005 https://oldschool.runescape.wiki/w/Update:Magic_and_Wilderness_Updates
    if (calc(%npc_stunned + 5) > map_clock) {
        // osrs wiki trivia says that snare didnt have this? No proof though
        // ive found proof of bind and entangle having this in 2006: https://imgur.com/a/jBb1awE
        mes("Your target is currently immune to that spell.");
        return(false);
    }
}
return(true);

[proc,pvm_debuff_allowed](dbrow $spell_data)(boolean)
// check if npc can be stat reduced
def_stat $stat;
def_int $constant;
def_int $percent;
def_npc_stat $npc_stat;
def_int $i = 0;
def_int $spell = db_getfield($spell_data, magic_spell_table:spell, 0);
while ($i < db_getfieldcount($spell_data, magic_spell_table:stat_change) & $spell ! ^flames_of_zamorak & $spell ! ^claws_of_guthix & $spell ! ^saradomin_strike) {
    if (npc_category = castlewars_barricade) {
        mes("You can't weaken that.");
        return (false);
    }
    $stat, $constant, $percent = db_getfield($spell_data, magic_spell_table:stat_change, $i);
    $npc_stat = ~convert_stat_to_npc_stat($stat);
    if (npc_stat($npc_stat) < npc_basestat($npc_stat)) {
        // in osrs, confuse and weaken spell have a different message
        if (($npc_stat = strength & $spell = ^weaken) | ($npc_stat = attack & $spell = ^confuse)) {
            mes("Your foe's <lowercase(~stat_name($stat))> has already been lowered.");
        } else {
            mes("Your foe's <lowercase(~stat_name($stat))> has already been weakened.");
        }
        p_stopaction;
        return(false);
    }
    $i = add($i, 1);
}
return(true);

[proc,pvm_spell_cast](dbrow $spell_data)(int)
~barrows_combat_entry; // casting at a monster is combat too - Ahrim's degrades (degrade/scripts/degrade.rs2)
~delete_spell_runes($spell_data);
~give_spell_xp($spell_data);

// in osrs you can only defensive cast with a staff. Not sure if this is the case in 2004
// Might be confusing for players if they just so happen to have their non-magic weapon on defensive, and end up gaining def xp from manual casting.
// so maybe jagex did it this way?

// spell anim
anim(db_getfield($spell_data, magic_spell_table:anim, 0), 0);
// player spell visual effect
if (db_getfieldcount($spell_data, magic_spell_table:spotanim_origin) > 0) {
    spotanim_pl(db_getfield($spell_data, magic_spell_table:spotanim_origin, 0), 92, 0);
}
// shoot spell projectile
%action_delay = add(map_clock, ~magic_cast_delay);
def_int $duration = 0;
if (db_getfieldcount($spell_data, magic_spell_table:spotanim_proj) > 0) {
    $duration = ~npc_projectile(coord, npc_uid, db_getfield($spell_data, magic_spell_table:spotanim_proj, 0));
} else {
    $duration = ~spell_flight(npc_range(coord));
}
// OSRS:
// only continue fighting if auto cast is turned on
// freezes, and stat reductions dont continue ever, even if you have autocast enabled.
// crumble undead continues autocast for some reason
if (~player_autocast_enabled = true & db_getfield($spell_data, magic_spell_table:continue_by_autocast, 0) = true) {
    p_opnpct(db_getfield(~get_spell_data(~twinflame_autocast_spell(%autocast_spell)), magic_spell_table:spellcom, 0));
}
return($duration);


[proc,pvm_spell_success](dbrow $spell_data, int $maxhit, int $duration)
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
// Magic xp on its own, unless the staff tab is on its DEFENSIVE Spell box - %com_mode 4, which
// player_combat_stat turns into %damagestyle ^style_magic_defensive - and then the xp is split
// between Magic and Defence. This used to read ^style_melee_defensive, Focus, because the staff tab
// had no spell styles at all to read: defensive casting was something you got by standing on a
// MELEE style, which is not how Old School has it (oldschool.runescape.wiki/w/Defensive_casting).
// ~give_combat_experience already knew both splits - 2 Magic per point of damage, or 1.33 Magic and
// 1 Defence - so only the choice of style was missing.
def_int $damagestyle = ^style_magic_normal;
if (%damagestyle = ^style_magic_defensive) {
    $damagestyle = ^style_magic_defensive;
}
// play spell cast sound
if (db_getfieldcount($spell_data, magic_spell_table:sound_cast) > 0) {
    sound_synth(db_getfield($spell_data, magic_spell_table:sound_cast, 0), 0, 0);
}
// roll 0-maxhit
def_int $damage = randominc(min($maxhit, npc_param(max_dealt)));
if(npc_type = salarin_the_twisted) {
    def_int $spell = db_getfield($spell_data, magic_spell_table:spell, 0);
    // strike spells are the only way to damage salarin the twisted, the damage is fixed 9-12
    switch_int ($spell) {
        case ^wind_strike : $damage = 9;
        case ^water_strike : $damage = 10;
        case ^earth_strike : $damage = 11;
        case ^fire_strike : $damage = 12;
    }
}
else if (npc_type = chronozon) {
    def_int $spell = db_getfield($spell_data, magic_spell_table:spell, 0);
    ~chronozon_spell($spell);
}
// Horror from the Deep - Dagannoth Mother (quest_horror): during an elemental phase, only the
// matching elemental spell family damages her (e.g. horror_dagganoth_air only takes damage from
// wind strike/bolt/blast/wave); during her melee/ranged-weakness phases, magic is blocked entirely.
// ~dagmother_spell_matches_phase is defined in quests/quest_horror/scripts/quest_horror_combat.rs2.
else if (npc_type = horror_dagganoth_air | npc_type = horror_dagganoth_water | npc_type = horror_dagganoth_earth | npc_type = horror_dagganoth_fire | npc_type = horror_dagganoth_ranged | npc_type = horror_dagganoth_melee) {
    def_int $spell = db_getfield($spell_data, magic_spell_table:spell, 0);
    if (~dagmother_spell_matches_phase($spell) = false) {
        $damage = 0;
    }
}
// Desert Treasure - Kamil takes damage only from Fire spells, Fareed only from Water spells.
// ~dt_spell_damage_allowed is in quests/quest_deserttreasure/scripts/dt_combat.rs2 and returns true
// for every other npc, so this costs one proc call on spells cast at anything else.
else if (npc_type = icediamond_icewarrior | npc_type = firediamond_firewarrior) {
    if (~dt_spell_damage_allowed(db_getfield($spell_data, magic_spell_table:spell, 0)) = false) {
        $damage = 0;
    }
}
// if maxhit is defined then damage npc
~npc_retaliate(calc($duration / 30 + 1)); // delayed an extra tick in osrs
if ($maxhit ! null) {
    // damage npc
    //mes("Duration: <tostring($duration)>, Duration (ticks): <tostring(calc($duration / 30))>");
    ~npc_queue_hit($damage, min($maxhit, npc_param(max_dealt)), calc($duration / 30 + 1)); // delayed an extra tick in osrs
    // The twinflame staff's second hit: a tick after the first, 40% of it rounded down, no xp.
    if ($damage > 0 & ~twinflame_second_hit(db_getfield($spell_data, magic_spell_table:spell, 0)) = true) {
        npc_queue(2, divide(multiply(min($damage, npc_stat(hitpoints)), 40), 100), calc($duration / 30 + 2));
        spotanim_npc(db_getfield($spell_data, magic_spell_table:spotanim_target, 0), add($duration, 30));
    }
    // npcs didnt have a flinch anim until sept 20 2006. https://youtu.be/UFgMqvI4to8
    // https://oldschool.runescape.wiki/w/Update:Slug_Menace
    npc_anim(npc_param(defend_anim), $duration); // delay npc this tick
    // npc sound
    if (npc_param(defend_sound) ! null) {
        sound_synth(npc_param(defend_sound), 0, $duration); // delay 1 client tick for the hit queue
    }
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience($damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
    // Ahrim's Strength drain, which is magic-only, and Guthan's heal, which is not.
    ~barrows_set_hit_npc($damage_capped, ^magic_style);
    // Ancient Magicks - Blood spells heal the caster by heal_percent% of the damage dealt, Smoke spells
    // have a poison_chance in poison_chance (1-in-N) chance to poison for poison_severity. Data-driven
    // off the dbrow columns rather than a spell-name switch, so any future spell can opt in via data
    // alone. No existing hook did either of these before this pass - pvm_spell_success previously only
    // had bespoke hooks for splash-damage overrides (Salarin/Chronozon/Dagannoth Mother).
    //
    // TWO THINGS WERE WRONG WITH THE HEAL. It was taken from $damage_capped, the damage after it was
    // trimmed to the monster's remaining hitpoints - so the killing blow, the one cast in every fight
    // that matters most, healed nothing at all, and a Barrage finishing off four things healed for
    // four scraps. Old School heals off "the damage the spell would have done", low-health target or
    // not (oldschool.runescape.wiki/w/Blood_spells), which is the rolled $damage. And it landed at
    // the CAST rather than with the hit, seconds of flight time early. Both fixed: the roll, queued
    // to the tick the hitsplat lands on. stat_heal itself caps at the caster's base Hitpoints level.
    def_int $heal_percent = db_getfield($spell_data, magic_spell_table:heal_percent, 0);
    if ($heal_percent > 0 & $damage > 0) {
        // One less than the hit's own delay on purpose: a monster's queue runs a tick ahead of a
        // player's, so npc_queue(.., N) and queue(.., N) are a tick apart. N-1 puts the heal on the
        // same tick as the hitsplat.
        queue(blood_spell_heal, divide($duration, 30), divide(multiply($damage, $heal_percent), 100));
    }
    // poison_chance is "1 in N" (8 for all 4 smoke spells, per osrs wiki) - randominc(N-1) gives N
    // equally likely outcomes (0..N-1), so checking for exactly 0 is a clean 1-in-N roll.
    def_int $poison_chance = db_getfield($spell_data, magic_spell_table:poison_chance, 0);
    if ($poison_chance > 0 & $damage_capped > 0 & randominc(sub($poison_chance, 1)) = 0) {
        ~npc_poison_start(db_getfield($spell_data, magic_spell_table:poison_severity, 0));
    }
}
// spell visual
if (db_getfieldcount($spell_data, magic_spell_table:sound_hit) > 0) {
    sound_synth(db_getfield($spell_data, magic_spell_table:sound_hit, 0), 0, $duration);
}
spotanim_npc(db_getfield($spell_data, magic_spell_table:spotanim_target, 0), $duration);


// The Blood spells' share of the damage, landing on the tick the hitsplat does rather than on the
// tick of the cast. A queue and not a plain stat_heal at the cast site because the damage is queued
// too (~npc_queue_hit) - the heal and the splat it comes from belong on the same tick.
[queue,blood_spell_heal](int $amount)
stat_heal(hitpoints, $amount, 0);

[proc,pvm_spell_fail](dbrow $spell_data, int $duration)
// splash
if (db_getfieldcount($spell_data, magic_spell_table:sound_cast) > 0) {
    sound_synth(db_getfield($spell_data, magic_spell_table:sound_cast, 0), 0, 0);
}
sound_synth(spellfail, 1, $duration);
spotanim_npc(failedspell_impact, 92, $duration);
// splashing in osrs causes insta auto retal
~npc_retaliate(0);


[proc,pvm_stat_change_effect](dbrow $spell_data)
def_stat $stat;
def_int $constant;
def_int $percent;
def_npc_stat $npc_stat;
def_int $i = 0;
while ($i < db_getfieldcount($spell_data, magic_spell_table:stat_change)) {
    $stat, $constant, $percent = db_getfield($spell_data, magic_spell_table:stat_change, $i);
    $npc_stat = ~convert_stat_to_npc_stat($stat);
    if (npc_stat($npc_stat) >= npc_basestat($npc_stat)) {
        if ($constant > 0 & $percent > 0) {
            // if both positive assume statadd
            // nothing ever uses this but i guess if someone wants to add some heal spell or something
            npc_statadd($npc_stat, $constant, $percent);
        } else {
            npc_statsub($npc_stat, abs($constant), abs($percent)); // npc_statdrain?
        }
    }
    $i = add($i, 1);
}


[proc,pvm_freeze_effect](dbrow $spell_data)
// freeze npc if spell has freeze effect - unless it is held already, or in the five immune ticks after
// a hold, or a castle wars barricade. For the hold spells pvm_freeze_allowed has already checked; this
// is what keeps an ice spell's freeze from refreshing a freeze or ignoring the immunity.
if (db_getfield($spell_data, magic_spell_table:freeze_time, 0) > 0 & calc(%npc_stunned + 5) <= map_clock & npc_category ! castlewars_barricade) {
    %npc_stunned = calc(map_clock + db_getfield($spell_data, magic_spell_table:freeze_time, 0) + 1);
    npc_walktrigger(8, 0);
}

[ai_queue8,_]
if (map_clock < %npc_stunned) {
    npc_walk(npc_coord);
    npc_walktrigger(8, 0);
}

// Ancient Magicks - the ancient_magic spellbook interface (see its .if for the sprite mapping).
[apnpct,ancient_magic:ice_rush] ~pvm_default_spell(^ice_rush);
[apnpct,ancient_magic:ice_burst] ~pvm_default_spell(^ice_burst);
