[apnpct,ancient_magic:smoke_burst] ~pvm_default_spell(^smoke_burst);
[apnpct,ancient_magic:smoke_blitz] ~pvm_default_spell(^smoke_blitz);
[apnpct,ancient_magic:smoke_barrage] ~pvm_default_spell(^smoke_barrage);
[apnpct,ancient_magic:blood_rush] ~pvm_default_spell(^blood_rush);
[apnpct,ancient_magic:blood_burst] ~pvm_default_spell(^blood_burst);
[apnpct,ancient_magic:blood_blitz] ~pvm_default_spell(^blood_blitz);
