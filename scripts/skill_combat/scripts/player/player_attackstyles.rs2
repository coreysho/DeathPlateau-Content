[if_button,combat_claw:claw1] ~set_attackstyle(1);
[if_button,combat_claw:claw2] ~set_attackstyle(2);
[if_button,combat_claw:claw3] ~set_attackstyle(3);

// CHANGING STYLE DOES NOT STOP THE FIGHT. This used to call p_clearpendingaction, which is
// Player.clearPendingAction - it clears the interaction outright, so every tap of the combat tab
// dropped whatever you were attacking and you stood there until you clicked the target again.
// Old School lets you switch style mid-fight and keep swinging (it is how you move onto Defensive
// without losing a tick), so the interaction is left alone here; only the style changes.
//
// The p_finduid is still the gate it always was: no protected access means the player is busy, so
// the change is refused and the varp is resynced to undo the client's optimistic highlight. if_close
// stays too - the tab click closes a dialogue the same way any other sidebar click does.
[proc,set_attackstyle](int $style)
if_close;
if (p_finduid(uid) = true) {
    ~set_com_mode($style);
    ~player_combat_stat;
    // AND THAT IS HOW AUTOCAST IS TURNED OFF. The staff tab's two Spell boxes are combat styles of
    // their own now (auto_cast.rs2), so the old on/off toggle beside them is gone: in Old School you
    // stop autocasting by picking a style that is not a spell, exactly as picking Bash on a staff
    // does here. ~player_combat_stat has just recomputed %damagetype for the style chosen, so this
    // reads the NEW style, and the chosen spell itself is kept - clicking a Spell box resumes it.
    if (%damagetype ! ^magic_style) {
        %autocast_set = 0;
    }
    return;
}
%com_mode = %com_mode; // resync varp

// THE ONE PLACE %com_mode IS ALLOWED TO CHANGE. Old School remembers a style per weapon CATEGORY,
// not one style for the whole character - "Weapons that share a category (daggers, swords, bows
// etc.) will now remember the combat style that was used", from the 6th Birthday and QoL update of
// 21 February 2019 - so every write of %com_mode has to be mirrored into the slot of whatever is in
// the right hand, or ~update_weapon_category will restore the stale one the moment the tab is
// redrawn (and ~initalltabs redraws it after things as innocent as picking an autocast spell).
[proc,set_com_mode](int $style)
%com_mode = $style;
~attackstyle_memory_set(inv_getobj(worn, ^wearpos_rhand), $style);

// WHICH OF THE EIGHTEEN REMEMBERED STYLES BELONGS TO THIS WEAPON. The categories are the ones
// ~update_weapon_category switches on below, one slot per combat tab the player can be shown -
// flowers use the blunt tab and javelins and chinchompas use the thrown tab, so they share those
// slots, and anything with no tab of its own shares unarmed's.
//
// A members' weapon on a free world is deliberately read as unarmed here, because that is the tab
// ~update_weapon_category shows for it: the style it is set to is unarmed's, so that is where it
// has to be remembered.
[proc,attackstyle_memory_get](obj $weapon)(int)
if ($weapon = null | (map_members = ^false & oc_members($weapon) = true)) {
    return(%atkstyle_unarmed);
}
switch_category (oc_category($weapon)) {
    // melee
    case weapon_2h_sword : return(%atkstyle_2h_sword);
    case weapon_axe : return(%atkstyle_axe);
    case weapon_blunt, flowers : return(%atkstyle_blunt);
    case weapon_pickaxe : return(%atkstyle_pickaxe);
    case weapon_scythe : return(%atkstyle_scythe);
    case weapon_slash : return(%atkstyle_slash);
    case weapon_spear : return(%atkstyle_spear);
    case weapon_spiked : return(%atkstyle_spiked);
    case weapon_stab : return(%atkstyle_stab);
    case weapon_claws : return(%atkstyle_claws);
    case weapon_whip : return(%atkstyle_whip);
    // ranged
    case weapon_bow : return(%atkstyle_bow);
    case weapon_crossbow : return(%atkstyle_crossbow);
    case weapon_thrown, weapon_javelin : return(%atkstyle_thrown);
    case weapon_salamander : return(%atkstyle_salamander);
    // magic
    case weapon_staff : return(%atkstyle_staff);
    case weapon_powered_staff : return(%atkstyle_powered_staff);
    // unarmed everything else
    case default : return(%atkstyle_unarmed);
}

// The write half of ~attackstyle_memory_get - the same list, and it has to stay the same list.
[proc,attackstyle_memory_set](obj $weapon, int $style)
if ($weapon = null | (map_members = ^false & oc_members($weapon) = true)) {
    %atkstyle_unarmed = $style;
    return;
}
switch_category (oc_category($weapon)) {
    // melee
    case weapon_2h_sword : %atkstyle_2h_sword = $style;
    case weapon_axe : %atkstyle_axe = $style;
    case weapon_blunt, flowers : %atkstyle_blunt = $style;
    case weapon_pickaxe : %atkstyle_pickaxe = $style;
    case weapon_scythe : %atkstyle_scythe = $style;
    case weapon_slash : %atkstyle_slash = $style;
    case weapon_spear : %atkstyle_spear = $style;
    case weapon_spiked : %atkstyle_spiked = $style;
    case weapon_stab : %atkstyle_stab = $style;
    case weapon_claws : %atkstyle_claws = $style;
    case weapon_whip : %atkstyle_whip = $style;
    // ranged
    case weapon_bow : %atkstyle_bow = $style;
    case weapon_crossbow : %atkstyle_crossbow = $style;
    case weapon_thrown, weapon_javelin : %atkstyle_thrown = $style;
    case weapon_salamander : %atkstyle_salamander = $style;
    // magic
    case weapon_staff : %atkstyle_staff = $style;
    case weapon_powered_staff : %atkstyle_powered_staff = $style;
    // unarmed everything else
    case default : %atkstyle_unarmed = $style;
}

// updates the attack style tab depending on the
// weapon currently equipped or not by the player
[proc,update_weapon_category](obj $previous)
// dont remove attack style if the equipted item is not a weapon
if ($previous ! null & oc_wearpos($previous) ! ^wearpos_rhand) {
    return;
}
def_obj $obj = inv_getobj(worn, ^wearpos_rhand);
// THE STYLE THIS CATEGORY WAS LAST LEFT ON. Every write of %com_mode goes through ~set_com_mode, so
// the slot for the weapon already in hand holds exactly what %com_mode holds and this is a no-op
// except when the weapon has actually changed - which is what lets it sit here unconditionally and
// cover the login too (~initalltabs calls this proc with the worn weapon as its own "previous").
//
// This is what fixes bows coming up on Longrange: %com_mode is perm, so a melee Block (index 3)
// used to survive the logout and player_combat_stat.rs2's clamp trimmed it to the bow tab's last
// style, which is Longrange. Now the bow gets the bow's own remembered style, and a bow nobody has
// ever set a style on gets 0 - Accurate, the first option on the tab.
%com_mode = ~attackstyle_memory_get($obj);
if ($previous = null | $obj = null | oc_category($previous) ! oc_category($obj)) {
    // todo somehow confirm this
    // osrs keeps track of selected per category
    ~player_autocast_reset;
}
if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    if_settab(gnomeball, 0);
    return;
}
if ($obj = null | (map_members = ^false & oc_members($obj) = true)) {
    ~weapon_category_tab_attack_unarmed($obj);
    return;
}
switch_category (oc_category($obj)) {
    // melee
    case weapon_2h_sword : ~weapon_category_tab_attack(combat_heavysword:name, combat_heavysword, $obj, combat_heavysword:specbar_layer);
    case weapon_axe : ~weapon_category_tab_attack(combat_axe:name, combat_axe, $obj, combat_axe:specbar_layer);
    case weapon_blunt, flowers : ~weapon_category_tab_attack(combat_blunt:name, combat_blunt, $obj, combat_blunt:specbar_layer);
    case weapon_pickaxe : ~weapon_category_tab_attack(combat_pickaxe:name, combat_pickaxe, $obj, combat_pickaxe:specbar_layer);
    case weapon_scythe : ~weapon_category_tab_attack(combat_scythe:name, combat_scythe, $obj, null);
    case weapon_slash : ~weapon_category_tab_attack(combat_hacksword:name, combat_hacksword, $obj, combat_hacksword:specbar_layer);
    case weapon_spear : ~weapon_category_tab_attack(combat_spear:name, combat_spear, $obj, combat_spear:specbar_layer);
    case weapon_spiked : ~weapon_category_tab_attack(combat_spiked:name, combat_spiked, $obj, combat_spiked:specbar_layer);
    case weapon_stab : ~weapon_category_tab_attack(combat_stabsword:name, combat_stabsword, $obj, combat_stabsword:specbar_layer);
    case weapon_claws : ~weapon_category_tab_attack(combat_claw:name, combat_claw, $obj, combat_claw:specbar_layer);
    case weapon_whip : ~weapon_category_tab_attack(combat_whip:name, combat_whip, $obj, combat_whip:specbar_layer);
    // ranged
    case weapon_bow : ~weapon_category_tab_attack(combat_bow:name, combat_bow, $obj, combat_bow:specbar_layer);
    case weapon_crossbow : ~weapon_category_tab_attack(combat_crossbow:name, combat_crossbow, $obj, combat_crossbow:specbar_layer);
    case weapon_thrown, weapon_javelin :
        // a chinchompa is a thrown weapon with 474's tab of its own: Short, Medium and Long fuse
        if ($obj = chinchompa | $obj = red_chinchompa) {
            ~weapon_category_tab_attack(combat_chinchompa:name, combat_chinchompa, $obj, combat_chinchompa:specbar_layer);
        } else {
            ~weapon_category_tab_attack(combat_thrown:name, combat_thrown, $obj, combat_thrown:specbar_layer);
        }
    case weapon_salamander : ~weapon_category_tab_attack(combat_salamander:name, combat_salamander, $obj, combat_salamander:specbar_layer);
    // magic
    case weapon_staff : ~weapon_category_tab_attack(combat_staff_2:name, combat_staff_2, $obj, null);
    case weapon_powered_staff : ~weapon_category_tab_attack(combat_powered_staff:name, combat_powered_staff, $obj, null);
    // unarmed everything else
    case default : ~weapon_category_tab_attack_unarmed($obj);
}

[proc,weapon_category_tab_attack](component $component2, interface $interface, obj $obj, component $specbar_layer)
// 474's combat tabs have no weapon preview: the weapon is named in the title instead.
if_settext($component2, "<oc_name($obj)>");
if ($specbar_layer ! null) {
    if (oc_param($obj, specwep) = ^true) {
        if_sethide($specbar_layer, false);
    } else {
        if_sethide($specbar_layer, true);
    }
}
if_settab($interface, 0);

// sends the unarmed interface tab
[proc,weapon_category_tab_attack_unarmed](obj $obj)
// yes this is actually "unarmed" between beta and 2005-ish.
if ($obj = null | (map_members = ^false & oc_members($obj) = true)) {
    if_settext(combat_unarmed:name, "unarmed");
} else {
    if (oc_param($obj, specwep) = ^true) {
        if_sethide(combat_unarmed:specbar_layer, false);
    } else {
        if_sethide(combat_unarmed:specbar_layer, true);
    }
    if_settext(combat_unarmed:name, "<oc_name($obj)>"); // gnomeball uses this
}
if_settab(combat_unarmed, 0);

[proc,.update_weapon_category](obj $previous)
// dont remove attack style if the equipted item is not a weapon
if ($previous ! null & oc_wearpos($previous) ! ^wearpos_rhand) {
    return;
}
def_obj $obj = .inv_getobj(worn, ^wearpos_rhand);
// As above. There is no .set_com_mode to go with it because nothing on the secondary-player path
// ever writes .%com_mode - it only reads it - so the slots are always whatever the player's own
// ~set_com_mode last put there, and restoring from them here is the whole job.
.%com_mode = ~.attackstyle_memory_get($obj);
if ($previous = null | $obj = null | oc_category($previous) ! oc_category($obj)) {
    // todo somehow confirm this
    // osrs keeps track of selected per category
    ~.player_autocast_reset;
}
if (~.inzone_coord_pair_table(gnomeball_zones, .coord) = true) {
    .if_settab(gnomeball, 0);
    return;
}
if ($obj = null | (map_members = ^false & oc_members($obj) = true)) {
    ~.weapon_category_tab_attack_unarmed($obj);
    return;
}
switch_category (oc_category($obj)) {
    // melee
    case weapon_2h_sword : ~.weapon_category_tab_attack(combat_heavysword:name, combat_heavysword, $obj, combat_heavysword:specbar_layer);
    case weapon_axe : ~.weapon_category_tab_attack(combat_axe:name, combat_axe, $obj, combat_axe:specbar_layer);
    case weapon_blunt, flowers : ~.weapon_category_tab_attack(combat_blunt:name, combat_blunt, $obj, combat_blunt:specbar_layer);
    case weapon_pickaxe : ~.weapon_category_tab_attack(combat_pickaxe:name, combat_pickaxe, $obj, combat_pickaxe:specbar_layer);
    case weapon_scythe : ~.weapon_category_tab_attack(combat_scythe:name, combat_scythe, $obj, null);
    case weapon_slash : ~.weapon_category_tab_attack(combat_hacksword:name, combat_hacksword, $obj, combat_hacksword:specbar_layer);
    case weapon_spear : ~.weapon_category_tab_attack(combat_spear:name, combat_spear, $obj, combat_spear:specbar_layer);
    case weapon_spiked : ~.weapon_category_tab_attack(combat_spiked:name, combat_spiked, $obj, combat_spiked:specbar_layer);
    case weapon_stab : ~.weapon_category_tab_attack(combat_stabsword:name, combat_stabsword, $obj, combat_stabsword:specbar_layer);
    case weapon_claws : ~.weapon_category_tab_attack(combat_claw:name, combat_claw, $obj, combat_claw:specbar_layer);
    case weapon_whip : ~.weapon_category_tab_attack(combat_whip:name, combat_whip, $obj, combat_whip:specbar_layer);
    // ranged
    case weapon_bow : ~.weapon_category_tab_attack(combat_bow:name, combat_bow, $obj, combat_bow:specbar_layer);
    case weapon_crossbow : ~.weapon_category_tab_attack(combat_crossbow:name, combat_crossbow, $obj, combat_crossbow:specbar_layer);
    case weapon_thrown, weapon_javelin :
        if ($obj = chinchompa | $obj = red_chinchompa) {
            ~.weapon_category_tab_attack(combat_chinchompa:name, combat_chinchompa, $obj, combat_chinchompa:specbar_layer);
        } else {
            ~.weapon_category_tab_attack(combat_thrown:name, combat_thrown, $obj, combat_thrown:specbar_layer);
        }
    case weapon_salamander : ~.weapon_category_tab_attack(combat_salamander:name, combat_salamander, $obj, combat_salamander:specbar_layer);
    // magic
    case weapon_staff : ~.weapon_category_tab_attack(combat_staff_2:name, combat_staff_2, $obj, null);
    case weapon_powered_staff : ~.weapon_category_tab_attack(combat_powered_staff:name, combat_powered_staff, $obj, null);
    // unarmed everything else
    case default : ~.weapon_category_tab_attack_unarmed($obj);
}

[proc,.weapon_category_tab_attack](component $component2, interface $interface, obj $obj, component $specbar_layer)
// 474's combat tabs have no weapon preview: the weapon is named in the title instead.
.if_settext($component2, "<oc_name($obj)>");
if ($specbar_layer ! null) {
    if (oc_param($obj, specwep) = ^true) {
        .if_sethide($specbar_layer, false);
    } else {
        .if_sethide($specbar_layer, true);
    }
}
.if_settab($interface, 0);

// sends the unarmed interface tab
[proc,.weapon_category_tab_attack_unarmed](obj $obj)
// yes this is actually "unarmed" between beta and 2005-ish.
if ($obj = null) {
    .if_settext(combat_unarmed:name, "unarmed");
} else {
    if (oc_param($obj, specwep) = ^true) {
        .if_sethide(combat_unarmed:specbar_layer, false);
    } else {
        .if_sethide(combat_unarmed:specbar_layer, true);
    }
    .if_settext(combat_unarmed:name, "<oc_name($obj)>"); // gnomeball uses this
}
.if_settab(combat_unarmed, 0);

// The secondary-player half of ~attackstyle_memory_get. Read-only: see ~.update_weapon_category.
[proc,.attackstyle_memory_get](obj $weapon)(int)
if ($weapon = null | (map_members = ^false & oc_members($weapon) = true)) {
    return(.%atkstyle_unarmed);
}
switch_category (oc_category($weapon)) {
    // melee
    case weapon_2h_sword : return(.%atkstyle_2h_sword);
    case weapon_axe : return(.%atkstyle_axe);
    case weapon_blunt, flowers : return(.%atkstyle_blunt);
    case weapon_pickaxe : return(.%atkstyle_pickaxe);
    case weapon_scythe : return(.%atkstyle_scythe);
    case weapon_slash : return(.%atkstyle_slash);
    case weapon_spear : return(.%atkstyle_spear);
    case weapon_spiked : return(.%atkstyle_spiked);
    case weapon_stab : return(.%atkstyle_stab);
    case weapon_claws : return(.%atkstyle_claws);
    case weapon_whip : return(.%atkstyle_whip);
    // ranged
    case weapon_bow : return(.%atkstyle_bow);
    case weapon_crossbow : return(.%atkstyle_crossbow);
    case weapon_thrown, weapon_javelin : return(.%atkstyle_thrown);
    case weapon_salamander : return(.%atkstyle_salamander);
    // magic
    case weapon_staff : return(.%atkstyle_staff);
    case weapon_powered_staff : return(.%atkstyle_powered_staff);
    // unarmed everything else
    case default : return(.%atkstyle_unarmed);
}
