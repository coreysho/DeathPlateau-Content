[label,player_ranged_attack]
if (~npc_is_attackable = false) {
    return;
}

if (%action_delay > map_clock) {
    p_opnpc(2);
    return;
}

if (npc_stat(hitpoints) = 0) {
    return;
}

// set the skill clock depending on the weapon attack rate
def_obj $rhand = inv_getobj(worn, ^wearpos_rhand);
if ($rhand = null) {
    %action_delay = add(map_clock, 4);
} else {
    %action_delay = add(map_clock, oc_param($rhand, attackrate));
}
if (%damagestyle = ^style_ranged_rapid) {
    %action_delay = sub(%action_delay, 1);
}
// this can be either the quiver or rhand.
def_obj $ammo = ~player_ranged_check_ammo($rhand);
if ($ammo = null) {
    p_stopaction;
    ~update_all($rhand);
    return;
}

// check hit, give combat xp
def_int $damage = 0;
// Black mask (i) / slayer helmet (i): 15% to the accuracy roll and the max hit against monsters on
// the player's current slayer task. The PLAIN mask gives nothing here - only the imbued pair do,
// which is the whole reason to buy the imbue. ~black_mask_imbued_on_task is in
// skill_slayer/scripts/black_mask.rs2 and shares its "on task" test with the melee bonus.
def_int $mask_num = 1;
def_int $mask_div = 1;
if (~black_mask_imbued_on_task = true) {
    $mask_num = 23;
    $mask_div = 20;
}
// an enchanted bolt's effect (bolt_effects.rs2): some roll only on a hit, and those that roll
// regardless land whatever the accuracy roll says
def_boolean $hit = ~player_npc_hit_roll_boosted(%damagetype, $mask_num, $mask_div);
def_int $bolt_effect = ~bolt_effect_roll($rhand, $ammo, $hit);
def_int $hit_max = 0; // what $damage was rolled against, for the max hit splat
if ($bolt_effect ! ^bolt_none | $hit = true) {
    def_int $maxhit = %com_maxhit;
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    if (inv_total(worn, holy_water) > 0) {
        if(npc_param(demonbane_vulnerable) = true) {
            $maxhit = scale(160, 100, %com_maxhit);
            if(npc_type = nezikchened) {
                $maxhit = add($maxhit, 5);
            }
            if (npc_stat(defence) >= npc_basestat(defence)) npc_statsub(defence, 0, 5);
        } else {
            $maxhit = 0;
        }
    }
    // After the branches that assign from %com_maxhit and would otherwise discard this, and
    // before the ones that zero $maxhit outright - the same position player_melee.rs2 uses.
    $maxhit = scale($mask_num, $mask_div, $maxhit);
    if((npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth)
        & oc_category($rhand) ! weapon_bow & inv_total(worn, slayer_broad_arrows) = 0) {
        $maxhit = 0;
    }
    // Horror from the Deep - Dagannoth Mother (quest_horror): ranged only damages her during her
    // green/ranged-weakness phase. See the matching melee-side comment in player_melee.rs2 and the
    // magic-side handling in player_magic.rs2 for the other four (elemental) phases.
    if (npc_type = horror_dagganoth_air | npc_type = horror_dagganoth_water | npc_type = horror_dagganoth_earth | npc_type = horror_dagganoth_fire | npc_type = horror_dagganoth_melee) {
        $maxhit = 0;
    }
    $hit_max = min($maxhit, npc_param(max_dealt));
    $damage = randominc($hit_max);
    // not where the target is immune to ranged (a max hit of 0 above)
    if ($bolt_effect ! ^bolt_none & $maxhit > 0) {
        $damage = min(~bolt_effect_damage($bolt_effect, $maxhit), npc_param(max_dealt));
    } else {
        $bolt_effect = ^bolt_none;
    }
    // A cave kraken's hide turns arrows aside: a seventh of the damage (OSRS; area_kraken_cove).
    if (npc_type = cave_kraken) {
        $damage = divide($damage, 7);
    }
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    // Guthan's heal is "attacks", not "melee attacks", so it fires here too.
    ~barrows_set_hit_npc($damage_capped, %damagetype);
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}

def_int $poison_severity = oc_param($ammo, poison_severity);
if ($damage > 0 & $poison_severity > 0 & random(8) = 0) { // 1/8 chance to poison
    // poison npc
    ~npc_poison_start(max(sub($poison_severity, 14), 0)); // lowered by 14 if ranged attack
}

p_opnpc(2);

//mes("attackstyle: <tostring(%attackstyle)>, damagestyle: <tostring(%damagestyle)>, damage: <tostring($damage)>, damagetype: <tostring(%damagetype)>");
anim(%com_attackanim, 0);
sound_synth(%com_attacksound, 0, 0);
def_int $delay = add(~player_ranged_use_weapon($rhand, $ammo), 30); // osrs it seems to be delayed an extra tick
~npc_retaliate(calc($delay / 30));
~npc_queue_hit($damage, $hit_max, calc($delay / 30));
npc_anim(npc_param(defend_anim), sub($delay, 30)); // delay npc this tick
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, sub($delay, 30)); // delay 1 client tick for the hit queue
}
// the bolt effect's graphic as the bolt lands, with the flinch
~bolt_effect_land($bolt_effect, $damage, sub($delay, 30));

[proc,player_ranged_check_ammo](obj $rhand)(obj)
// The crystal bow makes its own arrows, so it is its own ammo. This has to come before the
// category checks below, which would otherwise reject a bow for not being arrows.
if (oc_param($rhand, ammo_self_supplied) = true) {
    return($rhand);
}
def_category $weapon_cat = oc_category($rhand);
if ($weapon_cat ! weapon_bow & $weapon_cat ! weapon_crossbow) {
    return($rhand); // in this case, the rhand is the ammo.
}
def_obj $ammo = inv_getobj(worn, ^wearpos_quiver);
if ($ammo = null) {
    if($rhand = ogre_bow) mes("There is no ammo left in your quiver");
    else mes("There is no ammo left in your quiver.");
    return(null);
}
def_category $ammo_cat = oc_category($ammo);
if (($rhand = ogre_bow & $ammo_cat ! ogre_arrows) | 
    ($rhand ! ogre_bow & $weapon_cat = weapon_bow & $ammo_cat ! arrows)) {
    mes("You can't use that ammo with your bow."); // todo confirm this for 2004.
    return(null);
}
if ($weapon_cat = weapon_crossbow & $ammo_cat ! bolts) {
    mes("You can't use that ammo with your crossbow."); // todo confirm this for 2004.
    return(null);
}
// the hunters' crossbow and kebbit bolts only go with each other (skill_hunter/scripts/hunter_imps.rs2)
if (~hunter_crossbow_ammo_ok($rhand, $ammo) = false) {
    mes("You can't use that ammo with your crossbow.");
    return(null);
}
if (oc_param($ammo, levelrequire) > oc_param($rhand, levelrequire)) { //todo confirm crossbows could use all bolts at lvl 1
    mes("Your bow isn't powerful enough for those arrows."); // todo confirm this for 2004.
    return(null);
}

return($ammo);

[proc,player_ranged_use_weapon](obj $rhand, obj $ammo)(int)
if ($ammo = ogre_arrow) spotanim_pl(oc_param($ammo, proj_launch), 50, 0);
else spotanim_pl(oc_param($ammo, proj_launch), 96, 0);
def_int $delay = 30;
~crystal_bow_shot; // crystal bow spends one charge per shot - see degrade/scripts/degrade.rs2
switch_category(oc_category($rhand)) {
    case weapon_bow :
        $delay = ~npc_projectile(coord, npc_uid, oc_param($ammo, proj_travel), 40, 36, 41, 15, 5, 11, 5);
        ~ranged_dropammo_npc($ammo, divide($delay, 30));
    case weapon_crossbow :
        // a bolt flies almost flat (angle 5), where an arrow is lobbed (15), from the shoulder the
        // OSRS crossbow animation holds it at - ~bolt_projectile
        $delay = ~bolt_projectile_npc($ammo);
        ~ranged_dropammo_npc($ammo, divide($delay, 30));
    case weapon_thrown, weapon_javelin : 
        $delay = ~npc_projectile(coord, npc_uid, oc_param($ammo, proj_travel), 40, 36, 32, 15, 0, 11, 5);
        ~ranged_dropammo_npc($ammo, divide($delay, 30));
        if (inv_total(worn, $ammo) = 0) {
            mes("That was your last one!");
            p_stopaction;
            ~update_all($ammo);
        }
}
return($delay);

[proc,ranged_dropammo_npc](obj $ammo, int $delay)
// Self-supplied ammo is the weapon itself - never consume or drop it. No-drop ammo is used
// up but never lands on the floor (bolt racks).
if (oc_param($ammo, ammo_self_supplied) = true) {
    return;
}
if (oc_param($ammo, ammo_no_drop) = true) {
    inv_del(worn, $ammo, 1);
    return;
}
if($ammo = holy_water) {
    ~ranged_dropammo_holywater(npc_coord, $delay);
    return;
}
if (~ranged_ammo_saved = true) { // Ava's device, or the Ranging cape standing in for one: the ammo stays in the quiver
    return;
}
if (random(^dropammo_chance) ! 0) {
    if (map_blocked(npc_coord) = false) {
        inv_dropitem_delayed(worn, npc_coord, $ammo, 1, ^lootdrop_duration, $delay);
        return;
    }
}
inv_del(worn, $ammo, 1);

[proc,ranged_dropammo_holywater](coord $coord, int $delay)
if (~in_duel_arena(coord) = true) {
    return;
}
inv_del(worn, holy_water, 1);
if (inv_freespace(worn) > 0) {
    inv_add(worn, smashed_glass, 1);
    inv_dropitem_delayed(worn, $coord, smashed_glass, 1, ^lootdrop_duration, $delay);
}
