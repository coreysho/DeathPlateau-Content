[label,pvp_melee_attack]
if (~duel_arena_melee_check = false) {
    return;
}
if (.%death = ^true) {
    p_stopaction;
    return;
}
if (%action_delay > map_clock) {
    p_opplayer(2); // it is guaranteed here that we are already within op distance
    return;
}

p_opplayer(2);
~set_pk_vars;

def_obj $rhand = inv_getobj(worn, ^wearpos_rhand);
def_int $poison_severity = 0;
if ($rhand = null) {
    %action_delay = add(map_clock, 4);
} else {
    %action_delay = add(map_clock, oc_param($rhand, attackrate));
    $poison_severity = oc_param($rhand, poison_severity);
}

def_int $damage = 0;
// not sure if xp multipler exists for us or not?!
// https://oldschool.runescape.wiki/w/Combat#PvP_bonus_experience
// Verac's set ignores armour, Defence and protection prayers on a quarter of its attacks, which
// here means skipping the roll AND the 40% prayer reduction below it. Dharok's scales the max hit
// with the wearer's missing health. Both are in areas/area_barrows/scripts/barrows_sets.rs2.
def_boolean $verac = ~barrows_verac_ignores;
def_int $hit_max = 0; // what $damage was rolled against, for the max hit splat
if (~pvp_hit_roll(%damagetype) = true | $verac = true) {
    def_int $maxhit = ~barrows_dharok_maxhit(%com_maxhit);
    if (~.check_protect_prayer(^melee_style) = true & $verac = false) {
        $maxhit = scale(6, 10, $maxhit); // reduction of 40%
    }
    $hit_max = $maxhit;
    $damage = min(randominc($maxhit), .stat(hitpoints)); // tick eating existed! https://oldschool.runescape.wiki/w/Update:The_Wintertodt
    ~give_combat_experience_pvp(%damagestyle, $damage, ~pvp_xp_multiplier(~.player_combat_level));
    both_heropoints($damage);
    // Guthan's heal and Torag's energy drain.
    ~barrows_set_hit_player($damage, %damagetype);
}

anim(%com_attackanim, 0);
sound_synth(%com_attacksound, 0, 0);
.sound_synth(%com_attacksound, 0, 0);

.queue*(pvp_retaliate, 0)(uid);
~.pvp_damage_max(0, $damage, $hit_max);

.anim(.%com_defendanim, 20);
// .sound_synth(.%com_defendsound, 0, 20);
// sound_synth(.%com_defendsound, 0, 20);

if ($damage > 0 & $poison_severity > 0 & random(4) = 0) { // 1/4 chance to poison
    .queue(poison_player, 0, $poison_severity);
}
~abyssal_tentacle_swing; // a charge per swing (area_kraken_cove/scripts/abyssal_tentacle.rs2)
