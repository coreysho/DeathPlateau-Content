// returns the calculated max hit for this npc
[proc,npc_melee_maxhit]()(int)
def_int $strengthbonus = npc_param(strengthbonus);
//npcs are essentially always on controlled
def_int $effective_strength = ~combat_effective_stat(npc_stat(strength), 100); // no prayerbonus
$effective_strength = add($effective_strength, 9); // 'style bonus' of 1
def_int $melee_strength = ~combat_stat($effective_strength, $strengthbonus);
return(~combat_maxhit($melee_strength));

// returns the npc attack roll for this npc
// npcs only have one attackbonus.
[proc,npc_melee_attack_roll]()(int)
if (~check_protect_prayer(^melee_style) = true) {
    return(0);
}
def_int $attackbonus = npc_param(attackbonus);
def_int $effective_attack = ~combat_effective_stat(npc_stat(attack), 100); // no prayerbonus
$effective_attack = add($effective_attack, 9); // 'style bonus' of 1
//npcs are essentially always on controlled
return(~combat_stat($effective_attack, $attackbonus));

// returns the npc attack roll for this npc, doesn't account for prot melee
// npcs only have one attackbonus.
[proc,npc_melee_attack_roll_typeless]()(int)
def_int $attackbonus = npc_param(attackbonus);
def_int $effective_attack = ~combat_effective_stat(npc_stat(attack), 100); // no prayerbonus
$effective_attack = add($effective_attack, 9); // 'style bonus' of 1
//npcs are essentially always on controlled
return(~combat_stat($effective_attack, $attackbonus));

// perform a basic melee attack from the npc to the player.
[proc,npc_meleeattack]
def_int $attack_roll = ~npc_melee_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(npc_param(damagetype));
def_int $maxhit = ~npc_melee_maxhit;

// npc_say("Clock: <tostring(map_clock)>, NPC A: <tostring($attack_roll)>, Player D: <tostring($defence_roll)>, NPC Max: <tostring($maxhit)>");

if (randominc($attack_roll) > randominc($defence_roll)) {
    ~playerhit_n_melee_max(randominc($maxhit), $maxhit, npc_param(attackrate));
    return;
}
~playerhit_n_melee(0, npc_param(attackrate));

[proc,playerhit_n_melee](int $damage, int $delay)
~playerhit_n_melee_max($damage, 0, $delay);

// ~playerhit_n_melee knowing the max the hit was rolled against, for the max hit splat
[proc,playerhit_n_melee_max](int $damage, int $maxhit, int $delay)
if_close; // close the player interface when taking a hit.
// not sure if this is correct
~npc_set_attack_vars;
%npc_action_delay = add(map_clock, $delay);
if (npc_stat(hitpoints) = 0) {
    return; // melee npc's on 0 health play the hit animation but dont actually damage you
    // but ranged/mage npcs do! This is unique to melee!
}
// POWER OF DEATH / POWER OF LIGHT: the staff of the dead and the staff of light halve the melee
// damage their wielder takes for a minute (bosses/godwars/scripts/gwd_staves.rs2). This proc is the
// single funnel every melee hit on a player comes through - Barrows, the Fight Cave and the quest
// bosses all reach the player through ~playerhit_n_melee - so it is the one place the halving
// covers every melee npc in the game rather than the standard attack path only.
//
// $maxhit is halved with it so the max-hit splat still means "the most this hit could have been",
// and the poison and prayer-drain checks below see the reduced number, which is the damage that
// was actually dealt.
if (~sotd_spec_active = true) {
    $damage = calc($damage / 2);
    $maxhit = calc($maxhit / 2);
}
~queue_combat_damage_player(0, $damage, $maxhit);
if (npc_param(poison_severity) > 0 & $damage > 0) {
    queue(poison_player, 0, npc_param(poison_severity));
}
// Desert Treasure - Damis's second form drains prayer on every hit landed in melee range. Queued
// exactly like the poison above, which is the only shape that reaches the player from here.
if (npc_type = fd_damis_tougher & $damage > 0) {
    queue(dt_damis_prayer_drain, 0, $damage);
}
// And the same shape param-driven, for anything whose drain is a FLAT number of points rather
// than a share of the damage - Tz-Kih in the Fight Cave is the first. Damis stays above on its own
// npc type because half-the-damage and a flat point are two mechanics, not one with an argument.
if (npc_param(prayer_drain) ! null & $damage > 0) {
    queue(fightcave_prayer_drain, 0, npc_param(prayer_drain));
}
// Monkey Madness - the capture monkeys of Ape Atoll do not just wound you: "if they hit the player,
// the player will appear in the Ape Atoll prison". Same queued shape as the drains above, which is
// the only way anything reaches the player from in here, and keyed on the category so the five
// named monkeys and the Monkey Guards share one line. Padulah is deliberately NOT in it: he has a
// static spawn and is meant to be fought.
if (npc_category = mm_captor & $damage > 0) {
    queue(mm_arrested, 0, 0);
}
// The Great Brain Robbery - every hit of Barrelchest's anchor "deactivates all prayers and drains
// prayer points", and takes a point of Attack and Defence with it. Same queued shape as the drains
// above; quests/quest_tgbr/scripts/tgbr_barrelchest.rs2 has the effect.
if (npc_type = tgbr_barrelchest & $damage > 0) {
    queue(tgbr_anchor_hit, 0, $damage);
}
queue*(playerhit_n_retaliate, 0)(npc_uid);
