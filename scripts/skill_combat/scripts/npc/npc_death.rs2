[proc,npc_death]
// npc_walk(npc_coord) is unnecessary due to npc_setmode(none).
// But they do it in this screenshot so might be good to do it here just incase: https://i.imgur.com/AfQ1MfF.png
npc_walk(npc_coord);
npc_setmode(none);
// AND THE RFD ROCK CAKE, which has to go BEFORE the arrivedelay below. That line gives up
// p_active_player, and everything after it has to win the player back with npc_findhero - which
// returns the active player but NOT protected access, so an inv_add after it will not compile.
// The hook swaps a hot rock cake for a cool one, so it needs the inventory, so it goes here.
//
// Same shape as the four hooks below it: ~hundred_icefiend_chill returns at once for anything
// that is not an icefiend, which is every death in the game bar a handful. It is a proc rather
// than an [ai_queue3] on the icefiend because an npc can only carry one of those.
~hundred_icefiend_chill;
npc_arrivedelay; // arrivedelay for up to two ticks (current osrs too) https://youtu.be/Vsnkdq8OOMg?t=209
~check_progress_task(npc_param(slayer_category)); // this is checked after arrivedelay
// The Barrows tunnels pay reward potential for everything that dies in them, and this is the one
// place every death passes through: the two Barrows skeletons already carry an [ai_queue3] for
// their drop table and a second trigger on the same npc is a hard build error, so there is no
// per-monster hook to use. ~barrows_potential returns immediately anywhere but down there.
~barrows_potential;
// AND THE BOSS KILL COUNTS, for the same reason and in the same place. Eight of the twelve bosses
// already carry an [ai_queue3] for their drop table and a second trigger on one npc is a hard
// build error, so there is no per-boss hook to use. ~boss_kill_record returns immediately for
// everything that is not one of the twelve, which is almost everything that dies.
~boss_kill_record;
// AND THE DROP-RATE BOOST, third hook, same funnel, same reason: the 214 drop tables are triggers
// rather than procs, so there is no way to add to one of them from outside. ~droprate_bonus rolls
// the monster's own table's bonus list for a player on a boosted rate (gamemodes/scripts/droprate.rs2),
// and returns at once for anyone else.
~droprate_bonus;
// AND THE PLAYER STATISTICS' monster kill count, same funnel: it credits the player the drop tables
// credit, so npc_findhero again. It moves the active player, which the finduid below sets again.
~player_stats_npc_kill;
// God Wars killcount. Reads one param and returns for every npc that is not one of the four
// gods' - which is every other npc in the game. bosses/godwars/scripts/gwd_killcount.rs2
~gwd_killcount_add;
if (finduid(%npc_aggressive_player) = true) {
    if (npc_param(death_sound) ! null) {
        ~sound_within_distance(npc_param(death_sound), 0, npc_coord, 12); // osrs
    }
    %lastcombat = null; // allows other npcs to hunt you immediately
}
npc_anim(npc_param(death_anim), 0);
npc_delay(1); // osrs has an extra tick of delay here. I think this delay can vary from npc to npc
npc_del;
