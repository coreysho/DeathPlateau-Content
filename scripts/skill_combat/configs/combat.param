// Optional per-attack-style animation: style1 = first combat-tab button ... style4 = fourth.
// ~combat_swing_anim_and_synth checks it before the stab/slash/crush anims above, for weapons
// that OSRS animates per style (godswords and the Saradomin sword: chop, slash, smash, block).
[style1_attack_anim]
type=seq
default=null

[style2_attack_anim]
type=seq
default=null

[style3_attack_anim]
type=seq
default=null

[style4_attack_anim]
type=seq
default=null

[defend_anim]
type=seq
default=human_unarmed_def
autodisable=yes

// The block an off-hand item plays when its wearer is hit, over the weapon's defend_anim
// (skill_combat/scripts/combat.rs2 ~combat_defend_anim). null = a plain shield block, or the
// weapon's own when the item is not a shield. The defenders carry osrs_defender_block.
[shield_defend_anim]
type=seq
default=null

[rangeattack_anim]
type=seq
default=human_unarmedpunch
autodisable=yes

[rangeattack_sound]
type=synth
default=null

[proj_launch]
type=spotanim
default=null

[proj_travel]
type=spotanim
default=null

[proj_height]
type=int
default=96

