type=int
default=0

[zamorakitem]
type=int
default=0

[guthixitem]
type=int
default=0

[saradominitem]
type=int
default=0

[poison_severity]
type=int
default=0

// npcs that reduces the players max hit. Such as strange plant
[max_dealt]
type=int
// high default value to avoid any issues
default=1000

// 1000 = 1x
[combat_xp_multiplier]
type=int
default=1000

[magicattack_anim]
type=seq
default=null

[npc_ammo]
type=namedobj
default=null

// todo: real name
[specwep]
type=int
default=0

// just some arbitrary default lol
[sa_energy]
type=int
default=1000

// Ammunition that is used up outright instead of dropping to the floor - bolt racks.
[ammo_no_drop]
type=boolean
default=no

// Weapons that supply their own ammunition and need nothing in the quiver - crystal bow.
[ammo_self_supplied]
type=boolean
default=no

// THE SHORTEST WEAPON THAT CAN REACH AN NPC AT ALL. 0, so it changes nothing anywhere it is not
// set. Zulrah is the reason it exists: Old School puts the snake across water from the walkway so
// only a halberd touches it, and this build lets you stand one tile from its body - measured, in
// Engine-TS tools/sim/zulrahreach.ts - so a bare fist reached it. Fixing that by geometry would
// mean moving the snake or the walkway and re-laying the cloud fill with it; this says the same
// thing in one param without touching the arena.
[min_attackrange]
type=int
default=0
autodisable=yes
