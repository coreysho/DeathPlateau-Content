[tzhaar_mace]
name=Tzhaar-ket-em
desc=A mace of obsidian.
members=yes
iop2=Wield
model=obj_tzhaar_mace
2dyof=6
2dzoom=840
2dyan=2028
2dxan=380
contrast=35
ambient=15
manwear=obj_tzhaar_mace_manwear,0
womanwear=obj_tzhaar_mace_manwear,6
cost=30000
wearpos=righthand
weight=4lb
param=stabattack,-4
param=slashattack,-4
param=crushattack,62
param=strengthbonus,56
param=attackrate,5
// THESE WERE slash_, AND THE WEAPON IS NEVER SWUNG AS SLASH. weapon_crush is not a case in
// combat.rs2's switch, so it falls through to weapon_unarmed_table - three crush styles. The
// mace therefore had no animation and no sound at all, and the missing sound ended the session.
// The Tzhaar-ket-om below it was always written crush_ and always worked. rs2check rule 19.
param=crushattack_anim,human_blunt_pound
param=defend_anim,human_blunt_block
param=crush_sound,mace_crush
category=weapon_crush

[tzhaar_maul]
name=Tzhaar-ket-om
desc=A maul of obsidian.
members=yes
iop2=Wield
model=obj_tzhaar_maul
2dxof=3
2dyof=-4
2dzoom=1130
2dyan=952
2dxan=396
contrast=35
ambient=15
manwear=obj_tzhaar_maul_manwear,0
womanwear=obj_tzhaar_maul_manwear,6
cost=50000
wearpos=righthand
wearpos2=lefthand
weight=8lb
param=crushattack,80
param=strengthbonus,85
// OSRS'S OWN ANIMATIONS (2026-09-21), converted from the OSRS cache into osrs_obsidian_anims.seq:
// the obsidian maul's slam, seq 2661, and the maul stance it shares with the granite maul - 1662
// ready, 1663 walk, 1664 run, 1666 block. All on the OSRS player skeleton, so the attack walk-merges
// with the stance it plays over. And the OSRS speed, 7 ticks; it had none, so swung at the default.
param=attackrate,7
param=crushattack_anim,osrs_obsidian_maul_attack
param=defend_anim,osrs_maul_block
param=crush_sound,2H_crush
category=weapon_crush
param=ready_baseanim,osrs_maul_ready
param=walk_f_baseanim,osrs_maul_walk
param=walk_b_baseanim,osrs_maul_walk
param=walk_l_baseanim,osrs_maul_walk
param=walk_r_baseanim,osrs_maul_walk
param=running_baseanim,osrs_maul_run
param=ornament_kit,tzhaar_ket_om_ornament_kit
param=ornament_into,tzhaar_ket_om_t
