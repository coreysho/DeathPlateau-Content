// PRISON PETE, and a cell that was not only built but half wired.
//
// WHAT IT IS, per oldschool.runescape.wiki/w/Prison_Pete: "Players must pull a lever on the wall,
// which displays an image of a balloon animal", then "search among several balloon animals in the
// room. When they pop the correct matching balloon, they receive a 'prison key'". Three right in a
// row and you "leave the cell and escape to freedom"; a wrong one and "getting the wrong balloon
// animal resets progress".
//
// THE DOORS WERE ALREADY WIRED TO THE KEY COUNT and nothing had ever written it. The three locs
// across the west wall - prisonpete_door_1, _2 and _3 - are multilocs over one varbit, and their
// lists are three barriers long, then two, then one: at nought keys all three show an Energy
// Barrier, and each key takes one of them away. Three keys and the wall is open. That is the whole
// escape, straight out of the 377 cache; all this script does is count.
//
// THE VARBIT IS THE CACHE'S OWN. It came through the unpack as varbit_1547 on swansong_temp bits
// 5-7, beside the two Swan Song varbits that share the varp. Nothing in this content has ever read
// or written any of the three. It has a name now; the bits and the base are untouched, because the
// doors are built on them.
//
// THE FOUR ARE NOT NAMED ANYWHERE. All four balloon npcs are called "Balloon Animal" and examine as
// "It looks like an animal", and the cache does not say which is the cat and which is the goat - so
// the lever shows the balloon's own model rather than naming a species this build cannot know. See
// macro_pete_lever.if.

[proc,macro_prisonpete_spawn]
%npc_macro_event_target = uid;
%macro_event_target_coord = coord;
%macro_pete_keys = 0;
%macro_pete_wants = 0;
queue(macro_pete_arrive, 0, 0);
npc_del;

[queue,macro_pete_arrive]
mes("Something grabs you and the world goes dark.");
p_delay(1);
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
~p_telejump_safe(^macro_prisonpete_landing);
mes("You wake up in a cell. There is a man here, and a great many balloons.");

[proc,macro_pete_leave]
%macro_pete_keys = 0;
%macro_pete_wants = 0;
inv_del(inv, prisonpete_key, 28);
%macro_event = ^no_macro_event;
p_delay(1);
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
~p_telejump_safe(%macro_event_target_coord);

[mapzoneexit,0_32_69]
~macro_events_varps_reset;
%macro_pete_keys = 0;
%macro_pete_wants = 0;

// ============================================================================ the lever

[oploc1,prisonpete_lever]
if (%macro_event ! ^macro_prisonpete) {
    mes("The lever will not budge.");
    return;
}
anim(human_pull_lever, 0);
sound_synth(lever, 1, 0);
p_delay(1);
// Pulling it again shows the same animal rather than rolling a new one: it is a picture on a wall,
// and a player who looked away should be able to look again.
if (%macro_pete_wants = 0) {
    %macro_pete_wants = calc(random(^macro_pete_animals) + 1);
}
~macro_pete_show(%macro_pete_wants);

[proc,macro_pete_show](int $which)
if_setmodel(macro_pete_lever:com_0, enum(int, int, macro_pete_balloon_model, $which));
if_settext(macro_pete_lever:com_1, "The dial stops on a picture of this one.");
if_openchat(macro_pete_lever);
if_addresumebutton(macro_pete_lever:com_2);
p_pausebutton;
if_close;

// ============================================================================ the balloons

[opnpc1,prisonpete_balloon1] @macro_pete_pop(1);
[opnpc1,prisonpete_balloon2] @macro_pete_pop(2);
[opnpc1,prisonpete_balloon3] @macro_pete_pop(3);
[opnpc1,prisonpete_balloon4] @macro_pete_pop(4);

[label,macro_pete_pop](int $which)
if (%macro_event ! ^macro_prisonpete) {
    mes("Nothing happens.");
    return;
}
if (%macro_pete_wants = 0) {
    mes("You should see what the lever says first.");
    return;
}
anim(human_pickpocket, 0);
// balloon_pop is a seq, not a synth - the balloon bursts on screen and pop1 is the noise.
npc_anim(balloon_pop, 0);
sound_synth(pop1, 1, 0);
p_delay(1);
npc_del;
if ($which = %macro_pete_wants) {
    %macro_pete_wants = 0;
    %macro_pete_keys = add(%macro_pete_keys, 1);
    inv_add(inv, prisonpete_key, 1);
    mes("There's a key inside! One of the barriers flickers out.");
    if (%macro_pete_keys >= ^macro_pete_keys_needed) {
        mes("The last barrier dies. The way out is open.");
    }
    return;
}
// "Getting the wrong balloon animal resets progress."
%macro_pete_wants = 0;
if (%macro_pete_keys > 0) {
    %macro_pete_keys = 0;
    inv_del(inv, prisonpete_key, 28);
    mes("Nothing but rubber - and the barriers come back up. Start again.");
    return;
}
mes("Nothing but rubber.");

// ============================================================================ Pete

[opnpc1,prisonpete_pete]
if (%macro_event ! ^macro_prisonpete) {
    ~chatnpc("<p,sad>Don't mind me. I live here now.");
    return;
}
if (%macro_pete_keys >= ^macro_pete_keys_needed) {
    ~chatnpc("<p,happy>That's the lot! Quick, before he notices.");
    ~macro_event_give_reward;
    // The wiki's ending: you both get out, and Evil Bob has him back inside the hour.
    ~chatnpc("<p,happy>Freedom! ...for a bit, anyway. He always finds me.");
    ~macro_pete_leave;
    return;
}
if (%macro_pete_keys = 0) {
    ~chatnpc("<p,sad>Three keys, that's what it takes. They're inside the balloons - pull the lever and it'll show you which one to pop.");
} else {
    ~chatnpc("<p,quiz>That's <tostring(%macro_pete_keys)> of three. Pull the lever again and see what it wants next.");
}
def_int $choice = ~p_choice2("I'll keep looking.", 1, "I'd rather go home.", 2);
if ($choice = 2) {
    ~chatnpc("<p,sad>Suit yourself. I'll be here.");
    ~macro_pete_leave;
}
