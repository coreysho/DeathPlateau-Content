// EVIL BOB'S ISLAND, which is built down to the last bamboo tree in map square 39_74: eight Fishing
// spots round the shore, two Uncooking pots, a Portal home, Bob sitting in the middle and two
// servants standing about. Four fish, a net and a Man speak amulet are in antimacro.obj. Only the
// script was missing.
//
// WHAT IT IS, per runescape.wiki/w/Evil_Bob: on the island players had to "catch cooked fish and
// uncook them for Evil Bob", and "a servant provided hints about the proper sequence of actions
// needed to put Evil Bob to sleep". "Once Evil Bob fell asleep after consuming the uncooked fish,
// players could leave the island." Everything here is backwards, which is the joke: you fish a
// cooked fish out of the water and put it in a pot to make it raw.
//
// THE AMULET IS WHY HE CAN TALK TO YOU. "Evil Bob wore a manspeak amulet, which is how players are
// able to converse with him without the need for a catspeak amulet" - so the amulet in the cache is
// his, not yours, and it is not handed out here.
//
// WHICH FISH IS THE RIGHT ONE IS NOT SOMETHING YOU CAN SEE. The two cooked fish are both called
// "Fishlike thing" and examine the same, and so do the two raw ones; the cache gives no way to tell
// them apart and that is deliberate. So the net decides it, one in three, and the only way through
// is to keep fishing - which is what an anti-macro event is for.

[proc,macro_evil_bob_spawn]
%npc_macro_event_target = uid;
%macro_event_target_coord = coord;
queue(macro_evil_bob_arrive, 0, 0);
npc_del;

[queue,macro_evil_bob_arrive]
mes("A cat looks up at you. Everything goes sideways.");
p_delay(1);
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
~p_telejump_safe(^macro_evil_bob_landing);
mes("You are on an island. A cat is watching you.");
// You cannot fish without one, and there is nowhere on the island to get one.
if (inv_total(inv, evil_bob_net) = 0) {
    ~macro_event_give_obj(evil_bob_net, 1);
    mes("Somebody has left a small fishing net at your feet.");
}

[proc,macro_evil_bob_leave]
inv_del(inv, evil_bob_net, 28);
inv_del(inv, evil_bob_cooked_fish_correct, 28);
inv_del(inv, evil_bob_cooked_fish_incorrect, 28);
inv_del(inv, evil_bob_uncooked_fish_correct, 28);
inv_del(inv, evil_bob_uncooked_fish_incorrect, 28);
%macro_event = ^no_macro_event;
p_delay(1);
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
~p_telejump_safe(%macro_event_target_coord);

[mapzoneexit,0_39_74]
~macro_events_varps_reset;

// ============================================================================ the island

[oploc1,loc_8986] // Fishing spot, "Net"
if (%macro_event ! ^macro_evil_bob) {
    mes("The fish, if they are fish, ignore you.");
    return;
}
if (inv_total(inv, evil_bob_net) = 0) {
    mes("You need a net to catch anything here.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have room for another one of those.");
    return;
}
anim(human_smallnet, 0);
p_delay(4);
// One in three. Nothing about the fish says which it is, so this roll is the only thing that does.
if (random(3) = 0) {
    inv_add(inv, evil_bob_cooked_fish_correct, 1);
} else {
    inv_add(inv, evil_bob_cooked_fish_incorrect, 1);
}
mes("You net a fishlike thing. It appears to already be cooked.");

// THE POT RUNS BACKWARDS, which is what makes it an Uncooking pot: a cooked thing goes in and a raw
// thing comes out, keeping whichever of the two it was.
[oplocu,loc_8985]
if (last_useitem = evil_bob_cooked_fish_correct) {
    @macro_evil_bob_uncook(evil_bob_cooked_fish_correct, evil_bob_uncooked_fish_correct);
}
if (last_useitem = evil_bob_cooked_fish_incorrect) {
    @macro_evil_bob_uncook(evil_bob_cooked_fish_incorrect, evil_bob_uncooked_fish_incorrect);
}
~displaymessage(^dm_default);

[label,macro_evil_bob_uncook](namedobj $from, namedobj $to)
anim(human_cooking, 0);
sound_synth(uncooking, 1, 0);
p_delay(3);
inv_del(inv, $from, 1);
inv_add(inv, $to, 1);
mes("Steam goes back into the pot and the fish comes out raw.");

[oploc1,loc_8987] // Portal
if (%macro_event ! ^macro_evil_bob) {
    mes("The portal fades as you reach for it.");
    return;
}
if (npc_find(coord, macro_evil_bob_island, 24, 0) = true) {
    if (%npc_int ! ^evil_bob_asleep) {
        mes("The cat is watching you. You get the feeling he would rather you stayed.");
        return;
    }
}
mes("You step through the portal.");
~macro_evil_bob_leave;

// ============================================================================ Bob and his servants

// Bob settles down a moment after he has eaten, in his own script, for the reason above.
[ai_queue1,macro_evil_bob_island]
npc_anim(cat_lay_down, 0);

[opnpc1,macro_evil_bob_island]
if (%macro_event ! ^macro_evil_bob) {
    ~chatnpc("<p,neutral>Mrrp.");
    return;
}
if (%npc_int = ^evil_bob_asleep) {
    ~chatnpc("<p,neutral>Zzzz.");
    mes("He is fast asleep. The portal will let you go now.");
    return;
}
if (inv_total(inv, evil_bob_uncooked_fish_correct) > 0) {
    ~chatnpc("<p,happy>Now THAT is a raw fishlike thing. Give it here.");
    inv_del(inv, evil_bob_uncooked_fish_correct, 1);
    npc_anim(cat_paw, 0);
    // NO npc_delay IN HERE. This is [opnpc1] - a player script with an npc attached - and a delay
    // on the npc corrupts p_active_player for the ~chatnpc below it, which the compiler says
    // plainly and will not build. The lying down is queued on Bob instead.
    npc_queue(1, 0, 3);
    %npc_int = ^evil_bob_asleep;
    ~chatnpc("<p,happy>...mmm. That's the one. I shall have a nap now.");
    mes("Evil Bob curls up and falls asleep. The portal is yours.");
    ~macro_evil_bob_pay;
    return;
}
if (inv_total(inv, evil_bob_uncooked_fish_incorrect) > 0) {
    ~chatnpc("<p,angry>Pfft. That is the WRONG fishlike thing. Fetch me another.");
    inv_del(inv, evil_bob_uncooked_fish_incorrect, 1);
    return;
}
if (inv_total(inv, evil_bob_cooked_fish_correct) > 0 | inv_total(inv, evil_bob_cooked_fish_incorrect) > 0) {
    ~chatnpc("<p,angry>Cooked? COOKED? Put it in the pot and bring it back raw.");
    return;
}
~chatnpc("<p,quiz>I am hungry, and I want a RAW fishlike thing. Ask one of the staff if you can't work it out.");

// "A servant provided hints about the proper sequence of actions needed to put Evil Bob to sleep."
[opnpc1,macro_evil_bob_male_servant] @macro_evil_bob_hint;
[opnpc1,macro_evil_bob_female_servant] @macro_evil_bob_hint;

[label,macro_evil_bob_hint]
if (%macro_event ! ^macro_evil_bob) {
    ~chatnpc("<p,neutral>I only work here.");
    return;
}
if (inv_total(inv, evil_bob_uncooked_fish_correct) > 0 | inv_total(inv, evil_bob_uncooked_fish_incorrect) > 0) {
    ~chatnpc("<p,neutral>Raw, is it? Then take it to him. He'll know if it's the right one.");
    return;
}
if (inv_total(inv, evil_bob_cooked_fish_correct) > 0 | inv_total(inv, evil_bob_cooked_fish_incorrect) > 0) {
    ~chatnpc("<p,neutral>That one's cooked. Pop it in the uncooking pot - the steam goes back in and it comes out raw.");
    return;
}
~chatnpc("<p,neutral>Net something out of the water. They come up cooked here; don't ask me why.");

// "The island event rewarded Magic or Fishing experience." The rate is the genie's lamp - base
// level times ten - so a reward from one random event is worth what a reward from another is.
[proc,macro_evil_bob_pay]
def_int $choice = ~p_choice2("Fishing.", 1, "Magic.", 2);
def_stat $stat = fishing;
if ($choice = 2) {
    $stat = magic;
}
def_int $base = stat_base($stat);
stat_advance($stat, multiply($base, 100)); // stat level * 10, the same as an xp lamp
sound_synth(found_gem, 1, 0);
~mesbox("You have been awarded <tostring(multiply($base, 10))> <~stat_name($stat)> experience!");
