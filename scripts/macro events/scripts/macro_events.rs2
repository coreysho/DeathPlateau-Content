// timer is initiated on login, in scripts\player\scripts\global.rs2
[timer,general_macro_events]
// make sure this is before afk_event is called, to retain the 'queueing' behavior for random event spawning
if (~macro_event_allowed = false) { 
    return;
}
if (afk_event = ^true) {
    // random events arent restricted in wildy? https://youtu.be/uPKaH7yg4To?t=421
    // Not restricted in banks: https://youtu.be/1Rz9Eg4ZHhA
    ~macro_event_general_spawn(~macro_event_set_random);
}


// this is called during:
// - alching. Confirmed: https://youtu.be/2nqpZoHUjSc?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT
// - teleporting. Confirmed: https://youtu.be/ZtnrEwb0n48?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=51
// (probably every spell)
// - cooking. Confirmed: https://youtu.be/Brq99Bdl0aI?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=198
// - cooking on a range: https://youtu.be/Tix1wbx3YCc?t=343
// - using flax wheel. Confirmed: https://youtu.be/sW48OR1I86M (early osrs)
// - using anvil? Cant find a video, not implemented.
// - fletching? Cant find a video, not implemented.
// - flax picking? Cant find a video, but it is implemented.
// - smithing at furnace. Confirmed? https://youtu.be/a6NobmSGBYw
// - crafting at furnace. Confirmed: https://youtu.be/7pS6s5rvvEY
[proc,macro_event_general_spawn](int $event)
if (~macro_event_allowed = false) { 
    return;
}
def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
if ($event_coord = null) {
    return;
}
// the same null, one call earlier: nothing may be marked as the active event if there is no npc
// to be it, so the lookup comes BEFORE %macro_event is written.
def_npc $event_npc = ~macro_event_npc($event);
if ($event_npc = null) {
    return;
}
%macro_event = $event;
npc_add($event_coord, $event_npc, 1000);
%macro_event_uid = npc_uid;
session_log(^log_moderator, "Random event spawned: <nc_debugname(npc_type)>");
switch_int ($event) {
    case ^macro_swarm : ~macro_swarm_spawn;
    case ^macro_triffidseed : ~macro_event_triffid_spawn;
    case ^macro_dwarf : ~macro_dwarf_spawn;
    case ^macro_geni : ~macro_geni_spawn;
    case ^macro_mysterious_old_man : ~macro_mysterious_old_man_spawn;
    case ^macro_evil_chicken : ~macro_evil_chicken_spawn;
    case ^macro_rick_turpentine : ~macro_rick_turpentine_spawn;
    case ^macro_capn_hand : ~macro_capn_hand_spawn;
    case ^macro_certer : ~macro_certer_spawn;
    case ^macro_dr_ford : ~macro_dr_ford_spawn;
    case ^macro_sandwich_lady : ~macro_sandwich_lady_spawn;
    case ^macro_gravedigger : ~macro_gravedigger_spawn;
    case ^macro_drilldemon : ~macro_drilldemon_spawn;
    case ^macro_jekyll : ~macro_jekyll_spawn;
    case ^macro_forester : ~macro_forester_spawn;
    case ^macro_prisonpete : ~macro_prisonpete_spawn;
    case ^macro_evil_bob : ~macro_evil_bob_spawn;
    case ^macro_mime : ~macro_mime_spawn;
    case ^macro_quizmaster : ~macro_quiz_spawn;
    case ^macro_frog : ~macro_frog_spawn;
    case ^macro_pillory : ~macro_pillory_spawn;
}

// this proc is used for random events teleing to follow the player
[proc,macro_event_area](coord $coord)(boolean)
if (~in_duel_arena($coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(trawler_game_zones, $coord) = true | ~inzone_coord_pair_table(trawler_wreck_zones, $coord) = true) { // allowed on boat in pre-game https://youtu.be/7-gUR40Nr8M
    return(false);
}
if (~in_tutorial_island($coord) = true) {
    return(false);
}
return(true);

// this proc is only used for spawning randoms
[proc,macro_event_allowed]()(boolean)
if (~macro_event_area(coord) = false) {
    return(false);
}
// this goes here to allow this bug: https://youtu.be/c0HABEQe41s
// - bug desc: random events will follow you into castle wars
if (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
    return(false);
}
// if this var isnt reset on npc delete, then youll never get a random event: https://youtu.be/vRlOfkCCGkw
if (%macro_event > 0) {
    return(false);
}
return(true);

// called when the player logs in
//
// %macro_event is 0 when no random event was following at logout, which is almost every login, and
// both event tables start at val=1 - so the lookup MISSES. Before enums were given default= it
// answered npc 0, which is hans, and nc_param quietly said false. With default=null it answers null
// and nc_param throws "An input for a Npc type was not valid to use. Input was -1." on every login.
// The guard is the fix; the enum was never the bug, it just stopped hiding this one.
[queue,macro_event_login]
def_int $macro_event = %macro_event;
%macro_event = 0;
def_npc $event_npc = ~macro_event_npc($macro_event);
if ($event_npc = null) {
    return;
}
if (nc_param($event_npc, follow_player_on_logout) = ^true) {
    ~macro_event_general_spawn($macro_event);
}

[proc,macro_event_logout]
if (npc_finduid(%macro_event_uid) = true) {
    %npc_macro_event_target = null;
}

[proc,macro_event_npc](int $event)(npc)
// THE ONE GENERAL EVENT THAT SCALES. Every other entry in the table is one npc whatever your level
// - a genie is a genie - but the Evil Chicken fights you, so it has six records the way the zombie
// and the tree spirit do. The table still names one of them, for its count and for the logout
// param; this is what decides which one you actually meet.
if ($event = ^macro_evil_chicken) {
    return(enum(int, npc, macro_event_evil_chicken_levels, ~macro_event_combat_level));
}
// THE CERTERS ARE THREE BROTHERS and the table can only name one. Which of Niles, Miles and Giles
// turns up is a coin toss each time, exactly as it is in the game.
if ($event = ^macro_certer) {
    return(enum(int, npc, macro_event_certer_brothers, random(enum_getoutputcount(macro_event_certer_brothers))));
}
def_npc $event_npc;
if (map_members = ^true) {
    $event_npc = enum(int, npc, general_macro_events_members, $event);
} else {
    $event_npc = enum(int, npc, general_macro_events_free, $event);
}
return($event_npc);

// WHICH EVENT TO SPAWN, picked from a list rather than counted. This used to roll
// 1..enum_getoutputcount over the npc table, which quietly required that table's ids to run 1..N
// with no gaps - so a members-only event could not be added without either giving it a free id too
// or shifting every id after it, and %macro_event stores an id across a logout. The _pick enums say
// outright which ids each world draws from, so the npc tables are free to have holes.
[proc,macro_event_set_random]()(int)
if (map_members = ^true) {
    return(enum(int, int, general_macro_events_members_pick, random(enum_getoutputcount(general_macro_events_members_pick))));
} else {
    return(enum(int, int, general_macro_events_free_pick, random(enum_getoutputcount(general_macro_events_free_pick))));
}

// used for skilling random events: how many general events this world has, which is what the skill
// dispatchers weight their own events against. The _pick tables, so a members-only event does not
// count towards a free world's odds.
[proc,macro_event_general_count]()(int)
if (map_members = ^true) {
    return(enum_getoutputcount(general_macro_events_members_pick));
}
return(enum_getoutputcount(general_macro_events_free_pick));

// teleports the player to a random location, using the coords in configs/macro_events_teleports.enum
[queue,macro_event_fail_teleport]
session_log(^log_adventure, "Failed random event and got teleported");
def_coord $teleport_coord;
if (map_members = ^true) {
    $teleport_coord = enum(int, coord, macro_event_fail_teleports_members, random(enum_getoutputcount(macro_event_fail_teleports_members)));
} else {
    $teleport_coord = enum(int, coord, macro_event_fail_teleports_free, random(enum_getoutputcount(macro_event_fail_teleports_free)));
}
// https://youtu.be/MS7ADB-hh18
// doesnt if_close
%macro_event = ^no_macro_event;
p_delay(1);
// https://youtu.be/g5k3XuXxyYQ?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=37
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
//--
~p_telejump_safe($teleport_coord); // todo: Confirm this

// called when the npc needs to be poofed away
[proc,macro_event_disappear]
if (npc_findhero = ^true) {
    sound_synth(smokepuff2, 1, 0);
}
spotanim_map(smokepuff, npc_coord, 124, 0);
npc_del;

[proc,macro_event_lost]()(boolean)
if (finduid(%npc_macro_event_target) = true) {
    if (%macro_event_uid ! npc_uid) {
        return(true);
    }
    if (~macro_event_area(coord) = false) {
        return(true);
    }
    // https://youtu.be/vRlOfkCCGkw?t=87
    if (coordy(coord) ! coordy(npc_coord) | npc_range(coord) > 15) {
        npc_tele(map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk));
        spotanim_map(smokepuff, npc_coord, 124, 0);
        sound_synth(smokepuff, 1, 0);
    }
    npc_setmode(playerfollow);
    return(false);
}
return(true);

[proc,macro_event_lost_hostile]()(boolean)
if (finduid(%npc_macro_event_target) = true) {
    if (npc_getmode = wander & (npc_range(coord) > 3 | coordy(npc_coord) ! coordy(coord))) { // seems like distance of 3? https://www.youtube.com/watch?v=GoRX3cp58eo&list=PLn23LiLYLb1am4weMQzkWn5m9b3m9fXv9&t=38s
        return(true);
    }
    return(false);
}
return(true);
// based off https://web.archive.org/web/20060814111255/http://www.zybez.net/misc.php?id=11
[proc,macro_event_combat_level]()(int)
def_int $combat_level = ~player_combat_level;
if ($combat_level < 11) {
    return(^macro_event_cmb_14);
}
if ($combat_level < 21) {
    return(^macro_event_cmb_29);
}
if ($combat_level < 41) {
    return(^macro_event_cmb_49);
}
if ($combat_level < 61) {
    return(^macro_event_cmb_79);
}
if ($combat_level < 91) {
    return(^macro_event_cmb_120);
}

return(^macro_event_cmb_159);

// for 2x2 npcs
[proc,macro_event_coord_2x2]()(coord)
def_int $i = 0;
def_coord $sw;
def_coord $nw;
def_coord $se;
def_coord $ne;
// basically prevent the npc from spawning into anything it shouldnt. and so it doesnt spawn ontop of player
while ($i < 50) {
    $sw = movecoord(coord, ~random_range(-2, 2), 0, ~random_range(-2, 2));
    $nw = movecoord($sw, 1, 0, 0);
    $se = movecoord($sw, 0, 0, 1);
    $ne = movecoord($sw, 1, 0, 1);
    if (map_blocked($sw) = false & map_blocked($nw) = false & map_blocked($se) = false & map_blocked($ne) = false
        & $sw ! coord & $se ! coord & $nw ! coord & $ne ! coord
        & lineofwalk($sw, coord) = true
        ){
        return($sw);
    }
    $i = calc($i + 1);
}
return(null);

[proc,macro_events_hide_tabs]
if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 11);
if_settab(null, 12);

[proc,macro_events_varps_reset]
%macro_event = ^no_macro_event;
%macro_event_target_coord = null;
%macro_event_uid = null;
