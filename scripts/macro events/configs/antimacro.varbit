// WHICH TRADE'S COFFIN BELONGS IN EACH GRAVE - the answer, and the only part of the puzzle the
// player is not looking at. It lives on macro_digger_var_4 rather than beside the grave states
// because macro_digger_var is transmitted for the multilocs, and a varp on the wire is a varp a
// client can read.
[macro_digger_coffin_1]
basevar=macro_digger_var_4
startbit=4
endbit=6

[macro_digger_coffin_2]
basevar=macro_digger_var_4
startbit=7
endbit=9

