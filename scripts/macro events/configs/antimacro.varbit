[macro_digger_name_2]
basevar=macro_digger_var_2
startbit=15
endbit=18

// name_3 had five bits where the other four have four, which pushed name_4 along and left name_5
// starting on bit 27 - the bit name_4 ends on. Two of the five names were the same number. Nothing
// reads these yet, so nothing was broken by it; it is fixed here rather than left as a trap.
[macro_digger_name_3]
basevar=macro_digger_var_2
startbit=19
endbit=22

[macro_digger_name_4]
basevar=macro_digger_var_2
startbit=23
endbit=26

[macro_digger_name_5]
basevar=macro_digger_var_2
startbit=27
endbit=30

