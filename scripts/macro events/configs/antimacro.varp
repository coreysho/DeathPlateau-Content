[macro_event]
scope=perm
protect=no

[macro_event_uid]
protect=no
type=npc_uid

[macro_whirlpool_counter]

[macro_gas_counter]

[macro_ent_counter]

// Where the player was standing when a room event took them away. protect=no because it is written
// from ~macro_event_general_spawn, which is reached from [timer,general_macro_events] and from the
// skilling dispatchers - none of which have protected access.
[macro_event_target_coord]
type=coord
scope=perm
protect=no

// Shared by the room events, one at a time: Candlelight's stage, and the four signposts in
// Sergeant Damien's yard (macro_drilldemon_post_1..4 sit on its low byte). transmit=yes because the
// client resolves the signposts' multilocs out of it; protect=no because the yard is laid out from
// ~macro_event_general_spawn, which is reached from [timer,general_macro_events] and has no
// protected access.
[macro_transmit]
transmit=yes
scope=perm
protect=no

[macro_candlelight_var]
transmit=yes
scope=perm

// THE FIVE GRAVES, AS THE CLIENT SEES THEM. macro_digger_grave_1..5 drive the multilocs on
// loc_12721..12725, so the client has to be told them or every grave stays as it was drawn.
// Transmitting them gives nothing away: whether a grave has a coffin in it is what you are looking
// at. The ANSWER - which coffin belongs in which grave - is macro_digger_coffin_1..5 on
// macro_digger_var_4, which is not transmitted, so a client cannot read the solution off the wire.
[macro_digger_var]
transmit=yes
protect=no

// protect=no on all four, the same as %macro_event above: the cemetery is laid out from
// ~macro_event_general_spawn, which is reached from [timer,general_macro_events] and from every
// skill's dispatcher, and a script without protected access cannot write a varbit. %macro_event has
// carried protect=no since before this; these are the same kind of state for the same reason.
[macro_digger_var_2]
protect=no

[macro_digger_var_3]
protect=no

[macro_digger_var_4]
protect=no

// Sergeant Damien's two: which exercise he has just called for and which of the four have been
// done. NOT transmitted - the four signposts are, on macro_transmit, and they are all the client
// needs to draw the yard. protect=no for the same reason as the gravedigger's above.
[macro_drilldemon_var]
protect=no

// Which pheasant the Freaky Forester asked this player for. Not transmitted: the birds all look
// alike on the client and which one is yours is decided when one dies.
[macro_forester_var]
protect=no

// Which balloon the lever in Prison Pete's cell is showing. The key count is not here - it is
// macro_pete_keys on swansong_temp, where the cache put it, because the doors are built on it.
[macro_pete_var]
protect=no

// What the mime is doing on stage and how much of the act the player has got right.
[macro_mime_var]
protect=no

// How far through the quiz the player is and how much of it they have got right.
[macro_quiz_var]
protect=no

// How many of the wrong frogs this player has kissed.
[macro_frog_var]
protect=no

// The cage's tumblers. transmit=yes because macro_pillory_open drives the door's multiloc and the
// client has to be told, and it gives nothing away: whether your own cage is open is what you are
// looking at.
[macro_pillory_var]
transmit=yes
protect=no

// EVIL BOB'S ISLAND. Nothing here is transmitted: which shore the fish are biting on is the whole
// puzzle, and a varp on the wire is a varp a client can read.
[macro_bob_var]
protect=no
