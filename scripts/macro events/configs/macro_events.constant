// The same marker the three above use, one per talking event this round added: a value %npc_int can
// never reach by counting warnings, so "already dealt with" and "warned once" cannot be confused.
^rick_turpentine_done = -1
^capn_hand_done = -1
^certer_done = -1
^dr_ford_done = -1
^sandwich_lady_done = -1

// LEO'S FIVE TRADES, which are the five symbols the cache carries a stone for - stonecook,
// stonespade, stoneaxe, stonemine, stonevase - and the five coffins runescape.wiki names.
^macro_digger_cook = 1
^macro_digger_farmer = 2
^macro_digger_lumberjack = 3
^macro_digger_miner = 4
^macro_digger_potter = 5
^macro_digger_trades = 5

// The open ground north of the graves, beside Leo and the mausoleum.
^macro_digger_landing = 0_30_78_9_11

// Map square 30_78 holds Pete's chapel (east) and Leo's cemetery (west). The cemetery ends at
// x=1934 and the chapel starts at x=1965; this is the wall between them.
^macro_room_30_78_split = 1950

