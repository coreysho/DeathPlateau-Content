^macro_swarm = 1
^macro_geni = 2
^macro_dwarf = 3
^macro_mysterious_old_man = 4

^macro_triffidseed = 5

// THE EVIL CHICKEN, members only. Not a judgement about the chicken: general_macro_events_free has
// to stay contiguous because ~macro_event_set_random rolls 1..enum_getoutputcount over it, so a
// sixth members event cannot also be a fifth free one without the same event having two ids - and
// %macro_event stores that id across a logout.
^macro_evil_chicken = 6

// The four cheapest of 2006scape's missing randoms: a character apiece, all four already built out
// of 377 parts in antimacro.npc, and nothing to walk into or click but a chat box.
^macro_rick_turpentine = 7
^macro_capn_hand = 8
^macro_certer = 9
^macro_dr_ford = 10

// The fifth of that set, and the only one that needed anything built: her tray is seven things and
// the chooser family stopped at four. multiobj7 is the whole of the extra work.
^macro_sandwich_lady = 11

// THE GRAVEDIGGER, and the first of these that needed a place as well as a person. The cemetery is
// built and Leo is standing in it; see macro_event_gravedigger.rs2.
^macro_gravedigger = 12

// SERGEANT DAMIEN. His yard, his four mats and his four signposts are built and placed in map
// square 49_75; see macro_event_drilldemon.rs2.
^macro_drilldemon = 13

// DR JEKYLL, who needs no room at all: he walks up to you, and if you walk away from him he stops
// being Dr Jekyll. See macro_event_jekyll.rs2.
^macro_jekyll = 14
^jekyll_done = -1

// THE FREAKY FORESTER. His clearing, his thirteen pheasants and his portal home are all built and
// placed in map square 40_74; see macro_event_forester.rs2.
^macro_forester = 15
^macro_forester_tails = 4
// Beside him in the middle of the clearing.
^macro_forester_landing = 0_40_74_40_40

// PRISON PETE. His cell, his lever, his eighteen balloons and the three barriers that are already
// wired to the key count are all built in map square 32_69; see macro_event_prisonpete.rs2.
^macro_prisonpete = 16
^macro_pete_animals = 4
^macro_pete_keys_needed = 3
// Beside Pete, in front of the barriers.
^macro_prisonpete_landing = 0_32_69_40_13

// EVIL BOB. His island - eight fishing spots, two uncooking pots, a portal and two servants - is
// built in map square 39_74; see macro_event_evil_bob.rs2.
^macro_evil_bob = 17
// %npc_int on the island Bob once he has eaten and gone to sleep, which is when the portal opens.
^evil_bob_asleep = -1
// On the sand in front of him.
^macro_evil_bob_landing = 0_39_74_25_42

// THE MIME. His theatre is built in map square 31_74 - 106 walls, 84 chairs, 84 stage tiles,
// curtains, two spotlights and three silent watchers - on three levels, with the seating at the
// bottom and the stage above it. See macro_event_mime.rs2.
^macro_mime = 18
^macro_mime_acts = 8
^macro_mime_acts_needed = 4
// Centre stage, level 1, three tiles in front of him.
^macro_mime_landing = 1_31_74_26_25

// THE QUIZ MASTER. His set is in map square 30_74: two lit three-by-three podiums, a ring of
// invisible walls and two light beams, with one standable tile on each podium and blocked ground
// everywhere else - which is what a game show set is. See macro_event_quiz.rs2.
^macro_quizmaster = 19
^macro_quiz_categories = 5
^macro_quiz_questions = 3
// The contestant's podium. His is the other one, four tiles north.
^macro_quiz_landing = 1_30_74_32_28

