// How many items each tier of chest holds. OSRS gives a better chest more room; these are the
// tunable numbers, like the room prices, and they run a quarter of the list per tier.
[poh_costume_cap]
inputtype=int
outputtype=int
default=null
val=1,24
val=2,48
val=3,72
val=4,96
