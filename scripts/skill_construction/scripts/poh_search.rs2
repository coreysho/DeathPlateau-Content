// SEARCHING A PIECE OF FURNITURE FOR WHAT IS IN IT. One window, fifteen pieces.
//
// Twenty-one pieces carry op1=Search and every one of them used to answer with a message and no
// items - "The tools are all where you left them" at a rack whose own cache desc reads "Hammer,
// chisel, saw and shears." DeathPlateau-Bugs#93.
//
// Fifteen of the twenty-one have published contents: the larder's three tiers, the workshop's five
// tool stores and the kitchen's seven shelves. The bookcase and the scroll rack are the other six
// and are deliberately left as they were - nothing is published for either, and the message they
// give already matches what the world's bookcases say.
//
// A PICKER, NOT A STORE. Every one of those wiki pages says the contents are unlimited, so
// poh_search_items holds one of each only so the client has an icon to draw: a Take click adds to
// the player and leaves the grid alone, and there is no amount to choose and nothing to put back.
// That is the whole difference between this and the tool leprechaun's window, which is a real
// store with counts.
//
// WHY A WINDOW AT ALL. ~p_choice holds five options and the teak shelves hold nine items. "One of
// each in a single click" is fine for a tool rack and wrong for a larder, so the owner picked the
// leprechaun's shape and this is the generic version of it (tools/genpohsearch.py).
//
// The lists are in poh_search_item in poh_furniture.enum, generated by tools/genfurn.py from the
// `search` op1 block of each family in tools/furnspec.json. The index is
// piece's search number * ^poh_search_slots + slot, which is the same flat-run trick
// poh_store_item uses for the costume room.

// $search is the piece's search number, $what goes in the title and $line under it - the generated
// trigger passes all three, because one window serving fifteen pieces has to be told which it is.
[proc,poh_search_open](int $search, string $what, string $line)
if (%poh_instance = null | instance_find(loc_coord) ! %poh_instance) {
    mes("You can only use that in your own house.");
    return;
}
~poh_search_show($search, $what, $line);

// THE WINDOW ITSELF, split from the guard above so that each half can be driven on its own. The
// guard needs a loc standing in the player's own house instance, which is the one thing a sim
// cannot conjure; everything that decides what the player actually gets is below this line and
// tools/sim/pohsearch.ts drives all fifteen pieces through it.
[proc,poh_search_show](int $search, string $what, string $line)
inv_clear(poh_search_items);
def_int $slot = 0;
// Filled in list order with inv_add rather than placed slot by slot: none of these items stack, so
// each add lands in the next free slot and the grid comes out in the order the list is written.
while ($slot < ^poh_search_slots) {
    def_namedobj $item = enum(int, namedobj, poh_search_item, calc($search * ^poh_search_slots + $slot));
    if ($item ! null) {
        inv_add(poh_search_items, $item, 1);
    }
    $slot = calc($slot + 1);
}
if_settext(poh_search_window:title, $what);
if_settext(poh_search_window:subtitle, $line);
inv_transmit(poh_search_items, poh_search_window:items);
if_openmain(poh_search_window);

// Emptied on close as well as on open. On open because the next piece's list is shorter as often
// as it is longer; here because a temp inv left full is a grid the player can still be holding a
// transmit on if anything reopens the window without going through the proc.
[if_close,poh_search_window]
inv_stoptransmit(poh_search_window:items);
inv_clear(poh_search_items);

// poh_search_give turns the clicked slot's obj into a namedobj, which is what inv_add takes - the
// same narrowing pet_variants.enum documents for last_useitem. It answers null for anything that is
// not in a search list, so a grid out of step with its list hands over nothing rather than
// something else.
[inv_button1,poh_search_window:items]
def_namedobj $item = enum(obj, namedobj, poh_search_give, inv_getobj(poh_search_items, last_slot));
if ($item = null) {
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You do not have enough inventory space to take that.");
    return;
}
inv_add(inv, $item, 1);
