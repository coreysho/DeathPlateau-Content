[ai_queue3,slayer_icefiend_1] @icefiend_drop_table;

// AND ITS GOD WARS COPY, level 18. It carries category=gwd_army so that
// [ai_timer,_gwd_army] can find it for the skirmish, and an npc has ONE category -
// so taking that one cost it the drop category it would otherwise have had, and it dropped
// its bones and nothing else. Named here rather than given a table of its own, because it
// is the same creature.
// DeathPlateau-Bugs#107.
[ai_queue3,gwd_icefiend] @icefiend_drop_table;

[label,icefiend_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}


// Tertiary
~trail_easycluedrop(^trail_easy_droprate, npc_coord);

def_int $random = random(128);
if ($random < 4) {
    obj_add(npc_coord, waterrune, calc(random(5) + 1), ^lootdrop_duration);
} else if ($random < 5) {
    obj_add(npc_coord, airrune, calc(random(5) + 1), ^lootdrop_duration);
} else if ($random < 9) {
    obj_add(npc_coord, coins, calc(random(30) + 1), ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, coins, calc(random(20) + 1), ^lootdrop_duration);
} else if ($random < 16) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}
