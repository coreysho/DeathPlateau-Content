// sources:
// https://oldschool.runescape.wiki/w/Jogre#Drops

// todo: RS3 drop table has differences, OSRS one has some logical errors

[ai_queue3,jogre] @jogre_drop_table;

// AND ITS GOD WARS COPY, level 58. It carries category=gwd_army so that
// [ai_timer,_gwd_army] can find it for the skirmish, and an npc has ONE category -
// so taking that one cost it the drop category it would otherwise have had, and it dropped
// its bones and nothing else. Named here rather than given a table of its own, because it
// is the same creature.
// DeathPlateau-Bugs#107.
[ai_queue3,gwd_jogre] @jogre_drop_table;

[label,jogre_drop_table]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Normal drop
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

// Treasure trail
~trail_mediumcluedrop(^trail_medium_droprate, npc_coord);

def_int $random = randominc(128);
if ($random < 30) {
    obj_add(npc_coord, bronze_spear, 1, ^lootdrop_duration);
} else if ($random < 34) {
    obj_add(npc_coord, iron_spear, 1, ^lootdrop_duration);
} else if ($random < 44) {
    obj_add(npc_coord, naturerune, 2, ^lootdrop_duration);
} else if ($random < 46) {
    obj_add(npc_coord, naturerune, 10, ^lootdrop_duration);
} else if ($random < 48) {
    obj_add(npc_coord, naturerune, 5, ^lootdrop_duration);
} else if ($random < 50) {
    obj_add(npc_coord, steel_javelin, 5, ^lootdrop_duration);
} else if ($random < 56) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 64) {
    obj_add(npc_coord, pineapple, 2, ^lootdrop_duration);
} else if ($random < 69) {
    obj_add(npc_coord, knife, 1, ^lootdrop_duration);
} else if ($random < 72) {
    obj_add(npc_coord, bones, 1, ^lootdrop_duration);
} else if ($random < 75) {
    obj_add(npc_coord, big_bones, 1, ^lootdrop_duration);
} else if ($random < 77) {
    obj_add(npc_coord, big_bones, 3, ^lootdrop_duration);
} else if ($random < 79) {
    obj_add(npc_coord, bones, 1, ^lootdrop_duration);
} else if ($random < 80) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
} else if ($random < 85) {
    obj_add(npc_coord, unidentified_snake_weed, 1, ^lootdrop_duration);
} else if ($random < 90) {
    obj_add(npc_coord, unidentified_rogues_purse, 1, ^lootdrop_duration);
} else if ($random < 117) {
    obj_add(npc_coord, village_trade_sticks, 22, ^lootdrop_duration);
} else {
    obj_add(npc_coord, ~roll_general_seed_table(nc_vislevel(npc_type)), ^lootdrop_duration);
}

if (random(^champion_scroll_chance) = 0) {
obj_add(npc_coord, champions_challenge_jogre, 1, ^lootdrop_duration);
}
