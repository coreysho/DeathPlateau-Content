[ai_queue3,slayer_pyrefiend_1] @pyrefiend_death;
[ai_queue3,slayer_pyrefiend_2] @pyrefiend_death;
[ai_queue3,slayer_pyrefiend_3] @pyrefiend_death;
[ai_queue3,slayer_pyrefiend_4] @pyrefiend_death;
// AND ITS GOD WARS COPY, level 48. It carries category=gwd_army so that
// [ai_timer,_gwd_army] can find it for the skirmish, and an npc has ONE category -
// so taking that one cost it the drop category it would otherwise have had, and it dropped
// its bones and nothing else. Named here rather than given a table of its own, because it
// is the same creature.
// DeathPlateau-Bugs#107.
[ai_queue3,gwd_pyrefiend] @pyrefiend_death;

[label,pyrefiend_death]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
~pyrefiend_death_loot; // the rolls themselves, so a superior can take three (skill_slayer/scripts/superiors.rs2)

[proc,pyrefiend_death_loot]

// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 4) {
    obj_add(npc_coord, steel_axe, 1, ^lootdrop_duration);
} else if ($random < 8) {
    obj_add(npc_coord, steel_full_helm, 1, ^lootdrop_duration);
} else if ($random < 11) {
    obj_add(npc_coord, staff_of_fire, 1, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, mithril_chainbody, 1, ^lootdrop_duration);
} else if ($random < 14) {
    obj_add(npc_coord, steel_armoured_boots, 1, ^lootdrop_duration);
} else if ($random < 15) {
    obj_add(npc_coord, adamant_med_helm, 1, ^lootdrop_duration);
} else if ($random < 36) {
    obj_add(npc_coord, firerune, 30, ^lootdrop_duration);
} else if ($random < 44) {
    obj_add(npc_coord, firerune, 60, ^lootdrop_duration);
} else if ($random < 49) {
    obj_add(npc_coord, chaosrune, 12, ^lootdrop_duration);
} else if ($random < 52) {
    obj_add(npc_coord, deathrune, 3, ^lootdrop_duration);
} else if ($random < 76) {
    obj_add(npc_coord, coins, 40, ^lootdrop_duration);
} else if ($random < 96) {
    obj_add(npc_coord, coins, 120, ^lootdrop_duration);
} else if ($random < 106) {
    obj_add(npc_coord, coins, 200, ^lootdrop_duration);
} else if ($random < 113) {
    obj_add(npc_coord, coins, 10, ^lootdrop_duration);
} else if ($random < 115) {
    obj_add(npc_coord, coins, 450, ^lootdrop_duration);
} else if ($random < 123) {
    obj_add(npc_coord, gold_ore, 1, ^lootdrop_duration);
} else if ($random < 125) {
    obj_add(npc_coord, jug_wine, 1, ^lootdrop_duration);
} else if ($random < 128) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}

