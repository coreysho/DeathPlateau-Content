// The silvthrill rod, which is In Aid of the Myreque's own step: the rod is cast with a sapphire in
// the head of it and the walkthrough has you cast Lvl-1 Enchant on the stone. burgh_rod_command1 and
// burgh_rod_command2 are the cache's two rods - the same description, the second one "it has been
// enchanted" - and nothing could turn one into the other. It takes the sapphire ring's animation,
// because what is being enchanted is a sapphire.
data=convertobj,burgh_rod_command1,burgh_rod_command2,human_cast_enchantring,enchant_ring,enchant_sapphire_ring
data=additional_reqmessage,"This spell can only be cast on Sapphire Amulets, Necklaces and Rings."
data=specificobj_reqmessage,unstrung_sapphire_amulet,You need to string the Sapphire Amulet before enchanting it.

[magic_spell_enchant_level2]
table=magic_spell_table
data=spell,^enchant_lvl2
data=members,false
data=levelrequired,27
data=runesrequired,airrune,3,cosmicrune,1,null,null
data=experience,370
data=convertobj,emerald_ring,ring_of_dueling_8,human_cast_enchantring,enchant_ring,enchant_emerald_ring
data=convertobj,strung_emerald_amulet,amulet_of_defence,human_enchantamuletlvl2,enchant_amulet_lvl2,enchant_emerald_amulet
// The Binding necklace. The ITEM was already here and already working - magic_emerald_necklace is
// in the cache named "Binding necklace", it drops from the three abyssal creatures
// (drop_tables/configs/npc_drops.dbrow), and runecraft_combo_runes.rs2 checks the front slot for it
// when you make combination runes. The one thing missing was any way to MAKE one, which is this
// line. It takes the emerald amulet's anim, spotanim and sound, the way the sapphire NECKLACE row
// above takes the sapphire amulet's.
//
// NO CHARGES, deliberately. Old School's binding necklace carries 16 uses; this one is the
// permanent item it has always been here, because the combo-rune check reads the worn slot and
// nothing in the build has ever decremented it. Giving it charges now would silently nerf an item
// players already own and already use.
data=convertobj,emerald_necklace,magic_emerald_necklace,human_enchantamuletlvl2,enchant_amulet_lvl2,enchant_emerald_amulet
// The Amulet of nature (11 July 2005, the Farming update). Lvl-2 Enchant on an emerald amulet
// strung with MAGIC string rather than wool - see skill_crafting/scripts/jewellery/stringing.rs2.
// Both halves were already in the cache with models and no config; skill_farming/scripts/
// amulet_of_nature.rs2 is what it does.
data=convertobj,magic_strung_emerald_amulet,nature_amulet,human_enchantamuletlvl2,enchant_amulet_lvl2,enchant_emerald_amulet
// Jade. Old School casts jade jewellery in SILVER and enchants it at Lvl-2; this build has one
// gem-jewellery window and jade is its seventh gem (skill_crafting/configs/jewellery).
data=convertobj,jade_ring,ring_of_returning_5,human_cast_enchantring,enchant_ring,enchant_emerald_ring
data=convertobj,jade_necklace,necklace_of_passage_5,human_enchantamuletlvl2,enchant_amulet_lvl2,enchant_emerald_amulet
data=convertobj,strung_jade_amulet,amulet_of_chemistry,human_enchantamuletlvl2,enchant_amulet_lvl2,enchant_emerald_amulet
data=additional_reqmessage,This spell can only be cast on emerald and jade jewellery.
data=specificobj_reqmessage,unstrung_emerald_amulet,You need to string the emerald amulet before enchanting it.
data=specificobj_reqmessage,unstrung_jade_amulet,You need to string the jade amulet before enchanting it.

