data=spell,^teleother_falador
data=spellcom,magic:teleother_falador
data=members,true
data=levelrequired,82
data=runesrequired,waterrune,1,soulrune,1,lawrune,1
data=experience,920
data=tele_coord,0_46_52_21_50

[magic_spell_teleother_camelot]
