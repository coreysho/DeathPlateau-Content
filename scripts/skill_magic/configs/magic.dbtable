[magic_staff_table]
column=staff,obj,LIST,INDEXED,REQUIRED
column=rune,namedobj

[magic_spell_table]
column=spell,int,INDEXED,REQUIRED
column=spellcom,component
column=name,string
column=members,boolean
column=levelrequired,int
column=runesrequired,namedobj,int,namedobj,int,namedobj,int
column=wornrequired,namedobj
column=worn_reqmessage,string
column=experience,int
column=loc_type,loc
column=convertobj,obj,namedobj,seq,spotanim,synth,LIST
column=tele_coord,coord
column=additional_reqmessage,string
// LIST added 2026-10-12. ~magic_spell_specificobj_reqmessage (skill_magic/scripts/magic.rs2) has
// always walked this column with db_getfieldcount and returned on the first obj that matches, so it
// was written for several rows from the start - the column just never said so, and no spell had
// needed a second one until Lvl-2 and Lvl-3 Enchant each picked up a second unstrung amulet (the
// jade and topaz ones). One row per spell still reads exactly as before.
column=specificobj_reqmessage,obj,string,LIST
column=stat_change,stat,int,int,LIST
column=freeze_time,int
column=anim,seq
column=spotanim_proj,spotanim,int,int,int,int,int,int,int
column=spotanim_origin,spotanim
column=spotanim_target,spotanim,int
column=sound_cast,synth
column=sound_hit,synth
column=maxhit,int
column=continue_by_autocast,boolean
// Added 2026-09-04 for the combat/Ancient Magicks spell rows (see claude/ancient-magicks.md).
// rune4: an optional 4th rune slot. runesrequired only has 3 fixed pairs, but the Smoke and Shadow
// ancients each cost 4 different runes. Only ever holds a NON-elemental rune (chaos/death/soul/blood)
// - the elemental runes always occupy the first 3 slots - so it deliberately does not go through
// ~staff_runes staff substitution, since no staff supplies those runes.
column=rune4,namedobj,int
// heal_percent: Blood ancients heal the caster for this % of damage dealt.
column=heal_percent,int
// poison_chance/poison_severity: Smoke ancients have a 1-in-<chance> shot at poisoning for <severity>.
column=poison_chance,int
column=poison_severity,int
// Added 2026-09-07. aoe: radius in tiles of the spell's area effect around the primary target.
// 1 gives the 3x3 grid the Ancient Burst and Barrage spells hit. Only read by ~pvm_spell_aoe in
// skill_combat/scripts/player/player_magic.rs2, and only honoured in multiway zones, so every row
// without it behaves exactly as before.
column=aoe,int
