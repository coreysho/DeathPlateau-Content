[if_button,magic:varrock_teleport] @magic_teleport(^varrock_teleport);
[if_button,magic:lumbridge_teleport] @magic_teleport(^lumbridge_teleport);
[if_button,magic:falador_teleport] @magic_teleport(^falador_teleport);
[if_button,magic:camelot_teleport] @magic_teleport(^camelot_teleport);
[if_button,magic:ardougne_teleport] @magic_teleport(^ardougne_teleport);
[if_button,magic:watchtower_teleport] @magic_teleport(^watchtower_teleport);
[if_button,magic:trollheim_teleport] @magic_teleport(^trollheim_teleport);
[if_button,magic:ape_atoll_teleport] @magic_teleport(^ape_atoll_teleport);

// The eight Ancient Magicks teleports (Corey, 2026-09-07). Same label as the normal book - the
// wilderness, quest and pre-tele checks are identical - and the destination comes from the same
// tele_coord column. The only difference is the animation, picked inside magic_teleport below.
[if_button,ancient_magic:paddewwa_teleport] @magic_teleport(^paddewwa_teleport);
[if_button,ancient_magic:senntisten_teleport] @magic_teleport(^senntisten_teleport);
[if_button,ancient_magic:kharyrll_teleport] @magic_teleport(^kharyrll_teleport);
[if_button,ancient_magic:lassar_teleport] @magic_teleport(^lassar_teleport);
[if_button,ancient_magic:dareeyak_teleport] @magic_teleport(^dareeyak_teleport);
[if_button,ancient_magic:carrallanger_teleport] @magic_teleport(^carrallanger_teleport);
[if_button,ancient_magic:annakarl_teleport] @magic_teleport(^annakarl_teleport);
[if_button,ancient_magic:ghorrock_teleport] @magic_teleport(^ghorrock_teleport);

[label,magic_teleport](int $spell)
if_close;
if (p_finduid(uid) = true) {
    // look for spell in db
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~check_spell_requirements($spell_data)= false) {
        return;
    }
    if (~wilderness_level(coord) > 20) {
        mes("A mysterious force blocks your teleport spell!");
        mes("You can't use this teleport after level 20 wilderness.");
        return;
    }
    if($spell = ^ardougne_teleport & %elenaquest < ^elena_complete) {
        mes("You must have completed Plague City to use this spell.");
        return;
    }
    if($spell = ^watchtower_teleport & %itwatchtower < ^itwatchtower_complete) {
        mes("You must have completed Watch Tower to use this spell.");
        return;
    }
    // https://www.reddit.com/r/2007scape/comments/b4vdki/watchtower_teleport_not_working_despite/, https://runescape.salmoneus.net/forums/topic/212538-cant-do-ardougne-tele-why-is-it-so/
    if(($spell = ^ardougne_teleport & %elenaquest < ^elena_complete_read_scroll) | ($spell = ^watchtower_teleport & %itwatchtower < ^itwatchtower_complete_read_scroll)) {
        mes("You havn't learnt how to cast this spell yet.");
        return;
    }
    // Ape Atoll: quest-gated like the two above, and it eats a banana on top of its runes.
    // magic_spell_table has no column for a plain inventory cost - runesrequired is rune-shaped,
    // and check_spell_requirements builds its failure message by stripping " Rune" off the obj
    // name - so the banana is checked here, beside the other per-spell exceptions, and deleted
    // below next to the runes.
    if($spell = ^ape_atoll_teleport & %mm_main < ^mm_complete) {
        mes("You must have completed Monkey Madness to use this spell.");
        return;
    }
    // Trollheim shipped ungated because Eadgar's Ruse did not exist. It does now, so it is gated
    // the same way Ape Atoll is.
    if($spell = ^trollheim_teleport & %eadgar_quest < ^eadgar_complete) {
        mes("You must have completed Eadgar's Ruse to use this spell.");
        return;
    }
    if($spell = ^ape_atoll_teleport & inv_total(inv, banana) < 1) {
        mes("You need a banana to cast this spell.");
        return;
    }
    if (~pre_tele_checks(coord) = false) {
        return;
    }
    if (afk_event = ^true) {
        ~macro_event_general_spawn(~macro_event_set_random);
        return;
    }
    // delete runes and give xp
    ~delete_spell_runes($spell_data);
    if($spell = ^ape_atoll_teleport) {
        inv_del(inv, banana, 1);
    }
    ~give_spell_xp($spell_data);
    // give additional affects
    // teleport player. Always a radius of 2
    def_coord $dest = map_findsquare(db_getfield($spell_data, magic_spell_table:tele_coord, 0), 0, 2, ^map_findsquare_lineofwalk);
    // The ancient teleports use the cache's own zaros_teleport seq and spotanim rather than the
    // normal book's human_castteleport / teleport_casting pair. Both were already in the 377 cache
    // (seq 1988, spotanim 392) and unused. Keyed off the spell id range so no other caller of
    // ~player_teleport_normal - jewellery, quest teleports, random events - is affected.
    if ($spell >= ^paddewwa_teleport & $spell <= ^ghorrock_teleport) {
        ~player_teleport_ancient($dest);
        return;
    }
    // the Lunar book's eight (skill_magic/scripts/lunar/lunar_travel.rs2)
    if (~spell_is_lunar($spell) = true) {
        ~player_teleport_lunar($dest);
        return;
    }
    ~player_teleport_normal($dest);
}

[proc,player_teleport_normal](coord $coord)
if_close;
p_stopaction;
sound_synth(teleport_all, 1, 0);
anim(human_castteleport, 0);
spotanim_pl(teleport_casting, 92, 0);
p_delay(2);
~p_telejump_safe($coord);

[proc,player_teleport_ancient](coord $coord)
if_close;
p_stopaction;
sound_synth(teleport_all, 1, 0);
anim(zaros_teleport, 0);
spotanim_pl(zaros_teleport, 92, 0);
p_delay(2);
~p_telejump_safe($coord);

[proc,p_telejump_safe](coord $coord)
// Every teleport animation ends shrunk and holds that frame (human_castteleport for 400 seconds),
// and walking cannot end it, so a teleport that does not happen still has to let it go.
if (stat(hitpoints) = 0) {
    anim(null, 0);
    return;
}
if (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
    anim(null, 0);
    return; // https://youtu.be/Yk7DSYxGucE?t=111 Random event is supposed to teleport you & note. But he only notes
}
p_telejump($coord);
anim(null, 0);
// todo: ensure this proc is used for other teleports too
def_int $rum = inv_total(inv, karamja_rum);
if ($rum > 0) {
    inv_del(inv, karamja_rum, $rum);
    mes("Your Karamjan rum gets broken and spilled.");
}
if(inv_total(inv, plaguesample) > 0) { // Biohazard plague sample
    inv_del(inv, plaguesample, ^max_32bit_int);
    mes("The plague sample is too delicate...it disintegrates in the crossing.");
    return;
}
~trollromance_leave_with_sled; // Troll Romance sled

// MAGIC, AND THINGS THAT ARE NOT MAGIC. Split in two on 13 October 2026, because the single proc
// made Monkey Madness uncompletable and did it silently.
//
// Awowogei sends you to the Ardougne zoo for one of his own and tells you - correctly - that you
// must carry him home because he will not survive a teleport. ~mm_carrying_monkey_teleport_check
// enforces that. But @mm_travel, the one label behind BOTH Waydar's glider and Lumdo's boat, also
// called this proc, and those two are the only route back to Ape Atoll. So you picked "Let's go.",
// the dialogue ran to the end, and you stayed in the hangar. Found by playing the quest through:
// it stopped at stage 12 of 20 with nothing on screen to say why.
//
// A glider and a rowboat are vehicles. The monkey rides in them; he just cannot be teleported.
// Everything else in here - a duel, Castle Wars, the trawler, a random event, Ana in her barrel -
// applies to any way of leaving, so it lives in ~pre_travel_checks and both callers get it.
[proc,pre_tele_checks](coord $coord)(boolean)
if (~mm_carrying_monkey_teleport_check = false) {
    return(false);
}
return(~pre_travel_checks($coord));

[proc,pre_travel_checks](coord $coord)(boolean)
if(inv_total(inv, thanainabarrel) > 0) {
    ~chatnpc_specific("Ana (in a Barrel)", anabarrel, "<p,idle>@dbl@-- You can't teleport while holding the barrel, it's just @dbl@too difficult to concentrate. --");
    return(false);
}
if (~inzone_coord_pair_table(trawler_wreck_zones, $coord) = true) {
    ~mesbox("Water and magic don't mix!|You can't teleport whilst swimming."); // osrs
    return(false);
}
if (~inzone_coord_pair_table(trawler_game_zones, $coord) = true) {
    ~mesbox("You're too far from shore to teleport!"); // osrs
    return(false);
}
if (~inzone_coord_pair_table(random_event_mime_zones, $coord) = true) {
    say("I need to finish my performance!"); // https://www.youtube.com/watch?v=aGIPPPlADys&t=92s
    return(false);
}
if (~inzone_coord_pair_table(random_event_maze_zones, $coord) = true) {
    say("I need to find the center of the maze!"); // https://www.youtube.com/watch?v=SFugJO98ap4
    return(false);
}
if (~in_duel_arena($coord) = true) {
    mes("Coward! You can't teleport from a duel."); //RS3 message: https://archive.org/details/runelibris
    //Colored in #AB0908 in RS3, but was likely not colored in 2004
    return(false);
}
if (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
    ~mesbox("You can't leave just like that!"); // osrs
    return(false);
}
return(true);
