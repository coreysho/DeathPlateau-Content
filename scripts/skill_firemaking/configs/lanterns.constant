// A LIT CANDLE GOING INTO A LANTERN needs Firemaking 4, where an unlit one needs nothing at all.
// Four is the candle lantern's own light level, which is the level the live game asks for on both
// of its lit recipes and on neither of its unlit ones (/w/Candle_lantern). No experience either
// way - the recipes all read skill1exp = 0.
^candle_lantern_lit_level = 4
