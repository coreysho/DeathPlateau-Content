// OSRS locs imported by tools/models/importosrslocs.py (osrslocimport.py).
// Models re-encoded by osrs2ob2.py with the loc recolours baked in.
//
// ALECK'S HUNTER EMPORIUM, Yanille. The building is 377's own - the house east of the Dragon Inn
// (m40_48, local 3..10 x 6..14) - and in November 2006 Jagex refitted it as the Hunter shop. The rev
// 474 cache carries no XTEA key for m40_48, so the refit is read off the OSRS map (rev236), which
// matches 377's walls, door and windows loc for loc: its floor (overlay 16 for 5) and its furniture.
// These are the four pieces 377 does not have - the counter Aleck stands at and three wall shelves of
// Hunter gear (jars, a snare); the rest of it is 377's own crates (sarim_crate*), bird cage
// stand, chair and lanterns, and the 474 bookcase Lunar Isle already imported (loc474_16707). OSRS's
// loc 19751 there is an invisible map-area marker (the Hunter shop's minimap icon, which the 377 client
// has no sprite for) and is not placed. See the Emporium section of scripts/hunter_imps.rs2.

[hunter_emporium_counter]
// OSRS loc 19699
name=Counter
model=osrsloc_19699
width=2
blockrange=no

[hunter_emporium_shelf_jars]
// OSRS loc 19703
model=osrsloc_19703
ambient=10
contrast=50

[hunter_emporium_shelf_snare]
// OSRS loc 19704
model=osrsloc_19704
ambient=10
contrast=50

[hunter_emporium_shelf]
// OSRS loc 19705
model=osrsloc_19705
ambient=10
contrast=50

// The Emporium's minimap icon, which the header above said the 377 client had no sprite for. It has
// one now: OSRS's own Hunter shop icon, a kebbit (sprite 1513, reached from loc 19751's maparea 67),
// written into mapfunction slot 71 by tools/models/genmapicon.py.
//
// An icon is always a loc of its own and never the building: the client only reads mapfunction off
// GROUND DECORATION (shape 22), which is why Jagex marks shops with general_store_icon and the like -
// an invisible model, forcedecor - and why this sits on its own tile. Placed in maps/m40_48.jm2 at
// local 6,10, the tile OSRS places 19751 on, which is the floor just inside the door.
[hunter_emporium_icon]
model=minigame_start_icon
forcedecor=yes
mapfunction=71
