// The side pack's five options move with the quantity buttons exactly as the bank grid's do, and
// for the same reason: with All selected the old code overwrote the only "Deposit 1" entry there
// was. ~bank_op_amount (bank_bar.rs2) is the one place op -> amount is decided for both grids.
[inv_button1,bank_side:inv] @bank_deposit(last_slot, ~bank_op_amount(1));
[inv_button2,bank_side:inv] @bank_deposit(last_slot, ~bank_op_amount(2));
[inv_button3,bank_side:inv] @bank_deposit(last_slot, ~bank_op_amount(3));
[inv_button4,bank_side:inv] @bank_deposit(last_slot, ~bank_op_amount(4));
[inv_button5,bank_side:inv] @bank_deposit(last_slot, ~bank_op_amount(5));
[inv_buttond,bank_side:inv] inv_movetoslot(inv, inv, last_slot, last_targetslot);

[label,bank_deposit](int $slot, int $requested_number)
// Check if the slot was empty.
def_obj $item = inv_getobj(inv, $slot);
// How many did they want to deposit?
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
// How many have they got?
def_int $number = inv_total(inv, $item);
// How many should we deposit?
if ($requested_number < $number) $number = $requested_number;
// Is it actually bankable?
if (~bank_check_nobreak($item) = true) {
    // custom handling here if needed.
    return;
}
// Okay, deposit it into the bank.
~bank_deposit_request(inv, $item, $number, $slot);
