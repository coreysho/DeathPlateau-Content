// The bank's bottom button bar (Corey, 2026-09-12). See claude/bank-tabs.md.
//
// Twelve buttons across the bottom of the bank window, OSRS's own art on all of them:
//   [Swap][Insert]  [Item][Note]  [1][5][10][X][All]  [Search]  [Dep inv][Dep worn]
// The four on the left already existed as text-labelled radio pairs and still live in bank.rs2;
// this file owns the eight new ones. tools/genbankbar.py draws the row.
//
// THE QUANTITY BUTTONS are radio buttons over one varp, exactly like Swap/Insert - buttontype=
// select writes %bankquantity client side on click AND sends this if_button, so the highlight is
// instant and the server still learns about it. What the server then does is rewrite ALL FIVE
// right-click options of both grids with if_setinvop, so the left click reads "Withdraw 10" and
// the four entries under it are the four amounts that are NOT selected.
//
// Rewriting all five is the fix for "when 'all' or 'x' amount is selected in bank you cannot
// withdraw 1" (Corey, 2026-09-30). Only option 1 used to be rewritten, and option 1 is the cache's
// "Withdraw 1" - so choosing All overwrote the only Withdraw-1 entry there was and left the menu
// reading All / 5 / 10 / All / X. OSRS always offers all five however the buttons are set; the
// selected one is only ever the LEFT click. The order here is OSRS's own - 1, 5, 10, X, All -
// which is already the order the ^bank_qty_* constants are numbered in, so a mode IS its rank.

[if_button,bank_main:bankqty1] ~bank_setquantity(^bank_qty_1);
[if_button,bank_main:bankqty5] ~bank_setquantity(^bank_qty_5);
[if_button,bank_main:bankqty10] ~bank_setquantity(^bank_qty_10);
[if_button,bank_main:bankqtyall] ~bank_setquantity(^bank_qty_all);

[if_button,bank_main:bankqtyx]
// The client has ALREADY flipped %bankquantity to X by the time this runs - buttontype=select
// applies its own operand locally before sending. So a cancelled prompt has to put the varp back
// rather than leave the bank sitting on an X of nothing.
p_countdialog;
if (last_int <= 0) {
    ~bank_setquantity(^bank_qty_1);
    return;
}
%bankquantity_x = last_int;
~bank_setquantity(^bank_qty_x);

[proc,bank_setquantity](int $quantity)
%bankquantity = $quantity;
~bank_apply_quantity;

// Push the current choice into the two grids' five options and onto the X button's face.
// Called on every change and once on open, because if_setinvop is not sticky: the client rebuilds
// a component's options from the cache whenever the interface is loaded (Component.unloadCom).
[proc,bank_apply_quantity]
def_int $op = 1;
def_string $label = "";
while ($op <= 5) {
    $label = ~bank_op_label($op);
    if_setinvop(bank_main:bank, $op, "Withdraw<$label>");
    if_setinvop(bank_side:inv, $op, "Deposit<$label>");
    $op = add($op, 1);
}
if_settext(bank_main:bankqtyxtext, ~bank_quantity_xlabel);

// Which of the five amounts sits on right-click option $op. Option 1 is whatever the quantity
// buttons are set to; options 2-5 are the other four, walked in ^bank_qty_* order (1, 5, 10, X,
// All) with the selected one skipped. That is why the menu can never lose an entry: the five
// options are a permutation of the five modes rather than four fixed ones plus an overwrite.
[proc,bank_op_mode](int $op)(int)
if ($op <= 1) {
    return(%bankquantity);
}
def_int $mode = ^bank_qty_1;
def_int $rank = 2;
while ($mode <= ^bank_qty_all) {
    if ($mode ! %bankquantity) {
        if ($rank = $op) {
            return($mode);
        }
        $rank = add($rank, 1);
    }
    $mode = add($mode, 1);
}
return(^bank_qty_1);

// The wording on option $op. The SELECTED entry spells out the stored X amount ("Withdraw 6000000")
// because that is what a left click will actually take; the explicit X entry underneath it stays
// the letter X, because clicking that one asks for an amount the way OSRS's Withdraw-X does.
[proc,bank_op_label](int $op)(string)
if ($op <= 1) {
    return(~bank_quantity_label);
}
return(~bank_mode_label(~bank_op_mode($op)));

// How many option $op takes. Same split as the label: the selected X entry uses the stored amount,
// the explicit X entry returns null, which @bank_withdraw and @bank_deposit read as "ask me".
[proc,bank_op_amount](int $op)(int)
def_int $mode = ~bank_op_mode($op);
if ($op <= 1 & $mode = ^bank_qty_x) {
    return(~bank_quantity_amount);
}
return(~bank_mode_amount($mode));

[proc,bank_mode_label](int $mode)(string)
switch_int ($mode) {
    case ^bank_qty_5 : return(" 5");
    case ^bank_qty_10 : return(" 10");
    case ^bank_qty_all : return(" All");
    case ^bank_qty_x : return(" X");
    case default : return(" 1");
}

[proc,bank_mode_amount](int $mode)(int)
switch_int ($mode) {
    case ^bank_qty_5 : return(5);
    case ^bank_qty_10 : return(10);
    case ^bank_qty_all : return(^max_32bit_int);
    case ^bank_qty_x : return(null);
    case default : return(1);
}

// The SELECTED amount, which is the one a left click takes. The four fixed amounts are
// ~bank_mode_amount's business; the only thing this adds is X, which stands for a stored number
// rather than for a prompt once the player has entered one.
[proc,bank_quantity_amount]()(int)
if (%bankquantity = ^bank_qty_x) {
    // belt and braces: the X button never stores a non-positive amount, but a zero here would
    // reach @bank_withdraw as "ask me" and pop a second amount prompt on every left click.
    if (%bankquantity_x > 0) {
        return(%bankquantity_x);
    }
    return(1);
}
return(~bank_mode_amount(%bankquantity));

// The selected amount's wording, the same split as ~bank_quantity_amount: a stored X is spelled
// out in full ("Withdraw 6000000") so the left-click option says what it will really take.
[proc,bank_quantity_label]()(string)
if (%bankquantity = ^bank_qty_x) {
    if (%bankquantity_x > 0) {
        return(" <tostring(%bankquantity_x)>");
    }
    return(" 1");
}
return(~bank_mode_label(%bankquantity));

// OSRS puts the chosen amount on the button once it has been set, so the bar reads 1 5 10 250 All
// rather than 1 5 10 X All. Before anything has been entered it is still an X.
//
// Abbreviated the way the game abbreviates a stack count, because the button is 36px wide and
// p11_full renders "6000000" at 49px - it ran over its neighbours. The widest string this can now
// produce is "2147M" at 29px. Switching to M at a million rather than at ten million (which is
// where stack counts switch) is what keeps "9999K" - 35px, too wide - off the button. The exact
// amount is never lost: it is spelled out in full on the left-click option, "Withdraw 6000000".
[proc,bank_quantity_xlabel]()(string)
if (%bankquantity_x <= 0) {
    return("X");
}
if (%bankquantity_x < 10000) {
    return(tostring(%bankquantity_x));
}
if (%bankquantity_x < 1000000) {
    return("<tostring(divide(%bankquantity_x, 1000))>K");
}
return("<tostring(divide(%bankquantity_x, 1000000))>M");

// ---- placeholders
//
// A placeholder is the bank slot holding its obj with a count of ZERO - see inv_placeholder in
// engine.rs2. It occupies its slot, so the tab arithmetic needs no changes at all: the ranges are
// positional and a placeholder is a position. Two things fall out of the engine for free and are
// worth knowing before changing any of this:
//
//   - DEPOSITING BACK LANDS IN THE STUB. Inventory.add finds an existing stack with getItemIndex,
//     which matches on obj id and ignores the count, so the placeholder IS the existing stack and
//     the deposit stacks into it. bank_deposit_request's occupied-count test then sees no new slot
//     and calls ~banktab_refresh rather than ~banktab_deposited, so the item stays where it was
//     filed. Nothing below had to arrange that.
//   - ~banktab_removed RETURNS EARLY on an occupied slot, which is what lets bank_withdraw_request
//     drop a stub in and then call it unchanged.
//
// Turning the padlock off deliberately leaves existing stubs alone, the way OSRS does. Release all
// is the explicit way to be rid of them.

[if_button,bank_main:banklock] %bankplaceholders = sub(1, %bankplaceholders);
[if_button,bank_main:banklockrelease] ~bank_release_all;

[proc,bank_is_placeholder](int $slot)(boolean)
if (inv_getobj(bank, $slot) = null) {
    return(false);
}
if (inv_getnum(bank, $slot) > 0) {
    return(false);
}
return(true);

[proc,bank_release](int $slot)
if (~bank_is_placeholder($slot) = false) {
    return;
}
inv_placeholder(bank, $slot, null);
~banktab_removed($slot);
~banktab_refresh;

// Top down, because ~banktab_removed closes the gap by shifting everything ABOVE the slot down one.
// Walking upwards would move slots this loop has not visited yet out from under it; walking
// downwards only ever disturbs slots it has already passed.
[proc,bank_release_all]
def_int $slot = sub(inv_size(bank), 1);
def_int $released = 0;
while ($slot >= 0) {
    if (~bank_is_placeholder($slot) = true) {
        inv_placeholder(bank, $slot, null);
        ~banktab_removed($slot);
        $released = add($released, 1);
    }
    $slot = sub($slot, 1);
}
if ($released = 0) {
    mes("You have no placeholders to release.");
    return;
}
~banktab_refresh;

// ---- deposit inventory / deposit worn
//
// Both walk their source inv slot by slot and hand each obj to the same ~bank_deposit_request the
// single-item deposit uses, so the f2p slot limit, the full-bank message, the session log and -
// crucially - ~banktab_deposited all behave exactly as they do for one item at a time. Walking
// FORWARD and re-reading each slot is safe because depositing an obj clears every stack of it:
// slots already visited cannot refill, and slots ahead can only empty.

[if_button,bank_main:bankdepinv] ~bank_deposit_inv;
[if_button,bank_main:bankdepworn] ~bank_deposit_worn;

[proc,bank_deposit_inv]
def_int $slot = 0;
while ($slot < inv_size(inv)) {
    def_obj $obj = inv_getobj(inv, $slot);
    if ($obj ! null & inv_getnum(inv, $slot) > 0) {
        if (~bank_check_nobreak($obj) = false) {
            ~bank_deposit_request(inv, $obj, inv_total(inv, $obj), $slot);
        }
    }
    $slot = add($slot, 1);
}

[proc,bank_deposit_worn]
// The weapon is read BEFORE anything moves: ~update_all wants whatever used to be in the right
// hand so it can put the attack tab back to unarmed.
def_obj $previous_weapon = inv_getobj(worn, ^wearpos_rhand);
def_boolean $moved = false;
def_int $slot = 0;
while ($slot < inv_size(worn)) {
    def_obj $obj = inv_getobj(worn, $slot);
    if ($obj ! null & ~bank_worn_keep($obj) = false & ~bank_check_nobreak($obj) = false) {
        ~bank_deposit_request(worn, $obj, inv_getnum(worn, $slot), $slot);
        if (inv_getobj(worn, $slot) = null) {
            $moved = true;
            if (oc_param($obj, specwep) = ^true) {
                %sa_attack = ^false;
            }
            ~on_unequip($obj);
        }
    }
    $slot = add($slot, 1);
}
if ($moved = true) {
    // once, at the end - ~update_all rebuilds appearance, bonuses and weight, and doing that per
    // slot would send fourteen of each for one click
    ~update_all($previous_weapon);
}

// The handful of things ~unequip refuses to take off. Same list, minus the duel arena check:
// there is no bank inside a duel, so it can never come up here.
[proc,bank_worn_keep](obj $obj)(boolean)
if (~wguild_is_barrels($obj) = true) {
    mes("You can't bank the kegs - put them down first.");
    return(true);
}
if ($obj = ball_gnomeball_game & ~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    mes("You feel it would be cheating to put the ball away whilst on the pitch.");
    return(true);
}
if (($obj = castlewars_cloak_zamorak | $obj = castlewars_cloak_saradomin) & (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true)) {
    mes("You can't remove your team's colours."); // osrs
    return(true);
}
return(false);
