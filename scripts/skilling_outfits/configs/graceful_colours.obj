// THE NINE GRACEFUL RECOLOURS AND THEIR KITS.
//
// GENERATED by tools/gengracefulcolours.py - do not hand-edit, regenerate.
//
// Each piece is a field-for-field copy of its plain record in skilling_outfits/configs/outfits.obj
// with two recolour pairs in front of it, because the whole graceful effect is that record's own
// weight= and param=energy_restore and a colour must not quietly be worth less than the piece it
// is a colour of. See the generator's header for where the two source colours come from and why
// Old School's own house colours could not be imported.

// ---------------------------------------------------------------- Draynor
[graceful_hood_draynor]
name=Draynor graceful hood
desc=Graceful hood, in the colours of Draynor.
recol1s=32656
recol1d=9572
recol2s=22160
recol2d=5346
model=obj_graceful_hood
manwear=obj_graceful_hood_manwear,0
womanwear=obj_graceful_hood_womanwear,0
manhead=obj_graceful_hood_manhead
womanhead=obj_graceful_hood_womanhead
// The bare head inside the hood (OSRS models 63/120, the pair the leather cowl already uses).
// It was left out of the import, so the chathead was a hood with a hole where the face goes.
manhead2=obj_leather_cowl_manhead2
womanhead2=obj_leather_cowl_womanhead2
wearpos=hat
wearpos2=head
wearpos3=jaw
2dzoom=848
2dxan=639
2dyan=24
2dxof=5
weight=-3kg
param=energy_restore,7
cost=35
members=yes
tradeable=no
iop2=Wear
category=armour_helmet
// Skilling outfits carry no combat bonuses and no equip
// requirement in OSRS - they are earned, not gated.
// No experience bonus in OSRS. Its effect is this record's own weight= line, which the
// engine sums into the run energy drain, and its energy_restore param, which it sums over WORN
// equipment in calculateRunWeight() and applies in updateEnergy(). Not in
// outfit_effects.rs2 - there is no script.
// energy_restore is 7, where OSRS pays 3. See tools/gracefulspec.json: the set totals
// 50% against OSRS's 30%, by Corey's choice, and the whole 50 is per piece.
// Which of the six this is, for the recolour kits - skilling_outfits/scripts/
// graceful_colours.rs2. Only the plain pieces carry it.
iop4=Revert
param=graceful_from,graceful_hood
param=graceful_colour,1

