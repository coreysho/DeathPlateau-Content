cost=40
members=yes
tradeable=no
iop2=Wear
category=armour_cape
// Skilling outfits carry no combat bonuses and no equip
// requirement in OSRS - they are earned, not gated.
// No experience bonus in OSRS. Its effect is this record's own weight= line, which the
// engine sums into the run energy drain, and its energy_restore param, which it sums over WORN
// equipment in calculateRunWeight() and applies in updateEnergy(). Not in
// outfit_effects.rs2 - there is no script.
// energy_restore is 8, where OSRS pays 3. See tools/gracefulspec.json: the set totals
// 50% against OSRS's 30%, by Corey's choice, and the whole 50 is per piece.
// Which of the six this is, for the recolour kits - skilling_outfits/scripts/
// graceful_colours.rs2. Only the plain pieces carry it.
iop4=Revert
param=graceful_from,graceful_cape
param=graceful_colour,8

// The kit. A swatch of the cloth: the cape's own inventory model in the colour it makes, so the
// shop window and the backpack both show what you are buying. Untradeable, which also means Grace
// cannot buy it back - ~can_sell_obj refuses untradeables at every shop in this build.
[graceful_kit_rellekka]
name=Rellekka graceful kit
desc=Use it on any graceful piece to recolour it. Revert takes it back off.
model=obj_graceful_cape
recol1s=32656
recol1d=16057
recol2s=22160
recol2d=7534
2dzoom=2320
2dxan=564
2dyan=827
2dxof=2
2dyof=2
cost=50
members=yes
tradeable=no
category=graceful_kit
param=graceful_colour,8

