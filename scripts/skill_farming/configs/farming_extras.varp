// Hand-written, and in its OWN FILE on purpose: farming.varp is generated by
// tools/farming/gen.py and says so at the top, so anything added there is lost the next time the
// crop table is regenerated. These two are not per-patch and have nothing to do with that
// generator, so they live here.

// Which patch the Amulet of nature is bound to, stored as patch index + 1 so that 0 means
// "bound to nothing" - patch index 0 is a real patch (the first Falador allotment).
// See skill_farming/scripts/amulet_of_nature.rs2.
[farming_nature_patch]
scope=perm
