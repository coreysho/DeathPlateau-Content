// Beside farming_roots.param, and out of the generated farming.constant for the same reason.
//
// Old School's tree-root yield is one root at the level that plants the tree and one more every
// eight levels after that, to a maximum of four: oak 15/23/31/39, willow 30/38/46/54, maple
// 45/53/61/69, yew 60/68/76/84, magic 75/83/91/99
// (oldschool.runescape.wiki/w/Tree_roots_(Farming)).
^farming_roots_per_level = 8
^farming_roots_max = 4
