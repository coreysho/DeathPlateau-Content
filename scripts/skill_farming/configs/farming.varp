// Last world minute the whole farming state was brought up to date for this player.
[farming_last_tick]
scope=perm

// DEAD as of 2026-09-18: the tool leprechaun's store is [leprechaun_store], an inv. This varp is
// kept only so ~leprechaun_migrate can empty it into that inv once and set it to zero - three bits
// per tool is where the old cap of seven came from, and OSRS's cap is a hundred.
//   bits 0-2 rakes, 3-5 seed dibbers, 6-8 spades, 9-11 gardening trowels, 12-14 secateurs,
//   bits 15-18 watering can (0 = none stored, 1..9 = a can holding 0..8 doses)
[farming_store_tools]
scope=perm

// World minute the last tree seedling was watered. One value covers every seedling in the
// inventory: they all take the same five minutes, so the only effect of sharing it is that a
// second seedling watered while the first is still going finishes at the same time as it.
[farming_seedling_time]
scope=perm

// Declared for the old leprechaun store and never read or written by anything. Left in place
// rather than deleted: a perm varp's id is how a saved value is found, so freeing an id invites
// whatever is given it next to inherit somebody's stale number.
[farming_store_buckets]
scope=perm

[farming_store_compost]
scope=perm

[farming_store_supercompost]
scope=perm

[farming_store_curepot]
scope=perm

// THE COUNTDOWN THE CLIENT COULD NOT WORK OUT FOR ITSELF (29 October 2026).
//
// A patch's appearance transmits, so the client has always known a crop's stage and whether it is
// diseased or ready. Its CLOCK did not: farming_time_N is the minute a patch last advanced and
// farming_flags_N holds the crop, and neither reaches the client - so "ready in 28 minutes" was
// not something any plugin could compute, only estimate by watching a patch change twice.
//
// farming_due_N is that answer, worked out here where the growth rules already live and sent over
// as one number: the world minute at which this patch next advances. 0 means nothing is coming -
// dead, a stump, or a fully grown plant with no produce to regrow.
//
// WHY THE MINUTE AND NOT "MINUTES LEFT". Minutes left would have to be rewritten every minute for
// every patch, which is 39 varp updates a minute per player forever. A due minute changes only
// when the patch does. The client subtracts it from farming_world_minute below.
//
// scope=temp, because this is derived: ~farming_update recomputes it from farming_time_N and the
// crop, and farming_login runs that for every patch before the player can see anything.
[farming_due_0]
transmit=yes
scope=temp

[farming_due_1]
transmit=yes
scope=temp

[farming_due_2]
transmit=yes
scope=temp

[farming_due_3]
transmit=yes
scope=temp

