// The server's own clock, so the client can turn a due minute into a countdown. Minutes since
// 1 January 2025 UTC, as world_minute counts them. Written once a minute by ~farming_update_all,
// which is one varp a minute per player and the reason farming_due_N does not have to be.
[farming_world_minute]
transmit=yes
scope=temp
