// Farming: what happens when you touch a patch (Corey, 2026-09-05) - see claude/farming-skill.md.
//
// A patch on the map is a multiloc, so the right-click options the player sees come from whichever
// appearance its varbit is currently showing - "Harvest" on a grown allotment, "Check-health" on a
// new tree, "Pick-spine" on a cactus, and nothing at all on bare soil. All of those arrive here as
// op1 on the same parent loc, so every handler starts by asking the patch what it is showing.
//
// Everything else is item-on-patch, which is how the 377 cache was built: there is no "Rake" option
// on a weedy patch, you use the rake on it. Same for the dibber, spade, watering can, compost,
// plant cure and secateurs.

// ============================================================================ helpers

// The tool checks are deliberately forgiving about where the tool is: anything in the inventory
// counts, and the tool leprechaun hands things back on request.
[proc,farming_has_tool](namedobj $tool)(boolean)
if (inv_total(inv, $tool) > 0) {
    return(true);
}
return(false);

[proc,farming_need_tool](namedobj $tool)(boolean)
if (~farming_has_tool($tool) = true) {
    return(true);
}
mes("You need <lowercase(oc_name($tool))> to do that.");
return(false);

// Magic secateurs give a 10% better chance to save a harvest life, whether worn or carried.
[proc,farming_has_magic_secateurs]()(boolean)
if (inv_total(inv, fairy_enchanted_secateurs) > 0) {
    return(true);
}
if (inv_total(worn, fairy_enchanted_secateurs) > 0) {
    return(true);
}
return(false);

// Farming xp is stored x10 on the seed so the published half-points survive; stat_advance wants the
// same x10 scale, so this is a straight pass-through with a guard.
[proc,farming_xp](int $amount)
if ($amount <= 0) {
    return;
}
// Farmer's outfit experience bonus - see skilling_outfits/scripts/outfit_xp.rs2 for the
// per-piece figures. This proc was already the single chokepoint for farming xp, so the
// bonus goes in here rather than at the call sites.
def_int $bonus = ~outfit_xp_bonus(farmers_strawhat, farmers_jacket, farmers_trousers, farmers_boots);
def_int $extra = calc(($amount * $bonus) / 1000);
// The bottomless compost bucket, which OSRS puts on the Hespori - a Farming Guild boss this
// server has no content for. It is a Farming reward for Farming either way, so it rides this
// proc the same way the ten skilling outfits ride theirs: the chance is proportional to what the
// action was worth, which pays for the work rather than for the click. Pre-bonus, so the
// farmer's outfit does not make its own successor come faster.
~compost_bucket_roll($amount);
stat_advance(farming, calc($amount + $extra));
// Farming had no random events at all until now - see "macro events"/scripts/farming. This proc is
// already the single chokepoint every farming action's experience goes through, which is also what
// makes it the right place to roll for one: the roll follows the work rather than the click.
~macro_randomfarming;

// ============================================================================ op1 - the context action

// Reached only from p_oploc(3). The three repeatable jobs are mutually exclusive states of a
// patch - weeds mean no crop, a grown crop is not a stump - so the patch's own state says which
// one to continue, and no extra bookkeeping is needed.
[proc,farming_continue](int $patch)
~farming_update($patch);
if (~farming_crop_id($patch) = 0) {
    if (~farming_get_state($patch) < ^farming_state_weeded & ~farming_has_tool(rake) = true) {
        ~farming_rake($patch);
    }
    return;
}
~farming_op1($patch);

[proc,farming_op1](int $patch)
~farming_update($patch);
def_int $crop = ~farming_crop_id($patch);
if ($crop = 0) {
    ~farming_inspect($patch);
    return;
}
def_namedobj $seed = ~farming_crop_obj($crop);
if ($seed = null) {
    ~farming_inspect($patch);
    return;
}

def_int $stage;
def_int $condition;
def_int $watered;
$stage, $condition, $watered = ~farming_decode($patch, $seed);

if ($condition = ^farming_stump) {
    mes("You need a spade to dig up the stump.");
    return;
}
if ($condition = ^farming_dead) {
    mes("This plant is dead. Clear the patch with a spade.");
    return;
}
if ($condition = ^farming_diseased) {
    mes("This plant is diseased. Treat it with a plant cure before it dies.");
    return;
}
if ($stage < oc_param($seed, farming_stages)) {
    ~farming_inspect($patch);
    return;
}

// Fully grown and healthy. The check-health xp comes first where the family has one.
if (oc_param($seed, farming_check_state) > 0 & ~farming_checked($patch) = false) {
    ~farming_check_health($patch, $seed);
    return;
}

switch_int(oc_param($seed, farming_family)) {
    case ^farming_family_tree : ~farming_chop_tree($patch, $seed);
    case ^farming_family_fruit_tree : ~farming_pick_produce($patch, $seed);
    case ^farming_family_bush : ~farming_pick_produce($patch, $seed);
    case ^farming_family_calquat : ~farming_pick_produce($patch, $seed);
    case ^farming_family_cactus : ~farming_pick_produce($patch, $seed);
    case ^farming_family_mushroom : ~farming_pick_produce($patch, $seed);
    case ^farming_family_spirit_tree : ~farming_spirit_tree($patch, $seed);
    case default : ~farming_harvest($patch, $seed);
}

// ============================================================================ check-health
//
// The single biggest xp drop in the skill, and the reason a magic tree is worth eight hours: it is
// paid once, the first time you look at a finished tree, bush or cactus.

// The Tangleroot. OSRS rolls it at a patch's CHECK-HEALTH where the family has one, and at the
// FINAL harvest - the pick that clears the patch - where it does not. So a ranarr patch is one
// roll however many herbs it gave, and a magic tree is one roll when you look at it.
[proc,farming_pet_roll](namedobj $seed)
~skillpet_roll(skillpet_tangleroot_item, farming, oc_param($seed, farming_pet_base));

[proc,farming_check_health](int $patch, namedobj $seed)
~farming_set_checked($patch, 1);
~farming_set_grown($patch, $seed);
~farming_set_time($patch, ~farming_now);
mes("You examine the <lowercase(oc_name($seed))> for signs of disease and find that it is in perfect health.");
~farming_xp(oc_param($seed, farming_check_xp));
~farming_pet_roll($seed);

// ============================================================================ harvesting
//
// Allotments, hops and herbs use the "lives" system: every pick rolls a chance to save, and only a
// failed roll costs one of the patch's three (or four with compost, five with supercompost) lives.
// That is why a ranarr patch usually gives more than three herbs.

[proc,farming_cts](namedobj $seed)(int)
def_int $low = oc_param($seed, farming_cts_low);
def_int $high = oc_param($seed, farming_cts_high);
if ($low <= 0) {
    return(0);
}
def_int $level = min(stat(farming), 99);
def_int $cts = add(add(divide(multiply($low, sub(99, $level)), 98), divide(multiply($high, sub($level, 1)), 98)), 10);
if (~farming_has_magic_secateurs = true) {
    $cts = divide(multiply($cts, ^farming_magic_secateurs_num), ^farming_magic_secateurs_div);
}
if (~skillcape_worn(farming) = true) { // skill cape perk (skillcapes/scripts/skillcape_perks.rs2): +5%, stacks with the secateurs
    $cts = scale(21, 20, $cts);
}
return($cts);

// Allotments are dug up with a spade; everything else is picked by hand. human_farming is the
// spade animation, farming_pick_mushroom is the bare-handed crouch-and-pick.
[proc,farming_harvest_anim](namedobj $seed)
if (oc_param($seed, farming_family) = ^farming_family_allotment) {
    anim(human_farming, 0);
    return;
}
anim(farming_pick_mushroom, 0);

[proc,farming_harvest](int $patch, namedobj $seed)
def_namedobj $produce = oc_param($seed, farming_produce);
if ($produce = null) {
    ~farming_inspect($patch);
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Your inventory is too full to hold any more <lowercase(oc_name($produce))>.");
    return;
}
if (oc_param($seed, farming_family) = ^farming_family_allotment & ~farming_need_tool(spade) = false) {
    return;
}

// A crop with no chance-to-save table is a single pick: most flowers are one bloom and done.
// Limpwurt is the exception - it carries a cts table and so runs the harvest-lives loop below,
// which is what gives the modern OSRS yield of three roots minimum, more as Farming rises.
if (~farming_cts($seed) <= 0) {
    ~farming_harvest_anim($seed);
    sound_synth(pick, 1, 0);
    p_delay(2);
    inv_add(inv, $produce, 1);
    mes("You harvest <lowercase(oc_name($produce))>.");
    ~farming_xp(oc_param($seed, farming_harvest_xp));
    ~farming_pet_roll($seed);
    ~farming_clear_patch($patch);
    return;
}

// One pick per call, then re-queue through the hidden op3 so the player keeps harvesting without
// re-clicking but can still stop by walking away or clicking something else.
//
// Pacing here comes from %action_delay against map_clock, never p_delay. p_delay sets
// player.delayed, and both MoveClickHandler and OpLocHandler drop the player's input while that
// is set - so a p_delay + p_oploc re-queue loop runs to completion and cannot be stopped by
// walking away or clicking something else. Ordinary woodcutting uses the map_clock idiom for
// exactly this reason (skill_woodcutting/scripts/woodcut.rs2).
if (%action_delay > map_clock) {
    p_oploc(3);
    return;
}
%action_delay = calc(map_clock + 3);
def_int $lives = ~farming_lives($patch);
~farming_harvest_anim($seed);
sound_synth(pick, 1, 0);

inv_add(inv, $produce, 1);
mes("You harvest <lowercase(oc_name($produce))>.");
~farming_xp(oc_param($seed, farming_harvest_xp));

if (random(multiply(^farming_cts_scale, 10)) >= ~farming_cts($seed)) {
    $lives = sub($lives, 1);
}
~farming_set_lives($patch, max($lives, 0));
if ($lives > 0) {
    p_oploc(3);
    return;
}
anim(null, 0);
~farming_pet_roll($seed);
~farming_clear_patch($patch);
mes("You have harvested everything this patch had to offer.");

// Berries, fruit, spines and mushrooms: no lives, just a stock that (mushrooms aside) grows back.
[proc,farming_pick_produce](int $patch, namedobj $seed)
def_namedobj $produce = oc_param($seed, farming_produce);
if ($produce = null) {
    ~farming_inspect($patch);
    return;
}
def_int $left = ~farming_produce_left($patch, $seed);
if ($left <= 0) {
    mes("There is nothing to pick yet.");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Your inventory is too full to hold any more <lowercase(oc_name($produce))>.");
    return;
}

~farming_harvest_anim($seed);
sound_synth(pick, 1, 0);
p_delay(2);

inv_add(inv, $produce, 1);
mes("You pick <lowercase(oc_name($produce))>.");
~farming_xp(oc_param($seed, farming_harvest_xp));

def_int $full = oc_param($seed, farming_checked_state);
if (oc_param($seed, farming_family) = ^farming_family_mushroom) {
    // Mushrooms count the other way and never come back - the last one empties the patch, and
    // being the final harvest of a family with no check-health, it is the one that rolls.
    if ($left <= 1) {
        ~farming_pet_roll($seed);
        ~farming_clear_patch($patch);
        return;
    }
    ~farming_set_state($patch, add(~farming_get_state($patch), 1));
    return;
}
~farming_set_state($patch, max($full, sub(~farming_get_state($patch), 1)));
// Restart the regrowth clock from this pick.
~farming_set_time($patch, ~farming_now);

// ============================================================================ trees

// A grown farm tree is chopped like any other tree: it keeps yielding logs until it happens to
// come down, and only then leaves the stump. The rates, xp, log type and level requirement all
// come out of the woodcutting_trees table, which already lists the five farmed tree locs
// (oak_tree_fullygrown_2 and friends) alongside their wild counterparts - so a farmed oak cuts at
// exactly the same rate as a wild one.
[proc,farming_tree_loc](namedobj $seed)(loc)
switch_obj ($seed) {
    case plantpot_oak_sapling        : return(oak_tree_fullygrown_2);
    case plantpot_willow_sapling     : return(willow_tree_fullygrown_2);
    case plantpot_maple_sapling      : return(maple_tree_fullygrown_2);
    case plantpot_yew_sapling        : return(yew_tree_fullygrown_2);
    case plantpot_magic_tree_sapling : return(magic_tree_fullygrown_2);
    case default                     : return(null);
}

[proc,farming_fell_tree](int $patch, namedobj $seed)
sound_synth(tree_fall, 1, 0);
anim(null, 0);
mes("The tree falls. Only the stump is left - dig it out with a spade.");
def_int $stump = oc_param($seed, farming_stump_state);
if ($stump > 0) {
    ~farming_set_state($patch, $stump);
    ~farming_set_time($patch, ~farming_now);
    return;
}
~farming_clear_patch($patch);

[proc,farming_chop_tree](int $patch, namedobj $seed)
def_loc $tree = ~farming_tree_loc($seed);
if ($tree = null) {
    ~farming_fell_tree($patch, $seed);
    return;
}
db_find(woodcutting_trees:tree, $tree);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~farming_fell_tree($patch, $seed);
    return;
}
def_int $level = db_getfield($data, woodcutting_trees:levelrequired, 0);
if (stat(woodcutting) < $level) {
    mes("You need a Woodcutting level of <tostring($level)> to chop down this tree.");
    return;
}
def_namedobj $axe = ~woodcutting_axe_checker(true);
if ($axe = null) {
    return;
}
def_int $low;
def_int $high;
$low, $high = ~woodcutting_successchance($data, $axe);
def_namedobj $logs = db_getfield($data, woodcutting_trees:product, 0);
def_int $xp = db_getfield($data, woodcutting_trees:productexp, 0);

// One swing per call, re-queued through the hidden op3 - the same way ordinary woodcutting
// re-queues with p_oploc, and the same reason: it has to be possible to stop.
//
// Pacing here comes from %action_delay against map_clock, never p_delay. p_delay sets
// player.delayed, and both MoveClickHandler and OpLocHandler drop the player's input while that
// is set - so a p_delay + p_oploc re-queue loop runs to completion and cannot be stopped by
// walking away or clicking something else. Ordinary woodcutting uses the map_clock idiom for
// exactly this reason (skill_woodcutting/scripts/woodcut.rs2).
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    mes("Your inventory is too full to hold any more logs.");
    return;
}
if (%action_delay > map_clock) {
    p_oploc(3);
    return;
}
%action_delay = calc(map_clock + 3);
anim(struct_param(oc_param($axe, woodcutting_struct), skill_anim), 0);
sound_synth(woodchop1, 1, 0);

if (stat_random(woodcutting, $low, $high) = true) {
    mes("You get some <lowercase(oc_name($logs))>.");
    inv_add(inv, $logs, 1);
    ~woodcutting_xp($xp);
    if (map_members = ^true & ~bird_nest_roll = true) { // 10% more with the Woodcutting cape
        ~drop_bird_nest;
    }
    // The tree comes down on roughly one log in eight, same as a wild tree depleting.
    if (random(8) = 0) {
        ~farming_fell_tree($patch, $seed);
        return;
    }
}
p_oploc(3);

[proc,farming_spirit_tree](int $patch, namedobj $seed)
mes("The spirit tree rustles, but says nothing you can understand yet.");

// ============================================================================ inspect and guide

[proc,farming_inspect](int $patch)
~farming_update($patch);
def_int $crop = ~farming_crop_id($patch);
if ($crop = 0) {
    def_int $weeds = ~farming_get_state($patch);
    if ($weeds >= ^farming_state_weeded) {
        if (~farming_compost($patch) = ^farming_compost_super) {
            mes("The patch is empty and treated with supercompost.");
        } else if (~farming_compost($patch) = ^farming_compost_normal) {
            mes("The patch is empty and treated with compost.");
        } else {
            mes("The patch is empty and ready for planting.");
        }
        return;
    }
    mes("The patch is overgrown with weeds. Use a rake on it to clear them.");
    return;
}

def_namedobj $seed = ~farming_crop_obj($crop);
def_int $stage;
def_int $condition;
def_int $watered;
$stage, $condition, $watered = ~farming_decode($patch, $seed);
def_int $stages = oc_param($seed, farming_stages);

if ($condition = ^farming_stump) {
    mes("Only a stump is left. Dig it out with a spade.");
    return;
}
if ($condition = ^farming_dead) {
    mes("The <lowercase(oc_name($seed))> has died. Clear the patch with a spade.");
    return;
}
if ($condition = ^farming_diseased) {
    mes("The <lowercase(oc_name($seed))> is diseased. Use a plant cure on it, or it will die.");
    return;
}
if ($stage >= $stages) {
    if (oc_param($seed, farming_produce_max) > 0) {
        mes("The plant is fully grown and is holding <tostring(~farming_produce_left($patch, $seed))> item(s).");
        return;
    }
    mes("The crop is ready to harvest.");
    return;
}

mes("The crop is at stage <tostring($stage)> of <tostring($stages)>.");
if ($watered = 1) {
    mes("It has been watered.");
}
if (~farming_protected($patch) = true) {
    mes("The farmer is looking after this patch.");
}

// op4 on every patch is "Guide" in the cache, so it opens the real thing rather than a
// two-line chat message. $patch is unused - the guide is the same wherever you open it from -
// but the parameter stays so the trigger line matches the others.
[proc,farming_guide](int $patch)
~open_farming_guide;
