[proc,pick_pocket](dbrow $data)
def_string $pocket = db_getfield($data, pickpocket:pocket, 0);
// https://www.youtube.com/watch?v=O2n9Hc719YE
mes("You attempt to pick the <$pocket>.");
p_delay(0);

if(npc_stat(hitpoints) = 0) {
    // https://youtu.be/L9dyUj1fiko?si=mK8K0u8o9_d1EVSd&t=70
    mes("Too late, they're dead.");
    return;
}
if (~check_if_success_pick_pocket($data) = false) {
    def_int $stun_ticks = db_getfield($data, pickpocket:stun_ticks, 0);
    def_int $stun_damage = db_getfield($data, pickpocket:stun_damage, 0);
    ~fail_pick_pocket($stun_damage, $stun_ticks, $pocket);
    return;
}

def_int $experience = db_getfield($data, pickpocket:experience, 0);
~pick_pocket_check_for_reward($data);
anim(human_pickpocket, 0);
~thieving_xp($experience);
~skillpet_roll(skillpet_rocky_item, thieving, db_getfield($data, pickpocket:pet_base, 0));
sound_synth(pick, 1, 0);
mes("You pick the <$pocket>.");

[proc,check_if_success_pick_pocket](dbrow $data)(boolean)
def_int $low = 0;
def_int $high = 0;
$low, $high = db_getfield($data, pickpocket:success_chance, 0);
if (~skillcape_worn(thieving) = true) { // skill cape perk (skillcapes/scripts/skillcape_perks.rs2): 10% more likely
    $low = scale(11, 10, $low);
    $high = scale(11, 10, $high);
}
return(stat_random(thieving, $low, $high));

[proc,fail_pick_pocket](int $damage, int $stun_ticks, string $pocket)
npc_say("What do you think you're doing?");
mes("You fail to pick the <$pocket>.");
npc_setmode(playerface);
p_delay(0);
// Birds above head.
spotanim_pl(stunned_thieving, 124, 0);
anim(%com_defendanim, 0);
npc_anim(npc_param(attack_anim), 0);
if (npc_param(attack_sound) ! null) {
    sound_synth(npc_param(attack_sound), 1, 0);
}
sound_synth(stunned, 1, 0);
p_delay(0);
~damage_self($damage);
npc_setmode(null);

mes("You've been stunned!");
%action_delay = calc(map_clock + $stun_ticks);
%stunned = calc(map_clock + $stun_ticks);
walktrigger(stunned);

[proc,steal_from_stall](dbrow $data, coord $loc_coord, int $loc_angle, locshape $loc_shape)
// if guard sees (for first time), stop player from stealing.
// guards proioritize over sellers
if (~stealing_check_for_guard($data) = true) {
    return;
} else if (~stealing_check_for_owner($data) = true) {
   return;
}
def_int $experience = db_getfield($data, stealing:experience, 0);
// osrs is 2x respawn speed, since they removed the scale by playercount
def_int $respawn_ticks = ~scale_by_playercount(db_getfield($data, stealing:respawn_ticks, 0));
anim(human_pickuptable, 0);
sound_synth(pick, 1, 0);
// p_delay here was added with this update: https://oldschool.runescape.wiki/w/Update:Special_Attacks
p_delay(0); 
switch_loc (loc_type) {
    case bakers_stall_stealing : 
        longqueue(stolen_from_stall_baker, ^baker_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^baker_stall_index);
    case tea_stall : 
        longqueue(stolen_from_stall_tea, ^tea_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^tea_stall_index);
    case silk_stall_stealing : 
        longqueue(stolen_from_stall_silk, ^silk_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^silk_stall_index);
    case fur_stall_stealing : 
        longqueue(stolen_from_stall_fur, ^fur_stall_timer, ^discard, 0); 
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^fur_stall_index);
    case silver_stall_stealing : 
        longqueue(stolen_from_stall_silver, ^silver_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^silver_stall_index);
    case spice_stall_stealing : 
        longqueue(stolen_from_stall_spice, ^spice_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^spice_stall_index);
    case gem_stall_stealing : 
        longqueue(stolen_from_stall_gem, ^gem_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^gem_stall_index);
    case seed_stall :
        longqueue(stolen_from_stall_seed, ^seed_stall_timer, ^discard, 0);
        %thieving_stall_timer = setbit(%thieving_stall_timer, ^seed_stall_index);
}
~stealing_check_for_reward($data);
~thieving_xp($experience);
~skillpet_roll(skillpet_rocky_item, thieving, db_getfield($data, stealing:pet_base, 0));
// WHAT A STOLEN STALL BECOMES. `market` is the 2x2 Varrock silver stall and fits every stall in
// the game except the five 1x1 monkey tables in Marim, which would be replaced by a piece of
// Varrock. Each of those names its own picked-over twin in next_loc_stage; everything else is
// unchanged.
def_loc $emptied = market;
if (loc_param(next_loc_stage) ! null) {
    $emptied = loc_param(next_loc_stage);
}
// Temp note: dur does not need updated
loc_change($emptied, $respawn_ticks);

[label,activate_trapped_chest]
p_arrivedelay;
if (map_members = ^false) {
    mes(^mes_members_thieving);
    return;
}

mes("You have activated a trap on the chest.");
anim(human_lockedchest, 0);
sound_synth(lever, 1, 0);
p_delay(0);
// https://oldschool.runescape.wiki/w/Chest_(nature_runes) - damage formula.
def_int $hitpoints = multiply(stat(hitpoints), 12);
def_int $damage = calc($hitpoints / 100);
$damage = calc($damage + 3);
~damage_self($damage);

[proc,disarm_trapped_chest](dbrow $data, loc $loc, coord $loc_coord, int $loc_angle, locshape $loc_shape)
// https://www.youtube.com/watch?v=5SxYEdRdiPU
mes("You find a trap on the chest, "); // extra space matches OSRS
p_delay(1);
mes("You disable the trap.");
sound_synth(locked, 1, 0);
p_delay(1);
mes("You open the chest.");
sound_synth(chest_open, 1, 0);
p_delay(1);
mes("You find treasure inside!");
anim(human_openchest, 0);
// No Rocky roll here: OSRS lists a base chance for pickpocketing, for stalls, for Pyramid
// Plunder's chests and for the Sorceress's Garden, and for nothing else - an ordinary
// thieving chest gives no pet.
~trapped_chest_check_for_reward($data);
def_int $experience = db_getfield($data, trapped_chest:experience, 0);
~thieving_xp($experience);
def_int $respawn_ticks = ~scale_by_playercount(db_getfield($data, trapped_chest:respawn_ticks, 0));
loc_change(loc_2574, 4); //opened chest
p_delay(2);
if (db_getfieldcount($data, trapped_chest:tele_coord) > 0) {
    mes("Suddenly a second magical trap triggers.");
    sound_synth(lever, 1, 0);
    p_teleport(db_getfield($data, trapped_chest:tele_coord, 0));
}
loc_change(loc_2572, $respawn_ticks); //looted chest


[proc,pick_pocket_check_for_reward](dbrow $data)
def_int $count = calc(db_getfieldcount($data, pickpocket:loot) - 1);
// 128 unless the row says otherwise. The Master Farmer's seed table runs from one in six to one in
// nine thousand and cannot be written in 128ths, so its row carries loot_total,10000; every other
// pocket leaves the column out and is unchanged.
def_int $reward_rarity_denominator = 128;
if (db_getfieldcount($data, pickpocket:loot_total) > 0) {
    $reward_rarity_denominator = db_getfield($data, pickpocket:loot_total, 0);
}
// The Rogue outfit doubles what a pickpocket yields. Rolled ONCE, here, rather than once per
// item: it is the theft that doubles, so a pocket paying two things pays double of both or
// neither. Stalls and chests are deliberately untouched - OSRS's set effect is pickpocketing
// only, and their reward procs are the next three below.
def_int $multiplier = 1;
if (~rogue_doubles = true) {
    $multiplier = 2;
}
// ONE OF THESE, OR ALL OF THESE, AND THE WEIGHT SAYS WHICH. This column carries two different
// kinds of table and until 2026-10-12 it treated both as the second kind:
//
//   * A WEIGHTED TABLE, weights adding up to 128 or less, where the pocket pays ONE of the rows -
//     the rogue's, the gnome's, the hero's and the H.A.M. member's. The arithmetic below is the
//     classic single-choice walk: roll against what is left, take the top slice, and the chance of
//     row i works out to exactly w(i)/128 whatever order the rows are in, because the chance of
//     still being in the loop at row i is D(i-1)/128.
//   * GUARANTEED DROPS, every weight 128, where the pocket pays ALL of the rows - the watchman's
//     60 coins AND his loaf of bread, the paladin's coins AND his chaos runes, and every trapped
//     chest and wall safe in the game.
//
// Without the return the first kind over-pays, and badly: the H.A.M. member's 36 rows came to 2.7
// items a pocket, the gnome's six to 1.7 - which is what "am i supposed to be receiving 3 items per
// pickpocket at ham members?" was. With a bare return the second kind under-pays instead, because
// the first 128-weight row it reaches always hits and nothing after it is ever read.
//
// So a weight at or above what is left of the denominator is a guaranteed drop: it is handed over,
// the denominator is left alone, and the loop goes on. Anything less is one row of a weighted table
// and ends the walk. Both kinds keep the behaviour they had, to the item.
while ($count >= 0) {
    def_namedobj $reward;
    def_int $reward_quantity_min;
    def_int $reward_quantity_max;
    def_int $reward_rarity_numerator;
    $reward, $reward_quantity_min, $reward_quantity_max, $reward_rarity_numerator = db_getfield($data, pickpocket:loot, $count);

    if ($reward_rarity_numerator >= $reward_rarity_denominator) {
        // Pickpocketing can reward more than one KIND of thing, when every row is guaranteed.
        def_int $always_roll = ~random_range($reward_quantity_min, $reward_quantity_max);
        inv_add(inv, $reward, calc($always_roll * $multiplier));
    } else {
        def_int $roll = random($reward_rarity_denominator);
        $reward_rarity_denominator = sub($reward_rarity_denominator, $reward_rarity_numerator);
        if ($roll >= $reward_rarity_denominator) {
            def_int $quantity_roll = ~random_range($reward_quantity_min, $reward_quantity_max);
            inv_add(inv, $reward, calc($quantity_roll * $multiplier));
            return;
        }
    }

    $count = calc($count - 1);
}

[proc,stealing_check_for_reward](dbrow $data)
def_int $length = db_getfieldcount($data, stealing:loot);
def_int $count = calc($length - 1);
def_int $reward_rarity_denominator = db_getfield($data, stealing:loot_total, 0);

while ($count >= 0) {
    def_namedobj $reward;
    def_int $min;
    def_int $max;
    def_int $reward_rarity_numerator;
    def_string $reward_message;

    $reward, $min, $max, $reward_rarity_numerator, $reward_message = db_getfield($data, stealing:loot, $count);
    def_int $reward_count = ~random_range($min, $max);
    def_int $rand = random($reward_rarity_denominator);
    $reward_rarity_denominator = sub($reward_rarity_denominator, $reward_rarity_numerator);
    if ($rand >= $reward_rarity_denominator) {
        // https://youtu.be/ZyiWFTAt_1o?t=2
        // extra sound is only from bread? (osrs)
        if ($reward = bread) {
            sound_synth(pick, 1, 0);
        }
        inv_add(inv, $reward, $reward_count);
        mes("You steal <$reward_message>.");
        return;
    }
    $count = calc($count - 1);
}

// THE SAME TWO KINDS OF TABLE as the pickpocket column above, and the same rule. Every chest in
// the game is the guaranteed kind today - all six rows carry weight 128, which is how the Ardougne
// castle chest pays its coins AND its shark AND its ore AND its sapphire - so this walk has never
// over-paid anybody. It would have the moment somebody wrote a weighted chest, the way the H.A.M.
// member's thirty-six rows did, so it is given the same guard rather than left as a trap.
[proc,trapped_chest_check_for_reward](dbrow $data)
def_int $count = calc(db_getfieldcount($data, trapped_chest:loot) - 1);
def_int $reward_rarity_denominator = 128;
while ($count >= 0) {
    def_namedobj $reward;
    def_int $reward_quantity_min;
    def_int $reward_quantity_max;
    def_int $reward_rarity_numerator;
    $reward, $reward_quantity_min, $reward_quantity_max, $reward_rarity_numerator = db_getfield($data, trapped_chest:loot, $count);

    if ($reward_rarity_numerator >= $reward_rarity_denominator) {
        // Trapped chests can reward more than one KIND of thing, when every row is guaranteed.
        def_int $always_roll = ~random_range($reward_quantity_min, $reward_quantity_max);
        inv_add(inv, $reward, $always_roll);
    } else {
        def_int $roll = random($reward_rarity_denominator);
        $reward_rarity_denominator = sub($reward_rarity_denominator, $reward_rarity_numerator);
        if ($roll >= $reward_rarity_denominator) {
            def_int $quantity_roll = ~random_range($reward_quantity_min, $reward_quantity_max);
            inv_add(inv, $reward, $quantity_roll);
            return;
        }
    }

    $count = calc($count - 1);
}
