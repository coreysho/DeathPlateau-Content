// THE DRAYNOR SEED STALL, which tools/silentops.py has been reporting as the one loc in the game
// advertising "Steal from" with nothing behind it. Olivia keeps it and the Market Guard watches
// it, both of them already standing there.
//
// Level 27 and 10 experience are the wiki's. The respawn is NINE seconds and not three: the update
// that cut it is from 2024. The seventeen seeds' drop rates add to exactly 1000/1000 as weights,
// which is how a stall table of this age was written.
[stealing_seed_stall]
table=stealing
data=loc,seed_stall
data=owner,seed_merchant
data=guard,wom_marketguard
data=level,27
data=experience,100
data=respawn_ticks,15
