// THE DRAYNOR SEED STALL, which tools/silentops.py has been reporting as the one loc in the game
// advertising "Steal from" with nothing behind it. Olivia keeps it and the Market Guard watches
// it, both of them already standing there.
//
// Level 27 and 10 experience are the wiki's. The respawn is NINE seconds and not three: the update
// that cut it is from 2024. The seventeen seeds' drop rates add to exactly 1000/1000 as weights,
// which is how a stall table of this age was written.
[stealing_seed_stall]
table=stealing
data=loc,seed_stall
data=owner,seed_merchant
data=guard,wom_marketguard
data=level,27
data=experience,100
data=respawn_ticks,15
data=loot,hammerstone_hop_seed,1,1,120,a hammerstone seed
data=loot,potato_seed,1,1,119,a potato seed
data=loot,marigold_seed,1,1,119,a marigold seed
data=loot,barley_seed,1,1,118,a barley seed
data=loot,onion_seed,1,1,89,an onion seed
data=loot,asgarnian_hop_seed,1,1,83,an asgarnian seed
data=loot,cabbage_seed,1,1,71,a cabbage seed
data=loot,yanillian_hop_seed,1,1,47,a yanillian seed
data=loot,rosemary_seed,1,1,36,a rosemary seed
data=loot,nasturtium_seed,1,1,35,a nasturtium seed
data=loot,tomato_seed,1,1,35,a tomato seed
data=loot,jute_seed,1,1,35,a jute seed
data=loot,sweetcorn_seed,1,1,30,a sweetcorn seed
data=loot,krandorian_hop_seed,1,1,24,a krandorian seed
data=loot,strawberry_seed,1,1,18,a strawberry seed
data=loot,wildblood_hop_seed,1,1,12,a wildblood seed
data=loot,watermelon_seed,1,1,9,a watermelon seed
data=loot_total,1000
data=stall,seed stall
data=pet_base,35815

// ===================================================================================================
// THE FIVE STALLS OF MARIM (27 October 2026)
// ===================================================================================================
// All five carried op2=Steal from in the cache and had no row and no trigger, so "Steal from" on
// any of them did nothing at all. Levels, experience and respawns are the OSRS Thieving table's,
// which lists them under Ape Atoll; respawn_ticks is stored at twice the Old School figure like
// every row above, because ~scale_by_playercount halves it again.
//
// EXPERIENCE IS IN TENTHS, like every row above and like stat_advance itself - the baker's
// stall's 16 experience is written 160. These five were written as 16, 20, 25, 90 and 210
// first and paid a tenth of what they should; tools/sim/mmstalls.ts caught it by dividing the
// experience paid by the number of items taken.
//
// NO OWNER. Every other stall in the game names the merchant who catches you, and the Marim five
// deliberately do not: their owners stand at the counter, so naming them would make the stall
// uncatchable at a range of one tile, and they are the two 65-Thieving stalls the skill is trained
// on. Padulah is the guard instead - "he will accost players if he sees them stealing from various
// stalls around the town" - and at eleven tiles from the nearest stall he only ever does so if he
// has wandered over, which is the wiki's "if he sees them".
//
// No pet_base: the OSRS wiki gives a Rocky base chance per stall and gives none for these five.
// Omitting it means ^skillpet_no_roll and no roll, which is better than inventing odds.

[stealing_mm_food_stall]
table=stealing
data=loc,mm_stall_food
data=guard,mm_padulah
data=level,5
data=experience,160
data=respawn_ticks,12
data=loot,banana,1,1,1,a banana
data=loot_total,1
data=stall,food stall

[stealing_mm_crafting_stall]
table=stealing
data=loc,mm_stall_crafting
data=guard,mm_padulah
data=level,5
data=experience,200
data=respawn_ticks,16
// No bracelet mould: bracelets are not 2006 jewellery and the cache has no mould for one. The
// other five of the wiki's six are here.
data=loot,ring_mould,1,1,1,a ring mould
data=loot,necklace_mould,1,1,1,a necklace mould
data=loot,amulet_mould,1,1,1,an amulet mould
data=loot,chisel,1,1,1,a chisel
data=loot,gold_bar,1,1,1,a gold bar
data=loot_total,5
data=stall,crafting stall

