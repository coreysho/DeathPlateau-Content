womanwear=obj_proselyte_hauberk_womanwear,0
womanwear2=obj_proselyte_hauberk_womanwear2
wearpos=torso
wearpos2=arms
2dzoom=1250
2dxan=488
2dxof=-1
recol1s=6342
recol1d=26048
recol2s=15855
recol2d=25368
recol3s=10570
recol3d=21140
weight=8618g
cost=12000
members=yes
iop2=Wear
// Defences are adamant's, read straight out of adamant_platebody - the wiki says proselyte
// matches adamant and this build's adamant is the thing it has to match. The prayer bonus
// is proselyte's own (+8; the full set is +18).
category=armour_body
param=magicattack,-30
param=rangeattack,-10
param=stabdefence,65
param=slashdefence,63
param=crushdefence,55
param=magicdefence,-6
param=rangedefence,63
param=prayerbonus,8
// Worn gate: [opheld2,proselyte_hauberk] in temple_knight/scripts/temple_knight.rs2.

