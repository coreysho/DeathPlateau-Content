// PROSELYTE ARMOUR - the Temple Knights' second harness, sold by Sir Tiffy Cashien once The Slug
// Menace is done. See scripts/temple_knight/configs/temple_knight.constant for the whole shelf and
// why initiate comes out of the 377 cache while this is a port.
//
// This set is POST-2006 CONTENT - The Slug Menace is 5 February 2007 and proselyte came with it, so
// there is nothing to be faithful to in a 377 cache and the pieces are imported from Old School
// instead, keeping its names (sallet / hauberk / cuisse / tasset), its models and its values.
// Initiate is the opposite case: it shipped in 377 as basic_tk_helm / basic_tk_body / basic_tk_legs
// and is finished in place in scripts/_unpack/377/all.obj rather than re-imported.
//
// NOT HERE: "Proselyte harness m" and "Proselyte harness f". Old School's shop lists both, but a
// harness is a Grand Exchange set placeholder - one obj that an exchange clerk swaps for three
// pieces - and this build has no set mechanic for one to plug into.
//
// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[proselyte_sallet]
name=Proselyte sallet
desc=A Proselyte Temple Knight's helm.
model=obj_proselyte_sallet
manwear=obj_proselyte_sallet_manwear,0
womanwear=obj_proselyte_sallet_womanwear,0
manhead=obj_proselyte_sallet_manhead
womanhead=obj_proselyte_sallet_womanhead
wearpos=hat
wearpos2=head
wearpos3=jaw
2dzoom=800
2dxan=160
2dyan=152
2dxof=-1
2dyof=6
recol1s=15855
recol1d=25368
recol2s=15392
recol2d=26048
weight=2267g
cost=8000
members=yes
iop2=Wear
// Defences are adamant's, read straight out of adamant_full_helm - the wiki says proselyte
// matches adamant and this build's adamant is the thing it has to match. The prayer bonus
// is proselyte's own (+4; the full set is +18).
category=armour_helmet
param=magicattack,-6
param=rangeattack,-2
param=stabdefence,19
param=slashdefence,21
param=crushdefence,16
param=magicdefence,-1
param=rangedefence,19
param=prayerbonus,4
// Worn gate: [opheld2,proselyte_sallet] in temple_knight/scripts/temple_knight.rs2.

[proselyte_hauberk]
name=Proselyte hauberk
desc=A Proselyte Temple Knight's armour.
model=obj_proselyte_hauberk
manwear=obj_proselyte_hauberk_manwear,0
