// Imported from a modern OSRS cache by tools/models/importosrs.py.
// Models are RE-ENCODED from OSRS model format into the 317-family format
// (tools/models/osrs2ob2.py); every one is round-trip verified before writing.
// wearpos/wearpos2/wearpos3 come from the cache - do not hand-edit them.

[skills_necklace_4]
name=Skills necklace(4)
desc=This will help me travel.
model=obj_skills_necklace_4
manwear=obj_skills_necklace_4_manwear,0
womanwear=obj_skills_necklace_4_womanwear,0
wearpos=front
2dzoom=465
2dxan=290
2dyan=166
2dxof=7
2dyof=66
recol1s=10570
recol1d=13331
weight=10g
cost=20200
members=yes
iop2=Wear
iop4=Rub
// Four teleports to the skill guilds this build HAS - see general/scripts/enchanted_jewellry/
// skills_necklace.rs2 for why there are four and not Old School's six.
// No combat bonuses: Old School's skills necklace has none either.
category=skills_necklace
param=next_obj_stage,skills_necklace_3
param=charges,4
wearop1=Fishing Guild
wearop2=Mining Guild
wearop3=Crafting Guild
wearop4=Cooking Guild

