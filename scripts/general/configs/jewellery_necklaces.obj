// phoenix_necklace.rs2 triggers on the obj directly. Old School gives it no combat bonuses.

[amulet_of_eternal_glory]
name=Amulet of eternal glory
desc=A dragonstone amulet with an unlimited supply of magic charges.
model=obj_amulet_of_eternal_glory
manwear=obj_amulet_of_eternal_glory_manwear,0
womanwear=obj_amulet_of_eternal_glory_womanwear,0
wearpos=front
2dzoom=620
2dxan=424
2dyan=68
2dxof=1
2dyof=16
recol1s=32767
recol1d=13331
recol2s=13537
recol2d=32767
recol3s=8321
recol3d=32767
recol4s=32736
recol4d=2114
weight=10g
cost=17625
members=yes
iop2=Wear
iop4=Rub
// A glory whose charge counter is gone. Stats are [amulet_of_glory_4]'s, copied rather than
// invented - Old School's eternal glory is stat-identical to a charged glory and differs only in
// never running down. It deliberately does NOT carry category_557: that category is the four
// charged amulets, whose worn options decrement, and this one must not.
category=amulet_of_eternal_glory
param=stabattack,10
param=slashattack,10
param=crushattack,10
param=magicattack,10
param=rangeattack,10
param=stabdefence,10
param=slashdefence,10
param=crushdefence,10
param=magicdefence,10
param=rangedefence,10
param=strengthbonus,8
param=prayerbonus,3
wearop1=Edgeville
wearop2=Karamja
wearop3=Draynor Village
wearop4=Al Kharid
