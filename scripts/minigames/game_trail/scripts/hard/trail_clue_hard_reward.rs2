// THE ELITE AND MASTER UNIQUES, WHICH HAVE NOWHERE ELSE TO COME FROM.
//
// This build has easy, medium and hard trails and no elite or master, so everything Old
// School puts behind those two would be unreachable: 3rd age druidic, the gilded tools, the
// tuxedos, Ankou, the mummy, the demon masks, Bloodhound. They come out of the hard casket
// instead, reached from its rare roll one time in eight - about 1 in 780 rolls, and with four
// to six rolls a casket, roughly one hard casket in 150 for any of them at all. 112 entries,
// so a particular one is a long way the other side of that.
//
// Kourend's scarves and hoods are left out for the same reason as its banners, and so are the
// seven ornament kits whose base item this build does not have - occult, torture, anguish,
// tormented, dragon full helm, dragon kiteshield and dragon platebody.

[proc,trail_clue_master_rare]
def_int $random = random(112);

switch_int ($random) {
    case 0 : inv_add(trail_rewardinv, dragon_chainbody_ornament_kit, 1);   // Dragon chainbody ornament kit
    case 1 : inv_add(trail_rewardinv, dragon_legs_skirt_ornament_kit, 1);   // Dragon legs/skirt ornament kit
    case 2 : inv_add(trail_rewardinv, dragon_sq_shield_ornament_kit, 1);   // Dragon sq shield ornament kit
    case 3 : inv_add(trail_rewardinv, dragon_scimitar_ornament_kit, 1);   // Dragon scimitar ornament kit
    case 4 : inv_add(trail_rewardinv, fury_ornament_kit, 1);   // Fury ornament kit
    case 5 : inv_add(trail_rewardinv, light_infinity_colour_kit, 1);   // Light infinity colour kit
    case 6 : inv_add(trail_rewardinv, dark_infinity_colour_kit, 1);   // Dark infinity colour kit
    case 7 : inv_add(trail_rewardinv, royal_crown, 1);   // Royal crown
    case 8 : inv_add(trail_rewardinv, royal_gown_top, 1);   // Royal gown top
    case 9 : inv_add(trail_rewardinv, royal_gown_bottom, 1);   // Royal gown bottom
    case 10 : inv_add(trail_rewardinv, royal_sceptre, 1);   // Royal sceptre
    case 11 : inv_add(trail_rewardinv, musketeer_hat, 1);   // Musketeer hat
    case 12 : inv_add(trail_rewardinv, musketeer_tabard, 1);   // Musketeer tabard
    case 13 : inv_add(trail_rewardinv, musketeer_pants, 1);   // Musketeer pants
    case 14 : inv_add(trail_rewardinv, black_dhide_body_g, 1);   // Black d'hide body (g)
    case 15 : inv_add(trail_rewardinv, black_dhide_body_t, 1);   // Black d'hide body (t)
    case 16 : inv_add(trail_rewardinv, black_dhide_chaps_g, 1);   // Black d'hide chaps (g)
    case 17 : inv_add(trail_rewardinv, black_dhide_chaps_t, 1);   // Black d'hide chaps (t)
    case 18 : inv_add(trail_rewardinv, rangers_tunic, 1);   // Rangers' tunic
    case 19 : inv_add(trail_rewardinv, ranger_gloves, 1);   // Ranger gloves
    case 20 : inv_add(trail_rewardinv, holy_wraps, 1);   // Holy wraps
    case 21 : inv_add(trail_rewardinv, bronze_dragon_mask, 1);   // Bronze dragon mask
    case 22 : inv_add(trail_rewardinv, iron_dragon_mask, 1);   // Iron dragon mask
    case 23 : inv_add(trail_rewardinv, steel_dragon_mask, 1);   // Steel dragon mask
    case 24 : inv_add(trail_rewardinv, mithril_dragon_mask, 1);   // Mithril dragon mask
    case 25 : inv_add(trail_rewardinv, adamant_dragon_mask, 1);   // Adamant dragon mask
    case 26 : inv_add(trail_rewardinv, rune_dragon_mask, 1);   // Rune dragon mask
    case 27 : inv_add(trail_rewardinv, katana, 1);   // Katana
