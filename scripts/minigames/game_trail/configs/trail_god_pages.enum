// The twelve god pages of this era, for ~trail_clue_god_page. Saradomin, Zamorak and Guthix only:
// the Armadyl, Bandos and Ancient pages came years later.
[trail_god_pages]
inputtype=int
outputtype=namedobj
default=null
val=0,holy_book_s_page1
val=1,holy_book_s_page2
val=2,holy_book_s_page3
val=3,holy_book_s_page4
val=4,holy_book_z_page1
val=5,holy_book_z_page2
val=6,holy_book_z_page3
val=7,holy_book_z_page4
val=8,holy_book_g_page1
val=9,holy_book_g_page2
val=10,holy_book_g_page3
val=11,holy_book_g_page4
