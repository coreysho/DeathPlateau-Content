category=weapon_2h_sword
param=slashattack,132
param=crushattack,80
param=strengthbonus,132
param=prayerbonus,8
param=attackrate,6
param=slashattack_anim,osrs_2h_slash
param=crushattack_anim,osrs_2h_smash
param=style1_attack_anim,osrs_2h_chop
param=style2_attack_anim,osrs_2h_slash
param=style3_attack_anim,osrs_2h_smash
param=style4_attack_anim,osrs_2h_block
param=defend_anim,osrs_2h_defend
param=specwep,^true
param=sa_energy,500
param=slash_sound,2H_slash
param=crush_sound,2H_crush
param=ready_baseanim,osrs_2h_ready
param=turnonspot_baseanim,osrs_2h_turnonspot
param=walk_f_baseanim,osrs_2h_walk
param=walk_b_baseanim,osrs_2h_walk
param=walk_l_baseanim,osrs_2h_walk_l
param=walk_r_baseanim,osrs_2h_walk_r
