// THE VOID KNIGHTS' EXCHANGE - what commendation points buy, and the window that sells it.
//
// A WINDOW NOW, NOT A CHAT MENU (13 October, Corey: "lets add the void knight exchange to an
// interface instead of chatbox. copy osrs"). It was five p_choice lines and a "show me the helmets"
// submenu, which is not what Old School does and cannot show a price list - let alone an
// experience table whose numbers change with your level, which is the half of the exchange that
// was missing entirely.
//
// WHY IT IS NOT A SHOP. ~openshop trades objs for coins out of a stock inv; commendation points
// are a varp, so there is nothing for a shop to take. That is the same problem the Slayer reward
// window has, and this is the same answer - a window that draws its own rows. The plumbing is
// generated (tools/genvoidui.py -> pest_rewards_ui.rs2), the rewards are data
// (configs/pest_rewards.enum), and every effect is here.
//
// THE PRICES ARE OLD SCHOOL'S and are deliberately not softened. A win pays 3-4 points, so a piece
// of void equipment is sixty-odd games - which is exactly what it is in the game it came from. The
// temptation with a solo variant is to make the reward match the smaller lobby; the reason not to
// is that the gear would then mean less here than it does there, and the gear is the only reason
// the minigame has a second session.
//
// The equip requirements (42 in six combat stats, 22 Prayer) are enforced by void_equip.rs2 and
// are deliberately NOT checked here: Old School sells it to anyone and lets them look at it in the
// bank until they can wear it.

// ============================================================================ the two tabs' data

[proc,void_ui_count](int $tab)(int)
switch_int ($tab) {
    case ^pest_tab_xp : return(enum_getoutputcount(pest_xp_name));
    case ^pest_tab_gear : return(enum_getoutputcount(pest_gear_obj));
}
return(0);

[proc,void_ui_name](int $tab, int $i)(string)
switch_int ($tab) {
    case ^pest_tab_xp : return(enum(int, string, pest_xp_name, $i));
    case ^pest_tab_gear : return(oc_name(enum(int, namedobj, pest_gear_obj, $i)));
}
return("");

// What the right-hand column says. The Equipment tab shows a price; the Experience tab shows what
// the trade would PAY, because the price is whatever the amount selector says and the interesting
// number is the experience - which depends on the player's level and so cannot be a table.
[proc,void_ui_cost_text](int $tab, int $i, int $amount)(string)
switch_int ($tab) {
    case ^pest_tab_gear : return("<tostring(enum(int, int, pest_gear_cost, $i))> pts");
    case ^pest_tab_xp :
        if (~void_xp_per_point($i) <= 0) {
            return("@red@level <tostring(^pest_xp_min_level)>+");
        }
        return("<tostring(~void_xp_total($i, $amount))> xp");
}
return("");

// Green for something already owned, red for something unaffordable, white otherwise. On the
// Experience tab "owned" has no meaning, so the only question is whether the points are there.
[proc,void_ui_tint](int $tab, int $i)(string)
if ($tab = ^pest_tab_gear) {
    if (inv_total(inv, enum(int, namedobj, pest_gear_obj, $i)) > 0
        | inv_total(bank, enum(int, namedobj, pest_gear_obj, $i)) > 0) {
        return("@gre@");
    }
    if (%pest_commendation < enum(int, int, pest_gear_cost, $i)) {
        return("@red@");
    }
}
return("@whi@");

[proc,void_ui_row_fill](int $sel, int $i)(int)
if ($sel = $i) {
    return(^pest_ui_row_on);
}
return(^pest_ui_row_off);

[proc,void_ui_tab_fill](int $tab, int $which)(int)
if ($tab = $which) {
    return(^pest_ui_tab_on);
}
return(^pest_ui_tab_off);

[proc,void_ui_tabtint](int $tab, int $which)(string)
if ($tab = $which) {
    return("@whi@");
}
return("@or1@");

[proc,void_ui_points_text]()(string)
return("@or1@<tostring(%pest_commendation)>@whi@ commendation points");

// The amount selector is the Experience tab's and nothing else's.
[proc,void_ui_amounts_hidden](int $tab)(boolean)
if ($tab = ^pest_tab_xp) {
    return(false);
}
return(true);

[proc,void_ui_amount_fill](int $amount, int $which)(int)
if ($amount = $which) {
    return(^pest_ui_row_on);
}
return(^pest_ui_row_off);

// ============================================================================ the description

[proc,void_ui_desc](int $tab, int $sel, int $amount, int $line)(string)
if ($sel < 0) {
    if ($line = 0) {
        return("@or1@Select something to see what it does.");
    }
    return("");
}
if ($tab = ^pest_tab_gear) {
    return(enum(int, string, pest_gear_desc, calc($sel * 2 + $line)));
}
// The Experience tab describes itself, because its numbers are the description: there is no
// sentence to write that is more useful than the rate and the bonus.
if (~void_xp_per_point($sel) <= 0) {
    if ($line = 0) {
        return("You need level <tostring(^pest_xp_min_level)> <lowercase(enum(int, string, pest_xp_name, $sel))> before the Knights will");
    }
    return("trade you experience in it.");
}
if ($line = 0) {
    return("<tostring(~void_xp_per_point($sel))> experience a point at your level, and <tostring($amount)> <~void_ui_point_word($amount)> buys");
}
return("<tostring(~void_xp_total($sel, $amount))>.<~void_ui_bonus_text($amount)>");

[proc,void_ui_point_word](int $amount)(string)
if ($amount = 1) {
    return("point");
}
return("points");

[proc,void_ui_bonus_text](int $amount)(string)
if ($amount = ^pest_xp_batch_hundred) {
    return(" That includes the <tostring(^pest_xp_bonus_hundred)>% bonus for trading a hundred at once.");
}
if ($amount = ^pest_xp_batch_ten) {
    return(" That includes the <tostring(^pest_xp_bonus_ten)>% bonus for trading ten at once.");
}
return("");

// ============================================================================ the experience

// OLD SCHOOL'S OWN FORMULA: floor(level * level / 600) * N, with N per skill in pest_rewards.enum.
// The BASE level, so a potion cannot be turned into experience.
//
// Below ^pest_xp_min_level the formula is floor(24*24/600) = 0 anyway; returning 0 here rather
// than letting it fall out of the arithmetic is what lets the window say "level 25+" instead of
// offering a trade that would pay nothing.
[proc,void_xp_per_point](int $i)(int)
def_stat $stat = enum(int, stat, pest_xp_stat, $i);
if ($stat = null) {
    return(0);
}
def_int $level = stat_base($stat);
if ($level < ^pest_xp_min_level) {
    return(0);
}
return(multiply(divide(multiply($level, $level), ^pest_xp_divisor), enum(int, int, pest_xp_rate, $i)));

// What $amount points actually pays, bonus included. The bonus is applied to the TOTAL rather than
// per point, which is what makes 100 points worth more than a hundred single trades.
[proc,void_xp_total](int $i, int $amount)(int)
def_int $base = multiply(~void_xp_per_point($i), $amount);
if ($base <= 0) {
    return(0);
}
if ($amount = ^pest_xp_batch_hundred) {
    return(add($base, divide(multiply($base, ^pest_xp_bonus_hundred), 100)));
}
if ($amount = ^pest_xp_batch_ten) {
    return(add($base, divide(multiply($base, ^pest_xp_bonus_ten), 100)));
}
return($base);

// ============================================================================ the window

// One opening. The loop is bounded rather than while(true) for two reasons: a menu that cannot end
// would hang the player script, and the engine spends one opcode budget on the whole session.
[proc,void_rewards_window]
def_int $tab = ^pest_tab_xp;
def_int $sel = -1;
def_int $amount = ^pest_xp_batch_one;
def_int $clicks = 0;
while ($clicks < ^pest_ui_clicks) {
    ~void_ui_draw($tab, $sel, $amount);
    if_openmain(pest_rewards);
    ~void_ui_buttons($tab);
    p_pausebutton;
    $clicks = calc($clicks + 1);
    def_int $clicked_tab = ~void_ui_clicked_tab;
    if ($clicked_tab >= 0) {
        $tab = $clicked_tab;
        $sel = -1;
    } else {
        def_int $clicked_amount = ~void_ui_clicked_amount;
        if ($clicked_amount > 0) {
            $amount = $clicked_amount;
        } else {
            def_int $row = ~void_ui_clicked_row;
            if ($row >= 0) {
                $sel = $row;
            } else if (last_com = pest_rewards:confirm) {
                if (~void_ui_take($tab, $sel, $amount) = true) {
                    $sel = -1;
                }
            } else {
                if_close;
                return;
            }
        }
    }
}
if_close;

// Confirm. Returns true when something happened, so the window can clear its selection.
[proc,void_ui_take](int $tab, int $sel, int $amount)(boolean)
if ($sel < 0) {
    mes("Select something first.");
    return(false);
}
switch_int ($tab) {
    case ^pest_tab_xp : return(~void_buy_xp($sel, $amount));
    case ^pest_tab_gear : return(~void_buy_gear($sel));
}
return(false);

[proc,void_buy_gear](int $sel)(boolean)
def_namedobj $item = enum(int, namedobj, pest_gear_obj, $sel);
def_int $cost = enum(int, int, pest_gear_cost, $sel);
if ($item = null | $cost <= 0) {
    return(false);
}
if (%pest_commendation < $cost) {
    mes("That costs <tostring($cost)> commendation points, and you have <tostring(%pest_commendation)>.");
    return(false);
}
if (inv_freespace(inv) < 1) {
    mes("You have no room to carry it.");
    return(false);
}
%pest_commendation = sub(%pest_commendation, $cost);
inv_add(inv, $item, 1);
mes("The Void Knight hands over the <lowercase(oc_name($item))>.");
return(true);

[proc,void_buy_xp](int $sel, int $amount)(boolean)
def_stat $stat = enum(int, stat, pest_xp_stat, $sel);
if ($stat = null | $amount <= 0) {
    return(false);
}
if (~void_xp_per_point($sel) <= 0) {
    mes("You need level <tostring(^pest_xp_min_level)> <lowercase(enum(int, string, pest_xp_name, $sel))> before the Knights will trade you experience in it.");
    return(false);
}
if (%pest_commendation < $amount) {
    mes("That costs <tostring($amount)> commendation points, and you have <tostring(%pest_commendation)>.");
    return(false);
}
// THE EXPERIENCE IS WORKED OUT BEFORE THE POINTS ARE TAKEN, not after: stat_advance can level the
// player up, and a level-up between the two would pay for the new level at the new rate. The
// window quotes the figure from the same proc, so what it said is what it pays.
def_int $xp = ~void_xp_total($sel, $amount);
%pest_commendation = sub(%pest_commendation, $amount);
// TENTHS. stat_advance counts experience in tenths of a point - a shrimp is productexp=100 and
// worth 10 experience - while ~void_xp_total speaks the player's units, because every figure the
// window prints comes out of it. One multiply here keeps the window honest and the award right;
// without it the Knights would pay a tenth of what they quoted.
stat_advance($stat, multiply($xp, 10));
mes("You trade <~pluralise($amount, "commendation point")> for <tostring($xp)> <lowercase(enum(int, string, pest_xp_name, $sel))> experience.");
return(true);
