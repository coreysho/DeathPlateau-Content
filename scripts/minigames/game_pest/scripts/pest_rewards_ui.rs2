// The whole window, repainted. $sel is -1 for nothing selected.
[proc,void_ui_draw](int $tab, int $sel, int $amount)
if_settext(pest_rewards:subtitle, "<~void_ui_points_text>");
if_settext(pest_rewards:tab0, "<~void_ui_tabtint($tab, 0)>Experience");
if_setcolour(pest_rewards:tab0fill, ~void_ui_tab_fill($tab, 0));
if_settext(pest_rewards:tab1, "<~void_ui_tabtint($tab, 1)>Equipment");
if_setcolour(pest_rewards:tab1fill, ~void_ui_tab_fill($tab, 1));
~void_ui_row0($tab, 0, $sel, $amount);
~void_ui_row1($tab, 1, $sel, $amount);
~void_ui_row2($tab, 2, $sel, $amount);
~void_ui_row3($tab, 3, $sel, $amount);
~void_ui_row4($tab, 4, $sel, $amount);
~void_ui_row5($tab, 5, $sel, $amount);
~void_ui_row6($tab, 6, $sel, $amount);
// The amount selector belongs to the Experience tab and nothing else.
if_sethide(pest_rewards:amounts, ~void_ui_amounts_hidden($tab));
if_setcolour(pest_rewards:amt0fill, ~void_ui_amount_fill($amount, 1));
if_setcolour(pest_rewards:amt1fill, ~void_ui_amount_fill($amount, 10));
if_setcolour(pest_rewards:amt2fill, ~void_ui_amount_fill($amount, 100));
if_settext(pest_rewards:desc0, "<~void_ui_desc($tab, $sel, $amount, 0)>");
if_settext(pest_rewards:desc1, "<~void_ui_desc($tab, $sel, $amount, 1)>");

// Every button the window can answer with, added after the draw.
[proc,void_ui_buttons](int $tab)
if_addresumebutton(pest_rewards:tab0);
if_addresumebutton(pest_rewards:tab1);
def_int $i = 0;
while ($i < ~void_ui_count($tab)) {
    ~void_ui_rowbutton($i);
    $i = calc($i + 1);
}
if ($tab = ^pest_tab_xp) {
    if_addresumebutton(pest_rewards:amt0fill);
    if_addresumebutton(pest_rewards:amt1fill);
    if_addresumebutton(pest_rewards:amt2fill);
}
if_addresumebutton(pest_rewards:back);
if_addresumebutton(pest_rewards:confirm);

// A resume button per row, by index. switch_int rather than seven ifs so an unused
// row costs one comparison.
[proc,void_ui_rowbutton](int $i)
switch_int ($i) {
    case 0 : if_addresumebutton(pest_rewards:r0box);
    case 1 : if_addresumebutton(pest_rewards:r1box);
    case 2 : if_addresumebutton(pest_rewards:r2box);
    case 3 : if_addresumebutton(pest_rewards:r3box);
    case 4 : if_addresumebutton(pest_rewards:r4box);
    case 5 : if_addresumebutton(pest_rewards:r5box);
    case 6 : if_addresumebutton(pest_rewards:r6box);
}

// Which row was clicked, or -1. The window reads last_com once and asks this.
[proc,void_ui_clicked_row]()(int)
switch_component (last_com) {
    case pest_rewards:r0box : return(0);
    case pest_rewards:r1box : return(1);
    case pest_rewards:r2box : return(2);
    case pest_rewards:r3box : return(3);
    case pest_rewards:r4box : return(4);
    case pest_rewards:r5box : return(5);
    case pest_rewards:r6box : return(6);
}
return(-1);

// Which tab was clicked, or -1.
[proc,void_ui_clicked_tab]()(int)
switch_component (last_com) {
    case pest_rewards:tab0 : return(0);
    case pest_rewards:tab1 : return(1);
}
return(-1);

// Which amount button was clicked, or -1. The value, not the index: the window
// carries the number of points and never the button that set it.
[proc,void_ui_clicked_amount]()(int)
switch_component (last_com) {
    case pest_rewards:amt0fill : return(1);
    case pest_rewards:amt1fill : return(10);
    case pest_rewards:amt2fill : return(100);
}
return(-1);
