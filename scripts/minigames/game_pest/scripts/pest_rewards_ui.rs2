if_settext(pest_rewards:r1name, "<~void_ui_tint($tab, $i)><~void_ui_name($tab, $i)>");
if_settext(pest_rewards:r1cost, "<~void_ui_tint($tab, $i)><~void_ui_cost_text($tab, $i, $amount)>");
if_setcolour(pest_rewards:r1box, ~void_ui_row_fill($sel, $i));

