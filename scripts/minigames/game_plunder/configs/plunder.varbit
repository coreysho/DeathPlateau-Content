// The fields of configs/plunder.varp.

[plunder_urn_1_state]
basevar=plunder_urns
startbit=0
endbit=1

[plunder_urn_2_state]
basevar=plunder_urns
startbit=2
endbit=3

[plunder_urn_3_state]
basevar=plunder_urns
startbit=4
endbit=5

[plunder_urn_4_state]
basevar=plunder_urns
startbit=6
endbit=7

[plunder_urn_5_state]
basevar=plunder_urns
startbit=8
endbit=9

[plunder_urn_6_state]
basevar=plunder_urns
startbit=10
endbit=11

[plunder_urn_7_state]
basevar=plunder_urns
startbit=12
endbit=13

[plunder_urn_8_state]
basevar=plunder_urns
startbit=14
endbit=15

[plunder_urn_9_state]
basevar=plunder_urns
startbit=16
endbit=17

[plunder_urn_10_state]
basevar=plunder_urns
startbit=18
endbit=19

[plunder_urn_11_state]
basevar=plunder_urns
startbit=20
endbit=21

[plunder_urn_12_state]
basevar=plunder_urns
startbit=22
endbit=23

[plunder_urn_13_state]
basevar=plunder_urns
startbit=24
endbit=25

[plunder_urn_14_state]
basevar=plunder_urns
startbit=26
endbit=27

[plunder_urn_15_state]
basevar=plunder_urns
startbit=28
endbit=29

[plunder_room]
// 0 = outside the pyramid, 1-8 = the room you are allowed to be in
basevar=plunder
startbit=0
endbit=3

[plunder_chest_state]
// 0 shut, 1 open
basevar=plunder
startbit=4
endbit=4

[plunder_sarcophagus_state]
// 0 shut, 1 opened, 2 emptied
basevar=plunder
startbit=5
endbit=6

[plunder_door_1_state]
// 0 locked, 1 open
basevar=plunder
startbit=7
endbit=7

[plunder_door_2_state]
basevar=plunder
startbit=8
endbit=8

[plunder_door_3_state]
basevar=plunder
startbit=9
endbit=9

[plunder_door_4_state]
basevar=plunder
startbit=10
endbit=10

[plunder_doors_tried]
// a four-bit mask of the wrong doors tried in this room
basevar=plunder
startbit=11
endbit=14

[plunder_correct_door]
// 1-4, rerolled on entering each room
basevar=plunder
startbit=15
endbit=17

[plunder_time_left]
// half-minutes remaining, 10 at the start of a run
basevar=plunder
startbit=18
endbit=22
