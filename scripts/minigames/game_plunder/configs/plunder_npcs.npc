recol2d=21036
recol3s=29595
recol3d=20971
recol4s=0
recol4d=7296
recol5s=28504
recol5d=20971
walkanim=deserttreasure_mummy_walk
readyanim=deserttreasure_mummy_ready
op2=Attack
vislevel=84
hitpoints=80
attack=70
strength=50
defence=70
magic=1
ranged=1
param=stabdefence,0
param=slashdefence,0
param=crushdefence,0
param=magicdefence,0
param=rangedefence,0
param=attackbonus,0
param=strengthbonus,0
param=damagetype,^crush_style
param=attackrate,4
param=attackrange,1
param=attack_anim,deserttreasure_mummy_attack
param=defend_anim,deserttreasure_mummy_block
