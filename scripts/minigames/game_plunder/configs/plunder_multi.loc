// The Pyramid Plunder multilocs, which importosrsmap.py cannot write: it follows a multiloc
// to its default child and places THAT, so all fifteen urn slots arrive as three ids and the
// chest, the sarcophagus and the four doors arrive stuck in their opening state.
//
// Every one of these is a varbit, and a varbit is per player - which is the point. Two people
// in the same room each see their own urns; a loc_change would show one of them the other's.
//
// The children are the imported art, one 377 loc per state, and the order is Jagex's own:
//   urn          0 untouched (Search / Check for Snakes)  1 checked and safe  2 checked, snake  3 emptied
//   chest        0 shut (Search)                          1 open
//   sarcophagus  0 shut (Open)                            1 opened (Search)   2 emptied
//   tomb door    0 locked (Pick-lock)                     1 open (Enter)

[plunder_urn_1]
// OSRS loc 26580
blockrange=no
active=yes
multivar=plunder_urn_1_state
multiloc=0,plunder_urn_a_fresh
multiloc=1,plunder_urn_a_checked
multiloc=2,plunder_urn_a_snake
multiloc=3,plunder_urn_a_empty

[plunder_urn_2]
// OSRS loc 26600
blockrange=no
active=yes
multivar=plunder_urn_2_state
