// =============================================================================================

[proc,plunder_running]()(boolean)
if (%plunder_room = 0) {
    mes("Nothing happens.");
    return(false);
}
return(true);

[proc,plunder_small_hit]()(int)
return(add(^plunder_hit_low, random(add(sub(^plunder_hit_high, ^plunder_hit_low), 1))));

