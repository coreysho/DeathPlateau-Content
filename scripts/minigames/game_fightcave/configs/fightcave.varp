// The TzHaar Fight Cave (minigames/game_fightcave/scripts/fightcave.rs2).
//
// ALL FOUR ARE TEMP, and that is deliberate rather than an oversight: an instance does not survive
// a restart, so neither may anything pointing into one. A player logged out mid-cave comes back
// outside with nothing, which is what OSRS does too.

// The instance this player's cave was built in - its south-west tile, or null when not inside.
[fightcave_instance]
type=coord

// Which wave is running, 1..^fightcave_waves. 0 when not inside.
[fightcave_wave]
type=int

// Where the cycle has got to, 0..^fightcave_cycle-1. It keeps counting across waves, which is what
// makes the spawn points feel like a rotation rather than a shuffle.
[fightcave_cycle_at]
type=int

// Set when the run was entered through the refight shortcut (suggestion #21) rather than at wave
// 1. The run is worth only Jad: ~fightcave_pay refuses the wave Tokkul and ~fightcave_reward holds
// back the broadcast, so the shortcut pays the cape, the pet roll and Jad's own 4,000 and nothing
// for the 62 waves it skipped.
//
// IT HAS TO BE STORED rather than worked out at the end, because by the time anything reads it
// %fightcave_wave is 63 whichever way the player came in - and a full run that fought its way to
// Jad must still be paid for the 62 waves it fought.
[fightcave_jad_only]
type=int

// Jad's "healers called" flag is an NPC var, not one of these - see fightcave.varn.
