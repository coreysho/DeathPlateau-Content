// What the Fight Cave pays, and what happens when you die in it.
//
// Both the Fire cape and Tokkul were already fully configured in the cache and had NO SOURCE - the
// cape with its full bonuses and tradeable=no, Tokkul stackable with its own count variants right
// up to 25. This is the only place either comes from.

// Tokkul for surviving $waves waves. The wiki gives the formula as N * (N + 1), and the same page
// quotes 8,032 for a completed cave: 63 * 64 = 4032, plus the 4,000 for Jad, is exactly that. Two
// independent statements of one number is the only reason to trust either, so
// ^fightcave_full_run_tokkul records it and the battery checks the arithmetic still lands on it.
[proc,fightcave_tokkul_for](int $waves)(int)
if ($waves <= 0) {
    return(0);
}
return(multiply($waves, add($waves, 1)));

[proc,fightcave_pay](int $waves)
// THE REFIGHT SHORTCUT PAYS FOR NO WAVES (suggestion #21). Entering at wave 63 leaves
// %fightcave_wave at 63, so every exit - leaving, dying, killing Jad - would otherwise hand over
// the 62 waves' Tokkul that the run never fought: 3,906 for walking back out, 4,032 for the kill.
// The guard is here rather than at the three call sites because there are three of them and this
// is the one thing they all do.
if (%fightcave_jad_only = ^true) {
    return;
}
def_int $tokkul = ~fightcave_tokkul_for($waves);
if ($tokkul <= 0) {
    return;
}
~obj_giveorbank(tzhaar_token, $tokkul);
mes("You are awarded <tostring($tokkul)> Tokkul.");

// Killing TzTok-Jad. The cape does not go in the bank if the pack is full - it goes on the floor of
// a cave that is about to be deleted - so this is the one reward that must reach the player's own
// inventory or their bank, never the ground.
[proc,fightcave_reward]
~obj_giveorbank(tzhaar_cape_fire, 1);
~collection_log_add(tzhaar_cape_fire, 1); // the collection log's Fight Caves page
~obj_giveorbank(tzhaar_token, ^fightcave_tokkul_jad);
mes("You are awarded <tostring(^fightcave_tokkul_jad)> Tokkul, and TzHaar-Mej-Jal's respect.");
// The pet, on its own roll. ~bosspet_roll would drop it on the floor of an instance that is about
// to be deleted, so this does the framework's own three checks and then hands it over the same way
// the cape is handed over.
~fightcave_pet_roll;
// THE BROADCAST IS FOR THE RUN, NOT THE KILL. A full cave is three quarters of an hour; the
// refight shortcut is a couple of minutes, and announcing every one of those to the whole world
// would turn the news into a Jad ticker. So a shortcut kill pays the cape and rolls the pet -
// which is the whole point of the shortcut - and keeps quiet about it.
if (%fightcave_jad_only = ^false) {
    ~broadcast_news("Fire cape!", "defeated TzTok-Jad and claimed a @dre@Fire cape@bla@.");
}

// Pack first, bank second. Nothing here may fall on the floor: the instance is deleted moments
// later and anything lying in it goes with it.
[proc,obj_giveorbank](namedobj $obj, int $count)
// A free slot takes anything; an existing stack takes more of a stackable without needing one.
if (inv_freespace(inv) > 0 | inv_total(inv, $obj) > 0) {
    inv_add(inv, $obj, $count);
    return;
}
inv_add(bank, $obj, $count);
mes("<oc_name($obj)> has been sent to your bank.");

// TzRek-Jad, received as every pet is (~pet_receive, npc/scripts/follower.rs2). Queued a tick: this
// runs in the cave, and a pet that came out to follow you here would be deleted with the instance
// the moment ~fightcave_end teleports you out - a tick later you are standing outside.
[proc,fightcave_pet_roll]
if (random(^fightcave_pet_rate) ! 0) {
    return;
}
~pet_receive_later(bosspet_tzrek_jad_item, 1);
