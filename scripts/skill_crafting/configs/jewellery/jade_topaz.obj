[burning_amulet_5]
name=Burning amulet(5)
desc=Useful teleports around the wilderness.
model=obj_burning_amulet_5
manwear=obj_burning_amulet_5_manwear,0
womanwear=obj_burning_amulet_5_womanwear,0
wearpos=front
2dzoom=620
2dxan=424
2dyan=68
2dxof=1
2dyof=16
recol1s=32736
recol1d=26425
recol2s=32767
recol2d=30767
weight=7g
cost=1250
members=yes
iop2=Wear
iop4=Rub
// Five teleports, and every destination is in the Wilderness: the Lava Maze, the Chaos Temple and
// the Bandit Camp. The wilderness-level gate that stops the glory and the games necklace working
// past 30 and 20 deliberately does NOT apply - this amulet's whole purpose is to put you up there,
// and Old School lets it (it asks for confirmation instead, which is what burning_amulet.rs2 does).
category=burning_amulet
param=next_obj_stage,burning_amulet_4
param=charges,5
wearop1=Lava Maze
wearop2=Chaos Temple
wearop3=Bandit Camp

