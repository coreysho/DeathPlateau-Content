param=charges,5
wearop1=Check

[efaritays_aid]
name=Efaritay's aid
desc=Aids the user against vampyres.
model=obj_efaritays_aid
wearpos=ring
2dzoom=830
2dxan=322
2dyan=135
2dzan=2024
2dxof=4
2dyof=-12
recol1s=32576
recol1d=26425
recol2s=32767
recol2d=30767
weight=6g
cost=1425
members=yes
iop2=Wear
iop3=Check
iop4=Break
// NOTHING IS WIRED TO THIS AND THAT IS DELIBERATE. Old School's Efaritay's aid does one thing: it
// lets a vampyre be finished without a stake. This build's vampyres are cache npcs with no stake
// mechanic to be exempt from (burgh_juvinate_vampyre_*, burgh_turned_vampyre_* in
// _unpack/377/all.npc, unscripted), so there is no behaviour to attach and inventing a vampyre
// combat rule to justify one ring is the wrong way round.
//
// It is therefore the topaz ring's enchant result and a wearable ring with Old School's own
// bonuses, and the day vampyres get built it is already here waiting. Same treatment the 48
// achievement diary items get in general/configs/diary_rewards.obj.
param=stabdefence,1
param=slashdefence,1
param=crushdefence,1
param=magicdefence,1
param=rangedefence,1

