[opheldu,ball_of_wool]
switch_obj (last_useitem)
{
    case unstrung_gold_amulet, unstrung_sapphire_amulet, unstrung_emerald_amulet, unstrung_ruby_amulet, unstrung_diamond_amulet, nostringstar : @string_amulet(last_useslot);
    // Haunted Mine's Salve shard. Wool is the only thing that will hold it; the label and the
    // shard's own [opheldu] live in quests/quest_hauntedmine.
    case crystalshard_necklace_unstrung : @hm_string_shard;
    // Jade and red topaz (2026-10-12). Members, like the dragonstone and onyx amulets below.
    case unstrung_jade_amulet, unstrung_topaz_amulet :
        if (map_members = ^false) {
            mes(^mes_members_feature);
            return;
        }
        @string_amulet(last_useslot);
    case nostringsnake, unstrung_dragonstone_amulet, unstrung_onyx_amulet :
        if (map_members = ^false) {
            mes(^mes_members_feature);
            return;
        }
        @string_amulet(last_useslot);
}
~displaymessage(^dm_default);

[opheldu,unstrung_sapphire_amulet]
if (last_useitem = ball_of_wool) @string_amulet(last_slot);
~displaymessage(^dm_default);

[opheldu,unstrung_emerald_amulet]
if (last_useitem = ball_of_wool) @string_amulet(last_slot);
// MAGIC string makes the Amulet of nature instead of the amulet of defence (2026-10-12). This
// trigger has to be the one that tests for it: [opheldu,unstrung_emerald_amulet] can only be
// declared once in the build, and it is declared here.
// skill_farming/scripts/amulet_of_nature.rs2 owns the other half of the use and the label.
if (last_useitem = magic_string) @nature_amulet_string(last_slot);
~displaymessage(^dm_default);

[opheldu,unstrung_ruby_amulet]
if (last_useitem = ball_of_wool) @string_amulet(last_slot);
~displaymessage(^dm_default);

[opheldu,unstrung_diamond_amulet]
if (last_useitem = ball_of_wool) @string_amulet(last_slot);
~displaymessage(^dm_default);

[opheldu,unstrung_dragonstone_amulet]
if (last_useitem = ball_of_wool) {
    if (map_members = ^false) {
        mes(^mes_members_feature);
        return;
    }
    @string_amulet(last_slot);
}
~displaymessage(^dm_default);

[opheldu,unstrung_jade_amulet]
if (last_useitem = ball_of_wool) {
    if (map_members = ^false) {
        mes(^mes_members_feature);
        return;
    }
    @string_amulet(last_slot);
}
~displaymessage(^dm_default);

[opheldu,unstrung_topaz_amulet]
if (last_useitem = ball_of_wool) {
    if (map_members = ^false) {
        mes(^mes_members_feature);
        return;
    }
    @string_amulet(last_slot);
}
~displaymessage(^dm_default);

[opheldu,nostringstar]
if (last_useitem = ball_of_wool) @string_amulet(last_slot);
~displaymessage(^dm_default);

[opheldu,nostringsnake]
if (last_useitem = ball_of_wool) {
    if (map_members = ^false) {
        mes(^mes_members_feature);
        return;
    }
    @string_amulet(last_slot);
}
~displaymessage(^dm_default);


[label,string_amulet](int $last)
def_obj $unstrung = inv_getobj(inv, $last);
def_struct $struct = oc_param($unstrung, crafting_jewelry_struct);
// Nothing is taken until we know what it becomes. The onyx amulet once had no struct, and this
// deleted the amulet and the wool and then failed on struct_param, so both were simply lost.
if ($struct = null) {
    ~displaymessage(^dm_default);
    return;
}

// delete items
inv_del(inv, $unstrung, 1);
inv_del(inv, ball_of_wool, 1);

// give item
inv_add(inv, struct_param($struct, strung), 1);

// always 4 crafting xp
stat_advance(crafting, 40);

// display game message
def_string $name = struct_param($struct, stringing_name);
if (string_length($name) < 1) {
    $name = "amulet";
}
mes("You put some string on your <$name>.");



