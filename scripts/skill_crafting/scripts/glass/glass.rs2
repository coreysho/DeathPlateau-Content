[oplocu,sandpit]
if (last_useitem = bucket_empty) @sand_fill;
~displaymessage(^dm_default);

// A use-on reaches only the item the player clicked SECOND, so a trigger that recognises nothing
// has to say ^dm_default: that is what hands the click to the other half (~displaymessage and
// opheldu_decline behind it). Falling off the end in silence swallowed it.
[opheldu,glassblowingpipe]
if (last_useitem = molten_glass) @craft_glass_interface;
~displaymessage(^dm_default);

[opheldu,molten_glass]
if (last_useitem = glassblowingpipe) @craft_glass_interface;
if (last_useitem = lens_mould) @craft_telescope_disc;
~displaymessage(^dm_default);

[label,sand_fill]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
anim(human_fillbucket_sandpit, 0);
inv_del(inv, bucket_empty, 1);
inv_add(inv, bucket_sand, 1);
mes("You fill the bucket with sand.");

[label,smelt_glass]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
// just a guess for now. level failure:
if (stat(crafting) < 1) {
    ~mesbox("You need at least 1 Crafting to make Glass.");
    return;
}
// check if enough soda ash
if (inv_total(inv, soda_ash) < 1) {
    ~mesbox("You need some Soda Ash to make Glass.");
    return;
}
// check if enough sand
if (inv_total(inv, bucket_sand) < 1) {
    ~mesbox("You need some Sand to make Glass.");
    return;
}
// delete and add items in this order
inv_del(inv, bucket_sand, 1);
inv_add(inv, bucket_empty, 1);
inv_del(inv, soda_ash, 1);
inv_add(inv, molten_glass, 1);
// play anim and sound
anim(human_furnace,0);
sound_synth(furnace,1,0);
// success message
mes("You heat the sand and soda ash in the furnace to make glass.");
// give xp
stat_advance(crafting, 200);


[label,craft_glass_interface]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
// 2006'S OWN GLASSBLOWING PANEL, which was in the cache all along and nothing opened.
// skill_crafting/interfaces/glass_crafting.if lays out all seven products with their models and
// Make 1 / 5 / 10 / X on each, and it is what this used to be: a ~multiobj4 chooser with four of
// the seven products in it, so the candle lantern, the oil lamp, the fishbowl and the lantern lens
// could not be made at all - reported from the game as "cant make candle lantern". The chooser
// went to ~multiobj7 as the narrow fix for that; this is the round that puts the real panel in.
//
// The seven, in the order OSRS unlocks them, are 1, 4, 12, 33, 42, 46 and 49 Crafting. The panel
// orders them by its own layout instead, which is why the triggers below read by component and not
// by level.
//
// THE BUTTERFLY JAR IS STILL OUT, which is the one thing here that is not a correction. It is not
// an OSRS glassblowing product - a jar comes from a jar generator or a Hunter shop, and this build
// has both ([opheld3,jar_generator] and the Rellekka, Piscatoris and warlock shops) - and the panel
// has no slot for it either. Its struct and its param are left where they are.
if_openmain(glass_crafting);

// THE PANEL'S TWENTY-EIGHT BUTTONS: seven products, each with Make X, 10, 5 and 1 in that order,
// which is the order glass_crafting.if numbers them in. ^glass_make_x is the count that means
// "ask", and cannot collide with a real one.

[if_button,glass_crafting:com_10] @crafting_glass(vial_empty, ^glass_make_x);
[if_button,glass_crafting:com_11] @crafting_glass(vial_empty, 10);
[if_button,glass_crafting:com_12] @crafting_glass(vial_empty, 5);
[if_button,glass_crafting:com_13] @crafting_glass(vial_empty, 1);

[if_button,glass_crafting:com_14] @crafting_glass(stafforb, ^glass_make_x);
[if_button,glass_crafting:com_15] @crafting_glass(stafforb, 10);
[if_button,glass_crafting:com_16] @crafting_glass(stafforb, 5);
[if_button,glass_crafting:com_17] @crafting_glass(stafforb, 1);

[if_button,glass_crafting:com_18] @crafting_glass(beer_glass, ^glass_make_x);
[if_button,glass_crafting:com_19] @crafting_glass(beer_glass, 10);
[if_button,glass_crafting:com_20] @crafting_glass(beer_glass, 5);
[if_button,glass_crafting:com_21] @crafting_glass(beer_glass, 1);

[if_button,glass_crafting:com_22] @crafting_glass(candle_lantern_empty, ^glass_make_x);
[if_button,glass_crafting:com_23] @crafting_glass(candle_lantern_empty, 10);
[if_button,glass_crafting:com_24] @crafting_glass(candle_lantern_empty, 5);
[if_button,glass_crafting:com_25] @crafting_glass(candle_lantern_empty, 1);

[if_button,glass_crafting:com_26] @crafting_glass(oil_lamp_empty, ^glass_make_x);
[if_button,glass_crafting:com_27] @crafting_glass(oil_lamp_empty, 10);
[if_button,glass_crafting:com_28] @crafting_glass(oil_lamp_empty, 5);
[if_button,glass_crafting:com_29] @crafting_glass(oil_lamp_empty, 1);

[if_button,glass_crafting:com_30] @crafting_glass(bullseye_lantern_lens, ^glass_make_x);
[if_button,glass_crafting:com_31] @crafting_glass(bullseye_lantern_lens, 10);
[if_button,glass_crafting:com_32] @crafting_glass(bullseye_lantern_lens, 5);
[if_button,glass_crafting:com_33] @crafting_glass(bullseye_lantern_lens, 1);

[if_button,glass_crafting:com_34] @crafting_glass(fishbowl_empty, ^glass_make_x);
[if_button,glass_crafting:com_35] @crafting_glass(fishbowl_empty, 10);
[if_button,glass_crafting:com_36] @crafting_glass(fishbowl_empty, 5);
[if_button,glass_crafting:com_37] @crafting_glass(fishbowl_empty, 1);
[label,crafting_glass](namedobj $glass_item, int $count)
def_struct $struct = oc_param($glass_item, crafting_glass_struct);
def_int $level = struct_param($struct, levelrequire);
def_string $name = struct_param($struct, productmessage);
// Make X asks before anything else, so a player who wanted a count and is then refused for their
// level has not been asked for nothing - and so the level message is the last thing on screen.
if ($count = ^glass_make_x) {
    p_countdialog;
    $count = last_int;
}
if_close;
if ($count < 1) {
    return;
}
if (stat(crafting) < $level) {
    mes("You need level <tostring($level)> Crafting to make <$name>.");
    return;
}
if (inv_total(inv, molten_glass) < 1) {
    mes("You have no molten glass to work.");
    return;
}
// AS MANY AS WERE ASKED FOR, and no more. This made a single item and stopped, so an inventory of
// molten glass took twenty-six clicks; the fix for that made every piece in one go, which is right
// for a chooser with no count on it and wrong for a panel that has four. Make X with a big number
// is how you do the whole lot now.
//
// p_delay is what carries the repeat, the same way smelting spaces its bars out. It yields, so
// the player can walk away or click something else and the loop ends on its own the next time
// round - there is no state to clean up and nothing to interrupt explicitly.
def_int $made = 0;
while ($made < $count & inv_total(inv, molten_glass) > 0) {
    inv_del(inv, molten_glass, 1);
    inv_add(inv, $glass_item, 1);
    anim(human_glassblowing, 0);
    mes("You make <$name>.");
    stat_advance(crafting, struct_param($struct, productexp));
    $made = add($made, 1);
    // The last one needs no wait after it, and waiting would hold the player still for
    // nothing - which reads as the action not having finished.
    if ($made < $count & inv_total(inv, molten_glass) > 0) {
        p_delay(2);
    }
}
