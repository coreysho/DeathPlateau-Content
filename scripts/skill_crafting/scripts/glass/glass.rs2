[oplocu,sandpit]
if (last_useitem = bucket_empty) @sand_fill;
~displaymessage(^dm_default);

// A use-on reaches only the item the player clicked SECOND, so a trigger that recognises nothing
// has to say ^dm_default: that is what hands the click to the other half (~displaymessage and
// opheldu_decline behind it). Falling off the end in silence swallowed it.
[opheldu,glassblowingpipe]
if (last_useitem = molten_glass) @craft_glass_interface;
~displaymessage(^dm_default);

[opheldu,molten_glass]
if (last_useitem = glassblowingpipe) @craft_glass_interface;
if (last_useitem = lens_mould) @craft_telescope_disc;
~displaymessage(^dm_default);

[label,sand_fill]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
anim(human_fillbucket_sandpit, 0);
inv_del(inv, bucket_empty, 1);
inv_add(inv, bucket_sand, 1);
mes("You fill the bucket with sand.");

[label,smelt_glass]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
// just a guess for now. level failure:
if (stat(crafting) < 1) {
    ~mesbox("You need at least 1 Crafting to make Glass.");
    return;
}
// check if enough soda ash
if (inv_total(inv, soda_ash) < 1) {
    ~mesbox("You need some Soda Ash to make Glass.");
    return;
}
// check if enough sand
if (inv_total(inv, bucket_sand) < 1) {
    ~mesbox("You need some Sand to make Glass.");
    return;
}
// delete and add items in this order
inv_del(inv, bucket_sand, 1);
inv_add(inv, bucket_empty, 1);
inv_del(inv, soda_ash, 1);
inv_add(inv, molten_glass, 1);
// play anim and sound
anim(human_furnace,0);
sound_synth(furnace,1,0);
// success message
mes("You heat the sand and soda ash in the furnace to make glass.");
// give xp
stat_advance(crafting, 200);


[label,craft_glass_interface]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
// ALL SEVEN OF THEM. The chooser was ~multiobj4 and glass.struct has had more products than that
// for as long as this file has existed, so the candle lantern, the oil lamp, the fishbowl and the
// lantern lens could not be made at all - reported from the game as "cant make candle lantern".
// It is ~multiobj7 now, which is exactly as many slots as there are glassblowing products, in the
// order OSRS lists them: 1, 4, 12, 33, 42, 46 and 49 Crafting.
//
// THE LABELS ARE BROKEN BY HAND where they do not fit. multiobj7 puts the name UNDER the picture in
// a 67px column and the client does not wrap text - it only splits on a literal backslash-n - so a
// name wider than 66px would spill over its neighbours. Measured in q8_full with tools/ifrender.py:
// "Beer glass" is 69 and "Candle lantern" 98 and "Lantern lens" 85, so those three are split; the
// widest half is "lantern" at 47.
//
// THE BUTTERFLY JAR CAME OUT, which is the one thing here that is not a correction. It is not an
// OSRS glassblowing product - a jar comes from a jar generator or a Hunter shop, and this build has
// both ([opheld3,jar_generator] and the Rellekka, Piscatoris and warlock shops) - and it was
// holding a slot that a real product needed. Its struct and its param are left where they are, so
// putting it back is one line if that was deliberate.
//
// THE CACHE HAS A BETTER MENU THAN THIS and nobody is using it: skill_crafting/interfaces/
// glass_crafting.if is 2006's own glassblowing panel, with these same seven products laid out and
// Make 1 / 5 / 10 / X on each. Wiring it up is a bigger piece of work than this bug - 28 buttons
// and a count dialogue - so it is left for its own round rather than done badly here.
def_namedobj $item = ~multiobj7("What would you like to make?",
    beer_glass, 0, 0, 200, "Beer\\nglass", 0, 0,
    candle_lantern_empty, 0, 0, 230, "Candle\\nlantern", 0, 0,
    oil_lamp_empty, 0, 0, 230, "Oil lamp", 0, 0,
    vial_empty, 0, 0, 180, "Vial", 0, 0,
    fishbowl_empty, 0, 0, 230, "Fishbowl", 0, 0,
    stafforb, 0, 0, 200, "Orb", 0, 0,
    bullseye_lantern_lens, 0, 0, 180, "Lantern\\nlens", 0, 0
);
if ($item = null) {
    ~displaymessage(^dm_default);
    return;
}
@crafting_glass($item);


[label,crafting_glass](namedobj $glass_item)
def_struct $struct = oc_param($glass_item, crafting_glass_struct);
// check if high enough level
def_int $level = struct_param($struct, levelrequire);
def_string $name = struct_param($struct, productmessage);
if (stat(crafting) < $level) {
    mes("You need level <tostring($level)> Crafting to make <$name>.");
    return;
}
// EVERY PIECE OF GLASS, not one of them. This made a single item and stopped, so an inventory
// of molten glass took twenty-six clicks.
//
// p_delay is what carries the repeat, the same way smelting spaces its bars out. It yields, so
// the player can walk away or click something else and the loop ends on its own the next time
// round - there is no state to clean up and nothing to interrupt explicitly.
def_int $made = 0;
while (inv_total(inv, molten_glass) > 0) {
    inv_del(inv, molten_glass, 1);
    inv_add(inv, $glass_item, 1);
    anim(human_glassblowing, 0);
    mes("You make <$name>.");
    stat_advance(crafting, struct_param($struct, productexp));
    $made = add($made, 1);
    // The last one needs no wait after it, and waiting would hold the player still for
    // nothing - which reads as the action not having finished.
    if (inv_total(inv, molten_glass) > 0) {
        p_delay(2);
    }
}
