// THE VOTE CLERK at the Edgeville bank. op3=Trade is the shop system's own
// ([opnpc3,_shop_keeper] -> ~openshop_activenpc), so all this file owns is Talk-to.
//
// TALK-TO IS WHERE YOU READ YOUR BALANCE, and it is the only place you can. A vote point is a varp,
// so unlike Marks of Grace or Tokkul there is no stack in the inventory to look at - and a player
// with no tickets left has nothing to click to find out what they have. The clerk always will.

[opnpc1,vote_clerk]
~chatnpc("<p,happy>Welcome. I keep the ledger of who has voted.");
// Anything the ledger owes - a vote credited while the player was offline, or while their pack was
// full - before the balance, because the tickets a player is about to redeem are the reason they
// came. ~vote_deliver is the ledger; ~vote_collect_pending is what the clerk is already holding.
~vote_deliver;
~vote_collect_pending;
if (%vote_points = 0) {
    ~chatnpc("<p,neutral>You have no vote points. Redeem a vote ticket and come back.");
} else {
    ~chatnpc("<p,neutral>You have <~pluralise(%vote_points, "vote point")> to spend.");
}
def_int $choice = ~p_choice4(
    "Let's see the rewards, then.", 1,
    "I've voted - can you check?", 2,
    "Where can I vote?", 3,
    "Maybe later.", 4);
if ($choice = 4) {
    ~chatplayer("<p,neutral>Maybe later.");
    ~chatnpc("<p,neutral>The ledger will keep.");
    return;
}
if ($choice = 2) {
    ~chatplayer("<p,quiz>I've voted - can you check?");
    @vote_claim_talk;
}
if ($choice = 3) {
    ~chatplayer("<p,quiz>Where can I vote?");
    if (vote_sitecount = 0) {
        ~chatnpc("<p,neutral>Nowhere yet. When this server is listed somewhere, I'll be the one keeping count.");
        return;
    }
    ~vote_sites_mesbox;
    @vote_reminder_ask;
}
~chatplayer("<p,happy>Let's see the rewards, then.");
~openshop_activenpc;

// THE OFF SWITCH FOR THE REMINDER, and it lives here because this is where somebody annoyed by it
// comes. It is the tail of "Where can I vote?" rather than a fifth menu option because p_choice4 is
// four, and because a player who does not want to be reminded is a player asking about voting.
[label,vote_reminder_ask]
if (%vote_reminders_off = 1) {
    if (~p_choice2("Remind me when I can vote again.", 1, "No, leave it.", 2) ! 1) {
        ~chatplayer("<p,neutral>No, leave it.");
        return;
    }
    ~chatplayer("<p,neutral>Remind me when I can vote again.");
    %vote_reminders_off = 0;
    ~vote_reminder_start;
    ~chatnpc("<p,happy>I'll give you a nudge.");
    return;
}
if (~p_choice2("Thanks.", 1, "Stop reminding me about this.", 2) ! 2) {
    ~chatplayer("<p,neutral>Thanks.");
    return;
}
~chatplayer("<p,neutral>Stop reminding me about this.");
%vote_reminders_off = 1;
~vote_reminder_start;
~chatnpc("<p,neutral>Not another word. Ask me here if you change your mind.");
